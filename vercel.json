{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/stagione",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stagione/:percorso*",
      "destination": "/:percorso*",
      "permanent": true
    },
    {
      "source": "/mockup/sito/area.html",
      "destination": "/area",
      "permanent": true
    },
    {
      "source": "/mockup/sito/area-:pagina.html",
      "destination": "/area/:pagina",
      "permanent": true
    },
    {
      "source": "/mockup",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mockup/:percorso*",
      "destination": "/",
      "permanent": true
    }
  ]
}
