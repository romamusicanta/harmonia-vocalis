{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:percorso*",
      "has": [
        {
          "type": "host",
          "value": "harmonia-vocalis.vercel.app"
        }
      ],
      "destination": "https://romamusicanta.org/:percorso*",
      "permanent": true
    },
    {
      "source": "/:percorso*",
      "has": [
        {
          "type": "host",
          "value": "harmoniavocalis.com"
        }
      ],
      "destination": "https://romamusicanta.org/:percorso*",
      "permanent": true
    },
    {
      "source": "/:percorso*",
      "has": [
        {
          "type": "host",
          "value": "www.harmoniavocalis.com"
        }
      ],
      "destination": "https://romamusicanta.org/:percorso*",
      "permanent": true
    },
    {
      "source": "/stagione",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stagione/:percorso*",
      "destination": "/:percorso*",
      "permanent": true
    },
    {
      "source": "/area/presenze",
      "destination": "/area/prove",
      "permanent": true
    },
    {
      "source": "/mockup/sito/area.html",
      "destination": "/area",
      "permanent": true
    },
    {
      "source": "/mockup/sito/area-:pagina.html",
      "destination": "/area/:pagina",
      "permanent": true
    },
    {
      "source": "/mockup",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mockup/:percorso*",
      "destination": "/",
      "permanent": true
    }
  ]
}
