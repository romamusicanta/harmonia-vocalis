// nel colore d'accento. Il carattere Archivo largo è dichiarato in coro.config.ts (aspetto.caratteriLogo).
---

<svg viewBox="0 0 600 150" role="img" aria-label="Harmonia Vocalis">
  <g fill="none" stroke="currentColor" stroke-width="9"><path d="M40 60H420a20 20 0 0 1 0 40H40" /><path d="M440 80H540" /></g>
  <circle cx="552" cy="80" r="11" style="fill:var(--accento)" />
  <g fill="currentColor" style="font-family:Archivo,system-ui,sans-serif;font-stretch:125%">
    <text x="40" y="46" font-size="40" font-weight="900" letter-spacing="-1.4">HARMONIA</text>
    <text x="150" y="140" font-size="40" font-weight="300" letter-spacing="-1">VOCALIS</text>
  </g>
</svg>
