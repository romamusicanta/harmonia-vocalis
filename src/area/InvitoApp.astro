---
// Aree riservate (coristi, Maestro, Amministrazione): invito a installare l'app (la PWA, vedi src/componenti/TestaApp.astro), sotto la
// barra delle sezioni, solo nella prima pagina dell'area (TestataArea), con l'icona dell'app di quell'area. Nascosto finché lo script non sa che serve: su Android e nei browser che lo
// permettono un pulsante apre la richiesta di installazione; altrimenti spiega come aggiungerla
// alla schermata Home: su iPhone e iPad da Condividi (il pulsante cambia posto tra le versioni di
// Safari e negli altri browser, per questo il testo resta generico), su Android dal menu ⋮ di Chrome.
// Solo su telefoni e tablet, mai sul computer. Non compare se l'app è già aperta come app, né per
// chi l'ha chiuso (localStorage hv-invito-app, una data per area, per 60 giorni).
import Icona from '../componenti/Icona.astro';

interface Props { area?: 'coristi' | 'maestro' | 'admin' }
const { area = 'coristi' } = Astro.props;
const nome = { coristi: "l'area coristi", maestro: "l'area del Maestro", admin: "l'Amministrazione" }[area];
---

<div class="invito-app" hidden data-chiave={area === 'coristi' ? 'hv-invito-app' : `hv-invito-app-${area}`}>
  <div class="w">
    <img src={`/icone/icona-${area}-192.png`} alt="" width="44" height="44" />
    <div class="testo">
      <b>Metti {nome} sul telefono</b>
      <span class="breve">Si apre dalla schermata Home, come un'app.</span>
      <span class="android">In Chrome tocca <Icona nome="menu-punti" /> in alto a destra, poi <b>Installa app</b> (o <b>Aggiungi a schermata Home</b>): {nome} si aprirà con un tocco, come un'app.</span>
      <span class="ios">Tocca <Icona nome="condividi-ios" /> <b>Condividi</b> (in Safari può stare nel menu <b>···</b>), poi <b>Aggiungi alla schermata Home</b>: {nome} si aprirà con un tocco, come un'app{area !== 'admin' && ', e potrai ricevere le notifiche del coro'}.</span>
    </div>
    <button type="button" class="btn g piccolo installa">Installa</button>
    <button type="button" class="chiudi-invito" aria-label="Non ora" title="Non ora"><Icona nome="chiudi" classe="" /></button>
  </div>
</div>

<style>
  .invito-app { background: var(--bianco); border-bottom: 1px solid var(--linea); }
  .invito-app .w { display: flex; align-items: center; gap: 14px; padding-top: 14px; padding-bottom: 14px; }
  .invito-app img { border-radius: 10px; flex-shrink: 0; box-shadow: 0 0 0 1px var(--linea); }
  .invito-app .testo { flex: 1; min-width: 0; font-size: 14px; line-height: 1.45; color: var(--tenue); }
  .invito-app .testo > b { display: block; color: var(--primario); font-size: 15px; }
  .invito-app .testo b { color: var(--primario); }
  .invito-app .testo :global(svg) { width: 16px; height: 16px; vertical-align: -3px; color: var(--primario); }
  .invito-app .breve, .invito-app .ios, .invito-app .android, .invito-app .installa { display: none; }
  .invito-app.su-ios .ios, .invito-app.su-android .android, .invito-app.installabile .breve { display: inline; }
  .invito-app.installabile .android, .invito-app.installabile .ios { display: none; }
  .invito-app.installabile .installa { display: inline-flex; flex-shrink: 0; }
  .chiudi-invito { width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 0; color: var(--tenue); border-radius: var(--raggio); flex-shrink: 0; cursor: pointer; }
  .chiudi-invito:hover { background: var(--fondo); color: var(--primario); }
</style>

<script>
  const invito = document.querySelector<HTMLElement>('.invito-app');
  const CHIAVE = invito?.dataset.chiave ?? 'hv-invito-app';
  const giaApp = matchMedia('(display-mode: standalone)').matches || (navigator as { standalone?: boolean }).standalone === true;
  let chiuso = false;
  try { chiuso = Date.now() - Number(localStorage.getItem(CHIAVE) ?? 0) < 60 * 86400 * 1000; } catch {}
  // Gli iPad recenti si presentano come Mac con lo schermo tattile
  const android = /android/i.test(navigator.userAgent);
  const ios = !android && (/iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));
  let richiesta: (Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> }) | undefined;
  const nascondi = () => { if (invito) invito.hidden = true; };

  // Solo su telefoni e tablet (Android, iPhone, iPad): mai sul computer, anche se il browser permette di installare
  if (invito && !giaApp && !chiuso && (ios || android)) {
    invito.classList.add(ios ? 'su-ios' : 'su-android');
    invito.hidden = false;
    // Chrome, Samsung Internet: la richiesta di installazione arriva quando il sito è installabile
    addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      richiesta = e as typeof richiesta;
      invito.classList.add('installabile');
      invito.hidden = false;
    });
    invito.querySelector('.installa')?.addEventListener('click', async () => {
      if (!richiesta) return;
      await richiesta.prompt();
      const { outcome } = await richiesta.userChoice;
      richiesta = undefined;
      if (outcome === 'accepted') nascondi();
    });
    invito.querySelector('.chiudi-invito')?.addEventListener('click', () => {
      try { localStorage.setItem(CHIAVE, String(Date.now())); } catch {}
      nascondi();
    });
    addEventListener('appinstalled', nascondi);
  }
</script>
