---
// Area coristi, pagina Presenze nel sito vero: chi è atteso alla prossima prova (o concerto), per
// sezione, con i nomi degli assenti (senza le note, che leggono solo il Maestro e i redattori), e le
// ultime prove. Presenti = coristi attivi quel giorno (scheda Coristi) meno le assenze.
import Icona from '../componenti/Icona.astro';
import { link } from '../motore/url';
import type { Veste } from '../motore/aspetto';
import { parti } from '../motore/concerti';
import { assenze, configurati, coristaDi, coristi, eventi, inizioStagione, nomeBreve, oggi, piuGiorni, riepilogo, type Riepilogo } from './dati';

interface Props { veste: Veste }
const { veste } = Astro.props;

let errore: string | undefined;
let prossimo: Riepilogo | undefined;
let storico: (Riepilogo & { tu?: boolean })[] = [];
let io: Awaited<ReturnType<typeof coristaDi>>;
if (!configurati()) errore = 'Le presenze non sono ancora collegate: mancano le impostazioni sul server.';
else {
  try {
    const [elenco, tutte, futuri, passati] = await Promise.all([
      coristi(), assenze(), eventi(oggi(), piuGiorni(oggi(), 60)), eventi(inizioStagione(oggi()), piuGiorni(oggi(), -1)),
    ]);
    io = await coristaDi(Astro.locals.corista!.email);
    const e = futuri.find((x) => x.inizioMs > Date.now() - 3 * 3600 * 1000);
    if (e) prossimo = riepilogo(e, elenco, tutte);
    storico = passati.filter((x) => x.tipo === 'prova').slice(-8).reverse().map((x) => {
      const r = riepilogo(x, elenco, tutte);
      return { ...r, tu: io && r.attesi.some((c) => c.email === io!.email) ? !r.assenti.some((c) => c.email === io!.email) : undefined };
    });
  } catch (e) {
    errore = `Google non ha risposto: ${(e as Error).message}. Riprova tra poco.`;
  }
}
const percento = (parte: number, totale: number) => `${totale ? Math.round((parte / totale) * 1000) / 10 : 0}%`;
const quando = (data: string) => { const d = parti({ data }); return `${d.giornoSettimana.toLowerCase()} ${Number(d.giorno)} ${d.mese.toLowerCase()}`; };
const breve = (data: string) => { const d = parti({ data }); return `${d.giornoSettimana.slice(0, 3)} ${Number(d.giorno)} ${d.meseBreve.toLowerCase()}`; };
const maiuscola = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const sezioniStorico = [...new Set(storico.flatMap((r) => r.perSezione.map((s) => s.sezione)))];
const mie = storico.filter((r) => r.tu).length;
const contate = storico.filter((r) => r.tu !== undefined).length;
---

<div class="area-intesta">
  <div class="w">
    <div>
      <span class="eti" style="margin-bottom:12px">Presenze</span>
      <h1>{prossimo ? `Chi c'è ${parti({ data: prossimo.evento.data }).giornoSettimana.toLowerCase()}` : 'Presenze'}</h1>
      <p>Chi non ha segnalato un'assenza è atteso. Le assenze si segnalano dalla pagina <a href={link(veste, '/area/prove')} style="text-decoration:underline">Prove e concerti</a>.</p>
    </div>
  </div>
</div>

<div class="area-main">
  <div class="w">
    {errore && <p class="carta" style="padding:20px">{errore}</p>}
    <div class="cruscotto">
      {prossimo && (
        <article class="carta c-7 su">
          <div class="ct"><h2>{maiuscola(quando(prossimo.evento.data))}{prossimo.evento.inizio && ` · ${prossimo.evento.inizio}`} · {prossimo.evento.titolo}</h2><span class="tag">{prossimo.evento.tipo === 'concerto' ? 'Prossimo concerto' : 'Prossima prova'}</span></div>
          <div class="cc" style="display:flex;gap:28px;flex-wrap:wrap;align-items:end;border-bottom:1px solid var(--linea)">
            <div><b style="font-family:var(--f-titoli);font-weight:var(--peso-titoli);font-size:56px;line-height:.8;letter-spacing:-0.012em;color:var(--primario)">{prossimo.attesi.length - prossimo.assenti.length}</b><span class="tenue" style="font-size:18px;font-weight:600;margin-left:10px">attesi su {prossimo.attesi.length}</span></div>
            <div class="legenda"><span><i style="background:var(--primario)"></i>Attesi</span><span><i style="background:var(--rosso)"></i>Assenti</span></div>
          </div>
          <div class="sezioni-presenze">
            {prossimo.perSezione.map((s) => {
              const tua = s.sezione === io?.sezione;
              return <div class:list={['sp', { tua }]}><span class="nome">{s.sezione}{tua && <span class="tag" style="margin-left:6px;vertical-align:middle">La tua sezione</span>}</span><span class="cifre"><b>{s.presenti}</b> / {s.totale} · {s.assenti === 1 ? '1 assente' : `${s.assenti} assenti`}</span><span class="barra"><i style={`width:${percento(s.presenti, s.totale)};background:var(--primario)`}></i><i style={`width:${percento(s.assenti, s.totale)};background:var(--rosso)`}></i></span></div>;
            })}
          </div>
        </article>
      )}

      {prossimo && (
        <article class="carta c-5 su">
          <div class="ct"><h2>Assenti segnalati</h2><span class="tag rosso">{prossimo.assenti.length}</span></div>
          {prossimo.assenti.length ? (
            <ul class="assenti">
              {prossimo.assenti.map((c) => <li><span class="av">{c.nome.charAt(0)}{c.cognome.charAt(0)}</span><b>{nomeBreve(c)}<small>{c.sezione}</small></b></li>)}
            </ul>
          ) : <div class="cc tenue">Nessuna assenza segnalata.</div>}
        </article>
      )}

      {storico.length > 0 && (
        <article class="carta c-12">
          <div class="ct"><h2>Ultime prove</h2><span class="tenue" style="font-size:14px">Presenti per sezione</span></div>
          <div class="tabella-wrap">
            <table class="tabella">
              <thead><tr><th>Prova</th>{sezioniStorico.map((s) => <th class="num">{s}</th>)}<th class="num">Tu</th><th class="num">Totale</th></tr></thead>
              <tbody>
                {storico.map((r) => {
                  const tot = r.attesi.length - r.assenti.length;
                  return (
                    <tr><td>{breve(r.evento.data)}</td>{sezioniStorico.map((s) => { const x = r.perSezione.find((p) => p.sezione === s); return <td class="num">{x ? `${x.presenti}/${x.totale}` : '—'}</td>; })}<td class="num">{r.tu === undefined ? '—' : r.tu ? <Icona nome="spunta" /> : <span class="tenue">assente</span>}</td><td class="num"><span class="cella-barra"><b>{tot}</b><span class="barra"><i style={`width:${percento(tot, r.attesi.length)}`}></i></span></span></td></tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {contate > 0 && <div class="cc tenue" style="border-top:1px solid var(--linea);font-size:14px">Tu: presente a {mie} prove su {contate}.</div>}
        </article>
      )}
    </div>
  </div>
</div>
