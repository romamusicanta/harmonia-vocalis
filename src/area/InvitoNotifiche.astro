---
// Area coristi e area del Maestro: invito ad attivare le notifiche push del coro (src/area/notifiche.ts),
// sotto la barra delle sezioni nella prima pagina, come InvitoApp. Nascosto finché lo script non sa
// che serve: compare solo dove il browser le permette (su iPhone e iPad solo nell'app installata:
// fuori dall'app c'è già l'invito a installarla) e se il telefono non è ancora iscritto, né per chi
// l'ha chiuso (localStorage hv-invito-notifiche, per 60 giorni) o le ha bloccate. Un telefono già
// iscritto ripete l'iscrizione al sito ogni settimana, così il foglio resta aggiornato.
import Icona from '../componenti/Icona.astro';
import { chiavePubblica, configurate } from './notifiche';

interface Props { area?: 'coristi' | 'maestro' }
const { area = 'coristi' } = Astro.props;
---

{configurate() && (
  <div class="invito-notifiche" hidden data-chiave={chiavePubblica()} data-area={area}>
    <div class="w">
      <span class="campana"><Icona nome="campanella" classe="" /></span>
      <div class="testo">
        <b>Ricevi le notifiche del coro</b>
        <span class="breve">Prove cambiate, avvisi, convocazioni e registrazioni nuove arrivano sul telefono.</span>
        <span class="fatto">Fatto: le notifiche arriveranno su questo telefono.</span>
        <span class="no">Il telefono non le ha permesse. Si possono riattivare dalle impostazioni delle notifiche.</span>
      </div>
      <button type="button" class="btn g piccolo attiva">Attiva</button>
      <button type="button" class="chiudi-invito" aria-label="Non ora" title="Non ora"><Icona nome="chiudi" classe="" /></button>
    </div>
  </div>
)}

<style>
  /* Come InvitoApp, che sta subito sopra quando compaiono tutti e due */
  .invito-notifiche { background: var(--bianco); border-bottom: 1px solid var(--linea); }
  .invito-notifiche .w { display: flex; align-items: center; gap: 14px; padding-top: 14px; padding-bottom: 14px; }
  .invito-notifiche .testo { flex: 1; min-width: 0; font-size: 14px; line-height: 1.45; color: var(--tenue); }
  .invito-notifiche .testo > b { display: block; color: var(--primario); font-size: 15px; }
  .chiudi-invito { width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 0; color: var(--tenue); border-radius: var(--raggio); flex-shrink: 0; cursor: pointer; }
  .chiudi-invito:hover { background: var(--fondo); color: var(--primario); }
  .campana { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; border-radius: 10px; background: var(--primario); color: var(--accento); }
  .campana :global(svg) { width: 24px; height: 24px; }
  .invito-notifiche .fatto, .invito-notifiche .no { display: none; }
  .invito-notifiche.ok .fatto, .invito-notifiche.negate .no { display: inline; }
  .invito-notifiche:is(.ok, .negate) :is(.breve, .attiva) { display: none; }
  .invito-notifiche .attiva { flex-shrink: 0; }
</style>

<script>
  const invito = document.querySelector<HTMLElement>('.invito-notifiche');
  const CHIAVE = 'hv-invito-notifiche';
  const ISCRITTO = 'hv-notifiche-iscritto';
  const leggi = (k: string) => { try { return Number(localStorage.getItem(k) ?? 0); } catch { return 0; } };
  const scrivi = (k: string) => { try { localStorage.setItem(k, String(Date.now())); } catch {} };
  const supportate = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

  // La chiave VAPID, da base64url ai byte che vuole il browser
  const byte = (b64: string) => Uint8Array.from(atob((b64 + '='.repeat((4 - (b64.length % 4)) % 4)).replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
  const salva = (iscrizione: PushSubscription) => fetch('/area/notifiche', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ azione: 'iscrivi', iscrizione: iscrizione.toJSON(), area: invito?.dataset.area }),
  }).then((r) => { if (!r.ok) throw new Error(String(r.status)); scrivi(ISCRITTO); });

  if (invito && supportate && Notification.permission !== 'denied') {
    navigator.serviceWorker.ready.then(async (reg) => {
      const gia = await reg.pushManager.getSubscription();
      if (gia) {
        if (Date.now() - leggi(ISCRITTO) > 7 * 86400 * 1000) salva(gia).catch(() => {});
        return;
      }
      if (Date.now() - leggi(CHIAVE) < 60 * 86400 * 1000) return;
      invito.hidden = false;
      invito.querySelector('.attiva')?.addEventListener('click', async () => {
        // Su iPhone il permesso va chiesto subito, dentro il tocco
        const permesso = await Notification.requestPermission();
        if (permesso !== 'granted') { invito.classList.add('negate'); return; }
        try {
          const iscrizione = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: byte(invito.dataset.chiave!) });
          await salva(iscrizione);
          invito.classList.add('ok');
          setTimeout(() => { invito.hidden = true; }, 5000);
        } catch {
          invito.querySelector('.breve')!.textContent = 'Non è stato possibile attivarle: riprova tra poco.';
        }
      });
    });
    invito.querySelector('.chiudi-invito')?.addEventListener('click', () => { scrivi(CHIAVE); invito.hidden = true; });
  }
</script>
