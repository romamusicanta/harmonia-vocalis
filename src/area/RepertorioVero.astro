---
// Area coristi, pagina Repertorio nel sito vero: i pezzi della scheda Repertorio
// (src/area/repertorio.ts), prima quelli in studio. Per ognuno tracce per sezione (in evidenza
// quella del corista), esecuzione di riferimento, spartito, brani separati e note del Maestro.
// Ogni pezzo è una riga che si apre (con la ricerca in testa se sono molti); l'ancora #<id>, usata
// da Calendario, Concerti e Registrazioni, apre quel pezzo. I file del Drive del
// coro si aprono dal sito (src/area/file.ts); per i link che restano su Drive, l'aiuto per entrarci.
import Icona from '../componenti/Icona.astro';
import { coristaDi } from './dati';
import { nomeCompleto, repertorio, type Pezzo } from './repertorio';
import { comeHtml } from './testo';
import Errore from './Errore.astro';
import AiutoDrive from './AiutoDrive.astro';
import { linkDelSito, suDrive } from './file';

let errore: unknown;
let elenco: Pezzo[] = [];
let sezione: string | undefined;
try {
  [elenco, sezione] = await Promise.all([repertorio(), coristaDi(Astro.locals.corista!.email).then((c) => c?.sezione)]);
} catch (e) {
  errore = e;
}
// La propria sezione prima, poi le altre nell'ordine del coro
const tracce = (p: Pezzo) => [...p.tracce.filter((t) => t.sezione === sezione), ...p.tracce.filter((t) => t.sezione !== sezione)];
// I file del Drive del coro passano dal sito
elenco = elenco.map((p) => ({ ...p, spartito: linkDelSito(p.spartito), brani: p.brani.map((b) => ({ ...b, link: linkDelSito(b.link) })), tracce: p.tracce.map((t) => ({ ...t, link: linkDelSito(t.link) })) }));
const semplice = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const suGoogle = elenco.some((p) => [p.spartito, ...p.brani.map((b) => b.link), ...p.tracce.map((t) => t.link)].some(suDrive));
---

<div class="area-intesta">
  <div class="w">
    <div>
      <span class="eti" style="margin-bottom:12px">Repertorio</span>
      <h1>Repertorio</h1>
      <p>Spartiti, tracce per lo studio di ogni sezione, esecuzioni di riferimento e note del Maestro.</p>
    </div>
  </div>
</div>

<div class="area-main">
  <div class="w">
    {errore && <Errore e={errore} />}
    {suGoogle && <AiutoDrive />}
    {elenco.length > 6 && <input class="filtra-pezzi" type="search" placeholder="Cerca nel repertorio per autore o titolo…" aria-label="Cerca nel repertorio" />}
    {!errore && elenco.length === 0 && <p class="carta" style="padding:20px">Il repertorio non è ancora stato inserito.</p>}
    {elenco.map((p) => (
      <details class="opera-studio" id={p.id} data-cerca={semplice(`${p.autore} ${p.titolo}`)}>
        <summary class="intest">
          <div>
            {p.autore && <span class="aut">{p.autore}</span>}
            <h2 style="margin-top:6px">{p.titolo}</h2>
            <span class="tenue indicatori">{[p.tracce.some((t) => t.sezione === sezione) && 'la tua traccia', p.spartito && 'spartito', p.brani.length && `${p.brani.length} ${p.brani.length === 1 ? 'brano' : 'brani'}`, p.note && 'note del Maestro'].filter(Boolean).join(' · ') || 'materiali in arrivo'}</span>
          </div>
          <span class:list={['tag', { grigio: p.stato !== 'In studio' }]}>{p.stato}</span>
        </summary>
        <div class="corpo-o">
          <div class="colonna">
            <h3>Tracce per lo studio</h3>
            {p.tracce.length ? (
              <div class="basi">
                {tracce(p).map((t) => (
                  <div class:list={['base', { tua: t.sezione === sezione }]}>
                    <div><b>{t.sezione}{t.sezione === sezione && <span class="tag" style="margin-left:6px">La tua sezione</span>}</b></div>
                    {t.link.startsWith('/area/file/')
                      ? <audio controls preload="none" src={t.link} aria-label={`Traccia: ${t.sezione}`}></audio>
                      : <div class="az-base"><a href={t.link} target="_blank" rel="noopener" aria-label={`Apri le tracce: ${t.sezione}`}><Icona nome="play" /></a></div>}
                  </div>
                ))}
              </div>
            ) : <p class="tenue">Tracce non ancora disponibili.</p>}
            {p.esecuzione && (
              <>
                <h3 style="margin-top:28px">Esecuzione di riferimento</h3>
                <a class="btn o piccolo" href={p.esecuzione} target="_blank" rel="noopener"><Icona nome="cuffie" />Ascolta</a>
              </>
            )}
          </div>
          <div class="colonna">
            <h3>Spartito</h3>
            {p.spartito
              ? <a class="btn piccolo" href={p.spartito} target="_blank" rel="noopener"><Icona nome="documento" />Apri lo spartito</a>
              : <p class="tenue">Spartito non ancora disponibile.</p>}
            {p.brani.length > 0 && (
              <>
                <h3 style="margin-top:28px">Brani cantati separatamente</h3>
                <div class="scorciatoie" style="border:1px solid var(--linea)">
                  {p.brani.map((b) => <a href={b.link} target="_blank" rel="noopener"><span class="icona-q"><Icona nome="documento" classe="" /></span><span><b>{b.nome}</b></span><Icona nome="esterno" /></a>)}
                </div>
              </>
            )}
            {p.note && (
              <div class="nota-maestro">
                <span class="eti">Note del Maestro</span>
                <div set:html={comeHtml(p.note)} />
              </div>
            )}
          </div>
        </div>
      </details>
    ))}
    {elenco.length > 0 && <p class="tenue" style="margin-top:24px;font-size:14px">{elenco.length} {elenco.length === 1 ? 'pezzo' : 'pezzi'}: {elenco.map(nomeCompleto).join(' · ')}</p>}
  </div>
</div>

<script>
  // Si apre il pezzo indicato nell'indirizzo (#<id>), anche quando cambia; ricerca per autore o titolo
  const apri = () => {
    const el = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
  };
  apri();
  addEventListener('hashchange', apri);
  const filtro = document.querySelector<HTMLInputElement>('.filtra-pezzi');
  filtro?.addEventListener('input', () => {
    const parole = filtro.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().split(/\s+/).filter(Boolean);
    document.querySelectorAll<HTMLElement>('details.opera-studio').forEach((d) => { d.hidden = !parole.every((p) => d.dataset.cerca!.includes(p)); });
  });
</script>

<style>
  /* Una riga per pezzo, che si apre */
  .opera-studio + .opera-studio { margin-top: 10px; }
  .opera-studio > summary { cursor: pointer; list-style: none; padding: 18px 22px; border-bottom: 0; scroll-margin-top: 150px; }
  .opera-studio > summary::-webkit-details-marker { display: none; }
  .opera-studio[open] > summary { border-bottom: 1px solid var(--linea); }
  .opera-studio > summary h2 { font-size: clamp(22px, 2.4vw, 28px); }
  .opera-studio > summary h2::after { content: ' ▸'; color: var(--tenue); font-size: .7em; }
  .opera-studio[open] > summary h2::after { content: ' ▾'; }
  .indicatori { display: block; font-size: 14px; margin-top: 4px; }
  .filtra-pezzi { width: 100%; font: inherit; padding: 10px 12px; border: 2px solid var(--bordo-campo, var(--linea)); border-radius: var(--raggio); background: var(--bianco); margin-bottom: 14px; }
  /* Tracce caricate come file: lettore audio nella riga della sezione */
  .base:has(audio) { grid-template-columns: minmax(0, 1fr); }
  .base audio { width: 100%; height: 40px; }
</style>
