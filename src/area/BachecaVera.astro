---
// Area coristi, Bacheca nel sito vero: tutto quello che serve per la settimana, dai dati veri.
// Prossima prova (pezzi, passi, "Non ci sarò"), prossimo concerto (convocazione e prova
// generale), avvisi (src/area/bacheca.ts), ultima registrazione (src/area/registrazioni.ts),
// attesi alla prossima prova, le proprie quote della stagione (src/area/tesoreria.ts: solo le sue, dal
// 5/10/2026). Spartiti e tracce stanno nella pagina Repertorio. Ogni parte che non risponde resta vuota senza bloccare le altre.
import ConLink from '../componenti/ConLink.astro';
import Icona from '../componenti/Icona.astro';
import { coro } from '../motore/coro';
import ContoQuote from './ContoQuote.astro';
import { configurato as fotoConfigurate, ultimeFoto } from './fotoConcerti';
import { parti } from '../motore/concerti';
import { aperto, assenze, coristaDi, coristi, eventi, luogoBreveDi, luogoDi, nomeEvento, oggi, piuGiorni, riepilogo, type Evento, type Riepilogo, etichettaStato, linkCalendarioProve } from './dati';
import { avvisi, firmaDi, inBacheca, nuovo, ruoliDi } from './bacheca';
import { linkDelSito } from './file';
import { convocazioni, type Convocazione } from './convocazioni';
import { repertorio, type Pezzo } from './repertorio';
import LinkPezzo from './LinkPezzo.astro';
import { registrazioni, type GiornoRegistrato } from './registrazioni';
import { SEPARATORE_PEZZI } from '../admin/prove';
import { comeHtml } from './testo';
import { configurata as tesoreriaConfigurata, euro, indice, quotaBase, riporti, riportoDi, meseEsteso, meseBreve, nomeMese, questoMese, quote, stagioneCorrente, statoDi, attiviNelMese, tutteLeQuote, type Quota } from './tesoreria';

const email = Astro.locals.corista!.email;
const nulla = <T,>(p: Promise<T>, vuoto: T) => p.catch(() => vuoto);
// Tutto in parallelo, quote e foto comprese: la pagina aspetta solo la lettura più lenta
const [io, prossimi, elencoAvvisi, ruoli, pezzi, regs, conv, tutti, tutte, foto, elencoQuote] = await Promise.all([
  nulla(coristaDi(email), undefined),
  nulla(eventi(piuGiorni(oggi(), -14), piuGiorni(oggi(), 120)), [] as Evento[]),
  nulla(avvisi(), []),
  nulla(ruoliDi(email), []),
  nulla(repertorio(), [] as Pezzo[]),
  nulla(registrazioni(), [] as GiornoRegistrato[]),
  nulla(convocazioni(), new Map<string, Convocazione>()),
  nulla(coristi(), []),
  nulla(assenze(), []),
  // Le ultime foto dei concerti (se Drive non risponde il riquadro non compare)
  fotoConfigurate() ? nulla(ultimeFoto(6), []) : [],
  // Le quote: solo se la tesoreria è collegata; se il foglio non risponde il riquadro non compare
  tesoreriaConfigurata() ? nulla(quote(), undefined as Quota[] | undefined) : undefined,
]);
const leQuote = io ? elencoQuote : undefined;
const adesso = Date.now() - 3 * 3600 * 1000;
const prova = prossimi.find((e) => e.tipo === 'prova' && e.inizioMs > adesso);
const concerto = prossimi.find((e) => e.tipo === 'concerto' && e.inizioMs > adesso);
const cv = concerto && conv.get(concerto.id);
const rProva: Riepilogo | undefined = prova && tutti.length ? riepilogo(prova, tutti, tutte) : undefined;
const mie = new Map(tutte.filter((a) => a.email === io?.email).map((a) => [a.idEvento, a.nota]));
const bacheca = inBacheca(elencoAvvisi);
const sezione = io?.sezione;
const ultima = regs.find((g) => g.tracce.length || g.link);
// Il conto per i bonifici delle quote
const t = coro.coristi?.tesoreria;
const conto = t?.iban ? { iban: t.iban, intestatario: t.intestatario ?? coro.associazione ?? coro.nome } : undefined;
// Le mie quote della stagione: un pallino per mese; dovute quelle fino al mese in corso
const mieQuote = leQuote && io ? (() => {
  const idx = indice(leQuote);
  // Il riporto della stagione prima, se c'è qualcosa da versare (o è stato versato)
  const r = riportoDi(riporti(leQuote, tutti), io.email, stagioneCorrente());
  const riporto = r && (r.importo > 0 || r.versato) ? r : undefined;
  // Anche i mesi con la quota base zero, in cui risulta esonerato
  const mesi = tutteLeQuote(stagioneCorrente()).filter((m) => attiviNelMese([io], m).length);
  const stati = mesi.map((m) => ({ mese: m, stato: statoDi(idx, io.email, m), dovuta: m <= questoMese(), nota: idx.get(`${io.email}|${m}`)?.nota }));
  const daVersare = stati.filter((x) => x.dovuta && x.stato === 'da-pagare');
  const riportoDaVersare = riporto && !riporto.versato ? riporto.importo : 0;
  const voci = [...(riportoDaVersare ? [`riporto della stagione prima (${euro(riportoDaVersare)})`] : []), ...daVersare.map((x) => nomeMese(x.mese))];
  return { stati, daVersare, riporto, voci, importo: daVersare.reduce((t, x) => t + quotaBase(idx, x.mese), 0) + riportoDaVersare };
})() : undefined;

// "Scrivi un avviso": il Maestro e il tesoriere li scrivono dalla loro area, gli altri ruoli dall'Amministrazione
const scriviAvvisi = ruoli.some((r) => r.id === 'maestro') ? '/maestro/avvisi' : ruoli.some((r) => r.id === 'tesoriere') && !ruoli.some((r) => r.id === 'redattori' || r.id === 'amministratori' || r.id === 'presidente') ? '/tesoriere/avvisi' : '/admin/avvisi';
const riga = (e: Evento, k: string) => e.righe.find(([x]) => x === k)?.[1];
const quando = (iso: string) => { const d = parti({ data: iso }); return `${d.giornoSettimana.toLowerCase()} ${Number(d.giorno)} ${d.mese.toLowerCase()}`; };
const traGiorni = (iso: string) => { const n = Math.round((Date.parse(`${iso}T12:00:00Z`) - Date.parse(`${oggi()}T12:00:00Z`)) / 86_400_000); return n === 0 ? 'Oggi' : n === 1 ? 'Domani' : `Tra ${n} giorni`; };
const maiuscola = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Prima l'appuntamento più vicino: se il concerto viene prima della prova, la sua scheda passa in
// testa e diventa grande; entro una settimana porta anche "Tra N giorni"
const concertoPrima = Boolean(concerto && (!prova || concerto.inizioMs < prova.inizioMs));
const intro = (concertoPrima
  ? [concerto && `${maiuscola(quando(concerto.data))} il concerto`, prova && `${quando(prova.data)} la prossima prova`]
  : [prova && `${maiuscola(quando(prova.data))} la prossima prova`, concerto && `${quando(concerto.data)} il concerto`]).filter(Boolean).join(', ');
const giorniAl = (iso: string) => Math.round((Date.parse(`${iso}T12:00:00Z`) - Date.parse(`${oggi()}T12:00:00Z`)) / 86_400_000);
const iscrizione = linkCalendarioProve(Astro.locals.corista!.email);
const pg = cv?.generale ? prossimi.find((x) => x.id === cv.generale) : undefined;
const generale = pg ? `${pg.data !== concerto!.data ? `${quando(pg.data)}, ` : ''}${pg.inizio ? `ore ${pg.inizio}` : ''}` : undefined;
---

<div class="area-intesta">
  <div class="w">
    <div>
      <span class="eti" style="margin-bottom:12px">Bacheca{sezione && ` · ${sezione}`}</span>
      <h1>Ciao {Astro.locals.corista!.nome}<span style="color:var(--accento)">.</span></h1>
      <p>{intro ? `${intro}. ` : ''}Qui trovi tutto quello che ti serve per la settimana.</p>
    </div>
    {iscrizione && <a class="btn o" href={iscrizione} target="_blank" rel="noopener"><Icona nome="calendario-piu" />Prove nel tuo Google Calendar</a>}
  </div>
</div>

<div class="area-main">
  <div class="w">
    <div class="cruscotto">

      {prova ? (() => {
        const d = parti({ data: prova.data });
        const rep = riga(prova, 'Repertorio')?.split(SEPARATORE_PEZZI).filter(Boolean) ?? [];
        const brani = riga(prova, 'Brani');
        const assente = mie.has(prova.id);
        return (
          <article class:list={['carta blu', concertoPrima ? 'c-5' : 'c-7']} style={concertoPrima ? 'order:1' : undefined}>
            <div class="ct"><h2>Prossima prova{prova.titolo !== 'Prova' && ` · ${prova.titolo.toLowerCase()}`}</h2><span class="tag">{traGiorni(prova.data)}</span></div>
            <div class="cc">
              <div class="prova-evidenza">
                <div class="gg">{d.giorno}<small>{d.giornoSettimana} · {d.mese}</small></div>
                <div>
                  <ul class="fatti" style="color:var(--primario-chiaro);margin-top:0">
                    <li><Icona nome="orologio" />{prova.inizio}{prova.fine && ` – ${prova.fine}`}</li>
                    {luogoDi(prova) && <li><Icona nome="luogo" />{luogoDi(prova)}</li>}
                    {riga(prova, 'Sezioni') && <li><Icona nome="persone" />{riga(prova, 'Sezioni')}</li>}
                  </ul>
                  {(rep.length > 0 || brani) && (
                    <>
                      <span class="eti gialla" style="margin-top:18px">Da preparare</span>
                      <ul class="brani">
                        {rep.map((t) => <li><LinkPezzo pezzi={pezzi} nome={t} stile="color:inherit;text-decoration:underline" /></li>)}
                        {brani && <li>{brani}</li>}
                      </ul>
                    </>
                  )}
                  {riga(prova, 'Portare') && <p style="margin-top:12px;color:var(--primario-chiaro);font-size:15px"><b style="color:#fff">Portare:</b> <ConLink testo={riga(prova, 'Portare')} /></p>}
                  {riga(prova, 'Note') && <p style="margin-top:6px;color:var(--primario-chiaro);font-size:15px"><ConLink testo={riga(prova, 'Note')} /></p>}
                </div>
              </div>
              {io && aperto(prova) && (
                <div class:list={['assenza', { segnalata: assente }]} data-evento={prova.id} data-etichetta={`${quando(prova.data)} · ${prova.titolo}`}>
                  <div class="da-fare"><button class="btn btn-assenza segna" type="button"><Icona nome="chiudi" />Non ci sarò</button></div>
                  <div class="fatto">
                    <div class="stato-assenza"><Icona nome="spunta" />Hai segnalato l'assenza · <button class="togli" type="button">Ritira</button></div>
                    <div class="nota-assenza"><label for={`n-${prova.id}`}>Nota per il Maestro e i redattori (facoltativa)</label><input id={`n-${prova.id}`} class="nota" maxlength="300" value={mie.get(prova.id) ?? ''} placeholder="Es. arrivo alle 21:30" /></div>
                  </div>
                </div>
              )}
            </div>
          </article>
        );
      })() : (
        <article class:list={['carta', concertoPrima ? 'c-5' : 'c-7']} style={concertoPrima ? 'order:1' : undefined}><div class="ct"><h2>Prossima prova</h2></div><div class="cc tenue">Nessuna prova in calendario nei prossimi mesi.</div></article>
      )}

      {concerto ? (() => {
        const d = parti({ data: concerto.data });
        const assente = mie.has(concerto.id);
        return (
          <article class:list={['carta', concertoPrima ? 'c-7 concerto-in-testa' : 'c-5']}>
            <div class="ct"><h2>Prossimo concerto</h2>{concertoPrima && giorniAl(concerto.data) <= 7 && <span class="tag">{traGiorni(concerto.data)}</span>}<a class="link-freccia" href={`/area/concerti#c-${concerto.id}`}>Convocazione <Icona nome="freccia" /></a></div>
            <div class="cc">
              <div style="display:flex;gap:20px;align-items:flex-start">
                <span class="data-grande">{d.giorno}<small>{d.meseBreve} · {d.giornoSettimana}</small></span>
                <div style="min-width:0">{concerto.rassegna && <span class="aut">{concerto.rassegna}</span>}<h3 style="font-size:22px">{nomeEvento(concerto)}</h3>{etichettaStato(concerto) && <span class="tag grigio" style="margin:4px 0">{etichettaStato(concerto)}</span>}<span class="tenue" style="font-size:15px">{[concerto.inizio && `ore ${concerto.inizio}`, luogoBreveDi(concerto)].filter(Boolean).join(' · ')}</span></div>
              </div>
              {cv && (cv.convocazione || generale) ? (
                <ul class="orari" style="margin-top:20px">
                  {cv.convocazione && <li><b>{cv.convocazione}</b><span>Convocazione{cv.ritrovo && ` · ${cv.ritrovo}`}</span></li>}
                  {generale && <li><b><Icona nome="nota" /></b><span>Prova generale: {generale}</span></li>}
                  {cv.abito && <li><b><Icona nome="gruccia" /></b><span>{cv.abito}</span></li>}
                </ul>
              ) : <p class="tenue" style="margin-top:16px;font-size:15px">Convocazione e prova generale in arrivo.</p>}
              {io && aperto(concerto) ? (
                <div class:list={['assenza', { segnalata: assente }]} data-evento={concerto.id} data-etichetta={`${quando(concerto.data)} · concerto ${nomeEvento(concerto)}`} style="margin-top:20px">
                  <div class="da-fare"><button class="btn btn-assenza piccolo segna" type="button"><Icona nome="chiudi" />Non ci sarò</button></div>
                  <div class="fatto">
                    <div class="stato-assenza"><Icona nome="spunta" />Hai segnalato l'assenza · <button class="togli" type="button">Ritira</button></div>
                    <div class="nota-assenza"><label for={`n-${concerto.id}`}>Nota (facoltativa)</label><input id={`n-${concerto.id}`} class="nota" maxlength="300" value={mie.get(concerto.id) ?? ''} placeholder="Es. sono fuori Roma" /></div>
                  </div>
                </div>
              ) : assente ? <div class="stato-assenza" style="margin-top:20px"><Icona nome="spunta" />Assenza segnalata</div> : null}
            </div>
          </article>
        );
      })() : null}

      <article class="carta c-7 su">
        <div class="ct"><h2>Avvisi</h2>{bacheca.filter(nuovo).length > 0 && <span class="tag grigio">{bacheca.filter(nuovo).length === 1 ? '1 nuovo' : `${bacheca.filter(nuovo).length} nuovi`}</span>}{ruoli.length > 0 && <a class="link-freccia" href={scriviAvvisi}>Scrivi un avviso <Icona nome="freccia" /></a>}</div>
        {bacheca.length === 0 && <div class="cc tenue">Nessun avviso in bacheca.</div>}
        <ul class="avvisi">
          {bacheca.map((a) => {
            const d = parti({ data: a.pubblicato || oggi() });
            return (
              <li class:list={['avviso', { nuovo: nuovo(a) }]}>
                <span class="chi">{nuovo(a) && <span class="tag">Nuovo</span>}<b>{firmaDi(a)}</b> · {Number(d.giorno)} {d.mese.toLowerCase()} {d.anno}</span>
                <h3>{a.titolo}</h3>
                <div class="testo-avviso" set:html={comeHtml(a.testo)} />
              </li>
            );
          })}
        </ul>
      </article>

      <div class="c-5" style="display:grid;gap:24px;align-content:start">
        {mieQuote && (mieQuote.stati.length > 0 || mieQuote.riporto) && (
          <article class="carta" id="quote">
            <div class="ct"><h2>Le tue quote</h2>{mieQuote.voci.length ? <span class="tag">{euro(mieQuote.importo)} da versare</span> : <span class="tag grigio">In regola</span>}</div>
            <div class="cc" style="display:grid;gap:12px">
              <ol class="mesi-quota" aria-label="Quote della stagione">
                {mieQuote.riporto && (
                  <li class:list={['riporto', mieQuote.riporto.versato ? 'pagata' : 'da-pagare', 'dovuta']} title={`Riporto della stagione prima, ${euro(mieQuote.riporto.importo)}: ${mieQuote.riporto.versato ? 'versato' : 'da versare'}`}>
                    <span class="pallino">{mieQuote.riporto.versato ? '✓' : ''}</span>rip.
                  </li>
                )}
                {mieQuote.stati.map((x) => (
                  <li class:list={[x.stato, { dovuta: x.dovuta }]} title={`${meseEsteso(x.mese)}: ${x.stato === 'pagata' ? 'pagata' : x.stato === 'esonerato' ? `esonerato${x.nota ? ` (${x.nota})` : ''}` : x.dovuta ? 'da versare' : 'non ancora dovuta'}`}>
                    <span class="pallino">{x.stato === 'pagata' ? '✓' : x.stato === 'esonerato' ? 'E' : ''}</span>{meseBreve(x.mese)}
                  </li>
                ))}
              </ol>
              <span class="tenue" style="font-size:14px">{mieQuote.voci.length
                ? `Da versare: ${mieQuote.voci.join(', ')}. Puoi ${mieQuote.voci.length === 1 ? 'darla' : 'darle'} al tesoriere alla prossima prova${conto ? ' o fare un bonifico' : ''}.`
                : `Hai versato tutte le quote dovute fino a ${nomeMese(questoMese())}. Grazie!`}</span>
            </div>
            {conto && <ContoQuote {...conto} />}
          </article>
        )}
        {!(mieQuote && (mieQuote.stati.length > 0 || mieQuote.riporto)) && conto && (
          <article class="carta" id="quote">
            <div class="ct"><h2>Quote del coro</h2></div>
            <ContoQuote {...conto} />
          </article>
        )}
        {fotoConfigurate() && (
          <article class="carta">
            <div class="ct"><h2>Ultime foto</h2><a class="link-freccia" href="/area/foto">Tutte <Icona nome="freccia" /></a></div>
            <div class="cc" style="display:grid;gap:12px">
              {foto.length > 0 ? (
                <ul class="ultime-foto">
                  {foto.map((f) => <li><a href={`/area/foto#c-${f.evento ?? f.data}`} title={`${f.titolo} · ${f.chi}`}><img src={`/area/foto/miniatura/${f.id}`} alt={`${f.titolo}, foto di ${f.chi}`} loading="lazy" /></a></li>)}
                </ul>
              ) : <span class="tenue" style="font-size:14px">Ancora nessuna foto dei concerti.</span>}
              <a class="btn o piccolo" style="justify-self:start" href="/area/foto#carica"><Icona nome="fotocamera" />Carica le tue foto</a>
            </div>
          </article>
        )}
        {ultima && (
          <article class="carta">
            <div class="ct"><h2>Ultima registrazione</h2><a class="link-freccia" href="/area/registrazioni">Tutte <Icona nome="freccia" /></a></div>
            <div class="cc" style="display:grid;gap:10px">
              <span class="tenue" style="font-size:14px">{maiuscola(quando(ultima.data))} · {ultima.titolo}{ultima.tracce[0] && ` · caricata da ${ultima.tracce[0].chi}`}</span>
              <a class="btn o piccolo" style="justify-self:start" href={linkDelSito(ultima.tracce[0]?.link ?? ultima.link)} target="_blank" rel="noopener"><Icona nome="play" />{ultima.tracce[0]?.titolo ?? 'Registrazione della prova'}</a>
            </div>
          </article>
        )}

        {rProva && (
          <a class="carta" href="/area/prove" style="display:block">
            <div class="cc" style="display:flex;justify-content:space-between;align-items:center;gap:16px">
              <div><span class="eti" style="margin-bottom:6px">Attesi {quando(prova!.data)}</span><b style="font-family:var(--f-titoli);font-weight:var(--peso-titoli);font-size:40px;color:var(--primario);letter-spacing:-0.012em;line-height:1">{rProva.attesi.length - rProva.assenti.length}<span class="tenue" style="font-size:18px;letter-spacing:0;font-weight:600"> su {rProva.attesi.length}</span></b></div>
              <Icona nome="freccia" classe="" />
            </div>
          </a>
        )}
      </div>

    </div>
  </div>
</div>

<script>
  import './assenze-client';
</script>

<style>
  /* Ultime foto dei concerti: miniature quadrate, tre per riga */
  .ultime-foto { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .ultime-foto a { display: block; aspect-ratio: 1; border-radius: 6px; overflow: hidden; background: var(--fondo); }
  .ultime-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Le tue quote: un pallino per mese (verde pagata, blu esonerato, giallo da versare, vuoto non ancora dovuta) */
  .mesi-quota { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 6px; }
  .mesi-quota li { display: grid; justify-items: center; gap: 3px; font-size: 12px; color: var(--tenue); width: 34px; }
  .mesi-quota .pallino { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--linea); display: grid; place-items: center; font-size: 13px; font-weight: 700; color: #fff; }
  .mesi-quota .pagata .pallino { background: #2e7d4f; border-color: #2e7d4f; }
  .mesi-quota .esonerato .pallino { background: var(--primario); border-color: var(--primario); }
  .mesi-quota .da-pagare.dovuta .pallino { border-color: var(--accento); background: color-mix(in srgb, var(--accento) 25%, var(--bianco)); }
  .mesi-quota .da-pagare.dovuta { color: var(--testo); font-weight: 700; }
  /* Il concerto in testa: bordo giallo per farlo notare */
  .concerto-in-testa { border: 2px solid var(--accento); }
  .cruscotto > :not([style*="order"]) { order: 2; }
  .cruscotto > .concerto-in-testa { order: 0; }
</style>
