---
// Area del tesoriere: la finestra del sollecito a chi deve ancora pagare le quote. Si apre da ogni
// pulsante .apri-sollecito della pagina: con data-mese solo quel mese, senza tutte le quote della
// stagione fino a oggi. L'elenco arriva da /tesoriere/sollecito (azione=quanti). Due modi:
// - notifica personale sui dispositivi dove il corista ha acceso le notifiche ("Ciao Anna, risulta
//   ancora da versare la quota di ottobre…", dal modello correggibile);
// - email: si apre il programma di posta con i loro indirizzi in Ccn (nessuno vede gli altri).
// Chi non ha né notifiche né guarda la posta va avvisato a voce: l'elenco dei nomi serve a questo.
import { coro } from '../motore/coro';
import { MODELLO_SOLLECITO } from './tesoreria';
import { configurate } from './notifiche';
---

<dialog class="finestra-notifica finestra-sollecito" data-firma={`Il tesoriere – ${coro.nome}`} data-notifiche={configurate() ? '1' : ''}>
  <form method="dialog">
    <h2 class="titolo-s">Chi deve ancora pagare</h2>
    <p class="nota quanti">Carico l'elenco…</p>
    <ul class="chi-deve"></ul>
    {configurate() && (
      <>
        <label class="solo-se-debitori">Messaggio della notifica<textarea name="modello" rows="4" maxlength="600">{MODELLO_SOLLECITO}</textarea></label>
        <p class="nota solo-se-debitori">{'{nome}'}, {'{mesi}'} e {'{importo}'} diventano il nome, cosa deve pagare («la quota di ottobre», «il riporto della stagione prima») e l'importo di ciascuno. Arriva con il titolo «Quota del coro» solo a chi ha acceso le notifiche.</p>
      </>
    )}
    <p class="esito" hidden></p>
    <div class="pulsanti">
      <button type="button" class="btn o piccolo chiudi">Chiudi</button>
      <a class="btn o piccolo posta solo-se-debitori" href="#">Email (in Ccn)</a>
      {configurate() && <button type="submit" class="btn g piccolo invia solo-se-debitori">Invia la notifica</button>}
    </div>
  </form>
</dialog>

<style>
  .chi-deve { list-style: none; margin: 0; padding: 0; max-height: 34vh; overflow: auto; border-top: 1px solid var(--linea); }
  .chi-deve:empty { display: none; }
  .chi-deve :global(li) { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--linea); font-size: 14px; }
  .chi-deve :global(li span) { color: var(--tenue); text-align: right; }
  .finestra-sollecito:not(.con-debitori) .solo-se-debitori { display: none; }
</style>

<script>
  const d = document.querySelector<HTMLDialogElement>('.finestra-sollecito');
  if (d) {
    const f = d.querySelector('form')!;
    const titolo = d.querySelector<HTMLElement>('.titolo-s')!;
    const quanti = d.querySelector<HTMLElement>('.quanti')!;
    const lista = d.querySelector<HTMLUListElement>('.chi-deve')!;
    const esito = d.querySelector<HTMLElement>('.esito')!;
    const invia = d.querySelector<HTMLButtonElement>('.invia');
    const posta = d.querySelector<HTMLAnchorElement>('.posta')!;
    let mese: string | undefined;
    const chiama = (azione: string) => fetch('/tesoriere/sollecito', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ azione, mese, modello: (f.modello as HTMLTextAreaElement | undefined)?.value }) })
      .then(async (r) => { const j = await r.json(); if (!r.ok) throw new Error(j.errore ?? `Errore ${r.status}`); return j; });
    const nomeMese = (m: string) => new Date(`${m}-15`).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
    d.querySelector('.chiudi')!.addEventListener('click', () => d.close());

    document.addEventListener('click', async (e) => {
      const b = (e.target as Element).closest<HTMLElement>('.apri-sollecito');
      if (!b) return;
      mese = b.dataset.mese || undefined;
      titolo.textContent = mese ? `Da pagare per ${nomeMese(mese)}` : 'Chi deve ancora pagare';
      quanti.textContent = 'Carico l’elenco…';
      lista.replaceChildren();
      d.classList.remove('con-debitori');
      esito.hidden = true;
      if (invia) { invia.disabled = false; invia.textContent = 'Invia la notifica'; }
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((x) => x !== d && x.close());
      if (!d.open) d.showModal();
      try {
        const j = await chiama('quanti');
        for (const x of j.elenco as { nome: string; mesi: string[]; importo: string }[]) {
          const li = document.createElement('li');
          li.append(Object.assign(document.createElement('b'), { textContent: x.nome }), Object.assign(document.createElement('span'), { textContent: `${mese ? '' : `${x.mesi.map((m) => (m === 'riporto' ? m : m.slice(0, 3))).join(', ')} · `}${x.importo}` }));
          lista.append(li);
        }
        d.classList.toggle('con-debitori', j.persone > 0);
        if (!j.persone) { quanti.textContent = mese ? 'Tutti in regola per questo mese.' : 'Tutti in regola con le quote della stagione fino a oggi.'; return; }
        quanti.textContent = `${j.persone} ${j.persone === 1 ? 'corista' : 'coristi'}, ${j.totale} in tutto.${d.dataset.notifiche ? ` La notifica arriverebbe a ${j.conNotifiche} di loro${j.persone - j.conNotifiche ? `: gli altri ${j.persone - j.conNotifiche} non hanno acceso le notifiche, avvisali per email o a voce.` : '.'}` : ''}`;
        if (invia) invia.disabled = !j.conNotifiche;
        const corpo = `Ciao,\nrisulta ancora da versare ${mese ? `la quota del coro di ${nomeMese(mese)}` : 'qualche quota del coro di questa stagione: puoi chiedere al tesoriere quali'}. Puoi darla al tesoriere alla prossima prova.\nGrazie!\n\n${d.dataset.firma}`;
        posta.href = `mailto:?bcc=${(j.email as string[]).map(encodeURIComponent).join(',')}&subject=${encodeURIComponent(mese ? `Quota del coro di ${nomeMese(mese)}` : 'Quote del coro')}&body=${encodeURIComponent(corpo)}`;
      } catch (err) {
        quanti.textContent = `Non riesco a caricare l’elenco. ${(err as Error).message}`;
      }
    });

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!invia) return;
      invia.disabled = true; invia.textContent = 'Invio…'; esito.hidden = true;
      try {
        const j = await chiama('invia');
        esito.className = 'esito ok';
        esito.textContent = `Sollecito arrivato a ${j.raggiunte} ${j.raggiunte === 1 ? 'persona' : 'persone'}.`;
        invia.textContent = 'Inviata';
      } catch (err) {
        esito.className = 'esito errore';
        esito.textContent = `Non inviata. ${(err as Error).message}`;
        invia.disabled = false; invia.textContent = 'Invia la notifica';
      }
      esito.hidden = false;
    });
  }
</script>
