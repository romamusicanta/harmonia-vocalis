            <a class="btn o piccolo" href={`${base}/repertorio?nuovo&raccolta=${r.id}#modulo`}>Aggiungi un pezzo nuovo</a>
          </div>
          {r.contenuto.length > 0 && (
            <ul class="pezzi-raccolta">
              {r.contenuto.map((id) => {
                const p = pezzoDi.get(id)!;
                return <VocePezzo p={p} base={base} attivo={p.id === inModifica?.id} ancora={prima(id)} altre={nomiRaccolte(p).filter((n) => n !== r.titolo)} cerca={cerca(p)} />;
              })}
