---
// Gestione del repertorio (src/area/repertorio.ts) nell'Amministrazione (/admin/repertorio; il
// Maestro scrive solo le note, da /maestro/repertorio). Due tipi (dal 13/10/2026):
// - opere (?modifica=id, ?nuovo, ?nuovo&raccolta=id per una nuova già dentro una raccolta): autore,
//   titolo, arrangiatore, stato, raccolte (caselle), esecuzione di riferimento, note del Maestro;
//   sotto, nel riquadro #file (dal 17/10/2026, vedi in testa a src/area/repertorio.ts), i brani
//   dell'opera (#brani), gli spartiti con i brani che contengono e le loro pagine (#spartiti) e le
//   tracce di studio a gruppi, una per voce (#tracce, voci in src/area/voci.ts); i file si caricano
//   su Drive a pezzi, con lo script in fondo, verso <base>/repertorio/file. Dopo un'azione su brani
//   o file si torna al riquadro toccato (?in=…), con l'esito lì;
// - raccolte (?modifica=id, ?nuova-raccolta): nome, nota e i pezzi, scelti e ordinati con SceltaPezzi.
// Sotto, un'unica lista: le raccolte, ognuna con dentro i suoi pezzi, poi le opere che non stanno in
// nessuna raccolta (riga del pezzo in src/area/VocePezzo.astro).
import Icona from '../componenti/Icona.astro';
import { catalogo, configurato, nomeCompleto, spartitoDi, STATI, vociDi, type Pezzo, type Raccolta } from './repertorio';
import SceltaVoce from './SceltaVoce.astro';
import { SEZIONI } from './dati';
import Errore from './Errore.astro';
import SceltaPezzi from './SceltaPezzi.astro';
import VocePezzo from './VocePezzo.astro';
import { comeHtml } from './testo';

interface Props { base: '/admin' | '/maestro' }
const { base } = Astro.props;
const q = Astro.url.searchParams;

let errore: unknown;
let elenco: Pezzo[] = [];
let raccolte: Raccolta[] = [];
try {
  ({ pezzi: elenco, raccolte } = await catalogo());
} catch (e) {
  errore = e;
}
const inModifica = elenco.find((p) => p.id === q.get('modifica'));
const raccoltaInModifica = raccolte.find((r) => r.id === q.get('modifica'));
const nuovaRaccolta = q.has('nuova-raccolta');
const nuovo = q.has('nuovo') || (!inModifica && !raccoltaInModifica && !nuovaRaccolta && elenco.length === 0 && !errore);
// Raccolte del pezzo nel modulo: le sue, o quella da cui si è partiti con «Aggiungi un pezzo nuovo»
const raccolteScelte = new Set(inModifica?.raccolte ?? [q.get('raccolta') ?? '']);
const pezzoDi = new Map(elenco.map((p) => [p.id, p]));
const nomiRaccolte = (p: Pezzo) => raccolte.filter((r) => p.raccolte.includes(r.id)).map((r) => r.titolo);
const quante = (n: number, uno: string, tanti: string) => `${n} ${n === 1 ? uno : tanti}`;
// Le opere che non stanno in nessuna raccolta: le altre si vedono dentro le loro raccolte
const opere = elenco.filter((p) => !p.raccolte.length);
// L'ancora #p-<id> di un pezzo in più raccolte sta nella prima
const giaVisti = new Set<string>();
const prima = (id: string) => !giaVisti.has(id) && Boolean(giaVisti.add(id));
const cerca = (p: Pezzo) => semplice(`${p.autore} ${p.titolo} ${p.arrangiatore} ${p.brani.map((b) => b.nome).join(' ')} ${nomiRaccolte(p).join(' ')}`);
// Le voci delle tracce, raggruppate per sezione nei menu (quelle per tutti in fondo)
const voci = vociDi(elenco);
const gruppiVoci = [...SEZIONI, ''].map((s) => [s || 'Per tutti', voci.filter((v) => v.sezione === s)] as [string, typeof voci]).filter(([, v]) => v.length);
// L'esito delle azioni su brani e file si mostra nel loro riquadro
const esitoQui = Boolean(q.get('esito') && (q.has('caricato') || q.has('in')));
const inSez = q.get('in') ?? '';
// Pezzo appena aggiunto: si propone di caricare spartito, brani e tracce
const appena = elenco.find((p) => p.id === q.get('file'));
const semplice = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
---

{q.get('esito') && !esitoQui && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']}>{q.get('esito')}{appena && <> <a class="btn g piccolo" style="margin-left:8px" href={`${base}/repertorio?modifica=${appena.id}#file`}>Aggiungi brani, spartiti e tracce</a></>}</p>}
{errore && <Errore e={errore} />}
{!configurato() && <p class="messaggio errore">Il caricamento dei file non è ancora attivo: manca la cartella Spartiti (variabile DRIVE_CARTELLA_SPARTITI) sul server.</p>}

{raccoltaInModifica || nuovaRaccolta ? (
  <>
    <form method="post" class="carta modulo-pezzo" id="modulo">
      <div class="ct"><h2>{raccoltaInModifica ? <><Icona nome="cartella" /> {raccoltaInModifica.titolo}</> : 'Nuova raccolta'}</h2><a class="link-freccia" href={`${base}/repertorio`}>{raccoltaInModifica ? 'Chiudi' : 'Annulla'}</a></div>
      <div class="cc">
        <p class="tenue" style="margin:0">Una raccolta è una cartella di pezzi (canti natalizi, brani per i bis…). Ogni pezzo resta un pezzo del repertorio, con spartito, tracce e note propri, e può stare in più raccolte.</p>
        <input type="hidden" name="azione" value="salva-raccolta" />
        {raccoltaInModifica && <input type="hidden" name="id" value={raccoltaInModifica.id} />}
        <label>Nome della raccolta<input name="titolo" required maxlength="140" value={raccoltaInModifica?.titolo} placeholder="Es. Canti natalizi" /></label>
        <label>Nota per i coristi <small>(facoltativa)</small><textarea name="note" rows="3" maxlength="4000" placeholder="Per esempio: il programma del concerto di Natale.">{raccoltaInModifica?.note}</textarea></label>
        <SceltaPezzi nome="contenuto" etichetta="Pezzi della raccolta" pezzi={elenco} raccolte={raccolte} soloPezzi senzaOrdine scelti={(raccoltaInModifica?.contenuto ?? []).map((id) => nomeCompleto(pezzoDi.get(id)!))} aiuto="Nella raccolta i pezzi stanno sempre in ordine di autore. Un pezzo che non è ancora nel repertorio si aggiunge con «Aggiungi un pezzo nuovo»." />
        <div class="azioni-pezzo">
          <button class="btn" type="submit"><Icona nome="spunta" />{raccoltaInModifica ? 'Salva la raccolta' : 'Crea la raccolta'}</button>
          {raccoltaInModifica && <a class="btn o" href={`${base}/repertorio?nuovo&raccolta=${raccoltaInModifica.id}#modulo`}>Aggiungi un pezzo nuovo</a>}
        </div>
      </div>
    </form>
    {raccoltaInModifica && (
      <form method="post" class="cancella-raccolta" onsubmit="return confirm('Togliere questa raccolta? I suoi pezzi restano nel repertorio.')">
        <input type="hidden" name="azione" value="cancella-raccolta" /><input type="hidden" name="id" value={raccoltaInModifica.id} />
        <button class="btn o piccolo cancella" type="submit">Togli la raccolta</button>
      </form>
    )}
  </>
) : (inModifica || nuovo) ? (
  <form method="post" class="carta modulo-pezzo" id="modulo">
    <div class="ct"><h2>{inModifica ? nomeCompleto(inModifica) : 'Nuovo pezzo'}</h2><a class="link-freccia" href={`${base}/repertorio`}>{inModifica ? 'Chiudi' : 'Annulla'}</a></div>
    <div class="cc">
      <input type="hidden" name="azione" value="salva" />
      {inModifica && <input type="hidden" name="id" value={inModifica.id} />}
      <div class="riga-campi">
        <label>Autore <small>(iniziali e cognome, come «W. A. Mozart», oppure «Anonimo» o «Tradizionale»)</small><input name="autore" maxlength="100" value={inModifica?.autore} placeholder="W. A. Mozart" /></label>
        <label>Titolo<input name="titolo" required maxlength="140" value={inModifica?.titolo} placeholder="Es. Requiem in re minore K 626" /></label>
        <label>Arrangiamento <small>(facoltativo: chi l'ha arrangiato, come «M. Micheli»)</small><input name="arrangiatore" maxlength="100" value={inModifica?.arrangiatore} /></label>
        <label>Stato
          <select name="stato">{STATI.map((s) => <option selected={(inModifica?.stato ?? STATI[0]) === s}>{s}</option>)}</select>
        </label>
      </div>

      {raccolte.length > 0 && (
        <fieldset>
          <input type="hidden" name="raccolte-nel-modulo" value="1" />
          <legend>Raccolte <small>(facoltative: un pezzo può stare in più raccolte, per esempio nei canti natalizi e nei bis)</small></legend>
          <div class="caselle">
            {raccolte.map((r) => <label class="casella"><input type="checkbox" name="raccolta" value={r.id} checked={raccolteScelte.has(r.id)} /><Icona nome="cartella" />{r.titolo}</label>)}
          </div>
        </fieldset>
      )}

      <label>Esecuzione di riferimento <small>(link, per esempio a YouTube)</small><input name="esecuzione" type="url" value={inModifica?.esecuzione} placeholder="https://…" /></label>
      <label>Note del Maestro sull'esecuzione<textarea name="note" rows="6" maxlength="4000" placeholder="Tempi, respiri, attacchi, pronuncia… Una riga vuota separa i paragrafi.">{inModifica?.note}</textarea></label>
      <button class="btn" type="submit"><Icona nome="spunta" />{inModifica ? 'Salva le modifiche' : 'Aggiungi al repertorio'}</button>
    </div>
  </form>
) : (
  <p class="azioni-pezzo" style="margin:24px 0"><a class="btn" href={`${base}/repertorio?nuovo#modulo`}><Icona nome="libro" />Aggiungi un pezzo</a><a class="btn o" href={`${base}/repertorio?nuova-raccolta#modulo`}><Icona nome="cartella" />Nuova raccolta</a></p>
)}

{inModifica && (
  <section class="carta modulo-pezzo" id="file" data-file={`${base}/repertorio/file`} data-pezzo={inModifica.id} data-ritorno={`${base}/repertorio?modifica=${inModifica.id}`} data-voci={JSON.stringify(voci)}>
    <div class="ct"><h2>Brani, spartiti e tracce</h2><span class="tenue" style="font-size:14px">I file vanno su Drive, nella cartella Spartiti; i coristi li aprono dal sito</span></div>
    {esitoQui && !['brani', 'spartiti', 'tracce'].includes(inSez) && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']} style="margin:16px 24px 0">{q.get('esito')}</p>}
    <div class="cc">
      <div class="file-gruppo" id="brani">
        <h3>Brani dell'opera</h3>
        {esitoQui && inSez === 'brani' && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']} style="margin:0">{q.get('esito')}</p>}
        <p class="tenue" style="margin:0">La struttura dell'opera (Kyrie, Gloria, Lacrimosa…): non sono file. Sono i nomi che i coristi leggono nelle prove, dove si può chiedere di preparare un solo brano, e ognuno apre lo spartito che lo contiene, alla sua pagina.</p>
        {inModifica.brani.map((b, i) => {
          const s = spartitoDi(inModifica, b.nome);
          return (
            <div class="file-riga riga-modificabile">
              <span class="nome-brano"><b>{b.nome}</b><small class="tenue">{!s ? 'nessuno spartito' : s.spartito.brani.length === 1 ? 'ha il suo spartito' : `nello spartito «${s.spartito.titolo}»${s.pagina ? `, da pagina ${s.pagina}` : ''}`}</small></span>
              <span class="azioni-file">
                {i > 0 && <form method="post"><input type="hidden" name="azione" value="sposta-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} /><input type="hidden" name="verso" value="-1" /><button class="btn o piccolo" type="submit" aria-label={`Sposta ${b.nome} su`}>↑</button></form>}
                {i < inModifica.brani.length - 1 && <form method="post"><input type="hidden" name="azione" value="sposta-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} /><input type="hidden" name="verso" value="1" /><button class="btn o piccolo" type="submit" aria-label={`Sposta ${b.nome} giù`}>↓</button></form>}
                <button class="btn o piccolo apri-modifica" type="button" aria-expanded="false">Rinomina</button>
                <form method="post" onsubmit="return confirm('Togliere questo brano dall\'opera? Spartiti e tracce restano.')"><input type="hidden" name="azione" value="togli-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} /><button class="btn o piccolo" type="submit">Togli</button></form>
              </span>
              <form class="modifica in-riga" method="post" hidden>
                <input type="hidden" name="azione" value="rinomina-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} />
                <input type="text" name="nome" value={b.nome} required maxlength="140" aria-label={`Nuovo nome di ${b.nome}`} />
                <button class="btn piccolo" type="submit">Salva</button>
                <button class="btn o piccolo chiudi-modifica" type="button">Annulla</button>
              </form>
            </div>
          );
        })}
        {inModifica.brani.length > 0 && <p class="tenue" style="margin:0">Con «Rinomina» il nome si scrive per bene (per esempio «Lacrimosa»): le prove già scritte con il nome di prima continuano a trovarlo, e spartiti e tracce che lo contengono si aggiornano.</p>}
        <form method="post" class="aggiungi-brani">
          <input type="hidden" name="azione" value="aggiungi-brani" /><input type="hidden" name="id" value={inModifica.id} />
          <label>{inModifica.brani.length ? 'Aggiungi brani' : 'Brani dell\'opera'} <small>(uno per riga, nell'ordine dell'opera)</small><textarea name="testo" rows="3" placeholder={'Kyrie\nGloria\nCredo'}></textarea></label>
          <button class="btn o piccolo" type="submit">Aggiungi</button>
        </form>
      </div>

      <div class="file-gruppo" id="spartiti">
        <h3>Spartiti</h3>
        {esitoQui && inSez === 'spartiti' && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']} style="margin:0">{q.get('esito')}</p>}
        <p class="tenue" style="margin:0">Uno o più PDF: la partitura completa, uno spartito per brano, un misto, oppure volumi che non corrispondono ai brani. Con «Brani e pagine» si indicano i brani che ogni spartito contiene e, se si vuole, la pagina dove comincia ciascuno.</p>
        {inModifica.spartiti.map((s) => (
          <div class="file-riga riga-modificabile">
            <span class="nome-brano"><a href={s.link} target="_blank" rel="noopener"><Icona nome="documento" />{s.titolo}</a><small class="tenue">{s.brani.length ? s.brani.map((b) => (b.pagina ? `${b.nome} (p. ${b.pagina})` : b.nome)).join(' · ') : 'nessun brano indicato'}</small></span>
            <span class="azioni-file">
              <button class="btn o piccolo apri-modifica" type="button" aria-expanded="false">{inModifica.brani.length ? 'Brani e pagine' : 'Rinomina'}</button>
              <form method="post" onsubmit="return confirm('Togliere questo spartito dal pezzo? Il file resta su Drive.')"><input type="hidden" name="azione" value="togli-file" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="file" value={s.id} /><button class="btn o piccolo" type="submit">Togli</button></form>
            </span>
            <form class="modifica" method="post" hidden>
              <input type="hidden" name="azione" value="salva-spartito" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="file" value={s.id} />
              <label>Titolo dello spartito<input type="text" name="titolo" value={s.titolo} required maxlength="140" placeholder="Es. Partitura completa, Volume 1, Gloria" /></label>
              {inModifica.brani.length > 0 && (
                <fieldset>
                  <legend>Brani che contiene <small>(con la pagina dove comincia, se si vuole)</small></legend>
                  <div class="brani-pagine">
                    {inModifica.brani.map((b, i) => {
                      const dentro = s.brani.find((x) => x.nome === b.nome);
                      return (
                        <div class="brano-pagina">
                          <label class="casella"><input type="checkbox" name="brano" value={i} checked={Boolean(dentro)} />{b.nome}</label>
                          <input type="number" name={`pagina-${i}`} min="1" max="9999" value={dentro?.pagina} placeholder="pag." aria-label={`Pagina di ${b.nome}`} />
                        </div>
                      );
                    })}
                  </div>
                </fieldset>
              )}
              <div class="azioni-pezzo"><button class="btn piccolo" type="submit">Salva</button><button class="btn o piccolo chiudi-modifica" type="button">Annulla</button></div>
            </form>
          </div>
        ))}
        {!inModifica.spartiti.length && <p class="tenue">Nessuno spartito.</p>}
        <label class="carica">Carica spartiti <small>(PDF, anche più di uno: il nome del file diventa il titolo; se è il nome di un brano, lo spartito contiene quel brano)</small><input type="file" data-uso="spartito" accept="application/pdf,image/*" multiple /></label>
      </div>

      <div class="file-gruppo" id="tracce">
        <h3>Tracce per lo studio</h3>
        {esitoQui && inSez === 'tracce' && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']} style="margin:0">{q.get('esito')}</p>}
        <p class="tenue" style="margin:0">A gruppi con un titolo («Opera intera», «Kyrie – tempo lento», «Gloria, battute 1–80»), facoltativamente legati a dei brani, con una traccia per voce. Le voci possono essere divise (Soprani I e II, Baritoni e Bassi…): ai coristi di una sezione si mostrano prima le voci della loro sezione.</p>
        {inModifica.tracce.map((g) => (
          <div class="gruppo-admin riga-modificabile">
            <div class="testa-gruppo">
              <span class="nome-brano"><b>{g.titolo}</b>{g.brani.length > 0 && <small class="tenue">{g.brani.join(' · ')}</small>}</span>
              <span class="azioni-file">
                <button class="btn o piccolo apri-modifica" type="button" aria-expanded="false">Modifica</button>
                <form method="post" onsubmit="return confirm('Togliere tutte le tracce di questo gruppo dal pezzo? I file restano su Drive.')"><input type="hidden" name="azione" value="togli-gruppo" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="gruppo" value={g.titolo} /><button class="btn o piccolo" type="submit">Togli il gruppo</button></form>
              </span>
            </div>
            <form class="modifica" method="post" hidden>
              <input type="hidden" name="azione" value="salva-gruppo" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="gruppo" value={g.titolo} />
              <label>Titolo del gruppo<input type="text" name="titolo" value={g.titolo} required maxlength="140" /></label>
              {inModifica.brani.length > 0 && (
                <fieldset><legend>Brani a cui si riferisce <small>(facoltativi)</small></legend>
                  <div class="caselle">{inModifica.brani.map((b, i) => <label class="casella"><input type="checkbox" name="brano" value={i} checked={g.brani.includes(b.nome)} />{b.nome}</label>)}</div>
                </fieldset>
              )}
              <div class="azioni-pezzo"><button class="btn piccolo" type="submit">Salva</button><button class="btn o piccolo chiudi-modifica" type="button">Annulla</button></div>
            </form>
            {g.tracce.map((t) => (
              <div class="file-riga traccia-riga">
                <form method="post" class="cambia-voce">
                  <input type="hidden" name="azione" value="cambia-voce" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="file" value={t.id} />
                  <select name="voce" aria-label="Voce della traccia" data-invia>{gruppiVoci.map(([nome, elenco]) => <optgroup label={nome}>{elenco.map((v) => <option value={v.nome} selected={v.nome === t.voce}>{v.nome}</option>)}</optgroup>)}</select>
                  <noscript><button class="btn o piccolo" type="submit">Cambia</button></noscript>
                </form>
                <a href={t.link} target="_blank" rel="noopener"><Icona nome="cuffie" />{/^https:\/\/drive\.google\.com\/file\//.test(t.link) ? 'File audio' : 'Link'}</a>
                <form method="post" onsubmit={`return confirm('Togliere la traccia ${t.voce} da questo gruppo? Se è un file, resta su Drive.')`}><input type="hidden" name="azione" value="togli-file" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="file" value={t.id} /><button class="btn o piccolo" type="submit">Togli</button></form>
              </div>
            ))}
            <form method="post" class="carica-gruppo" data-gruppo={g.titolo}>
              <input type="hidden" name="azione" value="aggiungi-link" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="gruppo" value={g.titolo} />
              <label class="btn o piccolo carica-traccia">Aggiungi tracce<input type="file" data-uso="traccia" accept="audio/*,.mp3,.m4a,.wav,.aac,.ogg,.opus" multiple class="sr" /></label>
              <details class="con-link">
                <summary class="btn o piccolo">Aggiungi un link</summary>
                <div class="campi-link">
                  <SceltaVoce voci={gruppiVoci} />
                  <input type="url" name="link" placeholder="https://… (YouTube o altro sito)" aria-label="Link della traccia" />
                  <button class="btn piccolo" type="submit">Aggiungi il link</button>
                </div>
              </details>
            </form>
          </div>
        ))}
        <details class="nuovo-gruppo" open={!inModifica.tracce.length}>
          <summary>Nuovo gruppo di tracce</summary>
          <form method="post" class="carica-gruppo nuovo">
            <input type="hidden" name="azione" value="aggiungi-link" /><input type="hidden" name="id" value={inModifica.id} />
            <label>Titolo del gruppo<input type="text" name="gruppo" maxlength="140" placeholder="Es. Opera intera, Kyrie – tempo lento" /></label>
            {inModifica.brani.length > 0 && (
              <fieldset><legend>Brani a cui si riferisce <small>(facoltativi)</small></legend>
                <div class="caselle">{inModifica.brani.map((b, i) => <label class="casella"><input type="checkbox" name="brano" value={i} />{b.nome}</label>)}</div>
              </fieldset>
            )}
            <label class="carica">File audio <small>(anche tutti insieme: la voce di ognuno si indovina dal nome del file, e si corregge prima di caricare)</small><input type="file" data-uso="traccia" accept="audio/*,.mp3,.m4a,.wav,.aac,.ogg,.opus" multiple /></label>
            <details class="con-link">
              <summary class="btn o piccolo">Oppure un link</summary>
              <div class="campi-link">
                <SceltaVoce voci={gruppiVoci} />
                <input type="url" name="link" placeholder="https://… (YouTube o altro sito)" aria-label="Link della traccia" />
                <button class="btn piccolo" type="submit">Aggiungi il link</button>
              </div>
            </details>
          </form>
        </details>
      </div>

      <div class="scelta-voci" hidden>
        <p class="eti-voci"><b>Di che voce è ogni traccia?</b> <span class="tenue">Controlla e correggi prima di caricare.</span></p>
        <ul class="elenco-voci"></ul>
        <template class="modello-voce"><li><span class="nome-file"></span><SceltaVoce voci={gruppiVoci} senzaNome /></li></template>
        <div class="azioni-pezzo"><button class="btn piccolo carica-tracce" type="button">Carica le tracce</button><button class="btn o piccolo annulla-tracce" type="button">Annulla</button></div>
      </div>
      <div class="avanza-file" hidden>
        <progress max="100" value="0" aria-label="Caricamento"></progress>
        <p class="stato-caricamento" role="status" aria-live="polite"></p>
        <small>Tieni aperta questa pagina fino alla fine.</small>
      </div>
    </div>
  </section>
)}

{/* Un'unica lista (dal 13/10/2026, richiesta di Mario): prima le raccolte, poi le opere che non
    stanno in nessuna raccolta; i pezzi di una raccolta si vedono solo dentro la raccolta */}
