---
// Gestione del repertorio (src/area/repertorio.ts) nell'Amministrazione (/admin/repertorio; il
// Maestro scrive solo le note, da /maestro/repertorio): elenco dei pezzi e modulo per
// aggiungerne uno o modificarlo (?modifica=id, ?nuovo): autore, titolo, stato, link alle tracce per
// sezione, esecuzione di riferimento, note del Maestro; spartito e brani separati si caricano su
// Drive dal modulo (a pezzi, con lo script in fondo, verso <base>/repertorio/file).
import Icona from '../componenti/Icona.astro';
import { configurato, nomeCompleto, repertorio, sezioniTracce, STATI, type Pezzo } from './repertorio';
import Errore from './Errore.astro';
import { comeHtml } from './testo';

interface Props { base: '/admin' | '/maestro' }
const { base } = Astro.props;
const q = Astro.url.searchParams;

let errore: unknown;
let elenco: Pezzo[] = [];
try {
  elenco = await repertorio();
} catch (e) {
  errore = e;
}
const inModifica = elenco.find((p) => p.id === q.get('modifica'));
const nuovo = q.has('nuovo') || (!inModifica && elenco.length === 0);
const traccia = (p: Pezzo | undefined, s: string) => p?.tracce.find((t) => t.sezione === s)?.link ?? '';
// Pezzo appena aggiunto: si propone di caricare spartito, brani e tracce
const appena = elenco.find((p) => p.id === q.get('file'));
const semplice = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
---

{q.get('esito') && !q.has('caricato') && <p class:list={['messaggio', q.get('ok') === '1' ? 'ok' : 'errore']}>{q.get('esito')}{appena && <> <a class="btn g piccolo" style="margin-left:8px" href={`${base}/repertorio?modifica=${appena.id}#file`}>Carica spartito, brani e tracce</a></>}</p>}
{errore && <Errore e={errore} />}
{!configurato() && <p class="messaggio errore">Il caricamento dei file non è ancora attivo: manca la cartella Spartiti (variabile DRIVE_CARTELLA_SPARTITI) sul server.</p>}

{(inModifica || nuovo) ? (
  <form method="post" class="carta modulo-pezzo" id="modulo">
    <div class="ct"><h2>{inModifica ? nomeCompleto(inModifica) : 'Nuovo pezzo'}</h2><a class="link-freccia" href={`${base}/repertorio`}>{inModifica ? 'Chiudi' : 'Annulla'}</a></div>
    <div class="cc">
      <input type="hidden" name="azione" value="salva" />
      {inModifica && <input type="hidden" name="id" value={inModifica.id} />}
      <div class="riga-campi">
        <label>Autore <small>(iniziali e cognome, come «W. A. Mozart», oppure «Anonimo» o «Tradizionale»)</small><input name="autore" maxlength="100" value={inModifica?.autore} placeholder="W. A. Mozart" /></label>
        <label>Titolo<input name="titolo" required maxlength="140" value={inModifica?.titolo} placeholder="Es. Requiem in re minore K 626" /></label>
        <label>Stato
          <select name="stato">{STATI.map((s) => <option selected={(inModifica?.stato ?? STATI[0]) === s}>{s}</option>)}</select>
        </label>
      </div>

      <fieldset>
        <legend>Tracce per lo studio <small>(link a YouTube o altro sito, uno per sezione; i file audio si caricano qui sotto, in «File del pezzo»)</small></legend>
        <div class="riga-campi">
          {sezioniTracce.map((s) => <label>{s}<input name={`tracce-${s}`} type="url" value={traccia(inModifica, s)} placeholder="https://…" /></label>)}
        </div>
      </fieldset>

      <label>Esecuzione di riferimento <small>(link, per esempio a YouTube)</small><input name="esecuzione" type="url" value={inModifica?.esecuzione} placeholder="https://…" /></label>
      <label>Note del Maestro sull'esecuzione<textarea name="note" rows="6" maxlength="4000" placeholder="Tempi, respiri, attacchi, pronuncia… Una riga vuota separa i paragrafi.">{inModifica?.note}</textarea></label>
      <button class="btn" type="submit"><Icona nome="spunta" />{inModifica ? 'Salva le modifiche' : 'Aggiungi al repertorio'}</button>
    </div>
  </form>
) : (
  <p style="margin:24px 0"><a class="btn" href={`${base}/repertorio?nuovo`}><Icona nome="libro" />Aggiungi un pezzo</a></p>
)}

{inModifica && (
  <section class="carta modulo-pezzo" id="file" data-file={`${base}/repertorio/file`} data-pezzo={inModifica.id} data-ritorno={`${base}/repertorio?modifica=${inModifica.id}`}>
    <div class="ct"><h2>File del pezzo</h2><span class="tenue" style="font-size:14px">Su Drive, nella cartella Spartiti; i coristi li aprono dal sito</span></div>
    {q.has('caricato') && q.get('esito') && <p class="messaggio ok" style="margin:16px 24px 0">{q.get('esito')}</p>}
    <div class="cc">
      <div class="file-gruppo">
        <h3>Spartito</h3>
        {inModifica.spartito ? (
          <div class="file-riga"><a href={inModifica.spartito} target="_blank" rel="noopener"><Icona nome="documento" />Spartito</a>
            <form method="post" onsubmit="return confirm('Togliere lo spartito da questo pezzo? Il file resta su Drive.')"><input type="hidden" name="azione" value="togli-spartito" /><input type="hidden" name="id" value={inModifica.id} /><button class="btn o piccolo" type="submit">Togli</button></form></div>
        ) : <p class="tenue">Nessuno spartito.</p>}
        <label class="carica">{inModifica.spartito ? 'Sostituisci lo spartito' : 'Carica lo spartito'} <small>(PDF)</small><input type="file" data-uso="spartito" accept="application/pdf,image/*" /></label>
      </div>
      <div class="file-gruppo">
        <h3>Brani cantati separatamente</h3>
        {inModifica.brani.length ? inModifica.brani.map((b, i) => (
          <div class="file-riga riga-brano"><a href={b.link} target="_blank" rel="noopener"><Icona nome="documento" />{b.nome}</a>
            <span class="azioni-file">
              <button class="btn o piccolo apri-rinomina" type="button" aria-expanded="false">Rinomina</button>
              <form method="post" onsubmit="return confirm('Togliere questo brano dal pezzo? Il file resta su Drive.')"><input type="hidden" name="azione" value="togli-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} /><button class="btn o piccolo" type="submit">Togli</button></form>
            </span>
            <form class="rinomina-brano" method="post" hidden>
              <input type="hidden" name="azione" value="rinomina-brano" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="indice" value={i} />
              <input type="text" name="nome" value={b.nome} required maxlength="140" aria-label={`Nuovo nome di ${b.nome}`} />
              <button class="btn piccolo" type="submit">Salva</button>
              <button class="btn o piccolo chiudi-rinomina" type="button">Annulla</button>
            </form>
          </div>
        )) : <p class="tenue">Nessun brano. Il nome del file diventa il nome del brano.</p>}
        {inModifica.brani.length > 0 && <p class="tenue" style="margin:0">Il nome del brano è quello che leggono i coristi nelle prove: con «Rinomina» si scrive per bene (per esempio «Va' pensiero (Nabucco)»). Le prove già scritte con il nome di prima continuano a trovarlo.</p>}
        <label class="carica">Aggiungi brani <small>(PDF, anche più di uno)</small><input type="file" data-uso="brano" accept="application/pdf,image/*" multiple /></label>
      </div>
      <div class="file-gruppo">
        <h3>Tracce per lo studio</h3>
        <p class="tenue" style="margin:0 0 4px">Un file audio per sezione: prende il posto del link o del file di prima. I coristi lo ascoltano nella pagina Repertorio.</p>
        {sezioniTracce.map((s) => {
          const t = traccia(inModifica, s);
          return (
            <div class="file-riga traccia-riga">
              <b>{s}</b>
              {t ? <a href={t} target="_blank" rel="noopener"><Icona nome="cuffie" />{/^https:\/\/drive\.google\.com\/file\//.test(t) ? 'File audio' : 'Link'}</a> : <span class="tenue">Nessuna traccia</span>}
              {t && <form method="post" onsubmit={`return confirm('Togliere la traccia ${s} da questo pezzo? Se è un file, resta su Drive.')`}><input type="hidden" name="azione" value="togli-traccia" /><input type="hidden" name="id" value={inModifica.id} /><input type="hidden" name="sezione" value={s} /><button class="btn o piccolo" type="submit">Togli</button></form>}
              <label class="btn o piccolo carica-traccia">{t ? 'Sostituisci' : 'Carica'}<input type="file" data-uso="traccia" data-sezione={s} accept="audio/*,.mp3,.m4a,.wav,.aac,.ogg,.opus" class="sr" /></label>
            </div>
          );
        })}
      </div>
      <div class="avanza-file" hidden>
        <progress max="100" value="0" aria-label="Caricamento"></progress>
        <p class="stato-caricamento" role="status" aria-live="polite"></p>
        <small>Tieni aperta questa pagina fino alla fine.</small>
      </div>
    </div>
  </section>
)}

<h2 class="titolo-elenco">Repertorio{elenco.length > 0 && <small> · {elenco.length} {elenco.length === 1 ? 'pezzo' : 'pezzi'}</small>}</h2>
{elenco.length === 0 && !errore && <p class="tenue">Ancora nessun pezzo.</p>}
{elenco.length > 6 && <input class="filtra-pezzi" type="search" placeholder="Cerca nel repertorio per autore o titolo…" aria-label="Cerca nel repertorio" />}
<ul class="carta elenco-pezzi">
  {elenco.map((p) => (
    <li id={`p-${p.id}`} class:list={{ attivo: p.id === inModifica?.id }} data-cerca={semplice(`${p.autore} ${p.titolo}`)}>
      <details>
        <summary>
          <span class="testa-pezzo"><span class="aut">{p.autore}</span><b>{p.titolo}</b></span>
          <span class:list={['tag', { grigio: p.stato !== 'In studio' }]}>{p.stato}</span>
          <span class="tenue dettagli">{[p.spartito && 'spartito', p.brani.length && `${p.brani.length} ${p.brani.length === 1 ? 'brano' : 'brani'}`, p.tracce.length && `${p.tracce.length} ${p.tracce.length === 1 ? 'traccia' : 'tracce'}`, p.esecuzione && 'esecuzione', p.note && 'note'].filter(Boolean).join(' · ') || 'nessun materiale'}</span>
        </summary>
        <div class="corpo-pezzo">
          <dl>
            <dt>Spartito</dt><dd>{p.spartito ? <a href={p.spartito} target="_blank" rel="noopener">Apri lo spartito</a> : <span class="tenue">—</span>}</dd>
            <dt>Brani</dt><dd>{p.brani.length ? p.brani.map((b, i) => <>{i > 0 && ' · '}<a href={b.link} target="_blank" rel="noopener">{b.nome}</a></>) : <span class="tenue">—</span>}</dd>
            <dt>Tracce</dt><dd>{p.tracce.length ? p.tracce.map((t, i) => <>{i > 0 && ' · '}<a href={t.link} target="_blank" rel="noopener">{t.sezione}</a></>) : <span class="tenue">—</span>}</dd>
            <dt>Esecuzione</dt><dd>{p.esecuzione ? <a href={p.esecuzione} target="_blank" rel="noopener">Ascolta</a> : <span class="tenue">—</span>}</dd>
            <dt>Note del Maestro</dt><dd>{p.note ? <div set:html={comeHtml(p.note)} /> : <span class="tenue">—</span>}</dd>
          </dl>
          <div class="azioni-pezzo">
            <a class="btn o piccolo" href={`${base}/repertorio?modifica=${p.id}#modulo`}>Modifica</a>
            <form method="post" onsubmit="return confirm('Togliere questo pezzo dal repertorio? I file restano su Drive.')">
              <input type="hidden" name="azione" value="cancella" /><input type="hidden" name="id" value={p.id} />
              <button class="btn o piccolo cancella" type="submit">Togli dal repertorio</button>
            </form>
          </div>
        </div>
      </details>
    </li>
  ))}
</ul>

<script>
  // Brani: "Rinomina" apre sotto la riga il campo con il nome, "Annulla" lo richiude
  document.querySelectorAll<HTMLElement>('.riga-brano').forEach((riga) => {
    const apri = riga.querySelector<HTMLButtonElement>('.apri-rinomina')!;
    const modulo = riga.querySelector<HTMLFormElement>('.rinomina-brano')!;
    const campo = modulo.querySelector<HTMLInputElement>('input[name=nome]')!;
    const mostra = (si: boolean) => {
      modulo.hidden = !si;
      apri.setAttribute('aria-expanded', String(si));
      if (si) { campo.focus(); campo.select(); } else { campo.value = campo.defaultValue; apri.focus(); }
    };
    apri.addEventListener('click', () => mostra(modulo.hidden));
    modulo.querySelector('.chiudi-rinomina')!.addEventListener('click', () => mostra(false));
    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); mostra(false); } });
  });
</script>

<script>
  // Elenco: si apre il pezzo indicato nell'indirizzo (#p-<id>); ricerca per autore o titolo
  const daAprire = location.hash.startsWith('#p-') && document.querySelector<HTMLElement>(location.hash);
  if (daAprire) daAprire.querySelector('details')?.setAttribute('open', '');
  const filtro = document.querySelector<HTMLInputElement>('.filtra-pezzi');
  filtro?.addEventListener('input', () => {
    const parole = filtro.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().split(/\s+/).filter(Boolean);
    document.querySelectorAll<HTMLElement>('.elenco-pezzi > li').forEach((li) => { li.hidden = !parole.every((p) => li.dataset.cerca!.includes(p)); });
  });
</script>

<script>
  // Caricamento a pezzi (src/area/caricamento-client.ts): uno dopo l'altro, poi si ricarica la pagina
  import { carica } from './caricamento-client';
  const box = document.querySelector<HTMLElement>('[data-file]');
  const avanza = box?.querySelector<HTMLElement>('.avanza-file');
  const barra = avanza?.querySelector('progress');
  const stato = box?.querySelector<HTMLElement>('.stato-caricamento');
  // Modifiche al pezzo non ancora salvate: si salvano prima di caricare, perché alla fine la pagina si ricarica
  const modulo = document.querySelector<HTMLFormElement>('#modulo');
  let modificato = false;
  modulo?.addEventListener('input', () => { modificato = true; });
  box?.querySelectorAll<HTMLInputElement>('input[type=file]').forEach((input) => input.addEventListener('change', async () => {
    const file = [...(input.files ?? [])];
    if (!file.length) return;
    box.querySelectorAll<HTMLInputElement>('input[type=file]').forEach((i) => (i.disabled = true));
    // Avanzamento subito sotto il riquadro del file scelto, dove lo si sta guardando
    input.closest('.carica, .traccia-riga')?.after(avanza!);
    avanza!.hidden = false;
    barra!.value = 0;
    avanza!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    try {
      if (modificato && modulo) {
        stato!.textContent = 'Salvo prima le modifiche al pezzo…';
        const r = await fetch(location.pathname, { method: 'POST', body: new FormData(modulo) });
        if (!r.ok) throw new Error('Le modifiche al pezzo non si sono salvate: premi «Salva le modifiche» e riprova.');
        modificato = false;
      }
      for (const [i, f] of file.entries()) {
        await carica(box.dataset.file!, f, { pezzo: box.dataset.pezzo!, uso: input.dataset.uso!, ...(input.dataset.sezione ? { sezione: input.dataset.sezione } : {}) }, (q) => {
          barra!.value = Math.round(((i + q) / file.length) * 100);
          stato!.textContent = `Carico «${f.name}»${file.length > 1 ? ` (${i + 1} di ${file.length})` : ''}: ${Math.round(q * 100)}%`;
        });
      }
      stato!.textContent = 'Caricato. Aggiorno la pagina…';
      location.href = `${box.dataset.ritorno}&ok=1&caricato=1&esito=${encodeURIComponent(file.length === 1 ? `«${file[0].name}» caricato.` : `${file.length} file caricati.`)}#file`;
    } catch (e) {
      stato!.textContent = `Caricamento non riuscito: ${(e as Error).message}`;
      barra!.value = 0;
      box.querySelectorAll<HTMLInputElement>('input[type=file]').forEach((i) => (i.disabled = false));
    }
  }));
</script>

<style>
  .modulo-pezzo { margin: 24px 0 8px; }
  .modulo-pezzo .cc { display: grid; gap: 18px; }
  .modulo-pezzo label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; color: var(--primario); }
  .modulo-pezzo small { font-weight: 400; color: var(--tenue); }
  .modulo-pezzo :is(input:not([type=file]), textarea, select) { font: inherit; font-weight: 400; color: var(--testo); padding: 10px 12px; border: 2px solid var(--linea); border-radius: var(--raggio); background: var(--bianco); width: 100%; }
  .modulo-pezzo .riga-campi { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .modulo-pezzo fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .modulo-pezzo legend { font-weight: 700; font-size: 14px; color: var(--primario); margin-bottom: 10px; }
  .modulo-pezzo button[type=submit]:not(.piccolo) { justify-self: start; }
  .file-gruppo { display: grid; gap: 10px; padding-bottom: 18px; border-bottom: 1px solid var(--linea); }
  .file-gruppo h3 { font-size: 17px; }
  .file-riga { display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--fondo); border-radius: var(--raggio); }
  .file-riga a { display: inline-flex; gap: 8px; align-items: center; font-weight: 600; color: var(--primario); text-decoration: underline; min-width: 0; overflow-wrap: anywhere; }
  .carica { padding: 12px; border: 2px dashed var(--linea); border-radius: var(--raggio); }
  .traccia-riga { flex-wrap: wrap; justify-content: flex-start; }
  .traccia-riga a { flex: 1 1 auto; }
  .traccia-riga b { min-width: 110px; color: var(--primario); }
  .carica-traccia { cursor: pointer; position: relative; margin-left: auto; }
  .carica-traccia:focus-within { outline: 3px solid var(--primario); outline-offset: 2px; }
  .stato-caricamento { font-weight: 600; color: var(--primario); min-height: 1.4em; margin: 0; }
  .avanza-file { display: grid; gap: 6px; padding: 12px; background: var(--fondo); border-radius: var(--raggio); }
  .avanza-file[hidden] { display: none; }
  .avanza-file progress { width: 100%; height: 14px; accent-color: var(--primario); }
  .avanza-file small { color: var(--tenue); font-size: 13px; }
  #file { scroll-margin-top: 140px; }
  .titolo-elenco { font-family: var(--f-titoli); font-size: 22px; color: var(--primario); margin: 40px 0 14px; }
  .elenco-pezzi { list-style: none; margin: 0; padding: 0; }
  .elenco-pezzi li { border-bottom: 1px solid var(--linea); scroll-margin-top: 140px; }
  .elenco-pezzi summary { display: flex; gap: 6px 14px; align-items: center; flex-wrap: wrap; padding: 14px 20px; cursor: pointer; list-style: none; }
  .elenco-pezzi summary::-webkit-details-marker { display: none; }
  .elenco-pezzi summary::before { content: '▸'; color: var(--tenue); transition: transform .15s; }
  .elenco-pezzi details[open] summary::before { transform: rotate(90deg); }
  .elenco-pezzi .testa-pezzo { flex: 1 1 260px; min-width: 0; }
  .elenco-pezzi .dettagli { flex-basis: 100%; padding-left: 22px; }
  .corpo-pezzo { padding: 0 20px 18px 42px; display: grid; gap: 14px; }
  .corpo-pezzo dl { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 8px 16px; margin: 0; font-size: 15px; }
  .corpo-pezzo dt { font-weight: 700; color: var(--primario); }
  .corpo-pezzo dd { margin: 0; overflow-wrap: anywhere; }
  .corpo-pezzo a { text-decoration: underline; }
  @media (max-width: 560px) { .corpo-pezzo { padding-left: 20px; } .corpo-pezzo dl { grid-template-columns: 1fr; gap: 2px; } .corpo-pezzo dd { margin-bottom: 8px; } }
  .filtra-pezzi { width: 100%; font: inherit; padding: 10px 12px; border: 2px solid var(--bordo-campo, var(--linea)); border-radius: var(--raggio); background: var(--bianco); margin-bottom: 12px; }
  .titolo-elenco small { font-size: 15px; font-family: var(--f-testo); color: var(--tenue); font-weight: 400; }
  .elenco-pezzi li:last-child { border-bottom: 0; }
  .elenco-pezzi li.attivo { box-shadow: inset 4px 0 0 var(--accento); }
  .elenco-pezzi b { display: block; font-family: var(--f-titoli); font-size: 18px; color: var(--primario); }
  .elenco-pezzi .aut { display: block; }
  .elenco-pezzi .dettagli { font-size: 14px; }
  .azioni-pezzo { display: flex; gap: 8px; }
  .azioni-pezzo form, .file-riga form { display: contents; }
  .riga-brano { flex-wrap: wrap; }
  .riga-brano .azioni-file { display: flex; gap: 8px; flex-shrink: 0; }
  .riga-brano form.rinomina-brano { display: flex; flex-wrap: wrap; gap: 8px; flex-basis: 100%; }
  .riga-brano form.rinomina-brano[hidden] { display: none; }
  .rinomina-brano input[type=text] { flex: 1 1 220px; min-width: 0; font: inherit; padding: 8px 10px; border: 2px solid var(--bordo-campo, var(--linea)); border-radius: var(--raggio); background: var(--bianco); color: var(--testo); }
  .cancella { color: var(--rosso) !important; box-shadow: inset 0 0 0 2px var(--rosso) !important; }
  .messaggio { padding: 14px 18px; border-radius: var(--raggio); margin: 20px 0; border: 2px solid var(--linea); background: var(--bianco); }
  .messaggio.ok { border-color: #2e7d4f; }
  .messaggio.errore { border-color: #b3261e; color: #b3261e; }
</style>
