  {opere.map((p) => <VocePezzo p={p} base={base} attivo={p.id === inModifica?.id} ancora={prima(p.id)} altre={[]} cerca={cerca(p)} />)}
</ul>

<script>
  // Brani, spartiti e gruppi di tracce: «Rinomina» o «Modifica» aprono sotto la riga il modulo,
  // «Annulla» (o Esc) lo richiude; il menu della voce di una traccia salva appena cambia
  document.querySelectorAll<HTMLElement>('.riga-modificabile').forEach((riga) => {
    const apri = riga.querySelector<HTMLButtonElement>(':scope > .azioni-file .apri-modifica, :scope > .testa-gruppo .apri-modifica')!;
    const modulo = riga.querySelector<HTMLFormElement>(':scope > form.modifica')!;
    if (!apri || !modulo) return;
    const campo = modulo.querySelector<HTMLInputElement>('input[type=text]');
    const mostra = (si: boolean) => {
      modulo.hidden = !si;
      apri.setAttribute('aria-expanded', String(si));
      if (si) { campo?.focus(); campo?.select(); } else { modulo.reset(); apri.focus(); }
    };
    apri.addEventListener('click', () => mostra(modulo.hidden));
    modulo.querySelector('.chiudi-modifica')!.addEventListener('click', () => mostra(false));
    modulo.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); mostra(false); } });
  });
  document.querySelectorAll<HTMLSelectElement>('select[data-invia]').forEach((s) => s.addEventListener('change', () => s.form?.requestSubmit()));
  // Una pagina scritta accende la casella del suo brano
  document.querySelectorAll<HTMLElement>('.brano-pagina').forEach((r) => {
    const casella = r.querySelector<HTMLInputElement>('input[type=checkbox]')!;
    r.querySelector<HTMLInputElement>('input[type=number]')!.addEventListener('input', (e) => { if ((e.target as HTMLInputElement).value) casella.checked = true; });
  });
</script>

<script>
  // Lista: si apre il pezzo o la raccolta indicati nell'indirizzo (#p-<id>, #r-<id>), anche quando
  // cambia; un pezzo dentro una raccolta apre anche la raccolta. Ricerca per autore, titolo o
  // raccolta: una raccolta si vede se il suo nome o uno dei suoi pezzi corrisponde, e si apre
  const apri = () => {
    const el = /^#[pr]-/.test(location.hash) && document.querySelector<HTMLElement>(location.hash);
    if (!el) return;
    el.hidden = false;
    el.parentElement?.closest('.voce-raccolta')?.querySelector('details')?.setAttribute('open', '');
    el.querySelector('details')?.setAttribute('open', '');
    el.scrollIntoView({ block: 'start' });
  };
  apri();
  addEventListener('hashchange', apri);
  const filtro = document.querySelector<HTMLInputElement>('.filtra-pezzi');
  filtro?.addEventListener('input', () => {
    const parole = filtro.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().split(/\s+/).filter(Boolean);
    const vale = (el: HTMLElement) => parole.every((p) => el.dataset.cerca!.includes(p));
    document.querySelectorAll<HTMLElement>('.lista-repertorio .voce-pezzo').forEach((li) => { li.hidden = !vale(li); });
    document.querySelectorAll<HTMLElement>('.lista-repertorio > .voce-raccolta').forEach((r) => {
      const pezzi = [...r.querySelectorAll<HTMLElement>('.voce-pezzo')];
      if (parole.length && vale(r)) pezzi.forEach((li) => { li.hidden = false; });
      const trovati = pezzi.some((li) => !li.hidden) || (parole.length > 0 && vale(r));
      r.hidden = parole.length > 0 && !trovati;
      r.querySelector('details')!.open = parole.length > 0 && pezzi.some((li) => !li.hidden);
    });
  });
</script>

<script>
  // Caricamento a pezzi (src/area/caricamento-client.ts): uno dopo l'altro, poi si ricarica la
  // pagina. Gli spartiti partono subito; per le tracce prima si sceglie la voce di ogni file
  // (indovinata dal nome, src/area/voci.ts), poi «Carica le tracce»
  import { carica } from './caricamento-client';
  import { indovinaVoce, type Voce } from './voci';
  import { preparaTendine } from '../motore/tendine';
  const box = document.querySelector<HTMLElement>('[data-file]');
  const avanza = box?.querySelector<HTMLElement>('.avanza-file');
  const barra = avanza?.querySelector('progress');
  const stato = box?.querySelector<HTMLElement>('.stato-caricamento');
  const scelta = box?.querySelector<HTMLElement>('.scelta-voci');
  const elencoVoci = scelta?.querySelector<HTMLUListElement>('.elenco-voci');
  const modello = scelta?.querySelector<HTMLTemplateElement>('.modello-voce');
  const voci: Voce[] = JSON.parse(box?.dataset.voci ?? '[]');
  // Modifiche al pezzo non ancora salvate: si salvano prima di caricare, perché alla fine la pagina si ricarica
  const modulo = document.querySelector<HTMLFormElement>('#modulo');
  let modificato = false;
  modulo?.addEventListener('input', () => { modificato = true; });
  const blocca = (si: boolean) => box?.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input[type=file], .carica-tracce').forEach((i) => (i.disabled = si));

  type DaCaricare = { file: File; extra: Record<string, string> };
  async function caricaTutti(lista: DaCaricare[], vicino: Element, dove: string) {
    if (!box) return;
    blocca(true);
    vicino.after(avanza!);
    avanza!.hidden = false;
    barra!.value = 0;
    avanza!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    try {
      if (modificato && modulo) {
        stato!.textContent = 'Salvo prima le modifiche al pezzo…';
        const r = await fetch(location.pathname, { method: 'POST', body: new FormData(modulo) });
        if (!r.ok) throw new Error('Le modifiche al pezzo non si sono salvate: premi «Salva le modifiche» e riprova.');
        modificato = false;
      }
      for (const [i, { file: f, extra }] of lista.entries()) {
        await carica(box.dataset.file!, f, { pezzo: box.dataset.pezzo!, ...extra }, (q) => {
          barra!.value = Math.round(((i + q) / lista.length) * 100);
          stato!.textContent = `Carico «${f.name}»${lista.length > 1 ? ` (${i + 1} di ${lista.length})` : ''}: ${Math.round(q * 100)}%`;
        });
      }
      stato!.textContent = 'Caricato. Aggiorno la pagina…';
      location.href = `${box.dataset.ritorno}&ok=1&caricato=1&in=${dove}&esito=${encodeURIComponent(lista.length === 1 ? `«${lista[0].file.name}» caricato.` : `${lista.length} file caricati.`)}#${dove}`;
    } catch (e) {
      stato!.textContent = `Caricamento non riuscito: ${(e as Error).message}`;
      barra!.value = 0;
      blocca(false);
    }
  }

  box?.querySelectorAll<HTMLInputElement>('input[type=file][data-uso=spartito]').forEach((input) => input.addEventListener('change', () => {
    const file = [...(input.files ?? [])];
    if (file.length) caricaTutti(file.map((f) => ({ file: f, extra: { uso: 'spartito' } })), input.closest('.carica')!, 'spartiti');
  }));

  // Tracce: il gruppo (titolo e brani) viene dal modulo in cui sta il pulsante
  let gruppo: HTMLFormElement | undefined;
  let scelti: File[] = [];
  box?.querySelectorAll<HTMLInputElement>('input[type=file][data-uso=traccia]').forEach((input) => input.addEventListener('change', () => {
    const file = [...(input.files ?? [])];
    input.value = '';
    if (!file.length || !scelta || !elencoVoci || !modello) return;
    gruppo = input.form!;
    const titolo = gruppo.querySelector<HTMLInputElement>('input[name=gruppo]')!;
    if (!titolo.value.trim()) { alert('Scrivi prima il titolo del gruppo di tracce, per esempio «Opera intera».'); titolo.focus(); return; }
    scelti = file;
    elencoVoci.innerHTML = '';
    for (const f of file) {
      const riga = modello.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      riga.querySelector('.nome-file')!.textContent = f.name;
      const voce = riga.querySelector<HTMLSelectElement>('select[data-voce]')!;
      const indovinata = indovinaVoce(f.name, voci);
      voce.value = indovinata ?? voci[0]?.nome ?? '';
      if (!indovinata) riga.classList.add('da-scegliere');
      elencoVoci.append(riga);
    }
    gruppo.after(scelta);
    scelta.hidden = false;
    preparaTendine(scelta);
    scelta.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }));
  scelta?.querySelector('.annulla-tracce')?.addEventListener('click', () => { scelta.hidden = true; scelti = []; });
  scelta?.querySelector('.carica-tracce')?.addEventListener('click', () => {
    if (!gruppo || !scelti.length) return;
    const titolo = gruppo.querySelector<HTMLInputElement>('input[name=gruppo]')!.value.trim();
    const brani = [...gruppo.querySelectorAll<HTMLInputElement>('input[name=brano]:checked')].map((c) => c.closest('label')!.textContent!.trim()).join('\n');
    const righe = [...elencoVoci!.children];
    const lista = scelti.map((f, i) => {
      const r = righe[i];
      const voce = r.querySelector<HTMLSelectElement>('select[data-voce]')!.value;
      return { file: f, extra: { uso: 'traccia', titolo, brani, voce, voceNuova: r.querySelector<HTMLInputElement>('input[name=voce-nuova]')!.value, sezioneNuova: r.querySelector<HTMLSelectElement>('select[name=sezione-nuova]')!.value } };
    });
    if (lista.some((x) => x.extra.voce === 'altra' && !x.extra.voceNuova.trim())) { alert('Scrivi il nome della voce nuova.'); return; }
    caricaTutti(lista, scelta!, 'tracce');
  });
</script>

