---
// Area coristi, pagina Repertorio: la scheda di un pezzo (src/area/RepertorioVero.astro), da sola o
// dentro una raccolta. Una riga con autore, titolo, arrangiamento, stato e, se lo spartito è uno
// solo, «Apri lo spartito»; si apre solo se sotto c'è qualcosa. Dal 17/10/2026 (src/area/repertorio.ts)
// tre elenchi indipendenti: le tracce per lo studio a gruppi con un titolo, ognuno con una traccia
// per voce (prima le voci della sezione del corista, in evidenza: per i bassi anche i baritoni),
// gli spartiti con il loro titolo e i brani che contengono, e i brani dell'opera, ognuno con il suo
// spartito alla sua pagina; poi esecuzione di riferimento e note del Maestro. I link arrivano già
// passati dal sito (linkDelSito). ancora = false per le copie di un pezzo che sta in più raccolte:
// l'ancora #<id> (Calendario, Concerti, Registrazioni) va alla prima.
import Icona from '../componenti/Icona.astro';
import { allaPagina, spartitoDi, type Pezzo, type Traccia } from './repertorio';
import { comeHtml } from './testo';

interface Props { p: Pezzo; sezione?: string; ancora?: boolean; cerca: string }
const { p, sezione, ancora = true, cerca } = Astro.props;
const mia = (t: Traccia) => Boolean(sezione && t.sezione === sezione);
// La propria sezione prima, poi le altre nell'ordine del catalogo delle voci
const inOrdine = (tracce: Traccia[]) => [...tracce.filter(mia), ...tracce.filter((t) => !mia(t))];
const tua = p.tracce.some((g) => g.tracce.some(mia));
const nTracce = p.tracce.reduce((n, g) => n + g.tracce.length, 0);
// Lo spartito di un solo brano si apre dall'elenco dei brani: tra gli spartiti restano gli altri
// (partitura completa, volumi); se ne resta uno, è il pulsante «Apri lo spartito»
const generali = p.spartiti.filter((s) => s.brani.length !== 1 || !p.brani.some((b) => b.nome === s.brani[0].nome));
const unico = generali.length === 1 ? generali[0] : undefined;
const quante = (n: number, uno: string, tanti: string) => n && `${n} ${n === 1 ? uno : tanti}`;
const espandibile = Boolean(nTracce || generali.length > 1 || p.brani.length || p.esecuzione || p.note);
const Riga = espandibile ? 'details' : 'div';
const Testa = espandibile ? 'summary' : 'div';
const file = (link: string) => link.startsWith('/area/file/') || link.startsWith('/maestro/file/');
---

<Riga class:list={['opera-studio', { fisso: !espandibile }]} id={ancora ? p.id : undefined} data-pezzo={p.id} data-cerca={cerca}>
  <Testa class="intest">
    <div class="testo-pezzo">
      {p.autore && <span class="aut">{p.autore}</span>}
      <h2 style="margin-top:6px">{p.titolo}</h2>
      {p.arrangiatore && <span class="arr">arr. {p.arrangiatore}</span>}
      <span class="tenue indicatori">{[tua && 'la tua traccia', generali.length > 1 && quante(generali.length, 'spartito', 'spartiti'), quante(p.brani.length, 'brano', 'brani'), quante(nTracce, 'traccia', 'tracce'), p.note && 'note del Maestro'].filter(Boolean).join(' · ') || (p.spartiti.length ? '' : 'materiali in arrivo')}</span>
    </div>
    <div class="lato-pezzo">
      <span class:list={['tag', { grigio: p.stato !== 'In studio' }]}>{p.stato}</span>
      {unico && <a class="btn piccolo" href={unico.link} target="_blank" rel="noopener"><Icona nome="documento" />Apri lo spartito</a>}
    </div>
  </Testa>
  {espandibile && (
    <div class="corpo-o">
      {(nTracce > 0 || p.esecuzione) && (
        <div class="colonna">
          {nTracce > 0 && <h3>Tracce per lo studio</h3>}
          {p.tracce.map((g) => (
            <div class="gruppo-tracce">
              {(p.tracce.length > 1 || g.brani.length > 0 || g.titolo !== 'Tracce') && (
                <p class="titolo-gruppo"><b>{g.titolo}</b>{g.brani.length > 0 && <small>{g.brani.join(' · ')}</small>}</p>
              )}
              <div class="basi">
                {inOrdine(g.tracce).map((t) => (
                  <div class:list={['base', { tua: mia(t) }]}>
                    <div><b>{t.voce}{mia(t) && <span class="tag" style="margin-left:6px">La tua sezione</span>}</b></div>
                    {file(t.link)
                      ? <audio controls preload="none" src={t.link} aria-label={`Traccia ${t.voce}: ${g.titolo}`}></audio>
                      : <div class="az-base"><a href={t.link} target="_blank" rel="noopener" aria-label={`Apri la traccia ${t.voce}: ${g.titolo}`}><Icona nome="play" /></a></div>}
                  </div>
                ))}
              </div>
            </div>
          ))}
          {p.esecuzione && (
            <>
              <h3 style={nTracce ? 'margin-top:28px' : undefined}>Esecuzione di riferimento</h3>
              <a class="btn o piccolo" href={p.esecuzione} target="_blank" rel="noopener"><Icona nome="cuffie" />Ascolta</a>
            </>
          )}
        </div>
      )}
      {(generali.length > 1 || p.brani.length > 0 || p.note) && (
        <div class="colonna">
          {generali.length > 1 && (
            <>
              <h3>Spartiti</h3>
              <div class="parti">
                {generali.map((s) => (
                  <a class="parte-spartito parte" href={s.link} target="_blank" rel="noopener">
                    <span class="icona-q"><Icona nome="documento" classe="" /></span>
                    <span><b>{s.titolo}</b>{s.brani.length > 0 && <small>{s.brani.map((b) => b.nome).join(' · ')}</small>}</span>
                    <Icona nome="esterno" />
                  </a>
                ))}
              </div>
            </>
          )}
          {p.brani.length > 0 && (
            <>
              <h3 style={generali.length > 1 ? 'margin-top:28px' : undefined}>Brani</h3>
              <ol class="brani-opera">
                {p.brani.map((b) => {
                  const s = spartitoDi(p, b.nome);
                  return (
                    <li>
                      {s ? (
                        <a href={allaPagina(s.spartito.link, s.pagina)} target="_blank" rel="noopener" title={`Spartito: ${s.spartito.titolo}${s.pagina ? `, pagina ${s.pagina}` : ''}`}>
                          <span>{b.nome}</span><small>{s.pagina ? `${s.spartito.brani.length > 1 && generali.length > 1 ? `${s.spartito.titolo}, ` : ''}p. ${s.pagina}` : s.spartito.brani.length > 1 ? s.spartito.titolo : 'spartito'}</small>
                        </a>
                      ) : <span class="senza"><span>{b.nome}</span></span>}
                    </li>
                  );
                })}
              </ol>
            </>
          )}
          {p.note && (
            <div class="nota-maestro" style={p.brani.length || generali.length > 1 ? undefined : 'margin-top:0'}>
              <span class="eti">Note del Maestro</span>
              <div set:html={comeHtml(p.note)} />
            </div>
          )}
        </div>
      )}
    </div>
  )}
</Riga>

<style>
  /* Una riga per pezzo, che si apre */
  .opera-studio + .opera-studio { margin-top: 10px; }
  .opera-studio > .intest { padding: 18px 22px; border-bottom: 0; scroll-margin-top: 150px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 20px; align-items: stretch; }
  .opera-studio > summary { cursor: pointer; list-style: none; }
  .opera-studio { scroll-margin-top: 150px; }
  .lato-pezzo { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 12px; }
  .lato-pezzo .btn { white-space: nowrap; }
  /* Telefono: stato sempre in alto a destra, pulsante dello spartito sotto il titolo */
  @media (max-width: 560px) {
    .opera-studio > .intest { grid-template-columns: 1fr; position: relative; }
    .lato-pezzo { display: block; }
    .lato-pezzo .tag { position: absolute; top: 18px; right: 22px; }
    .testo-pezzo .aut { display: block; padding-right: 130px; min-height: 1.4em; }
  }
  .opera-studio > summary::-webkit-details-marker { display: none; }
  .opera-studio[open] > summary { border-bottom: 1px solid var(--linea); }
  .opera-studio > .intest h2 { font-size: clamp(22px, 2.4vw, 28px); }
  .opera-studio > summary h2::after { content: ' ▸'; color: var(--tenue); font-size: .7em; }
  .opera-studio[open] > summary h2::after { content: ' ▾'; }
  .arr { display: block; font-size: 14px; font-style: italic; color: var(--tenue); margin-top: 2px; }
  .indicatori { display: block; font-size: 14px; margin-top: 4px; }
  /* Gruppi di tracce: titolo e brani, poi una riga per voce */
  .gruppo-tracce + .gruppo-tracce { margin-top: 18px; }
  .titolo-gruppo { margin: 0 0 8px; display: grid; gap: 2px; }
  .titolo-gruppo b { color: var(--primario); font-size: 16px; }
  .titolo-gruppo small { color: var(--tenue); font-size: 13px; }
  /* Tracce caricate come file: lettore audio nella riga della voce */
  .base:has(audio) { grid-template-columns: minmax(0, 1fr); }
  .base audio { width: 100%; height: 40px; }
  /* Spartiti: titolo e, sotto, i brani che contengono */
  .parti { display: grid; gap: 10px; }
  .parte { border: 1px solid var(--linea); }
  .parte-spartito { display: flex; align-items: center; gap: 14px; padding: 12px 16px; background: var(--bianco); }
  .parte-spartito:hover { background: var(--fondo); }
  .parte-spartito b { display: block; color: var(--primario); font-size: 16px; line-height: 1.2; }
  .parte-spartito small { display: block; color: var(--tenue); font-size: 13px; margin-top: 2px; }
  .parte-spartito > :global(svg:last-child) { margin-left: auto; color: var(--tenue); flex-shrink: 0; }
  /* Brani: uno per riga, ognuno apre il suo spartito alla sua pagina */
  .brani-opera { list-style: none; margin: 0; padding: 0; border: 1px solid var(--linea); background: var(--bianco); }
  .brani-opera li + li { border-top: 1px solid var(--linea); }
  .brani-opera a, .brani-opera .senza { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; min-height: 44px; align-items: center; }
  .brani-opera a { color: var(--primario); font-weight: 600; }
  .brani-opera a:hover { background: var(--fondo); }
  .brani-opera a span { text-decoration: underline; }
  .brani-opera small { color: var(--tenue); font-weight: 400; font-size: 13px; white-space: nowrap; }
  .brani-opera .senza { color: var(--testo); }
</style>
