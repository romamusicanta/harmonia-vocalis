---
// Area coristi, pagina Repertorio: la scheda di un pezzo (src/area/RepertorioVero.astro), da sola o
// dentro una raccolta. Una riga con autore, titolo, arrangiamento, stato e «Apri lo spartito», che si
// apre solo se sotto c'è qualcosa: tracce per sezione dell'opera intera (in evidenza quella del
// corista), esecuzione di riferimento, parti dell'opera (movimenti o estratti, ognuna col suo
// spartito e, dal 13/10/2026, le sue tracce) e note del Maestro. ancora = false per le copie di un
// pezzo che sta in più raccolte: l'ancora #<id> (Calendario, Concerti, Registrazioni) va alla prima.
import Icona from '../componenti/Icona.astro';
import type { Pezzo, Traccia } from './repertorio';
import { comeHtml } from './testo';

interface Props { p: Pezzo; sezione?: string; ancora?: boolean; cerca: string }
const { p, sezione, ancora = true, cerca } = Astro.props;
// La propria sezione prima, poi le altre nell'ordine del coro
const inOrdine = (tracce: Traccia[]) => [...tracce.filter((t) => t.sezione === sezione), ...tracce.filter((t) => t.sezione !== sezione)];
const conTracceParti = p.brani.some((b) => b.tracce.length);
const tua = p.tracce.some((t) => t.sezione === sezione) || p.brani.some((b) => b.tracce.some((t) => t.sezione === sezione));
const espandibile = Boolean(p.tracce.length || p.brani.length || p.esecuzione || p.note);
const Riga = espandibile ? 'details' : 'div';
const Testa = espandibile ? 'summary' : 'div';
---

<Riga class:list={['opera-studio', { fisso: !espandibile }]} id={ancora ? p.id : undefined} data-pezzo={p.id} data-cerca={cerca}>
  <Testa class="intest">
    <div class="testo-pezzo">
      {p.autore && <span class="aut">{p.autore}</span>}
      <h2 style="margin-top:6px">{p.titolo}</h2>
      {p.arrangiatore && <span class="arr">arr. {p.arrangiatore}</span>}
      <span class="tenue indicatori">{[tua && 'la tua traccia', p.tracce.length && `${p.tracce.length} ${p.tracce.length === 1 ? 'traccia' : 'tracce'}`, p.brani.length && `${p.brani.length} ${p.brani.length === 1 ? 'parte' : 'parti'}`, conTracceParti && 'tracce delle parti', p.note && 'note del Maestro'].filter(Boolean).join(' · ') || (p.spartito ? '' : 'materiali in arrivo')}</span>
    </div>
    <div class="lato-pezzo">
      <span class:list={['tag', { grigio: p.stato !== 'In studio' }]}>{p.stato}</span>
      {p.spartito && <a class="btn piccolo" href={p.spartito} target="_blank" rel="noopener"><Icona nome="documento" />Apri lo spartito</a>}
    </div>
  </Testa>
  {espandibile && (
    <div class="corpo-o">
      {(p.tracce.length > 0 || p.esecuzione) && (
        <div class="colonna">
          {p.tracce.length > 0 && (
            <>
              <h3>Tracce per lo studio{p.brani.length > 0 && ' · opera intera'}</h3>
              <div class="basi">
                {inOrdine(p.tracce).map((t) => (
                  <div class:list={['base', { tua: t.sezione === sezione }]}>
                    <div><b>{t.sezione}{t.sezione === sezione && <span class="tag" style="margin-left:6px">La tua sezione</span>}</b></div>
                    {t.link.startsWith('/area/file/')
                      ? <audio controls preload="none" src={t.link} aria-label={`Traccia: ${t.sezione}`}></audio>
                      : <div class="az-base"><a href={t.link} target="_blank" rel="noopener" aria-label={`Apri le tracce: ${t.sezione}`}><Icona nome="play" /></a></div>}
                  </div>
                ))}
              </div>
            </>
          )}
          {p.esecuzione && (
            <>
              <h3 style={p.tracce.length ? 'margin-top:28px' : undefined}>Esecuzione di riferimento</h3>
              <a class="btn o piccolo" href={p.esecuzione} target="_blank" rel="noopener"><Icona nome="cuffie" />Ascolta</a>
            </>
          )}
        </div>
      )}
      {(p.brani.length > 0 || p.note) && (
        <div class="colonna">
          {p.brani.length > 0 && (
            <>
              <h3>Parti dell'opera</h3>
              <div class="parti">
                {p.brani.map((b) => (
                  <div class="parte">
                    <a class="parte-spartito" href={b.link} target="_blank" rel="noopener"><span class="icona-q"><Icona nome="documento" classe="" /></span><b>{b.nome}</b><Icona nome="esterno" /></a>
                    {b.tracce.length > 0 && (
                      <div class="basi tracce-parte">
                        {inOrdine(b.tracce).map((t) => (
                          <div class:list={['base', { tua: t.sezione === sezione }]}>
                            <div><b>{t.sezione}</b></div>
                            <audio controls preload="none" src={t.link} aria-label={`Traccia ${t.sezione}: ${b.nome}`}></audio>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </>
          )}
          {p.note && (
            <div class="nota-maestro" style={p.brani.length ? undefined : 'margin-top:0'}>
              <span class="eti">Note del Maestro</span>
              <div set:html={comeHtml(p.note)} />
            </div>
          )}
        </div>
      )}
    </div>
  )}
</Riga>

<style>
  /* Una riga per pezzo, che si apre */
  .opera-studio + .opera-studio { margin-top: 10px; }
  .opera-studio > .intest { padding: 18px 22px; border-bottom: 0; scroll-margin-top: 150px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 20px; align-items: stretch; }
  .opera-studio > summary { cursor: pointer; list-style: none; }
  .opera-studio { scroll-margin-top: 150px; }
  .lato-pezzo { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 12px; }
  .lato-pezzo .btn { white-space: nowrap; }
  /* Telefono: stato sempre in alto a destra, pulsante dello spartito sotto il titolo */
  @media (max-width: 560px) {
    .opera-studio > .intest { grid-template-columns: 1fr; position: relative; }
    .lato-pezzo { display: block; }
    .lato-pezzo .tag { position: absolute; top: 18px; right: 22px; }
    .testo-pezzo .aut { display: block; padding-right: 130px; min-height: 1.4em; }
  }
  .opera-studio > summary::-webkit-details-marker { display: none; }
  .opera-studio[open] > summary { border-bottom: 1px solid var(--linea); }
  .opera-studio > .intest h2 { font-size: clamp(22px, 2.4vw, 28px); }
  .opera-studio > summary h2::after { content: ' ▸'; color: var(--tenue); font-size: .7em; }
  .opera-studio[open] > summary h2::after { content: ' ▾'; }
  .arr { display: block; font-size: 14px; font-style: italic; color: var(--tenue); margin-top: 2px; }
  .indicatori { display: block; font-size: 14px; margin-top: 4px; }
  /* Tracce caricate come file: lettore audio nella riga della sezione */
  .base:has(audio) { grid-template-columns: minmax(0, 1fr); }
  .base audio { width: 100%; height: 40px; }
  /* Parti: lo spartito, e sotto le tracce della parte se ci sono */
  .parti { display: grid; gap: 10px; }
  .parte { border: 1px solid var(--linea); }
  .parte-spartito { display: flex; align-items: center; gap: 14px; padding: 12px 16px; background: var(--bianco); }
  .parte-spartito:hover { background: var(--fondo); }
  .parte-spartito b { color: var(--primario); font-size: 16px; line-height: 1.2; }
  .parte-spartito > :global(svg:last-child) { margin-left: auto; color: var(--tenue); flex-shrink: 0; }
  .tracce-parte { padding: 0 12px 12px; }
  .tracce-parte .base { padding: 8px 10px; }
</style>
