---
// Concerti: prossimi concerti dal calendario, archivio con filtri per autore e anno.
import ConLink from '../componenti/ConLink.astro';
import type { Veste } from '../motore/aspetto';
import Base from '../layouts/Base.astro';
import Icona from '../componenti/Icona.astro';
import Foto from '../componenti/Foto.astro';
import { Image } from 'astro:assets';
import { immagine } from '../motore/coro';
import { DEMO } from '../motore/coro';
import { contesto } from '../motore/url';
import { archivio, chiaveAutore, linkIscrizioneCalendario, luogoCompleto, parti, perStagione, prossimiConcerti, slug } from '../motore/concerti';
import { vesti } from '../vesti';
import { concertoIn } from '../motore/inglese';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { SchedaConcerto } = vesti[veste];
const { en, l, lingua, coro } = contesto(Astro.url, veste);

const [sigla1, sigla2] = coro.stagione.sigla.split('/');

// In programma
const prossimi = await prossimiConcerti();
const [primo, ...altri] = prossimi;
const prossimo = primo && concertoIn(primo, lingua);
const d = prossimo && parti(prossimo, lingua);
const iscrizione = linkIscrizioneCalendario();

// Archivio: filtri generati dai dati (autori per numero di concerti, "Altri programmi" in fondo; anni dal più recente)
const cognome = (autore: string) => autore.split(/\s+/).at(-1)!;
const conteggio = new Map<string, { nome: string; n: number }>();
for (const c of archivio) {
  if (!c.autore) continue;
  const k = chiaveAutore(c.autore);
  const voce = conteggio.get(k) ?? { nome: cognome(c.autore), n: 0 };
  voce.n++;
  conteggio.set(k, voce);
}
const autori = [...conteggio.entries()].sort((a, b) => b[1].n - a[1].n || a[1].nome.localeCompare(b[1].nome, 'it')).map(([valore, v]) => ({ valore, nome: v.nome }));
if (archivio.some((c) => !c.autore)) autori.push({ valore: 'altri', nome: en ? 'Other programmes' : 'Altri programmi' });
const anni = [...new Set(archivio.map((c) => c.data.slice(0, 4)))].sort().reverse();
const primoAnno = anni.at(-1);
const stagioni = perStagione(archivio.map((c) => concertoIn(c, lingua)), lingua);

const linkVideo = (id: string) => (coro.funzioni.ascolta ? l(`/ascolta#${id}`) : `https://www.youtube.com/watch?v=${id}`);
---

<Base veste={veste} titolo={en ? 'Concerts' : 'Concerti'} pagina="concerti" descrizione={en ? `Upcoming concerts and archive of the programmes performed by the ${coro.nome}.` : `Prossimi concerti e archivio dei programmi eseguiti dal ${coro.nome}.`}>
  <header class="intesta">
    <div class="w due">
      <div>
        <span class="eti" style="margin-bottom:20px">{en ? 'Concerts' : 'Concerti'}</span>
        <h1>{en ? 'Season' : 'Stagione'}<br />{sigla1}{sigla2 && <><span>/</span>{sigla2}</>}<span>.</span></h1>
      </div>
      <div>
        <p class="lead">{en
          ? `The calendar of upcoming concerts and the archive of every programme performed${primoAnno ? ` since ${primoAnno}` : ''}, with recordings where available.`
          : `Il calendario dei prossimi concerti e l'archivio di tutti i programmi eseguiti${primoAnno ? ` dal ${primoAnno}` : ''}, con le registrazioni dove disponibili.`}</p>
        <div class="bottoni" style="margin-top:24px"><a class="btn g" href="#in-programma">{en ? 'Upcoming' : 'In programma'}</a><a class="btn o" href="#archivio">{en ? 'Archive' : 'Archivio'}</a></div>
      </div>
    </div>
  </header>

  <section id="in-programma">
    <div class="w">
      <div class="testa">
        <h2>{en ? 'Upcoming' : 'In programma'}</h2>
        {iscrizione
          ? <a class="btn o" href={iscrizione} target="_blank" rel="noopener"><Icona nome="calendario-piu" />{en ? 'Subscribe to the calendar' : 'Iscriviti al calendario'}</a>
          : DEMO && <a class="btn o" href="#" data-finto-avviso="Nel sito vero apre il calendario Google «Concerti»"><Icona nome="calendario-piu" />Iscriviti al calendario</a>}
      </div>
      {/* Dati: Google Calendar "Concerti" */}
      {prossimo && d ? (
        <article class="in-programma">
          <div class="data">
            <div><div class="num">{d.giorno}</div><div class="mese">{d.mese} {d.anno}<br />{d.giornoSettimana}</div></div>
            <span class="tag blu" style="align-self:start">{en ? 'Next concert' : 'Prossimo concerto'}</span>
          </div>
          <div class="info">
            {prossimo.rassegna && <span class="aut">{prossimo.rassegna}</span>}
            <h3>{prossimo.autore && <>{prossimo.autore}<br /></>}{prossimo.titolo}</h3>
            <ul class="fatti">
              {luogoCompleto(prossimo) && <li><Icona nome="luogo" />{luogoCompleto(prossimo)}</li>}
              <li><Icona nome="orologio" />{d.ora ? (en ? d.ora : `Ore ${d.ora}`) : (en ? 'Time to be confirmed' : 'Orario da definire')}</li>
              {prossimo.organizza && <li><Icona nome="persone" />{en ? 'Organised by' : 'Organizza'}: <ConLink testo={prossimo.organizza} /></li>}
              {prossimo.ingresso && <li><Icona nome="biglietto" /><ConLink testo={prossimo.ingresso} /></li>}
            </ul>
            <div class="bottoni" style="margin-top:auto">
              <a class="btn" href={l(`/concerti/${slug(prossimo)}`)}>{en ? 'Details' : 'Dettagli'} <Icona nome="freccia" /></a>
              <a class="btn o" href={l(`/concerti/${slug(prossimo)}#calendario`)}><Icona nome="calendario-piu" />{en ? 'Add to calendar' : 'Aggiungi al calendario'}</a>
            </div>
          </div>
          {/* La locandina intera; senza, la foto del concerto; senza nemmeno quella, la foto di apertura del coro */}
          <div class:list={['foto', { locandina: Boolean(prossimo.locandina) }]}><Foto nome={prossimo.locandina ?? prossimo.foto ?? coro.foto.apertura} alt={prossimo.locandina ? `${en ? 'Poster' : 'Locandina'}: ${prossimo.titolo}, ${d!.giorno} ${d!.mese} ${d!.anno}${luogoCompleto(prossimo) ? `, ${luogoCompleto(prossimo)}` : ''}` : undefined} sizes="(min-width: 900px) 40vw, 100vw" /></div>
        </article>
      ) : (
        <p class="tenue" style="font-size:19px;padding:24px 0">{en ? 'No concerts scheduled yet: the new season is being prepared.' : 'Nessun concerto in calendario per ora: la nuova stagione è in preparazione.'}</p>
      )}
      {altri.length > 0 && (
        <div class="schede" style="margin-top:24px">
          {altri.map((c) => <SchedaConcerto concerto={c} href={l(`/concerti/${slug(c)}`)} etichetta={en ? 'Upcoming' : 'In programma'} azione={en ? 'Details and calendar' : 'Dettagli e calendario'} />)}
        </div>
      )}
      <p class="tenue" style="margin-top:24px;font-size:15px;display:flex;gap:10px;align-items:flex-start">
        <Icona nome="info" />
        <span>{en
          ? <>The season’s other dates will appear here as soon as they are confirmed.{(iscrizione || DEMO) && ' To keep up, subscribe to the calendar: it updates itself on your phone.'}</>
          : <>Gli altri appuntamenti della stagione compariranno qui appena confermati.{(iscrizione || DEMO) && ' Per non perderli, iscriviti al calendario: si aggiorna da solo sul telefono.'}</>}</span>
      </p>
    </div>
  </section>

  <section id="archivio" style="background:var(--fondo)">
    <div class="w">
      <div class="testa"><h2>{en ? 'Archive' : 'Archivio'}</h2><p>{en ? 'Programmes performed from the first season to today. The title opens the concert page, the play button the full recording on our channel.' : 'Programmi eseguiti dalla prima stagione a oggi. Il titolo apre la scheda del concerto, il pulsante play la registrazione integrale sul nostro canale.'}</p></div>
      <div class="filtri" data-filtri="#elenco-archivio">
        <div class="gruppo"><span>{en ? 'Composer' : 'Autore'}</span>
          <button class="chip on" type="button" data-filtro="autore" data-valore="tutti">{en ? 'All' : 'Tutti'}</button>
          {autori.map((a) => <button class="chip" type="button" data-filtro="autore" data-valore={a.valore}>{a.nome}</button>)}
        </div>
        <div class="gruppo"><span>{en ? 'Year' : 'Anno'}</span>
          <button class="chip on" type="button" data-filtro="anno" data-valore="tutti">{en ? 'All' : 'Tutti'}</button>
          {anni.map((a) => <button class="chip" type="button" data-filtro="anno" data-valore={a}>{a}</button>)}
        </div>
      </div>
      {/* Dati: eventi passati del calendario "Concerti", con gli ID dei video YouTube (riga Video:) */}
      <div id="elenco-archivio">
        {stagioni.map(({ stagione: s, concerti }) => (
          <div class="stag" data-gruppo id={s.id}>
            <div class="stag-testa"><h3>{s.sigla.split('/')[0]}<span aria-hidden="true">/</span><span class="sr"> </span>{s.sigla.split('/')[1]}</h3><small>{s.nome}</small></div>
            {concerti.map((c) => {
              const p = parti(c, lingua);
              const dove = [c.luogo, c.rassegna].filter(Boolean).join(' · ');
              return (
                <div class="riga" data-voce data-autore={chiaveAutore(c.autore)} data-anno={c.data.slice(0, 4)}>
                  {p.incerta
                    ? <span class="quando anno">{p.anno}<small>{en ? 'date to be confirmed' : 'data da precisare'}</small></span>
                    : <span class="quando">{p.giorno}<small>{p.meseBreve} {p.anno}</small></span>}
                  <div class="cosa con-mini">
                    {/* Miniatura della locandina: Astro ne fa alla build un file piccolo (64 e 128 px di larghezza, WebP) */}
                    {c.locandina
                      ? (p.incerta
                        ? <span class="mini"><Image src={immagine(c.locandina)} alt="" width={128} widths={[64, 128]} sizes="64px" loading="lazy" /></span>
                        : <a class="mini" href={l(`/concerti/${slug(c)}`)} tabindex="-1" aria-hidden="true"><Image src={immagine(c.locandina)} alt="" width={128} widths={[64, 128]} sizes="64px" loading="lazy" /></a>)
                      : <span class="mini vuota" aria-hidden="true"></span>}
                    <div>
                      {c.autore && <span class="aut">{c.autore}</span>}
                      {p.incerta ? <b>{c.titolo}</b> : <b><a href={l(`/concerti/${slug(c)}`)}>{c.titolo}</a></b>}
                      {c.evidenza && <span class="tag" style="margin-top:8px">{c.evidenza}</span>}
                    </div>
                  </div>
                  <span class="dove">{dove ? <><Icona nome="luogo" />{dove}</> : <span class="tenue" style="font-size:14px">{en ? 'Venue not given' : 'Luogo non indicato'}</span>}</span>
                  <span class="azione">{c.video && <a href={p.incerta ? linkVideo(c.video) : l(`/concerti/${slug(c)}#registrazione`)}><Icona nome="play" />{en ? 'Watch the video' : 'Guarda il video'}</a>}</span>
                </div>
              );
            })}
          </div>
        ))}
        <p class="nessun-risultato nascosto">{en ? 'No concert matches the chosen filters.' : 'Nessun concerto corrisponde ai filtri scelti.'}</p>
      </div>
    </div>
  </section>

  {coro.funzioni.organizzatori && (
    <section class="segui">
      <div class="w"><h2>{en ? 'Organising a concert series?' : 'Organizzi una rassegna?'}</h2><div class="bottoni"><a class="btn" href={l('/organizzatori')}>{en ? 'For organisers' : 'Per gli organizzatori'}</a><a class="btn o" href={l('/contatti')}>{en ? 'Write to us' : 'Scrivici'}</a></div></div>
    </section>
  )}
</Base>

<style>
  /* Miniatura della locandina accanto al titolo, intera (le locandine non si ritagliano) */
  .con-mini { display: flex; gap: 14px; align-items: flex-start; }
  .con-mini > div { min-width: 0; }
  .mini { flex: 0 0 auto; width: 52px; aspect-ratio: 3 / 4; border-radius: 4px; overflow: hidden; background: var(--bianco); box-shadow: 0 1px 3px rgb(0 0 0 / .12); display: block; }
  .mini :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mini.vuota { background: transparent; box-shadow: inset 0 0 0 1px var(--linea); }
  @media (max-width: 520px) { .mini { width: 44px; } }
</style>
