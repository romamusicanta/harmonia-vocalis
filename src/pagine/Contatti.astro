---
// Pagina "Contatti": modulo (solo nella demo), email, sedi, canali social, privacy in breve.
import type { Veste } from '../motore/aspetto';
import Base from '../layouts/Base.astro';
import Icona from '../componenti/Icona.astro';
import { DEMO } from '../motore/coro';
import { contesto } from '../motore/url';
import { linkMappa } from '../motore/concerti';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { en, l, lingua, coro } = contesto(Astro.url, veste);

const argomenti = [
  'Informazioni su un concerto',
  coro.funzioni.cantaConNoi && 'Vorrei entrare nel coro',
  coro.funzioni.organizzatori && 'Proposta di concerto / ingaggio',
  'Altro',
].filter(Boolean) as string[];

const { sede, prove } = coro;
// Nome del canale YouTube: "@coroesempio", o l'indirizzo senza protocollo
const canale = coro.link.youtube && (coro.link.youtubeCanale ?? coro.link.youtube.replace(/^https?:\/\/(www\.)?/, ''));
const profiloInstagram = coro.link.instagram && `@${coro.link.instagram.replace(/\/+$/, '').split('/').at(-1)}`;
---

<Base veste={veste} titolo={en ? 'Contact' : 'Contatti'} descrizione={en ? `How to contact the ${coro.nome}: email, office and rehearsals in Rome.` : `Come contattare il ${coro.nome}: email, sede e prove a ${coro.citta}.`} pagina="contatti">
  <header class="intesta">
    <div class="w due">
      <div>
        <span class="eti" style="margin-bottom:20px">{en ? 'Contact' : 'Contatti'}</span>
        <h1>{en ? 'Write to us' : 'Scrivici'}<span>.</span></h1>
      </div>
      <p class="lead">{en
        ? <>For information about our concerts{coro.funzioni.cantaConNoi && ', to join the choir'}{coro.funzioni.organizzatori && ' or to invite us to sing'}. We reply from the {coro.associazione ? 'association’s' : 'choir’s'} mailbox, and English is welcome.</>
        : <>Per informazioni sui concerti{coro.funzioni.cantaConNoi && ', per entrare nel coro'}{coro.funzioni.organizzatori && ' o per invitarci a cantare'}. Rispondiamo dalla casella {coro.associazione ? 'dell’associazione' : 'del coro'}.</>}</p>
    </div>
  </header>

  <section>
    <div class="w">
      <div class="due-col">
        <div>
          {DEMO ? (
            // DA FARE: servizio di invio dei moduli. Per ora il modulo esiste solo nella demo.
            <>
              <div class="testa"><h2 class="h-media">Modulo di contatto</h2></div>
              <form class="modulo" data-finto>
                <div class="riga-campi">
                  <div class="campo"><label for="c-nome">Nome e cognome</label><input id="c-nome" name="nome" autocomplete="name" required /></div>
                  <div class="campo"><label for="c-email">Email</label><input id="c-email" type="email" name="email" autocomplete="email" required /></div>
                </div>
                <div class="campo"><label for="c-motivo">Argomento</label>
                  <select id="c-motivo" name="argomento">{argomenti.map((a) => <option>{a}</option>)}</select>
                </div>
                <div class="campo"><label for="c-msg">Messaggio</label><textarea id="c-msg" name="messaggio" required></textarea></div>
                <label class="consenso"><input type="checkbox" required /><span>Ho letto l'<a href={l('/privacy')}>informativa privacy</a> e acconsento al trattamento dei dati per ricevere una risposta.</span></label>
                <div><button class="btn" type="submit">Invia <Icona nome="freccia" /></button></div>
                <div class="conferma" role="status"><b>Messaggio inviato, grazie.</b>Ti risponderemo all'indirizzo che hai indicato. (Demo: nessun dato è stato inviato.)</div>
              </form>
            </>
          ) : (
            <>
              <div class="testa"><h2 class="h-media">{en ? 'Send us an email' : 'Scrivici una email'}</h2></div>
              <p class="tenue" style="font-size:19px;margin:0 0 24px;max-width:48ch">{en ? `The quickest way to reach us: write to the ${coro.associazione ? 'association’s' : 'choir’s'} address and we will reply as soon as possible.` : `Il modo più rapido per raggiungerci: scrivi all'indirizzo ${coro.associazione ? 'dell’associazione' : 'del coro'}, ti risponderemo il prima possibile.`}</p>
              <a class="btn" href={`mailto:${coro.email}`}><Icona nome="email" />{coro.email}</a>
            </>
          )}
        </div>

        <aside style="display:grid;gap:20px">
          {/* Dati: coro.email in coro.config.ts. Fuori dalla demo l'email è già nella colonna principale */}
          {DEMO && (
            <div class="riquadro blu">
              <span class="eti gialla">Email</span>
              <a href={`mailto:${coro.email}`} style="font-weight:800;font-size:clamp(18px,2vw,22px);overflow-wrap:anywhere;display:block;margin-bottom:6px">{coro.email}</a>
              <p style="color:var(--primario-chiaro)">{en ? 'The quickest way to reach us.' : 'Il modo più rapido per raggiungerci.'}</p>
            </div>
          )}
          {sede && (
            <div class="riquadro" style="margin:0">
              {/* Dati: coro.sede in coro.config.ts */}
              <span class="eti">{en ? 'Registered office' : 'Sede legale'}</span>
              <p style="font-size:17px;font-weight:600;color:var(--primario)">{sede.nome}</p>
              <p style="font-size:17px">{sede.indirizzo}<br />{sede.cap} {en && sede.citta === 'Roma' ? 'Rome' : sede.citta}</p>
            </div>
          )}
          <div class="riquadro" style="margin:0">
            {/* Dati: coro.prove in coro.config.ts */}
            <span class="eti">{en ? 'Rehearsal venue' : 'Sede delle prove'}</span>
            <p style="font-size:17px;font-weight:600;color:var(--primario)">{prove.nome}</p>
            <p style="font-size:17px">{prove.indirizzo}<br />{prove.cap} {en && prove.citta === 'Roma' ? 'Rome' : prove.citta}</p>
            <p class="tenue" style="margin-top:8px">{prove.orari}</p>
            <a class="link-freccia" style="margin-top:12px" href={linkMappa(`${prove.indirizzo}, ${prove.cap} ${prove.citta}`)} target="_blank" rel="noopener"><Icona nome="mappa" />{en ? 'Open the map' : 'Apri la mappa'}</a>
          </div>
          {coro.link.youtube && (
            <div class="riquadro" style="margin:0;display:flex;gap:16px;align-items:center">
              {/* Dati: coro.link in coro.config.ts */}
              <span class="icona-q g"><Icona nome="youtube" classe="" /></span>
              <div><span class="eti" style="margin-bottom:4px">YouTube</span><a class="link-freccia" href={coro.link.youtube}>{canale} <Icona nome="esterno" /></a></div>
            </div>
          )}
          {coro.link.instagram && (
            <div class="riquadro" style="margin:0;display:flex;gap:16px;align-items:center">
              {/* Dati: coro.link in coro.config.ts */}
              <span class="icona-q g"><Icona nome="instagram" classe="" /></span>
              <div><span class="eti" style="margin-bottom:4px">Instagram</span><a class="link-freccia" href={coro.link.instagram}>{profiloInstagram} <Icona nome="esterno" /></a></div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <section id="privacy" style="background:var(--fondo);padding:64px 0">
    <div class="w stretta">
      <h2 class="h-media" style="margin-bottom:16px">{en ? 'Privacy, in short' : 'Privacy, in breve'}</h2>
      <p class="tenue" style="max-width:70ch">{en ? 'The website uses no profiling cookies. YouTube videos load only when you press play, from the cookie-free domain. The data you send us are used only to reply to you.' : 'Il sito non usa cookie di profilazione. I video di YouTube si caricano solo quando premi play, dal dominio senza cookie. I dati che ci invii servono solo a risponderti.'}</p>
      <a class="link-freccia" style="margin-top:16px" href={l('/privacy')}>{en ? 'Read the full notice' : 'Leggi l\'informativa completa'} <Icona nome="freccia" /></a>
    </div>
  </section>
</Base>
