---
// Informativa privacy: testo in coro/testi/privacy.md, che il coro adatta e fa verificare.
import type { Veste } from '../motore/aspetto';
import Base from '../layouts/Base.astro';

import { contesto } from '../motore/url';
import { testo } from '../motore/testi';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { en, l, lingua, coro } = contesto(Astro.url, veste);

const { dati, Contenuto } = testo<{ titolo?: string; lead?: string }>('privacy', lingua);
const titolo = (dati.titolo ?? 'Privacy').replace(/\.$/, '');
---

<Base veste={veste} titolo="Privacy" pagina="privacy" descrizione={en ? `Privacy notice of the ${coro.nome} website.` : `Informativa privacy del sito del ${coro.nome}.`}>
  {/* Dati: coro/testi/privacy.md (intestazione) */}
  <header class="intesta">
    <div class="w due">
      <div>
        <span class="eti" style="margin-bottom:20px">{en ? 'Notice' : 'Informativa'}</span>
        <h1>{titolo}<span>.</span></h1>
      </div>
      <p class="lead">{dati.lead ?? (en ? `How the ${coro.nome} website handles the data of its visitors and of those who write to us.` : `Come il sito del ${coro.nome} tratta i dati di chi lo visita e di chi ci scrive.`)}</p>
    </div>
  </header>

  <section>
    {/* Dati: coro/testi/privacy.md (corpo) */}
    <div class="w stretta">
      <div class="testo-lungo">
        <Contenuto />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Il primo titolo del Markdown non ha spazio sopra */
  .testo-lungo :global(h2:first-child) { margin-top: 0; }
</style>
