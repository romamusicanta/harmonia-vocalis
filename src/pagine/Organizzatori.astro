---
// Pagina "Per gli organizzatori": numeri, chi siamo, repertorio pronto, video, luoghi, contatti per ingaggi.
import ConLink from '../componenti/ConLink.astro';
import type { Veste } from '../motore/aspetto';
import Base from '../layouts/Base.astro';
import Icona from '../componenti/Icona.astro';
import Video from '../componenti/Video.astro';
import NotaVideo from '../componenti/NotaVideo.astro';
import { DEMO, elencoSezioni } from '../motore/coro';
import { contesto } from '../motore/url';
import { concertoIn, videoIn } from '../motore/inglese';
import { archivio, parti, semplifica } from '../motore/concerti';
import { elencoVideo, titoloCompleto } from '../motore/video';
import { testo } from '../motore/testi';
import { perAutore } from '../motore/autori';
import type { Concerto } from '../motore/tipi';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { en, l, lingua, coro } = contesto(Astro.url, veste);

type Testi = { presentazione: string; repertorio?: string; daSapere: string[] };
const { dati, Contenuto } = testo<Testi>('organizzatori', lingua);
// L'archivio nella lingua della pagina
const arch = archivio.map((c) => concertoIn(c, lingua));

const cognome = (autore?: string) => autore?.split(' ').at(-1);
const conAscolta = coro.funzioni.ascolta;
const video = (await elencoVideo()).map((v) => videoIn(v, lingua));
const videoEsiste = (id?: string) => Boolean(id && video.some((v) => v.id === id));

// ——— Repertorio pronto: un'opera per autore e titolo, dall'archivio ———
// Numero di catalogo in coda al titolo: "Requiem K 626" → "K 626", "Requiem op. 48" → "op. 48"
// (con almeno una cifra: "Te Deum" e "Laudate Dominum" non hanno un numero D)
const CATALOGO = /\s+((?:K|KV|RV|BWV|HWV|D|Hob\.|op\.|Op\.)\s*(?=[\w.\/]*\d)[\w.\/]+(?:\s+n\.\s*\d+)?)$/;
// La stessa opera può avere titoli diversi nei concerti ("Requiem", "Requiem in re minore K 626"):
// si confrontano cognome dell'autore e titolo senza catalogo né tonalità
const TONALITA = /\s+in\s+(?:(?:do|re|mi|fa|sol|la|si)(?:\s*(?:diesis|bemolle|#|b))?\s+(?:maggiore|minore)|[A-G](?:[-\s]?(?:flat|sharp|♭|♯))?\s+(?:major|minor))\b/i;
const chiaveOpera = (autore: string, titolo: string) => semplifica(`${cognome(autore)} ${titolo.replace(CATALOGO, '').replace(TONALITA, '')}`);
type Opera = { autore: string; titolo: string; catalogo?: string; concerti: Concerto[]; video?: string };
const opere = new Map<string, Opera>();
for (const c of arch) {
  if (!c.autore) continue; // i programmi misti senza autore non sono un'opera da proporre
  const chiave = chiaveOpera(c.autore, c.titolo);
  const o = opere.get(chiave) ?? { autore: c.autore, titolo: c.titolo, concerti: [] };
  o.catalogo ??= c.titolo.match(CATALOGO)?.[1];
  o.concerti.push(c);
  if (!o.video && videoEsiste(c.video)) o.video = c.video;
  opere.set(chiave, o);
}
// Le più eseguite prima; a parità, la più recente (l'archivio è già dal più recente)
const repertorio = [...opere.values()].sort((a, b) => b.concerti.length - a.concerti.length);

// Le schede (dal 17/10/2026, richiesta di Mario): tutte le opere «In repertorio» del repertorio dell'area
// riservata, in ordine di cognome dell'autore, scaricate alla build da scripts/scarica-allegati.mjs in
// coro/immagini/drive/repertorio.json, con il titolo così come è scritto lì (anche in inglese); un'opera già
// eseguita prende il video dall'archivio.
// Senza il file (demo, foglio che non risponde) le opere dell'archivio, sempre per autore.
type Pronta = { autore: string; titolo: string; arrangiatore?: string };
const filePronte = import.meta.glob<Pronta[]>('/coro/immagini/drive/repertorio.json', { eager: true, import: 'default' });
const pronte = DEMO ? undefined : Object.values(filePronte)[0];
const perTitolo = (titolo: string) => {
  const k = semplifica(titolo.replace(CATALOGO, '').replace(TONALITA, ''));
  const uguali = repertorio.filter((o) => semplifica(o.titolo.replace(CATALOGO, '').replace(TONALITA, '')) === k);
  return uguali.length === 1 ? uguali[0] : undefined;
};
type Scheda = { autore: string; titolo: string; arrangiatore?: string; eseguita?: Opera };
const inScheda: Scheda[] = (pronte?.length
  ? pronte.map((p) => {
      // Stessa chiave dell'archivio, oppure lo stesso titolo se è uno solo ("Haendel" e "Händel")
      const eseguita = opere.get(chiaveOpera(p.autore, p.titolo)) ?? perTitolo(p.titolo);
      return { ...p, eseguita };
    })
  : repertorio.map((o) => ({ autore: o.autore, titolo: o.titolo, eseguita: o }))
).sort(perAutore);

// ——— Luoghi e rassegne, distinti, dal più recente ———
const distinti = (valori: (string | undefined)[]) => [...new Set(valori.filter((v): v is string => Boolean(v)))];
const luoghi = distinti(arch.map((c) => c.luogo));
const rassegne = distinti(arch.map((c) => c.rassegna));

// ——— Numeri ———
const voci = coro.organico.reduce((n, s) => n + s.voci, 0);
const sezioni = elencoSezioni(coro.organico, lingua);
const primo = arch.at(-1);

// ——— Video: registrazioni legate ai concerti dell'archivio ———
const concertoDelVideo = new Map(arch.filter((c) => c.video).map((c) => [c.video!, c]));
const videoConcerti = video.filter((v) => concertoDelVideo.has(v.id));
const [videoPrincipale, ...altriVideo] = videoConcerti.length ? videoConcerti : video.filter((v) => v.autore !== 'Il coro');
const doveQuando = (id: string) => {
  const c = concertoDelVideo.get(id);
  return c ? [c.luogo, parti(c).anno].filter(Boolean).join(', ') : undefined;
};

// ——— Scheda del coro in PDF ———
const schedaPdf = coro.link.schedaPdf;
const avvisoPdf = 'Nel sito vero scarica la scheda del coro in PDF';
const conScheda = Boolean(schedaPdf) || DEMO;
const oggetto = `?subject=${encodeURIComponent(en ? 'Concert proposal' : 'Proposta di concerto')}`;
---

<Base veste={veste} titolo={en ? 'For organisers' : 'Per gli organizzatori'} descrizione={en ? `Invite the ${coro.nome} to sing: ready repertoire, videos and booking contacts.` : `Invitate il ${coro.nome} a cantare: repertorio pronto, video e contatti per ingaggi.`} pagina="organizzatori">
  {/* Dati: coro/testi/organizzatori.md (presentazione); coro.link.schedaPdf */}
  <header class="intesta blu">
    <div class="w due">
      <div>
        <span class="eti" style="margin-bottom:20px">{en ? 'For organisers' : 'Per gli organizzatori'}</span>
        <h1>{en ? 'We bring the choir to you' : 'Portiamo il coro da voi'}<span>.</span></h1>
      </div>
      <div>
        <p class="lead"><ConLink testo={dati.presentazione} /></p>
        <div class="bottoni" style="margin-top:24px">
          <a class="btn g" href="#contatti-ingaggi"><Icona nome="email" />{en ? 'Ask for a proposal' : 'Chiedi una proposta'}</a>
          {schedaPdf ? (
            <a class="btn oc" href={schedaPdf} download><Icona nome="scarica" />{en ? 'Choir profile (PDF, Italian)' : 'Scheda del coro (PDF)'}</a>
          ) : DEMO && (
            <a class="btn oc" href="#" data-finto-avviso={avvisoPdf}><Icona nome="scarica" />Scheda del coro (PDF)</a>
          )}
        </div>
      </div>
    </div>
  </header>

  {/* Dati: organico in coro.config.ts; opere, luoghi e primo concerto dall'archivio (calendario "Concerti") */}
  <section class="sezione stretta" style="background:var(--primario);padding-top:0">
    <div class="w">
      <div class="numeri" style="background:var(--primario-2);border-color:var(--primario-2)">
        <div class="numero" style="background:var(--primario)"><b style="color:var(--accento)">{voci}</b><span style="color:var(--primario-chiaro)">{en ? 'Voices' : 'Voci'}: {sezioni}</span></div>
        {repertorio.length > 0 && <div class="numero" style="background:var(--primario)"><b style="color:var(--accento)">{repertorio.length}</b><span style="color:var(--primario-chiaro)">{en ? 'Works in the repertoire, already performed in concert' : 'Opere in repertorio, già eseguite in concerto'}</span></div>}
        {luoghi.length > 0 && <div class="numero" style="background:var(--primario)"><b style="color:var(--accento)">{luoghi.length}</b><span style="color:var(--primario-chiaro)">{en ? 'Places where we have sung' : 'Località in cui abbiamo cantato'}</span></div>}
        {primo && <div class="numero" style="background:var(--primario)"><b style="color:var(--accento)">{parti(primo).anno}</b><span style="color:var(--primario-chiaro)">{en ? 'First concert' : 'Primo concerto'}: <em>{primo.titolo}</em>{primo.autore && !primo.titolo.includes(cognome(primo.autore)!) && ` ${en ? 'by' : 'di'} ${cognome(primo.autore)}`}</span></div>}
      </div>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="due-col">
        {/* Dati: coro.config.ts (nome, associazione, direttore) + corpo di coro/testi/organizzatori.md */}
        <div class="testo-lungo">
          <span class="eti" style="margin-bottom:14px">{en ? 'Who we are, in brief' : 'Chi siamo, in breve'}</span>
          {en
            ? <p class="apertura-testo">The {coro.nome} is {coro.associazione ? `the choir of the ${coro.associazione}` : `a ${coro.tipo.toLowerCase()} from ${coro.citta}`}, conducted by Maestro {coro.maestro.nome}.</p>
            : <p class="apertura-testo">Il {coro.nome} è {coro.associazione ? `il coro dell’${coro.associazione}` : `un ${coro.tipo.toLowerCase()} di ${coro.citta}`}, diretto dal M° {coro.maestro.nome}.</p>}
          <Contenuto />
        </div>
        {/* Dati: coro/testi/organizzatori.md (daSapere) */}
        <aside class="riquadro giallo">
          <h3>{en ? 'What we need to know' : 'Cosa ci serve sapere'}</h3>
          <ul class="elenco-puntato" style="font-size:15px;font-weight:500">
            {dati.daSapere.map((r) => <li>{r}</li>)}
          </ul>
          <a class="btn" style="margin-top:20px" href="#contatti-ingaggi">{en ? 'Write to us' : 'Scrivici'}</a>
        </aside>
      </div>
    </div>
  </section>

  {inScheda.length > 0 && (
    <section style="background:var(--fondo)">
      <div class="w">
        <div class="testa"><h2>{en ? 'Ready repertoire' : 'Repertorio pronto'}</h2>{dati.repertorio && <p><ConLink testo={dati.repertorio} /></p>}</div>
        {/* Dati: opere «In repertorio» del foglio "Coristi e assenze" (coro/immagini/drive/repertorio.json), archivio (calendario "Concerti") e canale YouTube */}
        <div class="schede-opere">
          {inScheda.map((o) => {
            // Ogni scheda porta da qualche parte: al video, all'archivio o, se non è ancora stata eseguita, ai contatti
            const conVideo = conAscolta && o.eseguita?.video;
            const [href, azione] = conVideo ? [l(`/ascolta#${o.eseguita!.video}`), en ? 'Listen' : 'Ascolta']
              : o.eseguita ? [l('/concerti#archivio'), en ? 'In the archive' : 'Nell’archivio']
              : ['#contatti-ingaggi', en ? 'Ask for it' : 'Chiedila'];
            return (
              <a class="opera" href={href}>
                <span class="aut">{o.autore}{o.arrangiatore && ` · arr. ${o.arrangiatore}`}</span>
                <h3>{o.titolo}</h3>
                <span class:list={['azione', { ascolto: conVideo }]}>{conVideo && <Icona nome="play" classe="" />}{azione} →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {conAscolta && videoPrincipale && (
    <section class="fascia">
      {/* Dati: canale YouTube, video delle registrazioni dei concerti in archivio */}
      <div class="w due">
        <div>
          <span class="eti gialla" style="margin-bottom:16px">{en ? 'Our best videos' : 'I video migliori'}</span>
          <h2>{en ? 'Hear how we sound' : 'Sentite come suoniamo'}</h2>
          <p>{en ? 'Full live recordings: the quickest way to get an idea.' : 'Registrazioni integrali dal vivo: il modo più rapido per farsi un\'idea.'}</p>
          <a class="btn g" href={l('/ascolta')}>{en ? 'All recordings' : 'Tutte le registrazioni'}</a>
        </div>
        <div>
          <Video video={videoPrincipale} />
          {altriVideo.length > 0 && (
            <div class="lista-mini">
              {altriVideo.slice(0, 2).map((v) => <a href={l(`/ascolta#${v.id}`)}>{titoloCompleto(v)} <em>{doveQuando(v.id) ?? v.pubblicato.slice(0, 4)}</em></a>)}
            </div>
          )}
          <NotaVideo />
        </div>
      </div>
    </section>
  )}

  {luoghi.length > 0 && (
    <section>
      <div class="w">
        <div class="testa"><h2>{en ? 'Where we have sung' : 'Dove abbiamo cantato'}</h2></div>
        {/* Dati: luoghi distinti dell'archivio (calendario "Concerti") */}
        <div style="display:flex;flex-wrap:wrap;gap:10px 12px">
          {luoghi.map((luogo) => <span class="tag bordo" style="font-size:14px;padding:10px 14px">{luogo}</span>)}
        </div>
        <p class="tenue" style="margin-top:20px;font-size:15px">{rassegne.length > 0 && <>{en ? 'Series and events' : 'Rassegne ed eventi'}: {rassegne.join(', ')}. </>}<a class="link-freccia" href={l('/concerti#archivio')}>{en ? 'Full archive' : 'Archivio completo'} <Icona nome="freccia" /></a></p>
      </div>
    </section>
  )}

  <section id="contatti-ingaggi" style="background:var(--fondo)">
    <div class="w">
      <div class="due-col metà">
        {/* Dati: coro.email in coro.config.ts */}
        <div>
          <span class="eti" style="margin-bottom:16px">{en ? 'Booking contacts' : 'Contatti per ingaggi'}</span>
          <h2>{en ? 'Let’s talk' : 'Parliamone'}</h2>
          <p class="tenue" style="font-size:19px;margin:18px 0 28px;max-width:40ch">{en ? 'Tell us the date, venue and programme you have in mind: we will send you a proposal.' : 'Indicate data, luogo e programma che avete in mente: vi mandiamo una proposta.'}</p>
          <div class="bottoni"><a class="btn" href={`mailto:${coro.email}${oggetto}`}><Icona nome="email" />{coro.email}</a></div>
        </div>
        {conScheda && (
          <div class="riquadro bordo" style="display:grid;gap:18px;padding:32px">
            {/* Dati: coro.link.schedaPdf in coro.config.ts */}
            <div style="display:flex;gap:16px;align-items:center"><span class="icona-q g"><Icona nome="documento" classe="" /></span><div><b style="color:var(--primario);font-size:18px;display:block">{en ? 'Choir profile' : 'Scheda del coro'}</b><span class="tenue" style="font-size:14px">{en ? 'Presentation, voices, repertoire, video links · PDF' : 'Presentazione, organico, repertorio, link ai video · PDF'}</span></div></div>
            {schedaPdf
              ? <a class="btn g" href={schedaPdf} download><Icona nome="scarica" />{en ? 'Download the profile' : 'Scarica la scheda'}</a>
              : <a class="btn g" href="#" data-finto-avviso={avvisoPdf}><Icona nome="scarica" />Scarica la scheda</a>}
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
