---
// Pagina "Canta con noi": audizioni, prove, candidatura e domande frequenti.
import ConLink from '../componenti/ConLink.astro';
import type { Veste } from '../motore/aspetto';
import Base from '../layouts/Base.astro';
import Icona from '../componenti/Icona.astro';
import Foto from '../componenti/Foto.astro';
import Video from '../componenti/Video.astro';
import NotaVideo from '../componenti/NotaVideo.astro';
import { AREA_CORISTI, DEMO } from '../motore/coro';
import { contesto } from '../motore/url';
import { videoIn } from '../motore/inglese';
import { linkMappa } from '../motore/concerti';
import { elencoVideo } from '../motore/video';
import { testo } from '../motore/testi';
import { REGISTRI, ETA_MINIMA, MAGGIORE_ETA } from '../motore/candidatura';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { en, l, lingua, coro } = contesto(Astro.url, veste);

type Testi = {
  presentazione: string;
  passi: { titolo: string; testo: string }[];
  domande: { domanda: string; risposta: string }[];
};
const { dati } = testo<Testi>('canta-con-noi', lingua);

// Sezioni vocali: "Soprani" → "Soprano", "Tenori" → "Tenore"
// Sigla dell'organico: Soprani, Contralti, Tenori, Bassi → "SATB"
const sigla = coro.organico.map((s) => (/^(contr|alt)/i.test(s.sezione) ? 'A' : s.sezione.charAt(0).toUpperCase())).join('');
const inLettere = en ? ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'] : ['Nessuna', 'Una', 'Due', 'Tre', 'Quattro', 'Cinque', 'Sei', 'Sette', 'Otto'];
const n = coro.organico.length;
const sezioni = `${inLettere[n] ?? n} ${en ? (n === 1 ? 'section' : 'sections') : n === 1 ? 'sezione' : 'sezioni'}`;
// Le prove come le dice la dichiarazione di impegno del modulo di candidatura
const PROVE = { it: 'tutti i mercoledì e due venerdì al mese, dalle 20:00 alle 22:00', en: 'every Wednesday and two Fridays a month, from 8 to 10 pm' };
const nomeBreve = coro.nome.replace(/^Coro\s+/i, '');
const minuscola = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

const indirizzoProve = `${coro.prove.indirizzo}, ${coro.prove.cap} ${en && coro.prove.citta === 'Roma' ? 'Rome' : coro.prove.citta}`;
const videoInvito = videoIn(coro.funzioni.ascolta ? (await elencoVideo()).find((v) => v.autore === 'Il coro') : undefined, lingua);
---

<Base veste={veste} titolo={en ? 'Sing with us' : 'Canta con noi'} anteprima={coro.foto.prove ?? coro.foto.coro} descrizione={en ? `Open auditions: the ${coro.nome} is looking for new voices in Rome.` : `Audizioni aperte: il ${coro.nome} cerca nuove voci a ${coro.citta}.`} pagina="canta-con-noi">
  {/* Dati: stagione e presentazione da coro.config.ts e coro/testi/canta-con-noi.md; organico e prove da coro.config.ts */}
  <section class="apertura">
    <div class="w">
      <div class="stagione">
        <span class="eti">{en ? 'Open auditions · Season' : 'Audizioni aperte · Stagione'} {coro.stagione.sigla}</span>
        <h1 style="font-size:clamp(32px,4.2vw,54px);line-height:1.05;letter-spacing:-0.012em">{en ? 'Sing with us' : 'Canta con noi'}<span>.</span></h1>
        <div>
          <p><ConLink testo={dati.presentazione} /></p>
          <div class="bottoni" style="margin-top:24px"><a class="btn g" href="#candidatura">{en ? 'Apply' : 'Candidati'}</a><a class="btn o" href="#prove">{en ? 'When we rehearse' : 'Quando proviamo'}</a></div>
        </div>
      </div>
      <div class="blocco-foto" style="min-height:480px;background:var(--accento)">
        <Foto nome={coro.foto.prove ?? coro.foto.coro} alt={en ? (coro.foto.prove ? `The ${coro.nome} at a rehearsal` : `The ${coro.nome}`) : coro.foto.prove ? `Il ${coro.nome} durante una prova` : `Il ${coro.nome}`} caricamento="eager" sizes="(min-width: 980px) 60vw, 100vw" style="mix-blend-mode:multiply;opacity:.55" />
        <div class="scheda" style="background:var(--primario);color:#fff;max-width:340px"><div class="n" style="color:var(--accento)">{sigla}</div><p>{sezioni}, {en ? 'one sound' : 'un solo suono'}<span style="color:var(--primario-chiaro)">{en ? `Rehearsals in Rome, ${minuscola(coro.prove.orari)}` : `Prove a ${coro.prove.citta}, ${minuscola(coro.prove.orari)}`}</span></p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="testa"><h2>{en ? 'What to expect' : 'Cosa ti aspetta'}</h2></div>
      {/* Dati: coro/testi/canta-con-noi.md (passi) */}
      <div class="passi">
        {dati.passi.map((p) => <div class="passo"><h3>{p.titolo}</h3><p>{p.testo}</p></div>)}
      </div>
    </div>
  </section>

  {/* Dati: coro.prove in coro.config.ts (orari, riquadri, sede) */}
  <section class="fascia" id="prove">
    <div class="w due">
      <div>
        <span class="eti gialla" style="margin-bottom:16px">{en ? 'Rehearsals' : 'Le prove'}</span>
        <h2>{en ? 'When we rehearse' : 'Quando proviamo'}</h2>
        <p>{en ? `${coro.prove.orari}, in Rome.` : `${coro.prove.orari}, a ${coro.prove.citta}.`}{AREA_CORISTI && DEMO && ' Le basi per lo studio a casa sono nell’area riservata ai coristi.'}</p>
      </div>
      <div>
        <div class="numeri" style="background:var(--primario-2);border-color:var(--primario-2)">
          {coro.prove.riquadri.map(([valore, nota]) => (
            <div class="numero" style="background:var(--primario)"><b style="color:var(--accento)">{valore}</b><span style="color:var(--primario-chiaro)">{nota}</span></div>
          ))}
        </div>
        <p style="display:flex;gap:10px;align-items:flex-start;font-size:16px;margin:20px 0 0;max-width:none"><Icona nome="luogo" classe="" /><span><b style="color:#fff">{coro.prove.nome}</b><br />{indirizzoProve}<br /><a href={linkMappa(indirizzoProve)} target="_blank" rel="noopener" style="color:var(--accento);font-weight:700">{en ? 'Open the map' : 'Apri la mappa'}</a></span></p>
      </div>
    </div>
  </section>

  <section id="candidatura">
    <div class="w">
      <div class="due-col">
        <div>
          <div class="testa"><h2>{en ? 'Apply' : 'Candidati'}</h2></div>
          {/* Modulo di candidatura (dal 25/11/2026): /api/candidatura, src/area/candidature.ts. Nella demo non invia niente */}
          <div class="conferma" id="candidatura-inviata" role="status" tabindex="-1"><b>{en ? 'Thank you, we have received your application.' : 'Grazie, abbiamo ricevuto la tua candidatura.'}</b>{en ? 'We have sent you a confirmation email and will write to you within a few days to arrange the audition.' : 'Ti abbiamo mandato un’email di conferma e ti scriveremo entro pochi giorni per fissare l’audizione.'}{DEMO && ' (Demo: nessun dato è stato inviato.)'}</div>
          <div class="conferma errore-modulo" id="candidatura-errore" role="alert" tabindex="-1"><b>{en ? 'Your application was not sent.' : 'La candidatura non è partita.'}</b><span data-messaggio>{en ? 'Please check the fields and try again, or write to us by email.' : 'Controlla i campi e riprova, oppure scrivici per email.'}</span></div>
          <form class="modulo candidatura" method="post" action="/api/candidatura" data-finto={DEMO ? '#candidatura-inviata' : undefined} data-candidatura={DEMO ? undefined : ''} data-maggiore={MAGGIORE_ETA}>
            <input type="hidden" name="lingua" value={lingua} />
            <input type="hidden" name="iniziato" value="" />
            <div class="nascosto" aria-hidden="true"><label>Sito web <input name="sito" tabindex="-1" autocomplete="off" /></label></div>
            <div class="campo"><label for="cand-nome">{en ? 'Name and surname' : 'Nome e cognome'}</label><input id="cand-nome" name="nome" autocomplete="name" maxlength="100" required /></div>
            <div class="riga-campi">
              <div class="campo">
                <label for="cand-eta">{en ? 'Age' : 'Età'}</label>
                <input id="cand-eta" name="eta" type="number" inputmode="numeric" min={ETA_MINIMA} max="99" required />
                <span class="aiuto" data-minorenne hidden>{en ? 'Under 18: if the audition goes well, we will ask your parents or guardians for their consent.' : 'Minorenne: se l’audizione va bene, chiederemo la delega di chi ne fa le veci.'}</span>
              </div>
              <div class="campo">
                <label for="cand-registro">{en ? 'Voice type' : 'Registro vocale'}</label>
                <select id="cand-registro" name="registro" required>
                  <option value="" disabled selected>{en ? 'Choose…' : 'Scegli…'}</option>
                  {REGISTRI.map((r) => <option value={r.it}>{en ? r.en : r.it}</option>)}
                </select>
                <span class="aiuto">{en ? 'Not sure? Choose “I don’t know”: we will find out at the audition.' : 'Non ne sei sicuro? Scegli «Non lo so»: lo scopriremo all’audizione.'}</span>
              </div>
            </div>
            <div class="campo"><label for="cand-email">Email</label><input id="cand-email" type="email" name="email" autocomplete="email" maxlength="200" required /></div>
            <div class="campo">
              <label for="cand-esp">{en ? 'Previous choral experience' : 'Esperienze corali precedenti'} <small>{en ? '(optional)' : '(facoltativo)'}</small></label>
              <textarea id="cand-esp" name="esperienze" maxlength="3000" placeholder={en ? 'Choirs you have sung in and for how long, music studies, whether you read music… “None” is perfectly fine too.' : 'Cori in cui hai cantato e per quanto tempo, studi musicali, se leggi la musica… Va benissimo anche «nessuna».'}></textarea>
            </div>
            <div class="campo">
              <label for="cand-perche">{en ? `Why would you like to join ${nomeBreve}?` : `Perché vorresti entrare in ${nomeBreve}?`}</label>
              <textarea id="cand-perche" name="motivazione" maxlength="3000" required placeholder={en ? 'We would love to know what motivates you!' : 'Ci farebbe piacere sapere cosa ti motiva!'}></textarea>
            </div>
            <div class="campo impegno">
              <span class="lab">{en ? 'Commitment statement' : 'Dichiarazione di impegno'}</span>
              <label class="consenso"><input type="checkbox" name="impegno" value="sì" required /><span>{en
                ? `I understand that, if my audition is successful, taking part in ${nomeBreve} requires regular attendance at rehearsals (${PROVE.en}), constant individual study of the repertoire and a responsible commitment towards the group. I confirm that I am willing to sustain this commitment seriously and consistently. Applicants under 18 will be asked for the consent of their parents or guardians.`
                : `Sono consapevole che la partecipazione al ${coro.nome}, in caso di esito positivo dell’audizione, richiede una presenza regolare alle prove (${PROVE.it}), uno studio individuale costante del repertorio e un impegno responsabile nei confronti del gruppo. Confermo di essere disponibile a sostenere con serietà e continuità tale impegno. In caso di corista minorenne verrà richiesta una delega alla partecipazione da parte dei genitori o di chi ne fa le veci.`}</span></label>
            </div>
            <label class="consenso"><input type="checkbox" name="privacy" value="sì" required /><span>{en
              ? <>I have read the <a href={l('/privacy')}>privacy notice</a> and agree to the processing of my data so that I can be contacted about the audition.</>
              : <>Ho letto l’<a href={l('/privacy')}>informativa privacy</a> e acconsento al trattamento dei miei dati per essere ricontattato riguardo all’audizione.</>}</span></label>
            <div><button class="btn" type="submit">{en ? 'Send your application' : 'Invia la candidatura'} <Icona nome="freccia" /></button></div>
            <p class="tenue" style="font-size:14px;margin:0">{en ? 'Prefer to write to us?' : 'Preferisci scriverci?'} <a href={`mailto:${coro.email}?subject=${encodeURIComponent(en ? 'Application to the choir' : 'Candidatura al coro')}`} style="color:var(--primario);text-decoration:underline">{coro.email}</a></p>
          </form>
        </div>
        <aside class="appiccicoso">
          {/* Dati: coro/testi/canta-con-noi.md (domande) */}
          <div class="riquadro giallo">
            <h3>{en ? 'Frequently asked questions' : 'Domande frequenti'}</h3>
            <dl style="display:grid;gap:16px;font-size:15px">
              {dati.domande.map((d) => <div><dt style="font-weight:800">{d.domanda}</dt><dd>{d.risposta}</dd></div>)}
            </dl>
          </div>
          {videoInvito && (
            <div style="margin-top:20px">
              {/* Dati: canale YouTube, primo video con autore "Il coro" */}
              <Video video={videoInvito} titolo={en ? `The video “${videoInvito.titolo}”` : `Il video «${videoInvito.titolo}»`} sottotitolo="" piccolo />
              <NotaVideo breve />
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  // Modulo di candidatura (src/area/candidature.ts): invio con fetch, conferma o errore senza
  // ricaricare la pagina; senza JavaScript il modulo parte lo stesso e torna sull'ancora giusta
  const f = document.querySelector<HTMLFormElement>('form.candidatura');
  if (f) {
    const iniziato = f.querySelector<HTMLInputElement>('[name=iniziato]')!;
    iniziato.value = String(Date.now());
    const eta = f.querySelector<HTMLInputElement>('[name=eta]')!;
    const nota = f.querySelector<HTMLElement>('[data-minorenne]')!;
    const maggiore = Number(f.dataset.maggiore);
    eta.addEventListener('input', () => { const n = Number(eta.value); nota.hidden = !(eta.value && n > 0 && n < maggiore); });
  }
  const ok = document.getElementById('candidatura-inviata')!;
  const ko = document.getElementById('candidatura-errore')!;
  const mostra = (box: HTMLElement) => {
    ok.classList.toggle('vista', box === ok);
    ko.classList.toggle('vista', box === ko);
    box.scrollIntoView({ block: 'center', behavior: 'smooth' });
    box.focus({ preventScroll: true });
  };
  if (f?.dataset.candidatura !== undefined) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bottone = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
      bottone.disabled = true;
      try {
        const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.ok) { f.style.display = 'none'; mostra(ok); return; }
        if (d.errore) ko.querySelector('[data-messaggio]')!.textContent = d.errore;
        mostra(ko);
      } catch {
        mostra(ko);
      } finally {
        bottone.disabled = false;
      }
    });
  }
</script>
