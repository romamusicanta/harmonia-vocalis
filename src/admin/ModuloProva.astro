---
// Il modulo di una prova, per crearla (<base>/prove/nuova) o modificarla (<base>/prove/modifica),
// nell'Amministrazione e nell'area del Maestro: invia a <base>/prove/salva e torna all'elenco.
// Convenzione dell'evento in src/admin/prove.ts; i pezzi da scegliere vengono dal repertorio.
import { coro } from '../motore/coro';
import { salaAbituale, SEPARATORE_PEZZI, type Prova } from './prove';
import { nomeCompleto, repertorio, type Pezzo } from '../area/repertorio';
import { fileDellaProva, type Traccia } from '../area/registrazioni';

// titolo e dopo: per una prova nuova creata da un'altra pagina (la prova generale dalla convocazione)
interface Props { prova?: Prova; data?: string; base: '/admin' | '/maestro'; titolo?: string; dopo?: string }
const { prova, data, base, titolo, dopo } = Astro.props;
const r = prova?.righe;
let pezzi: Pezzo[] = [];
try { pezzi = await repertorio(); } catch { /* senza repertorio resta il campo Brani */ }
const scelti = new Set((r?.Repertorio ?? '').split(SEPARATORE_PEZZI).map((x) => x.trim()).filter(Boolean));
// I pezzi scritti nella prova che non sono (più) nel repertorio restano scelti
const altri = [...scelti].filter((x) => !pezzi.some((p) => p.titolo === x));
// Registrazioni: per le prove già fatte, nel modulo di Modifica dell'Amministrazione
const oggi = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Rome' }).format(new Date());
const conRegistrazioni = Boolean(prova && base === '/admin' && prova.data <= oggi);
let registrate: Traccia[] = [];
if (conRegistrazioni) registrate = await fileDellaProva(prova!).catch(() => []);
const peso = (n?: number) => (n ? `${(n / 1024 / 1024).toFixed(1).replace('.', ',')} MB` : '');
---

<form class="modulo" id="modulo-prova" style="max-width:820px;margin-top:28px" novalidate data-base={base} data-dopo={dopo && dopo.startsWith('/admin/') ? dopo : undefined}>
  {prova && <input type="hidden" name="id" value={prova.id} />}
  {prova?.ricorrente && <p class="messaggio">È una data della prova settimanale: le modifiche valgono solo per il {prova.data.split('-').reverse().join('/')}, le altre settimane restano come sono.</p>}

  <h2>Quando e dove</h2>
  <div class="riga-campi">
    <div class="campo"><label for="data">Data</label><input id="data" name="data" type="date" required value={prova?.data ?? data} /></div>
    <div class="campo"><label for="inizio">Inizio</label><input id="inizio" name="inizio" type="time" required value={prova?.inizio ?? '20:00'} /></div>
    <div class="campo"><label for="fine">Fine</label><input id="fine" name="fine" type="time" required value={prova?.fine ?? '22:00'} /></div>
  </div>
  <div class="campo"><label for="titolo">Tipo di prova</label><input id="titolo" name="titolo" list="tipi" placeholder="Prova" value={prova?.titolo ?? titolo ?? 'Prova'} /><span class="aiuto">È il titolo nel calendario dei coristi.</span></div>
  <datalist id="tipi"><option value="Prova" /><option value="Prova supplementare" /><option value="Prova di sezione" /><option value="Prova generale" /><option value="Prova con orchestra" /></datalist>
  <div class="campo"><label for="luogo">Luogo</label><input id="luogo" name="luogo" placeholder={salaAbituale()} value={prova?.luogo} /><span class="aiuto">Vuoto = la sala abituale ({coro.prove.nome}).</span></div>

  <h2>Per i coristi</h2>
  <div class="campo"><label for="sezioni">Sezioni</label><input id="sezioni" name="sezioni" placeholder="Soprani e contralti" value={r?.Sezioni} /><span class="aiuto">Vuoto = tutto il coro.</span></div>
  <fieldset class="campo pezzi-prova">
    <legend>Pezzi del repertorio</legend>
    {pezzi.length || altri.length ? (
      <div class="scelte">
        {pezzi.map((p) => <label><input type="checkbox" name="repertorio" value={p.titolo} checked={scelti.has(p.titolo)} />{nomeCompleto(p)}</label>)}
        {altri.map((x) => <label><input type="checkbox" name="repertorio" value={x} checked />{x}</label>)}
      </div>
    ) : <span class="aiuto">Il repertorio è vuoto: i pezzi si aggiungono dalla pagina Repertorio.</span>}
    <span class="aiuto">Nell'area coristi diventano link a spartiti, tracce e note del pezzo.</span>
  </fieldset>
  <div class="campo"><label for="brani">Brani e passi</label><input id="brani" name="brani" placeholder="Lacrimosa, Domine Jesu: dalla battuta 20" value={r?.Brani} /><span class="aiuto">Cosa si prova in dettaglio, se il Maestro l'ha detto.</span></div>
  <div class="campo"><label for="portare">Portare</label><input id="portare" name="portare" placeholder="Spartito del Requiem, matita" value={r?.Portare} /></div>
  <div class="campo"><label for="note">Note</label><input id="note" name="note" placeholder="Si inizia puntuali: c'è il pianista" value={r?.Note} /></div>
  <div class="campo"><label for="registrazione">Registrazione su YouTube o altro sito <small>(facoltativo)</small></label><input id="registrazione" name="registrazione" type="url" placeholder="https://…" value={r?.Registrazione} /><span class="aiuto">Solo per un link esterno. I file registrati si caricano qui sotto{conRegistrazioni ? '' : ', quando la prova è stata fatta'}.</span></div>
  {prova?.altro && <input type="hidden" name="altro" value={prova.altro} />}

  <div class="bottoni" style="margin-top:12px">
    <button class="btn g" type="submit">{prova ? 'Salva le modifiche' : 'Crea la prova'}</button>
    <a class="btn o" href={`${base}/prove`}>Annulla</a>
    {prova && base === '/admin' && <a class="btn o" href={prova.htmlLink} target="_blank" rel="noopener">Apri nel calendario</a>}
  </div>
  <p id="esito" role="status"></p>
</form>

{conRegistrazioni && (
  <section class="scheda-admin registrazioni-prova" style="max-width:820px;margin-top:28px" data-evento={prova!.id}>
    <h2 style="margin-top:0">Registrazioni della prova</h2>
    <p class="tenue" style="font-size:15px">I coristi le trovano nella pagina Registrazioni. Si possono togliere anche quelle caricate dai coristi.</p>
    {registrate.length ? (
      <ul class="elenco-reg">
        {registrate.map((t) => <li><a href={t.link} target="_blank" rel="noopener">{t.titolo}</a><span class="tenue">{[t.chi, peso(t.dimensione)].filter(Boolean).join(' · ')}</span><button class="btn o piccolo togli-reg" type="button" data-id={t.id}>Togli</button></li>)}
      </ul>
    ) : <p class="tenue">Nessuna registrazione caricata.</p>}
    <div class="campo"><label for="titolo-reg">Titolo <small>(facoltativo; con più file resta il nome di ciascuno)</small></label><input id="titolo-reg" maxlength="120" placeholder="Es. Lacrimosa, tutti" /></div>
    <div class="campo"><label for="file-reg">File audio o video</label><input id="file-reg" type="file" accept="audio/*,video/*,.m4a,.mp3,.wav,.aac,.ogg,.opus,.amr" multiple /></div>
    <div class="avanza-reg" hidden><progress max="100" value="0" aria-label="Caricamento"></progress><small>Tieni aperta questa pagina fino alla fine.</small></div>
    <p class="stato-reg" role="status"></p>
    <button class="btn g" type="button" id="carica-reg" disabled>Carica la registrazione</button>
  </section>
)}

<script>
  const modulo = document.getElementById('modulo-prova') as HTMLFormElement;
  const esito = document.getElementById('esito')!;
  modulo.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const pulsante = modulo.querySelector<HTMLButtonElement>('button[type=submit]')!;
    pulsante.disabled = true;
    esito.className = 'messaggio';
    esito.textContent = 'Salvo nel calendario…';
    try {
      const r = await fetch(`${modulo.dataset.base}/prove/salva`, { method: 'POST', body: new FormData(modulo) });
      const j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
      if (!j.ok) throw new Error(j.errore);
      location.href = modulo.dataset.dopo ?? `${modulo.dataset.base}/prove?salvata=${encodeURIComponent(j.data)}`;
    } catch (e) {
      esito.className = 'messaggio errore';
      esito.textContent = `Non salvata: ${(e as Error).message}`;
      pulsante.disabled = false;
    }
  });
</script>

<script>
  // Registrazioni della prova: caricamento a pezzi e "Togli" (/admin/prove/registrazione)
  import { carica } from '../area/caricamento-client';
  const box = document.querySelector<HTMLElement>('.registrazioni-prova');
  if (box) {
    const input = box.querySelector<HTMLInputElement>('#file-reg')!;
    const pulsante = box.querySelector<HTMLButtonElement>('#carica-reg')!;
    const stato = box.querySelector<HTMLElement>('.stato-reg')!;
    const avanza = box.querySelector<HTMLElement>('.avanza-reg')!;
    const barra = avanza.querySelector('progress')!;
    input.addEventListener('change', () => {
      const n = input.files?.length ?? 0;
      pulsante.disabled = !n;
      pulsante.textContent = n > 1 ? `Carica ${n} registrazioni` : 'Carica la registrazione';
    });
    pulsante.addEventListener('click', async () => {
      const file = [...(input.files ?? [])];
      if (!file.length) return;
      pulsante.disabled = input.disabled = true;
      avanza.hidden = false;
      const titolo = file.length === 1 ? box.querySelector<HTMLInputElement>('#titolo-reg')!.value : '';
      try {
        for (const [i, f] of file.entries()) await carica('/admin/prove/registrazione', f, { evento: box.dataset.evento!, titolo }, (q) => { barra.value = Math.round(((i + q) / file.length) * 100); });
        location.reload();
      } catch (e) {
        stato.textContent = (e as Error).message;
        pulsante.disabled = input.disabled = false;
      }
    });
    box.querySelectorAll<HTMLButtonElement>('.togli-reg').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Togliere questa registrazione? Va nel cestino del Drive del coro.')) return;
      b.disabled = true;
      const r = await fetch('/admin/prove/registrazione', { method: 'POST', headers: { 'x-azione': 'togli', 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.dataset.id }) });
      const j = await r.json().catch(() => ({ ok: false, errore: `errore ${r.status}` }));
      if (j.ok) b.closest('li')!.remove();
      else { stato.textContent = j.errore; b.disabled = false; }
    }));
  }
</script>

<style>
  .elenco-reg { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 6px; }
  .elenco-reg li { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; padding: 10px 12px; background: var(--fondo); border-radius: var(--raggio); }
  .elenco-reg a { font-weight: 600; color: var(--primario); text-decoration: underline; flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; }
  .registrazioni-prova { display: grid; gap: 14px; }
  .registrazioni-prova progress { width: 100%; height: 14px; accent-color: var(--primario); }
  .stato-reg:empty { display: none; }
  .registrazioni-prova #carica-reg { justify-self: start; }
  .pezzi-prova { border: 0; padding: 0; margin: 0; }
  .pezzi-prova legend { font-weight: 700; font-size: 14px; color: var(--primario); margin-bottom: 8px; }
  .pezzi-prova .scelte { display: grid; gap: 6px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .pezzi-prova .scelte label { display: flex; gap: 8px; align-items: center; padding: 8px 10px; background: var(--bianco); border: 1px solid var(--linea); border-radius: var(--raggio); font-weight: 500; }
</style>
