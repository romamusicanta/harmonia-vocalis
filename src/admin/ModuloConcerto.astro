---
// Il modulo di un concerto, per crearlo (/admin/concerti/nuovo → /admin/concerti/crea) o per
// modificarlo (/admin/concerti/modifica → /admin/concerti/aggiorna). "Parti dalla locandina" la fa
// leggere e riempie i campi ancora vuoti (quelli già scritti restano, anche in un concerto nuovo).
// Il browser riduce le immagini prima dell'invio (limite di 4,5 MB per richiesta su Vercel).
import { coro } from '../motore/coro';
import type { DatiConcerto } from './concerto';
import { STATI, passato, type Stato } from './stati';

interface Allegato { title: string; fileUrl: string; fileId?: string }
interface Props {
  valori?: DatiConcerto;
  // In modifica: l'evento e gli allegati attuali
  evento?: { id: string; htmlLink: string; locandina?: Allegato; copertina?: Allegato };
  stato?: Stato;
}
const { valori, evento, stato = 'da-confermare' } = Astro.props;
// Un concerto passato ha lo stato "Passato", ricavato dalla data: lo stato salvato non si cambia più
const giaPassato = Boolean(evento && valori && passato(valori.data));
const v = valori;
const modifica = Boolean(evento);
const ruoli = ['Soprano', 'Mezzosoprano', 'Contralto', 'Tenore', 'Baritono', 'Basso', 'Solisti', 'Orchestra', 'Canta insieme a noi', 'Direttore', 'Maestro del coro', 'Pianoforte', 'Organo', 'Percussioni', 'Voce recitante'];
const opere = v?.opere.length ? v.opere : [{ autore: '', opera: '', operaEn: '', organico: '', organicoEn: '', brani: '' }];
const interpreti = v?.interpreti.length ? v.interpreti : [{ ruolo: '', nome: '' }];
// Anteprima di un allegato attuale, letta da Drive
const anteprima = (a?: Allegato) => a?.fileId && `/admin/drive/immagine?${new URLSearchParams({ id: a.fileId })}`;
---

<div class="scheda-admin" style="max-width:820px;margin-top:28px;border-width:2px;border-color:var(--accento)">
  <b style="color:var(--primario);font-size:19px">Parti dalla locandina</b>
  <p class="tenue" style="font-size:15px;margin:6px 0 14px">{modifica
    ? 'Carica la locandina: diventa la locandina del concerto e il sito la legge per riempire i campi ancora vuoti (quelli già scritti restano). Controlla prima di salvare.'
    : 'Carica la locandina: il sito la legge e riempie i campi vuoti qui sotto (quelli già scritti restano). Controllali sempre prima di creare il concerto, soprattutto data e nomi.'}</p>
  <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
    <label for="leggi-file" class="sr">Locandina da leggere</label><input type="file" id="leggi-file" accept="image/jpeg,image/png,image/webp" />
    <button class="btn g" type="button" id="leggi">Leggi la locandina</button>
  </div>
  <div id="letto" role="status"></div>
</div>

<form class="modulo" id="modulo-concerto" data-modifica={modifica ? '1' : undefined} style="max-width:820px;margin-top:28px" novalidate>
  {evento && <input type="hidden" name="evento" value={evento.id} />}
  <input type="hidden" name="rigaFoto" value={v?.rigaFoto} />
  <input type="hidden" name="rigaLocandina" value={v?.rigaLocandina} />
  <input type="hidden" name="rigaHome" value={v?.rigaHome} />
  <input type="hidden" name="prima" value={JSON.stringify(v?.prima ?? {})} />

  {giaPassato ? (
    <div class="campo stato-concerto">
      <input type="hidden" name="stato" value={stato} />
      <span class="legenda-stato">Stato</span>
      <p style="margin:0"><span class="tag grigio">Passato</span> <span class="tenue">{stato === 'in-cartellone' ? 'È nell’archivio del sito pubblico.' : 'Non è andato in cartellone: non è sul sito pubblico.'}</span></p>
    </div>
  ) : (
  <fieldset class="campo stato-concerto">
    <legend>Stato</legend>
    <div class="scelte-stato">
      {STATI.map((x) => <label><input type="radio" name="stato" value={x.id} checked={x.id === stato} /><span><b>{x.nome}</b><small>{x.aiuto}</small></span></label>)}
    </div>
    <span class="aiuto">Coristi e Maestro vedono il concerto in tutti gli stati. «In cartellone» lo copia nel calendario pubblico "Concerti": compare sul sito alla prossima pubblicazione. Dopo la data diventa da solo «Passato».</span>
  </fieldset>
  )}

  <h2>Quando e dove</h2>
  <div class="riga-campi">
    <div class="campo"><label for="data">Data</label><input id="data" name="data" type="date" required value={v?.data} /></div>
    <div class="campo"><label for="ora">Ora</label><input id="ora" name="ora" type="time" value={v?.ora} /><span class="aiuto">Vuota se l'orario non è ancora deciso: il sito scrive "Orario da definire".</span></div>
  </div>
  <label class="spunta"><input type="checkbox" name="dataIncerta" checked={v?.dataIncerta} /><span><b>Si sa solo l'anno</b><br /><small class="tenue">Per i concerti vecchi: scegli un giorno qualsiasi della stagione giusta. Il sito mostra solo l'anno e non fa la pagina del concerto.</small></span></label>
  <div class="riga-campi">
    <div class="campo"><label for="citta">Città</label><input id="citta" name="citta" placeholder="Rignano Flaminio (RM)" value={v?.citta} /></div>
    <div class="campo"><label for="sala">Sala o chiesa</label><input id="sala" name="sala" placeholder="Chiesa di S. Giuseppe" value={v?.sala} /></div>
  </div>
  <div class="campo"><label for="indirizzo">Indirizzo</label><input id="indirizzo" name="indirizzo" placeholder="Via Carlo Alberto dalla Chiesa 1" value={v?.indirizzo} /><span class="aiuto">Facoltativo: serve per il pulsante "Apri la mappa". Se contiene il CAP, la città si ricava da lì.</span></div>
  <div class="campo"><label for="rassegna">Rassegna o evento</label><input id="rassegna" name="rassegna" placeholder="Autunno Musicale 2026" value={v?.rassegna} /><span class="aiuto">Facoltativo: è il titolo dell'evento nel calendario; senza, si usa l'opera.</span></div>

  <h2>Programma</h2>
  <p class="tenue" style="font-size:15px">I campi «in inglese» sono per la versione inglese del sito: se restano vuoti li scrive il sito al salvataggio, e se cambi l'italiano lasciando l'inglese com'era lo riscrive. Correggili pure a mano: la correzione resta.</p>
  <div id="opere" style="display:grid;gap:14px">
    {opere.map((o, i) => (
      <div class="opera">
        <div class="riga-campi">
          <div class="campo"><label>Autore<input name="autore" placeholder="W. A. Mozart" value={o.autore} /></label></div>
          <div class="campo"><label><span>Opera{i === 0 && <small> (obbligatoria)</small>}</span><input name="opera" required={i === 0} placeholder="Requiem in re minore K 626" value={o.opera} /></label></div>
        </div>
        <div class="campo"><label>Opera in inglese<input name="operaEn" placeholder="Requiem in D minor K. 626" value={o.operaEn} lang="en" /></label></div>
        <div class="riga-campi">
          <div class="campo"><label>Organico <small>(facoltativo)</small><input name="organico" placeholder="per soli, coro e orchestra" value={o.organico} /></label></div>
          <div class="campo"><label>Organico in inglese<input name="organicoEn" placeholder="for soloists, choir and orchestra" value={o.organicoEn} lang="en" /></label></div>
        </div>
        <div class="campo"><label>Brani <small>(facoltativi, separati da virgole)</small><input name="brani" placeholder="Introitus, Kyrie, Dies irae…" value={o.brani} /></label></div>
      </div>
    ))}
  </div>
  <p><button class="btn o" type="button" data-aggiungi="opere">+ Un'altra opera</button></p>

  <h2>Dettagli</h2>
  <div class="riga-campi">
    <div class="campo"><label for="organizza">Organizza</label><input id="organizza" name="organizza" placeholder="Comune di Rignano Flaminio" value={v?.organizza} /></div>
    <div class="campo"><label for="ingresso">Ingresso</label><input id="ingresso" name="ingresso" placeholder="libero" value={v?.ingresso} /></div>
  </div>
  <div class="campo"><label for="ingressoEn">Ingresso in inglese</label><input id="ingressoEn" name="ingressoEn" placeholder="Free admission" value={v?.ingressoEn} lang="en" /></div>
  <div class="campo"><label for="evidenza">In evidenza</label><input id="evidenza" name="evidenza" placeholder="Per gli 800 anni dalla morte di San Francesco d'Assisi" value={v?.evidenza} /><span class="aiuto">Una frase che compare in risalto. Facoltativa.</span></div>
  <div class="campo"><label for="evidenzaEn">In evidenza in inglese</label><input id="evidenzaEn" name="evidenzaEn" placeholder="For the 800th anniversary of the death of Saint Francis of Assisi" value={v?.evidenzaEn} lang="en" /></div>

  <h2>Interpreti</h2>
  <p class="tenue" style="font-size:15px">Il M° {coro.maestro.nome} e il coro compaiono da soli. Aggiungi "Direttore" solo se dirige qualcun altro. Nome vuoto = "da annunciare".</p>
  <datalist id="ruoli">{ruoli.map((r) => <option value={r} />)}</datalist>
  <div id="interpreti" style="display:grid;gap:14px">
    {interpreti.map((x) => (
      <div class="riga-campi interprete">
        <div class="campo"><label>Ruolo<input name="ruolo" list="ruoli" placeholder="Soprano" value={x.ruolo} /></label></div>
        <div class="campo"><label>Nome<input name="nome" placeholder="Maria Rossi" value={x.nome} /></label></div>
      </div>
    ))}
  </div>
  <p><button class="btn o" type="button" data-aggiungi="interpreti">+ Un altro interprete</button></p>

  <div class="campo"><label for="video">Video su YouTube</label><input id="video" name="video" placeholder="https://www.youtube.com/watch?v=…" value={v?.video} /><span class="aiuto">Per un concerto passato con la registrazione sul canale: l'indirizzo del video. Facoltativo.</span></div>

  <h2>Immagini</h2>
  <div class="riga-campi">
    <div class="campo"><label for="locandina">Locandina</label>
      {evento?.locandina && <span style="font-size:15px">Ora: <a href={evento.locandina.fileUrl} target="_blank" rel="noopener" style="text-decoration:underline">{evento.locandina.title}</a></span>}
      {!evento?.locandina && v?.rigaLocandina && <span style="font-size:15px">Ora: {v.rigaLocandina} (nel sito)</span>}
      <div class="anteprime-file" data-tipo="locandina">
        {anteprima(evento?.locandina) && <figure class="attuale"><img src={anteprima(evento?.locandina)} alt="" loading="lazy" /><figcaption>Ora</figcaption></figure>}
        <figure class="da-salvare" data-per="locandina" hidden><img alt="" /><figcaption>{modifica ? 'Nuova, da salvare' : 'Scelta'}</figcaption></figure>
      </div>
      <input id="locandina" name="locandina" type="file" accept="image/jpeg,image/png,image/webp" />
      <span class="aiuto">{modifica ? 'Caricandone una, prende il posto di quella attuale (che resta su Drive).' : 'La locandina ufficiale (JPEG o PNG; un PDF va prima salvato come immagine).'}</span></div>
    <div class="campo"><label for="copertina">Foto principale</label>
      {evento?.copertina && <span style="font-size:15px">Ora: <a href={evento.copertina.fileUrl} target="_blank" rel="noopener" style="text-decoration:underline">{evento.copertina.title}</a></span>}
      {!evento?.copertina && v?.rigaFoto && <span style="font-size:15px">Ora: {v.rigaFoto} (nel sito)</span>}
      <div class="anteprime-file" data-tipo="copertina">
        {anteprima(evento?.copertina) && <figure class="attuale"><img src={anteprima(evento?.copertina)} alt="" loading="lazy" /><figcaption>Ora</figcaption></figure>}
        <figure class="da-salvare" data-per="copertina" hidden><img alt="" /><figcaption>{modifica ? 'Nuova, da salvare' : 'Scelta'}</figcaption></figure>
      </div>
      <input id="copertina" name="copertina" type="file" accept="image/jpeg,image/png,image/webp" />
      <span class="aiuto">Una foto del coro in questo concerto, la più bella: nelle schede prende il posto della locandina. Solo con il consenso delle persone riconoscibili.</span></div>
  </div>

  <div class="bottoni" style="margin-top:12px">
    <button class="btn g" type="submit">{modifica ? 'Salva le modifiche' : 'Crea il concerto'}</button>
    {evento && <a class="btn o" href={evento.htmlLink} target="_blank" rel="noopener">Apri nel calendario</a>}
  </div>
  <p id="esito" role="status"></p>
</form>

<style>
  .anteprime-file { display: flex; flex-wrap: wrap; gap: 12px; }
  .anteprime-file:empty { display: none; }
  .anteprime-file figure { margin: 0; width: 160px; }
  .anteprime-file img { display: block; width: 100%; height: 200px; border-radius: var(--raggio); background: var(--fondo); }
  .anteprime-file[data-tipo='locandina'] img { object-fit: contain; }
  .anteprime-file[data-tipo='copertina'] img { object-fit: cover; }
  .anteprime-file figcaption { font-size: 13px; margin-top: 4px; color: var(--tenue); }
  .anteprime-file .da-salvare figcaption { font-weight: 700; color: var(--primario); }
  .anteprime-file .da-salvare img { outline: 3px solid var(--accento); outline-offset: -3px; }
  .stato-concerto { border: 0; padding: 0; margin: 0 0 8px; }
  .stato-concerto .legenda-stato { display: block; font-weight: 700; font-size: 14px; color: var(--primario); margin-bottom: 8px; }
  .stato-concerto legend { font-weight: 700; font-size: 14px; color: var(--primario); margin-bottom: 8px; }
  .scelte-stato { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .scelte-stato label { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; background: var(--bianco); border: 2px solid var(--linea); border-radius: var(--raggio); cursor: pointer; }
  .scelte-stato label:has(input:checked) { border-color: var(--primario); box-shadow: inset 4px 0 0 var(--accento); }
  .scelte-stato input { margin-top: 3px; }
  .scelte-stato b { display: block; color: var(--primario); }
  .scelte-stato small { color: var(--tenue); font-size: 13px; }
  .spunta { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; margin: -4px 0 8px; }
  .spunta b { color: var(--primario); font-size: 14px; }
  .spunta input { margin-top: 4px; }
  #opere .opera { display: grid; gap: 10px; padding: 14px; background: var(--fondo); border-radius: var(--raggio); }
  #opere .opera .campo { margin: 0; }
  input[lang="en"] { font-style: italic; }
</style>

<script>
  import { riduci } from './immagini';

  const modulo = document.getElementById('modulo-concerto') as HTMLFormElement;
  const modifica = Boolean(modulo.dataset.modifica);
  const esito = document.getElementById('esito')!;
  const letto = document.getElementById('letto')!;

  // Anteprima del file scelto per locandina e foto principale, prima di salvare
  function aggiornaAnteprima(campo: string) {
    const file = (document.getElementById(campo) as HTMLInputElement).files?.[0];
    const figura = document.querySelector<HTMLElement>(`.da-salvare[data-per="${campo}"]`)!;
    const img = figura.querySelector('img')!;
    if (img.src) URL.revokeObjectURL(img.src);
    figura.hidden = !file;
    if (file) img.src = URL.createObjectURL(file);
    else img.removeAttribute('src');
  }
  for (const campo of ['locandina', 'copertina']) document.getElementById(campo)!.addEventListener('change', () => aggiornaAnteprima(campo));

  // Righe ripetibili: si copia la prima, svuotata
  function aggiungiRiga(id: string) {
    const contenitore = document.getElementById(id)!;
    const copia = contenitore.firstElementChild!.cloneNode(true) as HTMLElement;
    copia.querySelectorAll('input').forEach((i) => { i.value = ''; i.required = false; });
    contenitore.append(copia);
    return copia;
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-aggiungi]')) {
    b.addEventListener('click', () => aggiungiRiga(b.dataset.aggiungi!).querySelector('input')!.focus());
  }

  // Righe ripetibili riempite da un elenco: tante righe quanti gli elementi (almeno una)
  function riempiRighe(id: string, elenco: Record<string, string | null>[]) {
    const contenitore = document.getElementById(id)!;
    while (contenitore.children.length > 1) contenitore.lastElementChild!.remove();
    contenitore.querySelectorAll('input').forEach((i) => (i.value = ''));
    elenco.forEach((voce, n) => {
      const riga = n === 0 ? (contenitore.firstElementChild as HTMLElement) : aggiungiRiga(id);
      for (const [campo, valore] of Object.entries(voce)) {
        const input = riga.querySelector<HTMLInputElement>(`[name="${campo}"]`);
        if (input) input.value = valore ?? '';
      }
    });
  }
  const righeVuote = (id: string) => [...document.getElementById(id)!.querySelectorAll('input')].every((i) => !i.value.trim());

  // "Leggi la locandina": i dati letti riempiono il modulo (in modifica solo i campi vuoti),
  // la locandina va nel suo campo
  document.getElementById('leggi')!.addEventListener('click', async () => {
    const file = (document.getElementById('leggi-file') as HTMLInputElement).files?.[0];
    if (!file) return;
    const pulsante = document.getElementById('leggi') as HTMLButtonElement;
    pulsante.disabled = true;
    letto.className = 'messaggio';
    letto.textContent = 'Leggo la locandina… (qualche secondo)';
    try {
      const dati = new FormData();
      dati.set('locandina', await riduci(file));
      const r = await fetch('/admin/concerti/leggi-locandina', { method: 'POST', body: dati });
      const j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
      if (!j.ok) throw new Error(j.errore);
      const d = j.dati;
      // Solo i campi vuoti: quello che si è già scritto non si perde
      for (const campo of ['data', 'ora', 'citta', 'sala', 'indirizzo', 'rassegna', 'organizza', 'ingresso', 'evidenza']) {
        const input = modulo.elements.namedItem(campo) as HTMLInputElement;
        if (!input.value.trim()) input.value = d[campo] ?? input.value;
      }
      if (righeVuote('opere')) riempiRighe('opere', d.opere);
      // Organico e brani letti sono dell'ultima opera
      const ultima = document.getElementById('opere')!.lastElementChild!;
      for (const campo of ['organico', 'brani']) {
        const input = ultima.querySelector<HTMLInputElement>(`[name="${campo}"]`)!;
        if (!input.value.trim()) input.value = d[campo] ?? '';
      }
      if (righeVuote('interpreti')) riempiRighe('interpreti', d.interpreti);
      const dt = new DataTransfer();
      dt.items.add(file);
      (document.getElementById('locandina') as HTMLInputElement).files = dt.files;
      aggiornaAnteprima('locandina');
      const avvisi = [
        ...(!d.locandina ? ['Non sembra la locandina di un concerto.'] : []),
        ...(!d.coroCitato ? ['La locandina non nomina il coro: sei sicuro che sia un nostro concerto?'] : []),
        ...d.dubbi,
      ];
      letto.className = `messaggio ${avvisi.length ? 'errore' : 'ok'}`;
      letto.innerHTML = `<b>Campi vuoti riempiti dalla locandina (quelli già scritti restano): controllali.</b>` + (avvisi.length ? `<ul style="margin:8px 0 0 18px">${avvisi.map((a: string) => `<li>${a.replace(/</g, '&lt;')}</li>`).join('')}</ul>` : '');
    } catch (e) {
      letto.className = 'messaggio errore';
      letto.textContent = `Non letta: ${(e as Error).message}`;
    } finally {
      pulsante.disabled = false;
    }
  });

  function mostra(html: string, classe: string) {
    esito.className = `messaggio ${classe}`;
    esito.innerHTML = html;
    esito.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // "Pubblica ora" nel messaggio (data-pubblica): lo gestisce src/admin/pubblicazione-client.ts

  modulo.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!modulo.reportValidity()) return;
    const pulsante = modulo.querySelector<HTMLButtonElement>('button[type=submit]')!;
    pulsante.disabled = true;
    mostra(modifica ? 'Salvo le modifiche…' : 'Preparo le immagini e creo il concerto…', '');
    const indirizzo = modifica ? '/admin/concerti/aggiorna' : '/admin/concerti/crea';
    try {
      const dati = new FormData(modulo);
      for (const campo of ['locandina', 'copertina']) {
        const f = dati.get(campo);
        if (f instanceof File && f.size) dati.set(campo, await riduci(f));
        else dati.delete(campo);
      }
      let r = await fetch(indirizzo, { method: 'POST', body: dati });
      let j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
      // Nel calendario c'è già un concerto quel giorno: si crea solo se lo conferma
      if (j.giaPresente) {
        if (!confirm(`Nel calendario c'è già un concerto quel giorno: «${j.giaPresente}». Lo creo lo stesso?`)) throw new Error('c’è già un concerto quel giorno');
        dati.set('conferma', '1');
        r = await fetch(indirizzo, { method: 'POST', body: dati });
        j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
      }
      if (!j.ok) throw new Error(j.errore);
      const cartella = j.cartella ? ` · <a href="${j.cartella}" target="_blank" rel="noopener">Apri la cartella su Drive</a>` : '';
      const idEvento = j.id ?? modulo.querySelector<HTMLInputElement>('[name=evento]')?.value;
      const pulsanti = `<span style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px"><button type="button" class="btn g piccolo" data-pubblica>Pubblica ora</button>${idEvento && (modulo.querySelector<HTMLInputElement>('[name=data]')?.value ?? '') >= new Date().toISOString().slice(0, 10) ? `<a class="btn o piccolo" href="/admin/convocazioni?modifica=${encodeURIComponent(idEvento)}#modulo">Scrivi la convocazione</a>` : ''}<a class="btn o piccolo" href="/admin/concerti">Torna ai concerti</a></span>`;
      const statoScelto = modulo.querySelector<HTMLInputElement>('[name=stato]:checked') ?? modulo.querySelector<HTMLInputElement>('[name=stato]');
      const pubblica = statoScelto?.value === 'in-cartellone'
        ? `Sul sito pubblico comparirà dopo la pubblicazione.${pulsanti}`
        : `${statoScelto?.closest('label') ? `Stato «${statoScelto.closest('label')!.querySelector('b')?.textContent ?? ''}»: non` : 'Non'} è sul sito pubblico, coristi e Maestro lo vedono già.${pulsanti.replace('<button type="button" class="btn g piccolo" data-pubblica>Pubblica ora</button>', '')}`;
      if (modifica) {
        (document.getElementById('locandina') as HTMLInputElement).value = '';
        (document.getElementById('copertina') as HTMLInputElement).value = '';
        // Le immagini appena salvate prendono il posto di quelle attuali nelle anteprime
        for (const campo of ['locandina', 'copertina']) {
          const scelta = document.querySelector<HTMLElement>(`.da-salvare[data-per="${campo}"]`)!;
          if (scelta.hidden) continue;
          scelta.parentElement!.querySelector('.attuale')?.remove();
          scelta.querySelector('figcaption')!.textContent = 'Ora (da pubblicare)';
          scelta.classList.remove('da-salvare');
          scelta.removeAttribute('data-per');
          const nuova = scelta.cloneNode(true) as HTMLElement;
          nuova.hidden = true;
          nuova.classList.add('da-salvare');
          nuova.dataset.per = campo;
          nuova.querySelector('img')!.removeAttribute('src');
          nuova.querySelector('figcaption')!.textContent = 'Nuova, da salvare';
          scelta.after(nuova);
          scelta.classList.add('attuale');
        }
        // L'inglese scritto dal sito torna nei campi
        if (j.inglese) {
          for (const nome of ['operaEn', 'organicoEn'] as const) modulo.querySelectorAll<HTMLInputElement>(`#opere [name="${nome}"]`).forEach((input, i) => (input.value = j.inglese[nome][i] ?? ''));
          for (const nome of ['evidenzaEn', 'ingressoEn'] as const) (modulo.elements.namedItem(nome) as HTMLInputElement).value = j.inglese[nome];
          (modulo.elements.namedItem('prima') as HTMLInputElement).value = JSON.stringify(j.inglese.prima);
        }
        mostra(`Modifiche salvate. <a href="${j.evento}" target="_blank" rel="noopener">Apri l'evento nel calendario</a>${cartella}. ${pubblica}${j.avviso ? ` Attenzione: ${j.avviso}.` : ''}`, 'ok');
      } else {
        modulo.reset();
        for (const campo of ['locandina', 'copertina']) aggiornaAnteprima(campo);
        letto.className = '';
        letto.textContent = '';
        mostra(`Concerto creato. <a href="${j.evento}" target="_blank" rel="noopener">Apri l'evento nel calendario</a>${cartella}. ${pubblica}${j.avviso ? ` Attenzione: ${j.avviso}.` : ''}`, 'ok');
      }
    } catch (e) {
      mostra(`${modifica ? 'Non salvato' : 'Non creato'}: ${(e as Error).message}`, 'errore');
    } finally {
      pulsante.disabled = false;
    }
  });
</script>
