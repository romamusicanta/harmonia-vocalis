---
// Layout dell'area Amministrazione: stessa grafica del sito (veste e colori di coro.config.ts) e
// stessa testata delle altre aree riservate (TestataArea della veste Stagione), con le sezioni
// dell'area e chi è entrato. Pagine noindex, mai in cache.
import '../stile/palette.css';
import '../stile/caratteri.css';
import '../stile/comune.css';
import { coro } from '../motore/coro';
import { urlCaratteri } from '../motore/aspetto';
import { aspettoDi } from '../motore/url';
import { vesti } from '../vesti';
import TestataArea from '../vesti/stagione/TestataArea.astro';
import TestaApp from '../componenti/TestaApp.astro';

interface Props {
  titolo: string;
  sezione?: 'pubblicazione' | 'concerti' | 'testi' | 'foto' | 'prove' | 'assenze' | 'avvisi' | 'repertorio';
}
const { titolo, sezione } = Astro.props;
const veste = coro.aspetto.veste;
const aspetto = aspettoDi(veste);
const colori = aspetto.colori;
const stileColori = colori ? Object.entries(colori).filter(([, v]) => v).map(([k, v]) => `--${k}:${v}`).join(';') : undefined;
---

<!doctype html>
<html lang="it" data-veste={veste} data-palette={colori ? 'personalizzata' : aspetto.palette} data-carattere={aspetto.carattere} style={stileColori}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titolo} — Amministrazione {coro.nome}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <TestaApp app="admin" />
    <link rel="stylesheet" href={urlCaratteri([aspetto.carattere], coro.aspetto.caratteriLogo)} />
    {vesti[veste].stili.map((s) => <link rel="stylesheet" href={s} />)}
    <style is:global>
      main.admin { padding: 40px 0 80px; }
      main.admin h1 { font-family: var(--f-titoli); font-weight: var(--peso-titoli); font-size: clamp(28px, 3.4vw, 40px); color: var(--primario); margin-bottom: 8px; }
      main.admin h2 { font-family: var(--f-titoli); font-weight: var(--peso-titoli); font-size: 24px; color: var(--primario); margin: 40px 0 14px; }
      .messaggio { padding: 14px 18px; border-radius: var(--raggio); margin: 20px 0; border: 2px solid var(--linea); background: var(--bianco); }
      .messaggio.ok { border-color: #2e7d4f; }
      .messaggio.errore { border-color: #b3261e; color: #b3261e; }
      .scheda-admin { background: var(--bianco); border: 1px solid var(--linea); padding: 22px; border-radius: var(--raggio); }
      /* "Pubblica ora" in corso (src/admin/pubblicazione-client.ts): rotella nel pulsante e riquadro in basso a destra */
      .rotella { display: inline-block; width: 30px; height: 30px; flex: none; border-radius: 50%; border: 4px solid color-mix(in srgb, var(--primario) 15%, transparent); border-top-color: var(--accento); animation: gira 0.9s linear infinite; }
      .rotella.piccola { width: 16px; height: 16px; border-width: 3px; border-color: color-mix(in srgb, currentColor 30%, transparent); border-top-color: currentColor; }
      @keyframes gira { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .rotella { animation-duration: 3s; } }
      button.in-attesa, button.in-attesa:disabled { display: inline-flex; align-items: center; gap: 8px; opacity: 1; cursor: progress; }
      button.in-attesa [data-tempo] { font-variant-numeric: tabular-nums; }
      .pubblicazione-in-corso { position: fixed; right: 16px; bottom: 16px; z-index: 50; display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--bianco); border: 2px solid var(--accento); border-radius: var(--raggio); box-shadow: 0 6px 24px rgb(0 0 0 / .15); color: var(--primario); max-width: calc(100vw - 32px); }
      .pubblicazione-in-corso[hidden] { display: none; }
      .pubblicazione-in-corso div { display: grid; gap: 2px; }
      .pubblicazione-in-corso [data-tempo] { font-size: 14px; color: var(--tenue); font-variant-numeric: tabular-nums; }
    </style>
  </head>
  <body class="area">
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <TestataArea veste={veste} sezione={sezione} conBarra={Boolean(Astro.locals.sessione)} admin />
    <main class="admin" id="contenuto" tabindex="-1">
      <div class="w">
        <slot />
      </div>
    </main>
    <script>
      // Menu a tendina con la grafica del sito, come nelle altre pagine
      import '../motore/tendine';
      // "Pubblica ora": rotella e attesa della nuova versione, in tutte le pagine
      import './pubblicazione-client';
    </script>
  </body>
</html>
