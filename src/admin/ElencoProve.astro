---
// Elenco delle prove del calendario "Prove" (dall'inizio della stagione ai prossimi quattro mesi)
// nell'Amministrazione (/admin/prove, scrive chi è entrato): si apre sulle prossime, con "Oggi" o
// "Prossima" sulla prima; sotto le prove già fatte della stagione, ognuna con quante registrazioni ha
// e il pulsante per caricarle (porta al riquadro Registrazioni del modulo di Modifica). Modifica per ogni data (Cancella sta dentro la modifica) e il
// pulsante per una prova nuova. Dopo un salvataggio o una cancellazione, "Invia su WhatsApp" con il
// messaggio già scritto per il gruppo dei coristi.
import { CALENDARIO_PROVE_ID } from 'astro:env/server';
import { elencoProve, giornoEsteso, leggiProva, provaPerWhatsapp, type Chi, type Prova } from './prove';
import { linkWhatsapp } from '../area/bacheca';
import Icona from '../componenti/Icona.astro';
import InvioNotifica from '../area/InvioNotifica.astro';
import RigaProva from './RigaProva.astro';
import { inizioStagione } from '../area/dati';
import { registrazioni } from '../area/registrazioni';
import { parti } from '../motore/concerti';
import Errore from '../area/Errore.astro';

interface Props { base: '/admin' | '/maestro'; chi: Chi }
const { base, chi } = Astro.props;

const giorno = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
const oggi = giorno(new Date());
const tra = (n: number) => giorno(new Date(Date.now() + n * 86_400_000));
let prove: Prova[] = [];
let errore: unknown;
if (!CALENDARIO_PROVE_ID) errore = 'Manca la variabile CALENDARIO_PROVE_ID sul server.';
else {
  try {
    prove = await elencoProve(chi, inizioStagione(oggi), tra(122));
  } catch (e) {
    errore = e;
  }
}
const q = Astro.url.searchParams;
const salvata = q.get('salvata');
const sito = Astro.url.origin;
// Il messaggio per WhatsApp: della prova appena salvata o appena cancellata, solo se non è ancora
// passata (per le prove già fatte l'unico messaggio è quello della registrazione, nel modulo)
let whatsapp: string | undefined;
const idSalvata = q.get('id');
if (salvata && idSalvata && salvata >= oggi) {
  const p = prove.find((x) => x.id === idSalvata) ?? (await leggiProva(chi, idSalvata).catch(() => undefined));
  if (p) whatsapp = provaPerWhatsapp(p, q.get('come') === 'nuova' ? 'nuova' : 'cambiata', sito);
}
const cancellata = q.get('cancellata');
if (cancellata && cancellata >= oggi) whatsapp = provaPerWhatsapp({ data: cancellata, inizio: q.get('ora') ?? '', fine: '', titolo: q.get('titolo') ?? '', luogo: '', righe: {} as Prova['righe'] }, 'cancellata', sito);

// Prossime per mese; le passate a parte, la più recente prima
const prossime = prove.filter((p) => p.data >= oggi);
const passate = prove.filter((p) => p.data < oggi).reverse();
// Quante registrazioni ha ogni prova già fatta (file caricati più il link "Registrazione:")
const quante = new Map<string, number>();
if (passate.length) {
  for (const g of await registrazioni().catch(() => [])) if (g.evento) quante.set(g.evento, g.tracce.length + (g.link ? 1 : 0));
}
const mesi = new Map<string, Prova[]>();
for (const p of prossime) {
  const d = parti({ data: p.data });
  const chiave = `${d.mese} ${d.anno}`;
  if (!mesi.has(chiave)) mesi.set(chiave, []);
  mesi.get(chiave)!.push(p);
}

---

<p style="margin-top:16px"><a class="btn g" href={`${base}/prove/nuova`}>+ Nuova prova</a></p>
{salvata && <p class="messaggio ok">Prova del {salvata.split('-').reverse().join('/')} salvata.</p>}
{cancellata && <p class="messaggio ok">Prova di {giornoEsteso(cancellata)} cancellata.</p>}
{whatsapp && (
  <div class="invio-whatsapp">
    <span>Avvisa i coristi: il messaggio è già scritto, scegli la chat del coro. Con «Notifica» arriva anche sui telefoni di chi ha attivato le notifiche.</span>
    <a class="btn g piccolo" href={linkWhatsapp(whatsapp)} target="_blank" rel="noopener"><Icona nome="whatsapp" />WhatsApp</a>
    <InvioNotifica messaggio={whatsapp} />
  </div>
)}
{errore && <Errore e={errore} />}

{[...mesi].map(([mese, elenco], m) => (
  <>
    <h2>{mese}</h2>
    <ul class="elenco-prove">
      {elenco.map((p, i) => <RigaProva p={p} base={base} etichetta={m === 0 && i === 0 ? (p.data === oggi ? 'Oggi' : 'Prossima') : undefined} />)}
    </ul>
  </>
))}
{!errore && prove.length > 0 && prossime.length === 0 && <p class="tenue">Nessuna prova in programma nei prossimi quattro mesi.</p>}
{passate.length > 0 && (
  <section class="passate" id="fatte">
    <h2>Prove già fatte della stagione</h2>
    <p class="tenue" style="margin:0 0 12px;font-size:15px">Da qui si caricano le registrazioni: i coristi le trovano nella pagina Registrazioni della loro area, sotto la prova.</p>
    <ul class="elenco-prove">
      {passate.map((p) => <RigaProva p={p} base={base} passata registrazioni={quante.get(p.id) ?? 0} />)}
    </ul>
  </section>
)}
{!errore && prove.length === 0 && <p class="tenue">Nessuna prova in calendario.</p>}

<style>
  .elenco-prove { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .passate { margin-top: 40px; padding-top: 8px; border-top: 2px solid var(--linea); }
</style>
