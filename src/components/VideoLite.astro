---
// Anteprima del video che carica il player YouTube (dominio senza cookie) solo al clic:
// pagina più leggera e nessun cookie di terze parti finché il visitatore non avvia la riproduzione.
import { miniatura } from '../lib/youtube';

interface Props {
  id: string;
  titolo: string;
  sottotitolo?: string;
}
const { id, titolo, sottotitolo } = Astro.props;
---

<figure class="video">
  <button class="video__cornice" type="button" data-video={id} aria-label={`Riproduci: ${titolo}`}>
    <img src={miniatura(id)} alt="" loading="lazy" width="480" height="360" />
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
  </button>
  <figcaption>
    <span class="video__titolo">{titolo}</span>
    {sottotitolo && <span class="video__sotto">{sottotitolo}</span>}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-video]').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.video}?autoplay=1&rel=0`;
      f.title = b.getAttribute('aria-label') ?? 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.className = 'video__iframe';
      b.replaceWith(f);
    });
  });
</script>

<style>
  .video { margin: 0; }
  .video__cornice,
  :global(.video__iframe) {
    display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0;
    border-radius: var(--raggio); overflow: hidden; background: #000;
  }
  .video__cornice { position: relative; cursor: pointer; }
  .video__cornice img {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s, opacity 0.2s;
    opacity: 0.92;
  }
  .video__cornice:hover img { transform: scale(1.03); opacity: 1; }
  .video__play {
    position: absolute; inset: 0; margin: auto; width: 3.5rem; height: 3.5rem; border-radius: 50%;
    display: grid; place-items: center; color: #fff;
    background: color-mix(in srgb, #7b1e2c 88%, transparent);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35); transition: transform 0.2s;
  }
  .video__play svg { margin-left: 3px; }
  .video__cornice:hover .video__play { transform: scale(1.08); }
  figcaption { margin-top: 0.8rem; display: grid; gap: 0.15rem; }
  .video__titolo { font: 500 1.25rem/1.25 var(--serif); }
  .video__sotto { font-size: 0.85rem; color: var(--inchiostro-2); }
</style>
