---
import type { Concerto } from '../data/concerti';
import { linkGoogleCalendar, linkMappa, parti } from '../lib/concerti';

interface Props {
  concerto: Concerto;
  inEvidenza?: boolean;
}
const { concerto: c, inEvidenza = false } = Astro.props;
const d = parti(c.data);
---

<article class:list={['concerto', { 'concerto--evidenza': inEvidenza }]}>
  <div class="concerto__data" aria-hidden="true">
    <span class="concerto__gs">{d.giornoSettimana}</span>
    <span class="concerto__g">{d.giorno}</span>
    <span class="concerto__m">{d.mese} {d.anno}</span>
  </div>
  <div class="concerto__corpo">
    <p class="nascosto">{d.giornoSettimana} {d.giorno} {d.mese} {d.anno}</p>
    <h3>{c.programma ?? c.titolo}</h3>
    {c.programma && <p class="concerto__rassegna">{c.titolo}</p>}
    <p class="concerto__info">
      {d.ora && <><span>ore {d.ora}</span> · </>}
      <a href={linkMappa(c.luogo)} rel="noopener">{c.luogo}</a>
    </p>
    {c.organizzatore && <p class="concerto__note">Organizzato da {c.organizzatore}</p>}
    {c.note && <p class="concerto__note">{c.note}</p>}
    <div class="azioni">
      <a class:list={['pulsante', { 'pulsante--vuoto': !inEvidenza }]} href={linkGoogleCalendar(c)} rel="noopener">
        Aggiungi al calendario
      </a>
    </div>
  </div>
</article>

<style>
  .concerto {
    display: grid; grid-template-columns: auto 1fr; gap: 1.5rem 2rem;
    padding: 1.75rem; border: 1px solid var(--linea); border-radius: var(--raggio);
    background: var(--carta);
  }
  .concerto--evidenza { border-color: var(--oro); box-shadow: 0 1px 0 var(--oro); }
  .concerto__data {
    display: flex; flex-direction: column; align-items: center; min-width: 6.5rem;
    padding-right: 2rem; border-right: 1px solid var(--linea); text-align: center;
  }
  .concerto__gs, .concerto__m {
    font: 600 0.7rem/1.3 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--oro);
  }
  .concerto__g { font: 500 4rem/1 var(--serif); margin-block: 0.2rem; }
  .concerto h3 { margin-bottom: 0.3rem; }
  .concerto__rassegna { font: italic 1.2rem/1.3 var(--serif); color: var(--inchiostro-2); margin-bottom: 0.9rem; }
  .concerto__info { margin-bottom: 0.3rem; }
  .concerto__note { font-size: 0.92rem; color: var(--inchiostro-2); margin-bottom: 0.2rem; }
  .concerto .azioni { margin-top: 1.25rem; }

  @media (max-width: 36rem) {
    .concerto { grid-template-columns: 1fr; padding: 1.25rem; }
    .concerto__data {
      flex-direction: row; gap: 0.6rem; align-items: baseline; justify-content: flex-start;
      padding: 0 0 1rem; border-right: 0; border-bottom: 1px solid var(--linea);
    }
    .concerto__g { font-size: 2.5rem; order: -1; }
  }
</style>
