---
// Layout unico di tutte le pagine. Testata e piè di pagina vengono dalla veste grafica;
// colori e caratteri dagli attributi data-palette e data-carattere su <html>.
import '../stile/palette.css';
import '../stile/caratteri.css';
import '../stile/comune.css';
import Pannello from '../demo/Pannello.astro';
import PannelloIniziale from '../demo/PannelloIniziale.astro';
import { getImage } from 'astro:assets';
import { coroIn, DEMO, immagine } from '../motore/coro';
import { alternativa, linguaDi } from '../motore/lingua';
import { CARATTERI, urlCaratteri, type Carattere, type Veste } from '../motore/aspetto';
import PannelloProva from '../componenti/PannelloProva.astro';
import PannelloProvaIniziale from '../componenti/PannelloProvaIniziale.astro';
import { aspettoDi } from '../motore/url';
import { vesti } from '../vesti';
import TestaApp from '../componenti/TestaApp.astro';
import type { Pagina } from '../motore/navigazione';
import { datiCoro, type DatiStrutturati } from '../motore/seo';

interface Props {
  veste: Veste;
  titolo?: string;
  descrizione?: string;
  pagina?: Pagina;
  // Area coristi (o del Maestro, maestro: true): testata e piè di pagina ridotti; sezione attiva nella barra
  area?: { sezione?: string; conBarra?: boolean; maestro?: boolean };
  // Immagine dell'anteprima nei link condivisi (WhatsApp, social), da coro/immagini; senza, la foto di apertura
  anteprima?: string;
  // Dati strutturati per Google (src/motore/seo.ts); nella home quelli del coro si aggiungono da soli.
  // Ricevono l'indirizzo dell'immagine di anteprima
  dati?: (immagine?: string) => DatiStrutturati | DatiStrutturati[];
  // Pagina da non indicizzare (la 404)
  noindex?: boolean;
}
// Lingua dall'indirizzo (/en/… è inglese); l'altra versione della pagina, se c'è, per hreflang
const lingua = linguaDi(Astro.url);
const coro = coroIn(lingua);
const { veste, titolo, descrizione = coro.descrizione, pagina, area, anteprima, noindex } = Astro.props;
const altra = !area && !DEMO ? alternativa(Astro.url) : undefined;
// Gli indirizzi per hreflang nella stessa forma del canonical (con la barra finale)
const conBarra = (h: string) => (h.endsWith('/') ? h : `${h}/`);
const { Testata, Piede, TestataArea, PiedeArea, stili } = vesti[veste];
const titoloCompleto = titolo ? `${titolo} — ${coro.nome}` : `${coro.nome} — ${coro.tipo} ${lingua === 'en' ? 'in' : 'a'} ${coro.citta === 'Roma' && lingua === 'en' ? 'Rome' : coro.citta}`;
const aspetto = aspettoDi(veste);
// Pannello di prova (sito vero): veste, palette, colori e caratteri a scelta di chi guarda
const prova = !DEMO && (coro.aspetto.pannelloProva || coro.aspetto.inProva.length > 0);
const caratteri = DEMO || prova ? (Object.keys(CARATTERI) as Carattere[]) : [aspetto.carattere];
const colori = !DEMO && aspetto.colori;
const stileColori = colori ? Object.entries(colori).filter(([, v]) => v).map(([k, v]) => `--${k}:${v}`).join(';') : undefined;
// Le copie delle pagine nelle vesti in prova non vanno indicizzate
const inProva = !DEMO && veste !== coro.aspetto.veste;
const indicizzata = !(DEMO || area || inProva || noindex);
const indirizzo = new URL(Astro.url.pathname, Astro.site ?? coro.url).href;
// Anteprima nei link condivisi: JPEG largo al massimo 1200 px, che WhatsApp e i social leggono tutti
const sorgente = immagine(anteprima ?? coro.foto.apertura);
const og = indicizzata && sorgente.format !== 'svg' ? await getImage({ src: sorgente, width: Math.min(1200, sorgente.width), format: 'jpg' }) : undefined;
const immagineOg = og && new URL(og.src, indirizzo).href;
const dati = indicizzata ? [...(pagina === 'home' ? datiCoro(coro, lingua, immagineOg) : []), ...[Astro.props.dati?.(immagineOg) ?? []].flat()] : [];
---

<!doctype html>
<html lang={lingua} data-veste={veste} data-palette={colori ? 'personalizzata' : aspetto.palette} data-carattere={aspetto.carattere} style={stileColori}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {!indicizzata && <meta name="robots" content="noindex, nofollow" />}
    {indicizzata && Astro.site && <link rel="canonical" href={indirizzo} />}
    {indicizzata && altra && (
      <>
        <link rel="alternate" hreflang={lingua} href={indirizzo} />
        <link rel="alternate" hreflang={altra.lingua} href={new URL(conBarra(altra.href), indirizzo).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(lingua === 'it' ? Astro.url.pathname : conBarra(altra.href), indirizzo).href} />
      </>
    )}
    {indicizzata && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={lingua === 'en' ? 'en_GB' : 'it_IT'} />
        {altra && <meta property="og:locale:alternate" content={altra.lingua === 'en' ? 'en_GB' : 'it_IT'} />}
        <meta property="og:site_name" content={coro.nome} />
        <meta property="og:title" content={titolo ?? titoloCompleto} />
        <meta property="og:description" content={descrizione} />
        <meta property="og:url" content={indirizzo} />
        {og && <meta property="og:image" content={immagineOg} />}
        {og && <meta property="og:image:width" content={String(og.attributes.width)} />}
        {og && <meta property="og:image:height" content={String(og.attributes.height)} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {dati.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!DEMO && <TestaApp app={area?.maestro ? 'maestro' : area ? 'coristi' : 'sito'} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={urlCaratteri(caratteri, coro.aspetto.caratteriLogo)} />
    {stili.map((s) => <link rel="stylesheet" href={s} />)}
    {DEMO && <PannelloIniziale />}
    {prova && <PannelloProvaIniziale />}
  </head>
  <body class:list={{ area: Boolean(area) }}>
    <a class="salta" href="#contenuto">{lingua === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    {area ? <TestataArea veste={veste} sezione={area.sezione} conBarra={area.conBarra} maestro={area.maestro} /> : <Testata veste={veste} pagina={pagina} />}
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    {area ? <PiedeArea veste={veste} maestro={area.maestro} /> : <Piede veste={veste} />}
    {DEMO && <Pannello veste={veste} />}
    {prova && <PannelloProva veste={veste} />}
    <script>
      import '../motore/interazioni';
      import '../motore/tendine';
    </script>
  </body>
</html>
