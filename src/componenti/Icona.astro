interface Props {
  nome: NomeIcona;
  classe?: string;
  spessore?: number;
}
const { nome, classe = 'p', spessore = 1.8 } = Astro.props;
---

<svg class:list={['ic', classe]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={spessore} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONE[nome]} />
