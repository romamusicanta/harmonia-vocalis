---
// Video con miniatura: il lettore YouTube (dominio senza cookie) si carica solo al clic.
// I video finti della demo mostrano un avviso invece di partire.
import Icona from './Icona.astro';
import { eFinto, miniatura, titoloCompleto } from '../motore/video';
import type { Video } from '../motore/tipi';

interface Props {
  video: Video;
  titolo?: string;
  sottotitolo?: string;
  piccolo?: boolean;
  id?: string;
}
const { video, titolo = titoloCompleto(video), sottotitolo = video.sottotitolo, piccolo, id } = Astro.props;
---

<button class:list={['video', { piccolo }]} type="button" id={id} data-id={video.id} data-finto={eFinto(video) ? '' : undefined} aria-label={`Riproduci: ${titolo}`}>
  <img src={miniatura(video)} alt="" loading="lazy" />
  <span class="play"><i><Icona nome="play" classe="" /></i><b>{titolo}{sottotitolo && <span>{sottotitolo}</span>}</b></span>
</button>
