---
// Veste Classica: fregio tipografico (stella a quattro punte tra due filetti), decorativo.
interface Props { semplice?: boolean; classe?: string }
const { semplice = false, classe } = Astro.props;
---

<span class:list={['fregio', classe, { semplice }]} aria-hidden="true">
  <svg viewBox="0 0 64 16" width="64" height="16" fill="currentColor">
    <path d="M32 1.5l1.9 5.1 5.1 1.4-5.1 1.4L32 14.5l-1.9-5.1L25 8l5.1-1.4z" />
    <circle cx="20" cy="8" r="1.3" />
    <circle cx="44" cy="8" r="1.3" />
  </svg>
</span>
