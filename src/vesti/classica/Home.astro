---
// Veste Classica: pagina iniziale come un programma di sala. Frontespizio della stagione
// centrato con gli anni in numeri romani, foto incorniciata con didascalia, annuncio del
// prossimo concerto, programma della stagione, ascolto, il coro in tre medaglioni con cornice rettangolare.
import Icona from '../../componenti/Icona.astro';
import Foto from '../../componenti/Foto.astro';
import Video from '../../componenti/Video.astro';
import NotaVideo from '../../componenti/NotaVideo.astro';
import SchedaConcerto from './SchedaConcerto.astro';
import Fregio from './Fregio.astro';
import { anniStagione, romano } from './romani';
import { coro } from '../../motore/coro';
import { link } from '../../motore/url';
import { archivio, luogoCompleto, parti, prossimiConcerti, slug, stagione } from '../../motore/concerti';
import { elencoVideo, titoloCompleto, videoInEvidenza } from '../../motore/video';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste }
const { veste } = Astro.props;
const l = (p: string) => link(veste, p);

const prossimi = await prossimiConcerti();
const prossimo = prossimi[0];
const d = prossimo && parti(prossimo);
const schede = [
  ...prossimi.slice(1, 3).map((c) => ({ c, href: l(`/concerti/${slug(c)}`), etichetta: 'In programma', grigia: false, azione: 'Dettagli' })),
  ...archivio.slice(0, 4).map((c) => ({ c, href: l(`/concerti#${stagione(c).id}`), etichetta: `Stagione ${stagione(c).sigla}`, grigia: true, azione: "Nell'archivio" })),
].slice(0, 4);

const evidenza = coro.funzioni.ascolta ? await videoInEvidenza() : undefined;
const altriVideo = (await elencoVideo()).filter((v) => v.id !== evidenza?.id).slice(0, 3);
const voci = coro.organico.reduce((n, s) => n + s.voci, 0);
const anni = anniStagione(coro.stagione.sigla);
const sezioni = coro.organico.map((s) => s.sezione.charAt(0)).join(' · ');
---

<!-- Frontespizio della stagione -->
<section class="cl-apertura">
  <div class="w">
    <Fregio />
    <span class="eti">Stagione concertistica</span>
    <h1>{anni.join(' – ')}</h1>
    <p class="cl-romani" aria-hidden="true">{anni.map(romano).join(' · ')}</p>
    <p class="cl-presentazione">{coro.stagione.presentazione}</p>
    <div class="bottoni">
      <a class="btn" href={l('/concerti')}>Il programma completo</a>
      <a class="btn o" href={l('/concerti#in-programma')}><Icona nome="calendario-piu" />Segui il calendario</a>
    </div>
    <figure class="cl-cornice larga">
      <Foto nome={coro.foto.apertura} alt={`Il ${coro.nome} in concerto`} caricamento="eager" sizes="(min-width: 1100px) 1040px, 100vw" />
      <figcaption>Il {coro.nome} in concerto{coro.maestro.nome && `, diretto dal M° ${coro.maestro.nome}`}</figcaption>
    </figure>
  </div>
</section>

<!-- Dati: calendario "Concerti" (prossimo concerto) -->
{prossimo && d && (
  <section class="cl-annuncio">
    <div class="w">
      <div class="cl-avviso">
        <span class="eti">Il prossimo concerto</span>
        <p class="cl-quando">{d.esteso}{d.ora && <> · ore {d.ora}</>}</p>
        {prossimo.autore && <p class="aut">{prossimo.autore}</p>}
        <h2><a href={l(`/concerti/${slug(prossimo)}`)}>{prossimo.titolo}</a></h2>
        {prossimo.rassegna && <p class="cl-rassegna">{prossimo.rassegna}</p>}
        {luogoCompleto(prossimo) && <p class="cl-luogo"><Icona nome="luogo" />{luogoCompleto(prossimo)}</p>}
        <Fregio semplice />
        <div class="bottoni">
          <a class="btn" href={l(`/concerti/${slug(prossimo)}`)}>Dettagli del concerto</a>
          <a class="btn o" href={l(`/concerti/${slug(prossimo)}#calendario`)}><Icona nome="calendario-piu" />Aggiungi al calendario</a>
        </div>
      </div>
    </div>
  </section>
)}

{schede.length > 0 && (
  <section class="cl-programma">
    <div class="w">
      <div class="testa"><h2>Programma</h2><p>Gli altri appuntamenti e i concerti più recenti.</p></div>
      {/* Dati: calendario "Concerti" + archivio in coro/concerti.ts */}
      <div class="schede">
        {schede.map((s) => <SchedaConcerto concerto={s.c} href={s.href} etichetta={s.etichetta} grigia={s.grigia} azione={s.azione} />)}
      </div>
      <p class="cl-centro"><a class="link-freccia" href={l('/concerti#archivio')}>L'archivio completo dei programmi <Icona nome="freccia" /></a></p>
    </div>
  </section>
)}

{evidenza && (
  <section class="cl-ascolto">
    {/* Dati: canale YouTube (feed RSS letto in fase di build) */}
    <div class="w">
      <div class="testa"><h2>Ascolta i nostri concerti</h2><p>Registrazioni dal vivo, con orchestra e solisti. Un archivio che cresce a ogni stagione.</p></div>
      <div class="cl-cornice video-c">
        <Video video={evidenza} />
      </div>
      <NotaVideo />
      {altriVideo.length > 0 && (
        <ul class="cl-indice-video">
          {altriVideo.map((v) => <li><a href={l(`/ascolta#${v.id}`)}><span>{titoloCompleto(v)}</span><i aria-hidden="true"></i><em>{v.pubblicato.slice(0, 4)}</em></a></li>)}
        </ul>
      )}
      <p class="cl-centro"><a class="btn o" href={l('/ascolta')}>Tutte le registrazioni</a></p>
    </div>
  </section>
)}

<section class="cl-coro">
  <div class="w">
    <div class="testa"><h2>Il coro</h2></div>
    <div class="cl-medaglioni">
      <a class="cl-medaglione" href={l('/il-coro')}>
        <span class="cornice"><Foto nome={coro.foto.coro} sizes="(min-width: 1000px) 30vw, 80vw" /></span>
        <span class="eti">Dal {coro.fondazione}</span>
        <h3>La nostra storia</h3>
        <p>{coro.associazione ? `Nato dall'${coro.associazione}` : `Nato nel ${coro.fondazione}`}: {voci} voci per la musica corale, sacra e profana.</p>
        <span class="link-freccia">Scopri <Icona nome="freccia" /></span>
      </a>
      <a class="cl-medaglione" href={l('/il-maestro')}>
        <span class="cornice"><Foto nome={coro.maestro.foto} alt={`Il M° ${coro.maestro.nome}`} sizes="(min-width: 1000px) 30vw, 80vw" style="object-position:center 20%" /></span>
        <span class="eti">Il Maestro</span>
        <h3>{coro.maestro.nome}</h3>
        <p>{coro.maestro.presentazione}</p>
        <span class="link-freccia">Biografia <Icona nome="freccia" /></span>
      </a>
      {coro.funzioni.cantaConNoi && (
        <a class="cl-medaglione" href={l('/canta-con-noi')}>
          <span class="cornice vuoto"><b>{sezioni}</b></span>
          <span class="eti">Audizioni</span>
          <h3>Canta con noi</h3>
          <p>Cerchiamo nuove voci. {coro.prove.orari}, a {coro.prove.citta}.</p>
          <span class="link-freccia">Come partecipare <Icona nome="freccia" /></span>
        </a>
      )}
    </div>
  </div>
</section>

{coro.funzioni.organizzatori && (
  <section class="cl-organizzatori">
    <div class="w">
      <div class="cl-avviso">
        <span class="eti">Per gli organizzatori</span>
        <h2>Una rassegna, una festa patronale, un concerto di Natale?</h2>
        <p>Portiamo in concerto messe, oratori e polifonia, anche con orchestra: {voci} voci con un repertorio già pronto.</p>
        <div class="bottoni"><a class="btn" href={l('/organizzatori')}>Repertorio e contatti</a></div>
      </div>
    </div>
  </section>
)}

<section class="segui">
  <div class="w">
    <Fregio />
    <h2>Non perdere il prossimo concerto</h2>
    <div class="bottoni">
      <a class="btn" href={l('/concerti#in-programma')}><Icona nome="calendario-piu" />Aggiungi il calendario</a>
      {coro.link.youtube && <a class="btn o" href={coro.link.youtube}><Icona nome="youtube" />Iscriviti al canale</a>}
    </div>
  </div>
</section>
