---
// Veste Classica: piè di pagina come il retro di un programma di sala. Tutto centrato:
// fregio, marchio, descrizione in corsivo, indice delle pagine, recapiti e colophon.
import Marchio from './Marchio.astro';
import Fregio from './Fregio.astro';
import { coro } from '../../motore/coro';
import { link, linkArea } from '../../motore/url';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste }
const { veste } = Astro.props;
const f = coro.funzioni;
const l = coro.link;
const social = [
  l.youtube && { testo: 'YouTube', href: l.youtube },
  l.instagram && { testo: 'Instagram', href: l.instagram },
  l.facebook && { testo: 'Facebook', href: l.facebook },
].filter((v): v is { testo: string; href: string } => Boolean(v));
---

<footer class="cl-piede">
  <div class="w">
    <Fregio />
    <Marchio href={link(veste, '/')} />
    <p class="cl-descr">{coro.descrizione}</p>

    <div class="cl-indice">
      <div>
        <h2>Il coro</h2>
        <ul>
          <li><a href={link(veste, '/il-coro')}>Storia e direttivo</a></li>
          <li><a href={link(veste, '/il-maestro')}>Il Maestro</a></li>
          {f.cantaConNoi && <li><a href={link(veste, '/canta-con-noi')}>Canta con noi</a></li>}
          {f.organizzatori && <li><a href={link(veste, '/organizzatori')}>Per gli organizzatori</a></li>}
        </ul>
      </div>
      <div>
        <h2>Concerti e musica</h2>
        <ul>
          <li><a href={link(veste, '/concerti')}>Stagione e archivio</a></li>
          {f.ascolta && <li><a href={link(veste, '/ascolta')}>Registrazioni</a></li>}
          {social.map((s) => <li><a href={s.href}>{s.testo}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Recapiti</h2>
        <ul>
          <li><a href={`mailto:${coro.email}`}>{coro.email}</a></li>
          {coro.sede && <li>{coro.sede.indirizzo}, {coro.sede.cap} {coro.sede.citta}</li>}
          <li><a href={link(veste, '/contatti')}>Scrivici</a></li>
        </ul>
      </div>
    </div>

    <div class="cl-colophon">
      <p>© {new Date().getFullYear()} {coro.associazione ?? coro.nome}{coro.affiliazioni && ` · ${coro.affiliazioni}`}</p>
      <p><a href={link(veste, '/privacy')}>Privacy</a>{linkArea(veste) && <> · <a href={linkArea(veste)}>Area coristi</a></>}</p>
    </div>
  </div>
</footer>
