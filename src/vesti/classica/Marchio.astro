---
// Veste Classica: marchio centrato. Monogramma nel doppio cerchio, nome del coro, tipo e città in maiuscoletto.
// Se il coro ha un logo, il logo prende il posto di monogramma e nome; il sottotitolo resta
// solo quando è indicato (per esempio "Area coristi").
import { coro } from '../../motore/coro';
import { Logo } from '../../motore/logo';

interface Props { href: string; piccolo?: boolean; sottotitolo?: string }
const { href, piccolo = false, sottotitolo = `${coro.tipo} · ${coro.citta}` } = Astro.props;
---

{Logo ? (
  <a class:list={['cl-marchio con-logo', { piccolo }]} href={href}>
    <span class="logo-coro"><Logo /></span>
    {Astro.props.sottotitolo && <span class="cl-tipo">{sottotitolo}</span>}
  </a>
) : (
  <a class:list={['cl-marchio', { piccolo }]} href={href}>
    <span class="cl-sigla" aria-hidden="true">{coro.sigla}</span>
    <span class="cl-nome">{coro.nome}</span>
    <span class="cl-tipo">{sottotitolo}</span>
  </a>
)}
