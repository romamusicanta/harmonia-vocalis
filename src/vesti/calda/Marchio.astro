---
// Veste Calda: marchio del coro con la sigla in un bollino tondo; oppure il logo del coro, se c'è.
import { coro } from '../../motore/coro';
import { Logo } from '../../motore/logo';

interface Props { href: string }
const { href } = Astro.props;
---

{Logo ? (
  <a class="marchio con-logo" href={href}><span class="logo-coro"><Logo /></span></a>
) : (
  <a class="marchio" href={href}>
    <span class="q" aria-hidden="true"><b>{coro.sigla}</b></span>
    <span><b>{coro.nome}</b><small>{coro.tipo} · {coro.citta}</small></span>
  </a>
)}
