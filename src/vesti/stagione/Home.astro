---
// Veste Stagione: pagina iniziale. Sigla della stagione a tutta altezza, prossimo concerto
// sulla foto, schede dei concerti, le foto più belle dei concerti, fascia video, porte verso le pagine del coro.
import ConLink from '../../componenti/ConLink.astro';
import Icona from '../../componenti/Icona.astro';
import Foto from '../../componenti/Foto.astro';
import Video from '../../componenti/Video.astro';
import NotaVideo from '../../componenti/NotaVideo.astro';
import SchedaConcerto from './SchedaConcerto.astro';
import { contesto } from '../../motore/url';
import { concertoIn, videoIn } from '../../motore/inglese';
import { archivio, linkIscrizioneCalendario, parti, prossimiConcerti, slug, stagione } from '../../motore/concerti';
import { elencoVideo, titoloCompleto, videoInEvidenza } from '../../motore/video';
import type { Veste } from '../../motore/aspetto';
import { fotoInHome } from '../../motore/coro';
import Galleria from '../../componenti/Galleria.astro';

interface Props { veste: Veste }
const { veste } = Astro.props;
const { en, l, lingua, coro } = contesto(Astro.url, veste);
// Iscrizione al calendario Google dei concerti (come nella pagina Concerti); senza, il link ai concerti in programma
const iscrizione = linkIscrizioneCalendario();

const prossimi = await prossimiConcerti();
const prossimo = prossimi[0] && concertoIn(prossimi[0], lingua);
const d = prossimo && parti(prossimo, lingua);
// Schede della home: i concerti in programma e quelli già fatti della stagione in corso (tranne
// quelli con "Home: no"; un concerto in programma, quando è passato, resta così in home con
// l'etichetta della stagione), più i passati con "Home: sì", scelti dall'area Amministrazione;
// se non ce n'è nessuno, i più recenti fino a 4
const prossimiInHome = prossimi.filter((c) => c.home !== false);
const stagioneInCorso = stagione({ data: new Date().toISOString().slice(0, 10) }).id;
const passatiScelti = archivio.filter((c) => c.home || (c.home !== false && !c.dataIncerta && stagione(c).id === stagioneInCorso));
const passatiInHome = passatiScelti.length ? passatiScelti : archivio.slice(0, Math.max(0, 4 - prossimiInHome.length));
const schede = [
  ...prossimiInHome.map((c, i) => ({ c, href: l(`/concerti/${slug(c)}`), etichetta: i === 0 && c === prossimi[0] ? (en ? 'Next' : 'Prossimo') : (en ? 'Upcoming' : 'In programma'), grigia: false, azione: en ? 'Details and calendar' : 'Dettagli e calendario' })),
  ...passatiInHome.map((c) => ({ c, href: l(c.dataIncerta ? `/concerti#${stagione(c).id}` : `/concerti/${slug(c)}`), etichetta: `${en ? 'Season' : 'Stagione'} ${stagione(c).sigla}`, grigia: true, azione: c.dataIncerta ? (en ? 'In the archive' : "Nell'archivio") : (en ? 'Details' : 'Dettagli') })),
];

// Le foto scelte per la home tra quelle dei coristi (src/area/fotoConcerti.ts, visibilità «home»): le più
// belle di tutti i concerti, dal più recente; al più 9 (una grande e otto piccole), ognuna con il nome
// del concerto e il link alla sua pagina
const tuttiConcerti = [...prossimi, ...archivio];
const fotoHome = fotoInHome().slice(0, 9).map((f, n) => {
  const c = tuttiConcerti.find((x) => !x.dataIncerta && x.data.slice(0, 10) === f.data);
  const t = c && concertoIn(c, lingua);
  const nome = t ? [t.autore?.split(/\s+/).at(-1), t.titolo].filter(Boolean).join(', ') : '';
  const pd = c && parti(c, lingua);
  const giorno = pd ? `${Number(pd.giorno)} ${en ? pd.mese : pd.mese.toLowerCase()} ${pd.anno}` : '';
  return {
    nome: f.nome,
    alt: nome ? (en ? `Photo from the concert: ${nome}` : `Foto dal concerto: ${nome}`) : (en ? `Concert photo ${n + 1}` : `Foto di un concerto ${n + 1}`),
    didascalia: [nome, giorno].filter(Boolean).join(' · ') || undefined,
    href: c ? `${l(`/concerti/${slug(c)}`)}#foto` : undefined,
    testoLink: en ? 'The concert →' : 'Il concerto →',
  };
});

const evidenza = videoIn(coro.funzioni.ascolta ? await videoInEvidenza() : undefined, lingua);
const altriVideo = (await elencoVideo()).filter((v) => v.id !== evidenza?.id).slice(0, 3).map((v) => videoIn(v, lingua));
const voci = coro.organico.reduce((n, s) => n + s.voci, 0);
const [sigla1, sigla2] = coro.stagione.sigla.split('/');
---

<!-- Dati: calendario "Concerti" (prossimo concerto) -->
<section class="apertura">
  <div class="w">
    <div class="stagione">
      <span class="eti" aria-hidden="true">{en ? 'Concert season' : 'Stagione concertistica'}</span>
      {/* Il titolo si legge "Coro Harmonia Vocalis, stagione concertistica 26/27": l'etichetta sopra è solo
          a vista; il nome del coro nel titolo aiuta Google a mostrare questa pagina a chi cerca il coro */}
      <h1><span class="sr">{en ? `${coro.nome}, concert season ` : `${coro.nome}, stagione concertistica `}</span>{sigla1}{sigla2 && <><span aria-hidden="true">/</span><span class="sr"> </span>{sigla2}</>}<span aria-hidden="true">.</span></h1>
      <div>
        <p><ConLink testo={coro.stagione.presentazione} /></p>
        <div class="bottoni" style="margin-top:24px">
          <a class="btn" href={l('/concerti')}>{en ? 'All concerts' : 'Tutti i concerti'}</a>
          {iscrizione
            ? <a class="btn o" href={iscrizione} target="_blank" rel="noopener"><Icona nome="calendario-piu" />{en ? 'Subscribe to the calendar' : 'Iscriviti al calendario'}</a>
            : <a class="btn o" href={l('/concerti#in-programma')}><Icona nome="calendario" />{en ? 'Calendar' : 'Calendario'}</a>}
        </div>
      </div>
    </div>
    <div class="blocco-foto">
      <Foto nome={coro.foto.apertura} alt={en ? `The ${coro.nome} in concert` : `Il ${coro.nome} in concerto`} caricamento="eager" sizes="(min-width: 980px) 50vw, 100vw" />
      {prossimo && d && (
        <a class="scheda" href={l(`/concerti/${slug(prossimo)}`)}>
          <div class="n">{d.giorno}<small>{d.mese} · {d.giornoSettimana}</small></div>
          <p>{[prossimo.autore?.split(' ').at(-1), prossimo.titolo].filter(Boolean).join(', ')}<span>{[prossimo.rassegna, prossimo.luogo].filter(Boolean).join(' · ')}</span></p>
          <span class="vai">{en ? 'Concert details' : 'Dettagli del concerto'} <Icona nome="freccia" /></span>
        </a>
      )}
    </div>
  </div>
</section>

<section>
  <div class="w">
    <div class="testa"><h2>{en ? 'Upcoming and recent' : 'Prossimi e recenti'}</h2><a class="btn o" href={l('/concerti#archivio')}>{en ? 'Full archive' : 'Archivio completo'}</a></div>
    <!-- Dati: calendario "Concerti" (con "Home: sì/no") -->
    <div class="carosello-cont" data-carosello-cont>
      <div class="schede carosello" data-carosello tabindex="0" aria-label={en ? 'Concerts: scroll to see more' : 'Concerti: scorri per vederne altri'}>
        {schede.map((s) => <SchedaConcerto concerto={s.c} href={s.href} etichetta={s.etichetta} grigia={s.grigia} azione={s.azione} />)}
      </div>
      <button class="freccia-carosello sx" type="button" data-verso="-1" aria-label={en ? 'Previous concerts' : 'Concerti precedenti'} hidden><Icona nome="freccia" /></button>
      <button class="freccia-carosello dx" type="button" data-verso="1" aria-label={en ? 'Next concerts' : 'Concerti successivi'} hidden><Icona nome="freccia" /></button>
    </div>
  </div>
</section>

{fotoHome.length > 0 && (
  <section style="padding-top:0">
    <div class="w">
      <div class="testa"><h2>{en ? 'From our concerts' : 'Dai nostri concerti'}</h2></div>
      <!-- Dati: foto dei coristi scelte una per una dai redattori per la home -->
      <Galleria foto={fotoHome} mosaico en={en} />
    </div>
  </section>
)}

{evidenza && (
  <section class="fascia">
    {/* Dati: canale YouTube (feed RSS letto in fase di build) */}
    <div class="w due">
      <div>
        <h2>{en ? 'Listen to our concerts' : 'Ascolta i nostri concerti'}</h2>
        <p>{en ? 'Live recordings, with orchestra and soloists. An archive that grows every season.' : 'Registrazioni dal vivo, con orchestra e solisti. Un archivio che cresce a ogni stagione.'}</p>
        <a class="btn g" href={l('/ascolta')}>{en ? 'All recordings' : 'Tutte le registrazioni'}</a>
      </div>
      <div>
        <Video video={evidenza} />
        <div class="lista-mini">
          {altriVideo.map((v) => <a href={l(`/ascolta#${v.id}`)}>{titoloCompleto(v)} <em>{v.pubblicato.slice(0, 4)}</em></a>)}
        </div>
        <NotaVideo />
      </div>
    </div>
  </section>
)}

<section>
  <div class="w">
    <div class="testa"><h2>{en ? 'The Choir' : 'Il Coro'}</h2></div>
    <div class="porte">
      <a class="porta" href={l('/il-coro')}>
        <div class="img"><Foto nome={coro.foto.coro} sizes="(min-width: 1000px) 33vw, 100vw" /></div>
        <div class="c">{en
          ? <><h3>Our story</h3><p>Founded in {coro.fondazione}{coro.associazione && ` by the ${coro.associazione}`}: {voci} voices for choral music, sacred and secular.</p><span class="btn o">Discover</span></>
          : <><h3>La nostra storia</h3><p>Nato nel {coro.fondazione}{coro.associazione && ` dall'${coro.associazione}`}: {voci} voci per la musica corale, sacra e profana.</p><span class="btn o">Scopri</span></>}</div>
      </a>
      <a class="porta" href={l('/il-maestro')}>
        <div class="img"><Foto nome={coro.maestro.foto} alt={en ? `Maestro ${coro.maestro.nome}` : `Il M° ${coro.maestro.nome}`} sizes="(min-width: 1000px) 33vw, 100vw" style="object-position:center 20%" /></div>
        <div class="c"><h3>{en ? 'The Conductor' : 'Il Maestro'}</h3><p>{coro.maestro.nome}: {coro.maestro.presentazione.charAt(0).toLowerCase()}{coro.maestro.presentazione.slice(1)}</p><span class="btn o">{en ? 'Biography' : 'Biografia'}</span></div>
      </a>
      {coro.funzioni.cantaConNoi && (
        <a class="porta" href={l('/canta-con-noi')}>
          {/* La stessa foto della pagina Canta con noi */}
          <div class="img"><Foto nome={coro.foto.prove ?? coro.foto.coro} alt={en ? (coro.foto.prove ? `The ${coro.nome} at a rehearsal` : `The ${coro.nome}`) : coro.foto.prove ? `Il ${coro.nome} durante una prova` : `Il ${coro.nome}`} sizes="(min-width: 1000px) 33vw, 100vw" /></div>
          <div class="c"><h3>{en ? 'Sing with us' : 'Canta con noi'}</h3><p>{en ? `We are looking for new voices. ${coro.prove.orari}, in Rome.` : `Cerchiamo nuove voci. ${coro.prove.orari}, a ${coro.prove.citta}.`}</p><span class="btn">{en ? 'Auditions' : 'Audizioni'}</span></div>
        </a>
      )}
    </div>
  </div>
</section>

{coro.funzioni.organizzatori && (
  <section style="padding-top:0">
    <div class="w">
      <div class="riquadro" style="display:grid;gap:24px;padding:clamp(28px,4vw,48px)">
        <div style="display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:end">
          <div style="max-width:60ch">
            <span class="eti" style="margin-bottom:12px">{en ? 'For organisers' : 'Per gli organizzatori'}</span>
            <h2 class="h-media">{en ? 'A concert series, a patronal feast, a Christmas concert?' : 'Una rassegna, una festa patronale, un concerto di Natale?'}</h2>
            <p class="tenue" style="margin-top:12px">{en ? `We perform masses, oratorios and polyphony, also with orchestra: ${voci} voices with a ready repertoire.` : `Portiamo in concerto messe, oratori e polifonia, anche con orchestra: ${voci} voci con un repertorio già pronto.`}</p>
          </div>
          <a class="btn" href={l('/organizzatori')}>{en ? 'Repertoire and contacts' : 'Repertorio e contatti'} <Icona nome="freccia" /></a>
        </div>
      </div>
    </div>
  </section>
)}

<section class="segui">
  <div class="w">
    <h2>{en ? 'Don’t miss the next concert' : 'Non perdere il prossimo concerto'}</h2>
    <div class="bottoni">
      {iscrizione
        ? <a class="btn" href={iscrizione} target="_blank" rel="noopener"><Icona nome="calendario-piu" />{en ? 'Subscribe to the calendar' : 'Iscriviti al calendario'}</a>
        : <a class="btn" href={l('/concerti#in-programma')}><Icona nome="calendario-piu" />{en ? 'Upcoming concerts' : 'Concerti in programma'}</a>}
      {coro.link.youtube && <a class="btn o" href={coro.link.youtube}><Icona nome="youtube" />{en ? 'Subscribe to the channel' : 'Iscriviti al canale'}</a>}
    </div>
  </div>
</section>

<script>
  // Carosello delle schede: le frecce ai lati compaiono se le schede non entrano tutte e scorrono
  // di una pagina; al bordo raggiunto la freccia si attenua, e una sfumatura indica dove c'è ancora
  // contenuto. Senza JavaScript resta lo scorrimento orizzontale.
  for (const cont of document.querySelectorAll<HTMLElement>('[data-carosello-cont]')) {
    const carosello = cont.querySelector<HTMLElement>('[data-carosello]')!;
    const [indietro, avanti] = cont.querySelectorAll<HTMLButtonElement>('.freccia-carosello');
    const aggiorna = () => {
      const max = carosello.scrollWidth - carosello.clientWidth;
      const scorre = max > 4;
      indietro.hidden = avanti.hidden = !scorre;
      indietro.disabled = carosello.scrollLeft <= 4;
      avanti.disabled = carosello.scrollLeft >= max - 4;
      cont.classList.toggle('altro-sx', scorre && !indietro.disabled);
      cont.classList.toggle('altro-dx', scorre && !avanti.disabled);
    };
    const lento = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const b of [indietro, avanti]) {
      b.addEventListener('click', () => carosello.scrollBy({ left: Number(b.dataset.verso) * carosello.clientWidth, behavior: lento ? 'smooth' : 'auto' }));
    }
    carosello.addEventListener('scroll', aggiorna, { passive: true });
    new ResizeObserver(aggiorna).observe(carosello);
    aggiorna();
  }
</script>

<style>
</style>
