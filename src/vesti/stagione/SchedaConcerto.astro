---
// Veste Stagione: scheda concerto verticale (data grande, foto o locandina, autore e titolo).
import Foto from '../../componenti/Foto.astro';
import { parti } from '../../motore/concerti';
import { concertoIn } from '../../motore/inglese';
import { linguaDi } from '../../motore/lingua';
import type { Concerto } from '../../motore/tipi';

interface Props {
  concerto: Concerto;
  href: string;
  etichetta: string;
  grigia?: boolean;
  azione: string;
  conFoto?: boolean;
}
const { concerto, href, etichetta, grigia, azione, conFoto = true } = Astro.props;
const lingua = linguaDi(Astro.url);
const c = concertoIn(concerto, lingua);
const d = parti(c, lingua);
// La locandina intera (non ritagliata) sul fondo della scheda; senza, la foto del concerto (dal 6/10/2026
// la locandina ha la precedenza)
const anteprima = c.locandina ?? c.foto;
---

<a class="sc" href={href}>
  <div class="top">
    <span class="data-grande">{d.incerta ? d.anno : d.giorno}<small>{d.incerta ? (lingua === 'en' ? 'date to be confirmed' : 'data da precisare') : `${d.meseBreve} ${d.anno}`}</small></span>
    <span class:list={['tag', { grigio: grigia }]}>{etichetta}</span>
  </div>
  {conFoto && anteprima && <div class:list={['img', { locandina: Boolean(c.locandina) }]}><Foto nome={anteprima} alt={c.locandina ? `${lingua === 'en' ? 'Poster' : 'Locandina'}: ${c.titolo}` : ''} sizes="(min-width: 1000px) 25vw, 100vw" /></div>}
  <div class="corpo">
    {c.autore && <span class="aut">{c.autore}</span>}
    <h3>{c.titolo}</h3>
    <span class="luogo">{[c.luogo, c.rassegna].filter(Boolean).join(' · ')}</span>
    <span class="link">{azione} →</span>
  </div>
</a>
