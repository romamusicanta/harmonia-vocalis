---
// Veste Stagione: barra di servizio, testata con marchio e menu, menu mobile.
import Icona from '../../componenti/Icona.astro';
import Marchio from './Marchio.astro';
import { AREA_CORISTI, coro } from '../../motore/coro';
import { link } from '../../motore/url';
import { vociMenu, type Pagina } from '../../motore/navigazione';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste; pagina?: Pagina }
const { veste, pagina } = Astro.props;
const voci = vociMenu(veste);
const f = coro.funzioni;
const calendario = link(veste, '/concerti#in-programma');
---

<div class="servizio">
  <div class="w">
    <span class="info">{[coro.associazione && `Coro dell'${coro.associazione}`, coro.affiliazioni].filter(Boolean).join(' · ')}</span>
    <span class="dx">
      {f.organizzatori && <a href={link(veste, '/organizzatori')}>Per gli organizzatori</a>}
      {AREA_CORISTI && <a href={link(veste, '/area')}><Icona nome="lucchetto" />Area coristi</a>}
    </span>
  </div>
</div>
<header class="testata">
  <div class="w">
    <Marchio href={link(veste, '/')} />
    <nav class="nav" aria-label="Principale">
      {voci.map((v) => <a href={v.href} class:list={{ on: v.id === pagina }} aria-current={v.id === pagina ? 'page' : undefined}>{v.testo}</a>)}
    </nav>
    <div class="azioni">
      <a class="btn g" href={calendario}><Icona nome="calendario" />Calendario</a>
      <button class="hamb" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu-mobile"><Icona nome="menu" classe="apri" spessore={2} /><Icona nome="chiudi" classe="chiudi" spessore={2} /></button>
    </div>
  </div>
  <div class="menu-mobile" id="menu-mobile">
    <div class="w">
      {voci.map((v) => <a class:list={['voce', { on: v.id === pagina }]} href={v.href}>{v.testo}<Icona nome="freccia" classe="" /></a>)}
      <div class="extra">
        <a class="btn g" href={calendario}><Icona nome="calendario" />Calendario concerti</a>
        {f.organizzatori && <a class="btn o" href={link(veste, '/organizzatori')}>Per gli organizzatori</a>}
        {AREA_CORISTI && <a class="btn o" href={link(veste, '/area')}><Icona nome="lucchetto" />Area coristi</a>}
      </div>
    </div>
  </div>
</header>
