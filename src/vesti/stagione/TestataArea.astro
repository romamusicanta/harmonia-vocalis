---
// Veste Stagione: testata comune delle aree riservate (area coristi, area del Maestro, area
// Amministrazione), sempre in tre fasce: barra scura con il sito pubblico e la tendina "Area
// riservata" per passare da un'area all'altra; testata chiara con logo, nome dell'area, utente
// collegato e uscita; barra delle sezioni. Sotto 1000px barra scura e sezioni stanno nel menu
// dell'hamburger (in alto aree riservate e sito pubblico, poi le sezioni, in fondo utente ed Esci),
// con l'hamburger a sinistra, il logo con il nome dell'area al centro e la foto dell'utente a destra.
// Sul telefono (sotto 760px) le sezioni principali dell'area coristi e del Maestro stanno in una
// barra fissa in basso, con icona e scritta, e nel menu restano solo le altre. Con conBarra = false
// (pagine di accesso) niente utente, sezioni né menu, solo "Torna al sito".
import Icona, { type NomeIcona } from '../../componenti/Icona.astro';
import Marchio from './Marchio.astro';
import MenuRiservato from './MenuRiservato.astro';
import { areeRiservate, type AreaRiservata } from './aree';
import InvitoApp from '../../area/InvitoApp.astro';
import InterruttoreNotifiche from '../../area/InterruttoreNotifiche.astro';
import CaricamentoPagina from '../../area/CaricamentoPagina.astro';
import { ANTEPRIMA_AREA, coro, DEMO } from '../../motore/coro';
import { link } from '../../motore/url';
import { corista } from '../../demo/area';
import { ruoliDi } from '../../area/bacheca';
import { nelGruppo } from '../../area/servizio';
import { apreArea, apreMaestro, apreTesoriere, scriveTesoriere, leggiCorista, type Corista } from '../../area/accesso';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste; sezione?: string; conBarra?: boolean; maestro?: boolean; tesoriere?: boolean; admin?: boolean }
const { veste, sezione, conBarra = true, maestro = false, tesoriere = false, admin = false } = Astro.props;
const tipo = admin ? 'admin' : maestro ? 'maestro' : tesoriere ? 'tesoriere' : 'coristi';

// Chi è entrato (src/middleware.ts), con la foto dell'account Google se c'è (altrimenti, o se non si
// carica, l'icona della persona); nella demo il corista di esempio
const sessione = Astro.locals.sessione;
const utente = admin
  ? sessione && { nome: sessione.nome || sessione.email, dettaglio: sessione.email, foto: sessione.foto }
  : Astro.locals.corista
    ? { nome: Astro.locals.corista.nome, dettaglio: Astro.locals.corista.email, foto: Astro.locals.corista.foto }
    : { nome: corista.nome, dettaglio: `${corista.sezione} · ${corista.email}`, foto: undefined as string | undefined };
const esci = admin ? '/admin/esci' : DEMO ? link(veste, '/area/accesso') : maestro ? '/area/esci?da=maestro' : tesoriere ? '/area/esci?da=tesoriere' : '/area/esci';

// Tra le aree riservate (tendina e menu del telefono) solo quelle che chi è entrato può aprire (dal
// 7/10/2026; prima comparivano tutte, e chi ne sceglieva una non sua finiva a una pagina di accesso).
// Nell'area coristi, del Maestro e del tesoriere lo dice la sessione (src/area/accesso.ts);
// nell'Amministrazione (altra sessione) quella delle aree, se è della stessa persona (la apre l'accesso
// all'Amministrazione), altrimenti i gruppi, letti al più ogni 5 minuti. L'Amministrazione la aprono
// redattori, amministratori, gruppo Demo e chi ha un ruolo nella bacheca senza un'area propria (il presidente).
// Nelle pagine di accesso, dove non si sa chi è, come nel sito pubblico.
const ammessoAdmin = async (c: Corista) =>
  Boolean(c.redattore || c.amministratore || c.demo) ||
  (await ruoliDi(c.email).catch(() => [])).some((r) => r.id !== 'maestro' && r.id !== 'tesoriere');
const permesse: AreaRiservata[] | undefined = DEMO ? undefined : await (async () => {
  if (admin) {
    if (!sessione) return undefined;
    if (sessione.demo) return ['admin', 'maestro', 'tesoriere'];
    const delleAree = leggiCorista(Astro.cookies);
    if (delleAree?.email.toLowerCase() === sessione.email.toLowerCase()) {
      return [apreArea(delleAree) && 'coristi', 'admin', apreMaestro(delleAree) && 'maestro', apreTesoriere(delleAree) && 'tesoriere'].filter(Boolean) as AreaRiservata[];
    }
    const c = coro.coristi;
    const dentro = (g?: string) => (g ? nelGruppo(sessione.email, g).catch(() => false) : Promise.resolve(false));
    const [inCoro, inDirezione, inAmministratori, inTesoreria] = await Promise.all([
      dentro(c?.gruppo), dentro(c?.direzione), dentro(c?.amministratori),
      Promise.all((c?.tesoreria?.gruppi ?? []).map(dentro)).then((x) => x.some(Boolean)),
    ]);
    return [
      (inCoro || inAmministratori) && 'coristi', 'admin', (inDirezione || inAmministratori) && 'maestro',
      // L'area del tesoriere in sola lettura anche ai redattori: tutti quelli che entrano qui, tranne chi entra solo per gli avvisi
      (inTesoreria || inAmministratori || sessione.redattore !== false) && 'tesoriere',
    ].filter(Boolean) as AreaRiservata[];
  }
  const c = Astro.locals.corista;
  if (!c) return undefined;
  return [apreArea(c) && 'coristi', (await ammessoAdmin(c)) && 'admin', apreMaestro(c) && 'maestro', apreTesoriere(c) && 'tesoriere'].filter(Boolean) as AreaRiservata[];
})();
// Nell'area del tesoriere redattori e amministratori leggono soltanto: niente Avvisi e una striscia che lo dice
// Gruppo Demo (src/area/demo.ts): una striscia lo dice e i moduli non partono (il middleware li rifiuta comunque)
const demo = !DEMO && Boolean(admin ? sessione?.demo : Astro.locals.corista?.demo);
const solaLettura = tipo === 'tesoriere' && !DEMO && !demo && Boolean(Astro.locals.corista && !scriveTesoriere(Astro.locals.corista));
const aree = areeRiservate(veste, false, permesse);
const nomeArea = { coristi: 'Area coristi', maestro: 'Area del Maestro', tesoriere: 'Area del tesoriere', admin: 'Amministrazione' }[tipo];
const info = {
  coristi: `Area coristi · accesso riservato ai coristi del ${coro.nome}`,
  maestro: `Area del Maestro · accesso riservato alla direzione del ${coro.nome}`,
  tesoriere: `Area del tesoriere · accesso riservato al tesoriere del ${coro.nome}`,
  admin: `Amministrazione · accesso riservato ai redattori del sito del ${coro.nome}`,
}[tipo];
const casa = (conBarra && aree.find((a) => a.id === tipo)?.href) || link(veste, '/');

// Nell'Amministrazione solo chi ha un ruolo nella bacheca vede la voce Avvisi (i gruppi sono letti al
// più ogni 5 minuti); chi entra solo per gli avvisi (redattore = false) vede soltanto quella
const soloAvvisi = tipo === 'admin' && sessione?.redattore === false;
const scriveAvvisi = soloAvvisi || (tipo === 'admin' && conBarra && sessione
  ? (await ruoliDi(sessione.email).catch(() => [])).length > 0
  : false);

// Sezioni di ogni area; quelle con tab stanno, sul telefono, nella barra in basso (al più cinque)
type Sezione = { id: string; testo: string; breve?: string; icona?: NomeIcona; href: string; gruppo?: string; tab?: boolean };
const sezioni = ({
  coristi: [
    { id: 'bacheca', testo: 'Bacheca', icona: 'casa', href: link(veste, '/area'), tab: true },
    { id: 'prove', testo: 'Calendario', icona: 'calendario', href: link(veste, '/area/prove'), tab: true },
    // Le prove già fatte della stagione, ognuna con le sue registrazioni
    { id: 'registrazioni', testo: 'Registrazioni', icona: 'microfono', href: link(veste, '/area/registrazioni'), tab: true },
    { id: 'concerti', testo: 'Concerti', icona: 'biglietto', href: link(veste, '/area/concerti'), tab: true },
    { id: 'repertorio', testo: 'Repertorio', icona: 'libro', href: link(veste, '/area/repertorio'), tab: true },
    // Le foto dei concerti (dal 5/10/2026): nel menu, la barra in basso ha già cinque voci
    ...(DEMO ? [] : [{ id: 'foto', testo: 'Foto', icona: 'fotocamera' as const, href: '/area/foto' }]),
  ],
  maestro: [
    { id: 'report', testo: 'Presenze', icona: 'presenze', href: '/maestro', tab: true },
    { id: 'repertorio', testo: 'Note sul repertorio', breve: 'Note', icona: 'libro', href: '/maestro/repertorio', tab: true },
    { id: 'avvisi', testo: 'Avvisi', icona: 'campanella', href: '/maestro/avvisi', tab: true },
  ],
  tesoriere: [
    { id: 'riepilogo', testo: 'Riepilogo e quote', breve: 'Riepilogo', icona: 'euro', href: '/tesoriere', tab: true },
    { id: 'cassa', testo: 'Entrate e uscite', breve: 'Cassa', icona: 'cassa', href: '/tesoriere/cassa', tab: true },
    { id: 'maestri', testo: 'Maestri', icona: 'nota', href: '/tesoriere/maestri', tab: true },
    { id: 'rendiconto', testo: 'Rendiconto', icona: 'documento', href: '/tesoriere/rendiconto', tab: true },
    { id: 'avvisi', testo: 'Avvisi', icona: 'campanella', href: '/tesoriere/avvisi', tab: true },
  ],
  admin: [
    // Due gruppi: quello che cambia il sito pubblico (va pubblicato) e quello dell'area coristi (vale subito)
    { id: 'pubblicazione', testo: 'Pubblicazione', href: '/admin', gruppo: 'Sito pubblico' },
    { id: 'concerti', testo: 'Concerti', href: '/admin/concerti' },
    { id: 'testi', testo: 'Testi del sito', href: '/admin/testi' },
    { id: 'foto', testo: 'Foto del sito', href: '/admin/foto' },
    { id: 'foto-concerti', testo: 'Foto dei concerti', href: '/admin/foto-concerti' },
    { id: 'statistiche', testo: 'Statistiche', href: '/admin/statistiche' },
    { id: 'prove', testo: 'Prove', href: '/admin/prove', gruppo: 'Coro' },
    { id: 'assenze', testo: 'Assenze', href: '/admin/assenze' },
    { id: 'repertorio', testo: 'Repertorio', href: '/admin/repertorio' },
    ...(scriveAvvisi ? [{ id: 'avvisi', testo: 'Avvisi', href: '/admin/avvisi' }] : []),
  ],
} as Record<typeof tipo, Sezione[]>)[tipo].filter((s) => (!soloAvvisi || s.id === 'avvisi') && !(solaLettura && s.id === 'avvisi'));
const tab = sezioni.filter((s) => s.tab && s.icona);
// L'invito a installare l'app solo nella prima pagina dell'area
const primaPagina = sezione === sezioni[0]?.id;
---
<CaricamentoPagina />

<div class:list={['servizio area-s', { 'con-menu': conBarra }]}>
  <div class="w">
    <span class="info">{info}</span>
    <span class="dx">
      <a href={link(veste, '/')}><Icona nome="indietro" />Sito pubblico</a>
      {aree.length > 1 && <MenuRiservato veste={veste} corrente={tipo} permesse={permesse} />}
    </span>
  </div>
</div>
<header class:list={['testata', { 'testata-area': conBarra && utente }]}>
  <div class="w">
    {conBarra && utente && <button class="hamb hamb-area" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu-area"><Icona nome="menu" classe="apri" spessore={2} /><Icona nome="chiudi" classe="chiudi" spessore={2} /></button>}
    <span class="marchio-area"><Marchio href={casa} /><span class="etichetta-area">{nomeArea}</span></span>
    {conBarra ? (
      utente && (
        <div class="azioni">
          <span class="utente"><span class="av" aria-hidden="true"><Icona nome="persona" classe="" spessore={2} />{utente.foto && <img src={utente.foto} alt="" referrerpolicy="no-referrer" onerror="this.remove()" />}</span><span class="nome"><b>{utente.nome}</b><small>{utente.dettaglio}</small></span></span>
          <a class="esci-btn" href={esci} aria-label="Esci" title="Esci"><Icona nome="esci" classe="" /></a>
        </div>
      )
    ) : (
      <div class="azioni"><a class="btn o piccolo" href={link(veste, '/')}><Icona nome="indietro" />Torna al sito</a></div>
    )}
  </div>
  {conBarra && (
    <div class="menu-mobile" id="menu-area">
      <div class="w">
        {aree.length > 1 && (
          <div class="riservate-mobile in-testa">
            <span class="eti"><Icona nome="lucchetto" />Area riservata</span>
            {aree.map((a) => <a href={a.href} class:list={{ on: a.id === tipo }} aria-current={a.id === tipo ? 'page' : undefined}><Icona nome={a.icona} />{a.testo}</a>)}
          </div>
        )}
        <div class="extra in-testa"><a class="btn o" href={link(veste, '/')}><Icona nome="indietro" />Sito pubblico</a></div>
        <div class:list={['voci-area', { 'tutte-in-tab': tab.length === sezioni.length }]}>
          {sezioni.map((s) => <>{s.gruppo && <span class="eti gruppo-menu">{s.gruppo}</span>}<a class:list={['voce', { on: s.id === sezione, 'in-tab': tab.includes(s) }]} href={s.href} aria-current={s.id === sezione ? 'page' : undefined}>{s.testo}<Icona nome="freccia" classe="" /></a></>)}
        </div>
        {utente && (
          <div class="esci-menu">
            <span class="utente-menu"><b>{utente.nome}</b><small>{utente.dettaglio}</small></span>
            <a class="btn o" href={esci}><Icona nome="esci" />Esci</a>
          </div>
        )}
      </div>
    </div>
  )}
</header>
{DEMO && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Demo:</b> qui l'area coristi è aperta a tutti. Nel sito vero si entra con l'account Google, solo se l'indirizzo è nell'elenco dei coristi. Nomi e dati sono di esempio.</span></div>
  </div>
)}
{ANTEPRIMA_AREA && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Anteprima:</b> l'area coristi è in preparazione. <b>Calendario</b>, <b>concerti</b>, <b>repertorio</b>, <b>registrazioni</b> e <b>avvisi</b> sono veri; il resto della bacheca è ancora di esempio.</span></div>
  </div>
)}
{conBarra && (
  <nav class="barra-area" aria-label={nomeArea}>
    <div class="w">
      {sezioni.map((s) => <>{s.gruppo && <span class="gruppo-barra" aria-hidden="true">{s.gruppo}</span>}<a href={s.href} class:list={{ on: s.id === sezione }} aria-current={s.id === sezione ? 'page' : undefined}>{s.icona && <Icona nome={s.icona} />}{s.testo}</a></>)}
    </div>
  </nav>
)}
{conBarra && tab.length > 0 && (
  <nav class="barra-tab" aria-label={`${nomeArea}, sezioni`}>
    {tab.map((s) => <a href={s.href} class:list={{ on: s.id === sezione }} aria-current={s.id === sezione ? 'page' : undefined}><Icona nome={s.icona!} classe="" /><span>{s.breve ?? s.testo}</span></a>)}
  </nav>
)}
{conBarra && demo && (
  <div class="sola-lettura no-stampa"><div class="w"><Icona nome="lucchetto" /><span><b>Demo.</b> {tipo === 'tesoriere' ? 'Di ogni sezione dell’area del tesoriere vedi una descrizione, non i dati.' : 'Puoi guardare tutto, ma niente viene salvato. Nomi ed email dei coristi sono inventati, note e foto private nascoste.'}</span></div></div>
)}
{demo && (
  <div class="avviso-demo" role="status" hidden><Icona nome="lucchetto" /><span>Questa è una demo: le modifiche non vengono salvate.</span></div>
  <script is:inline>
    // Modalità demo: i moduli che salvano non partono, compare un avviso (prima degli altri script)
    document.addEventListener('submit', (e) => {
      const f = e.target;
      // Passano solo i moduli che non salvano: le finestre (method="dialog") e i filtri (method="get")
      if (!(f instanceof HTMLFormElement) || ['get', 'dialog'].includes((f.getAttribute('method') || '').toLowerCase())) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      const a = document.querySelector('.avviso-demo');
      if (!a) return;
      a.hidden = false;
      clearTimeout(a._t);
      a._t = setTimeout(() => { a.hidden = true; }, 3500);
    }, true);
  </script>
)}
{conBarra && solaLettura && (
  <div class="sola-lettura no-stampa"><div class="w"><Icona nome="lucchetto" /><span><b>Sola lettura.</b> Puoi consultare quote, cassa, maestri e rendiconto; solo il tesoriere può modificare i dati.</span></div></div>
)}
{conBarra && !DEMO && primaPagina && <InvitoApp area={tipo} />}
{conBarra && !DEMO && !demo && primaPagina && (tipo === 'coristi' || tipo === 'maestro') && <InterruttoreNotifiche area={tipo} />}

<script>
  // Menu del telefono delle aree riservate (il sito pubblico usa src/motore/interazioni.ts, che
  // l'area Amministrazione non carica)
  import { attivaMenu } from '../../motore/menu-mobile';
  attivaMenu(document.querySelector<HTMLButtonElement>('.hamb-area'));
</script>

<style>
  .sola-lettura { background: color-mix(in srgb, var(--accento) 16%, var(--bianco)); border-bottom: 1px solid var(--linea); }
  .sola-lettura .w { display: flex; align-items: center; gap: 10px; padding-top: 10px; padding-bottom: 10px; font-size: 14px; line-height: 1.4; }
  .sola-lettura b { color: var(--primario); }
  .sola-lettura :global(svg) { width: 18px; height: 18px; flex-shrink: 0; color: var(--primario); }
  @media print { .sola-lettura { display: none; } }
  .avviso-demo { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 1000; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 32px); padding: 12px 18px; border-radius: var(--raggio); background: var(--primario); color: #fff; font-size: 15px; box-shadow: 0 8px 24px rgb(0 0 0 / .25); }
  .avviso-demo[hidden] { display: none; }
  .avviso-demo :global(svg) { width: 18px; height: 18px; flex-shrink: 0; color: var(--accento); }
</style>
