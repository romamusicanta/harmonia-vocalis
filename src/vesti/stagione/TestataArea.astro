---
// Veste Stagione: testata comune delle aree riservate (area coristi, area del Maestro, area
// Amministrazione), sempre in tre fasce: barra scura con il sito pubblico e la tendina "Area
// riservata" per passare da un'area all'altra; testata chiara con logo, nome dell'area, utente
// collegato e uscita; barra delle sezioni. Sul telefono (sotto 1000px) barra scura e sezioni stanno
// nel menu dell'hamburger (in alto aree riservate e sito pubblico, sotto le sezioni), con
// l'hamburger a sinistra, il logo al centro e utente ed Esci a destra. Con conBarra = false (pagine di accesso) niente utente, sezioni né
// menu, solo "Torna al sito".
import Icona, { type NomeIcona } from '../../componenti/Icona.astro';
import Marchio from './Marchio.astro';
import MenuRiservato from './MenuRiservato.astro';
import { areeRiservate } from './aree';
import InvitoApp from '../../area/InvitoApp.astro';
import { ANTEPRIMA_AREA, coro, DEMO } from '../../motore/coro';
import { link } from '../../motore/url';
import { corista } from '../../demo/area';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste; sezione?: string; conBarra?: boolean; maestro?: boolean; admin?: boolean }
const { veste, sezione, conBarra = true, maestro = false, admin = false } = Astro.props;
const tipo = admin ? 'admin' : maestro ? 'maestro' : 'coristi';

// Chi è entrato (src/middleware.ts), con la foto dell'account Google se c'è (altrimenti, o se non si
// carica, l'icona della persona); nella demo il corista di esempio
const sessione = Astro.locals.sessione;
const utente = admin
  ? sessione && { nome: sessione.nome || sessione.email, dettaglio: sessione.email, foto: sessione.foto }
  : Astro.locals.corista
    ? { nome: Astro.locals.corista.nome, dettaglio: Astro.locals.corista.email, foto: Astro.locals.corista.foto }
    : { nome: corista.nome, dettaglio: `${corista.sezione} · ${corista.email}`, foto: undefined as string | undefined };
const esci = admin ? '/admin/esci' : DEMO ? link(veste, '/area/accesso') : maestro ? '/area/esci?da=maestro' : '/area/esci';

const aree = areeRiservate(veste);
const nomeArea = { coristi: 'Area coristi', maestro: 'Area del Maestro', admin: 'Amministrazione' }[tipo];
const info = {
  coristi: `Area coristi · accesso riservato ai coristi del ${coro.nome}`,
  maestro: `Area del Maestro · accesso riservato alla direzione del ${coro.nome}`,
  admin: `Amministrazione · accesso riservato ai redattori del sito del ${coro.nome}`,
}[tipo];
const casa = (conBarra && aree.find((a) => a.id === tipo)?.href) || link(veste, '/');

// Sezioni di ogni area
const sezioni: { id: string; testo: string; icona?: NomeIcona; href: string; gruppo?: string }[] = {
  coristi: [
    { id: 'bacheca', testo: 'Bacheca', icona: 'casa', href: link(veste, '/area') },
    { id: 'prove', testo: 'Calendario', icona: 'calendario', href: link(veste, '/area/prove') },
    { id: 'concerti', testo: 'Concerti', icona: 'biglietto', href: link(veste, '/area/concerti') },
    { id: 'repertorio', testo: 'Repertorio', icona: 'libro', href: link(veste, '/area/repertorio') },
    { id: 'registrazioni', testo: 'Registrazioni', icona: 'microfono', href: link(veste, '/area/registrazioni') },
  ],
  maestro: [
    { id: 'report', testo: 'Presenze', icona: 'presenze', href: '/maestro' },
    { id: 'repertorio', testo: 'Note sul repertorio', icona: 'libro', href: '/maestro/repertorio' },
    { id: 'avvisi', testo: 'Avvisi', icona: 'campanella', href: '/maestro/avvisi' },
  ],
  admin: [
    // Due gruppi: quello che cambia il sito pubblico (va pubblicato) e quello dell'area coristi (vale subito)
    { id: 'pubblicazione', testo: 'Pubblicazione', href: '/admin', gruppo: 'Sito pubblico' },
    { id: 'concerti', testo: 'Concerti', href: '/admin/concerti' },
    { id: 'foto', testo: 'Foto del sito', href: '/admin/foto' },
    { id: 'prove', testo: 'Prove', href: '/admin/prove', gruppo: 'Coro' },
    { id: 'assenze', testo: 'Assenze', href: '/admin/assenze' },
    { id: 'repertorio', testo: 'Repertorio', href: '/admin/repertorio' },
    { id: 'avvisi', testo: 'Avvisi', href: '/admin/avvisi' },
  ],
}[tipo] as { id: string; testo: string; icona?: NomeIcona; href: string; gruppo?: string }[];
---

<div class:list={['servizio area-s', { 'con-menu': conBarra }]}>
  <div class="w">
    <span class="info">{info}</span>
    <span class="dx">
      <a href={link(veste, '/')}><Icona nome="indietro" />Sito pubblico</a>
      {aree.length > 1 && <MenuRiservato veste={veste} corrente={tipo} />}
    </span>
  </div>
</div>
<header class:list={['testata', { 'testata-area': conBarra && utente }]}>
  <div class="w">
    {conBarra && utente && <button class="hamb hamb-area" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu-area"><Icona nome="menu" classe="apri" spessore={2} /><Icona nome="chiudi" classe="chiudi" spessore={2} /></button>}
    <span class="marchio-area"><Marchio href={casa} /><span class="etichetta-area">{nomeArea}</span></span>
    {conBarra ? (
      utente && (
        <div class="azioni">
          <span class="utente"><span class="av" aria-hidden="true"><Icona nome="persona" classe="" spessore={2} />{utente.foto && <img src={utente.foto} alt="" referrerpolicy="no-referrer" onerror="this.remove()" />}</span><span class="nome"><b>{utente.nome}</b><small>{utente.dettaglio}</small></span></span>
          <a class="esci-btn" href={esci} aria-label="Esci" title="Esci"><Icona nome="esci" classe="" /></a>
        </div>
      )
    ) : (
      <div class="azioni"><a class="btn o piccolo" href={link(veste, '/')}><Icona nome="indietro" />Torna al sito</a></div>
    )}
  </div>
  {conBarra && (
    <div class="menu-mobile" id="menu-area">
      <div class="w">
        {aree.length > 1 && (
          <div class="riservate-mobile in-testa">
            <span class="eti"><Icona nome="lucchetto" />Area riservata</span>
            {aree.map((a) => <a href={a.href} class:list={{ on: a.id === tipo }} aria-current={a.id === tipo ? 'page' : undefined}><Icona nome={a.icona} />{a.testo}</a>)}
          </div>
        )}
        <div class="extra in-testa"><a class="btn o" href={link(veste, '/')}><Icona nome="indietro" />Sito pubblico</a></div>
        <div class="voci-area">
          {sezioni.map((s) => <>{s.gruppo && <span class="eti gruppo-menu">{s.gruppo}</span>}<a class:list={['voce', { on: s.id === sezione }]} href={s.href} aria-current={s.id === sezione ? 'page' : undefined}>{s.testo}<Icona nome="freccia" classe="" /></a></>)}
        </div>
      </div>
    </div>
  )}
</header>
{DEMO && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Demo:</b> qui l'area coristi è aperta a tutti. Nel sito vero si entra con l'account Google, solo se l'indirizzo è nell'elenco dei coristi. Nomi e dati sono di esempio.</span></div>
  </div>
)}
{ANTEPRIMA_AREA && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Anteprima:</b> l'area coristi è in preparazione. <b>Calendario</b>, <b>concerti</b>, <b>repertorio</b>, <b>registrazioni</b> e <b>avvisi</b> sono veri; il resto della bacheca è ancora di esempio.</span></div>
  </div>
)}
{conBarra && (
  <nav class="barra-area" aria-label={nomeArea}>
    <div class="w">
      {sezioni.map((s) => <>{s.gruppo && <span class="gruppo-barra" aria-hidden="true">{s.gruppo}</span>}<a href={s.href} class:list={{ on: s.id === sezione }} aria-current={s.id === sezione ? 'page' : undefined}>{s.icona && <Icona nome={s.icona} />}{s.testo}</a></>)}
    </div>
  </nav>
)}
{conBarra && !DEMO && <InvitoApp area={tipo} />}

<script>
  // Menu del telefono delle aree riservate (il sito pubblico usa src/motore/interazioni.ts, che
  // l'area Amministrazione non carica)
  import { attivaMenu } from '../../motore/menu-mobile';
  attivaMenu(document.querySelector<HTMLButtonElement>('.hamb-area'));
</script>
