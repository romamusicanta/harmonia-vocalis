---
// Veste Stagione: testata comune delle aree riservate (area coristi, area redattori, area tesoriere,
// area Maestro). Dall'8/10/2026 le sezioni stanno in un menu laterale a sinistra, raggruppate per area
// (solo le aree che chi è entrato può aprire; quella in cui si è aperta, le altre richiuse), con in fondo
// il sito pubblico, l'utente collegato ed Esci. Sul computer il menu si riduce alle sole icone con il
// pulsante in alto (la scelta resta nel browser, localStorage hv-laterale); sotto 1000px è un pannello
// che si apre con l'hamburger di una testata stretta (hamburger, logo con il nome dell'area, foto
// dell'utente). Sul telefono (sotto 760px) le sezioni principali dell'area in cui si è stanno anche in
// una barra fissa in basso, con icona e scritta. Con conBarra = false (pagine di accesso) niente
// utente né menu, solo la barra scura con la tendina delle aree e "Torna al sito".
import Icona, { type NomeIcona } from '../../componenti/Icona.astro';
import Marchio from './Marchio.astro';
import MenuRiservato from './MenuRiservato.astro';
import { areeRiservate, type AreaRiservata } from './aree';
import InvitoApp from '../../area/InvitoApp.astro';
import InterruttoreNotifiche from '../../area/InterruttoreNotifiche.astro';
import CaricamentoPagina from '../../area/CaricamentoPagina.astro';
import { ANTEPRIMA_AREA, coro, DEMO } from '../../motore/coro';
import { link } from '../../motore/url';
import { corista } from '../../demo/area';
import { ruoliDi } from '../../area/bacheca';
import { apreArea, apreMaestro, apreRedattori, apreTesoriere, gruppiDi, scriveTesoriere, leggiCorista, type Corista } from '../../area/accesso';
import type { Veste } from '../../motore/aspetto';

interface Props { veste: Veste; sezione?: string; conBarra?: boolean; maestro?: boolean; tesoriere?: boolean; admin?: boolean }
const { veste, sezione, conBarra = true, maestro = false, tesoriere = false, admin = false } = Astro.props;
const tipo: AreaRiservata = admin ? 'admin' : maestro ? 'maestro' : tesoriere ? 'tesoriere' : 'coristi';

// Chi è entrato (src/middleware.ts), con la foto dell'account Google se c'è (altrimenti, o se non si
// carica, l'icona della persona); nella demo il corista di esempio
const sessione = Astro.locals.sessione;
const utente = admin
  ? sessione && { nome: sessione.nome || sessione.email, dettaglio: sessione.email, foto: sessione.foto }
  : Astro.locals.corista
    ? { nome: Astro.locals.corista.nome, dettaglio: Astro.locals.corista.email, foto: Astro.locals.corista.foto }
    : { nome: corista.nome, dettaglio: `${corista.sezione} · ${corista.email}`, foto: undefined as string | undefined };
const esci = admin ? '/admin/esci' : DEMO ? link(veste, '/area/accesso') : maestro ? '/area/esci?da=maestro' : tesoriere ? '/area/esci?da=tesoriere' : '/area/esci';

// I gruppi di chi è entrato, per sapere quali aree mostrare: nell'area coristi, del Maestro e del
// tesoriere li dice la sessione (src/area/accesso.ts); nell'area redattori (altra sessione) quella delle
// aree, se è della stessa persona, altrimenti i gruppi, letti al più ogni 5 minuti. Nelle pagine di
// accesso, dove non si sa chi è, nessuno (aree come nel sito pubblico).
const persona: Corista | undefined = DEMO || !conBarra ? undefined : await (async () => {
  if (!admin) return Astro.locals.corista;
  if (!sessione) return undefined;
  const base = { email: sessione.email, nome: sessione.nome, verificato: 0 };
  if (sessione.demo) return { ...base, demo: true };
  const delleAree = leggiCorista(Astro.cookies);
  if (delleAree?.email.toLowerCase() === sessione.email.toLowerCase()) return delleAree;
  return { ...base, ...(await gruppiDi(sessione.email).catch(() => ({}))) };
})();
// I ruoli nella bacheca (presidente, amministratori…) danno la voce Avvisi nell'area redattori
const ruoli = persona && !persona.demo ? await ruoliDi(persona.email).catch(() => []) : [];
const permesse: AreaRiservata[] | undefined = persona && ([
  apreArea(persona) && 'coristi', (admin || apreRedattori(persona)) && 'admin', apreTesoriere(persona) && 'tesoriere', apreMaestro(persona) && 'maestro',
].filter(Boolean) as AreaRiservata[]);
const aree = areeRiservate(veste, false, permesse);

// Gruppo Demo (src/area/demo.ts): una striscia lo dice e i moduli non partono (il middleware li rifiuta comunque)
const demo = !DEMO && Boolean(persona?.demo);
// Nell'area del tesoriere gli amministratori leggono soltanto: niente Avvisi e una striscia che lo dice
const lettoreTesoriere = !DEMO && !demo && Boolean(persona && !scriveTesoriere(persona));
const solaLettura = tipo === 'tesoriere' && lettoreTesoriere;
const nomeArea = aree.find((a) => a.id === tipo)?.testo ?? { coristi: 'Area coristi', admin: 'Area redattori', tesoriere: 'Area tesoriere', maestro: 'Area Maestro' }[tipo];
const info = {
  coristi: `Area coristi · accesso riservato ai coristi del ${coro.nome}`,
  maestro: `Area Maestro · accesso riservato alla direzione del ${coro.nome}`,
  tesoriere: `Area tesoriere · accesso riservato al tesoriere del ${coro.nome}`,
  admin: `Area redattori · accesso riservato ai redattori del sito del ${coro.nome}`,
}[tipo];
const casa = (conBarra && aree.find((a) => a.id === tipo)?.href) || link(veste, '/');

// Sezioni di ogni area; quelle con tab stanno, sul telefono, nella barra in basso (al più cinque)
type Sezione = { id: string; testo: string; breve?: string; icona: NomeIcona; href: string; gruppo?: string; tab?: boolean };
const sezioniDi = (area: AreaRiservata): Sezione[] => ({
  coristi: [
    { id: 'bacheca', testo: 'Bacheca', icona: 'casa', href: link(veste, '/area'), tab: true },
    { id: 'prove', testo: 'Calendario', icona: 'calendario', href: link(veste, '/area/prove'), tab: true },
    // Le prove già fatte della stagione, ognuna con le sue registrazioni
    { id: 'registrazioni', testo: 'Registrazioni', icona: 'microfono', href: link(veste, '/area/registrazioni'), tab: true },
    { id: 'concerti', testo: 'Concerti', icona: 'biglietto', href: link(veste, '/area/concerti'), tab: true },
    { id: 'repertorio', testo: 'Repertorio', icona: 'libro', href: link(veste, '/area/repertorio'), tab: true },
    // Le foto dei concerti (dal 5/10/2026): nel menu, la barra in basso ha già cinque voci
    ...(DEMO ? [] : [{ id: 'foto', testo: 'Foto', icona: 'fotocamera' as const, href: '/area/foto' }]),
  ],
  admin: [
    // Due gruppi: quello che cambia il sito pubblico (va pubblicato) e quello dell'area riservata (vale subito)
    { id: 'pubblicazione', testo: 'Pubblicazione', icona: 'globo', href: '/admin', gruppo: 'Sito pubblico' },
    { id: 'concerti', testo: 'Concerti', icona: 'biglietto', href: '/admin/concerti' },
    { id: 'testi', testo: 'Testi del sito', icona: 'documento', href: '/admin/testi' },
    { id: 'foto', testo: 'Foto del sito', icona: 'immagine', href: '/admin/foto' },
    { id: 'foto-concerti', testo: 'Foto dei concerti', icona: 'fotocamera', href: '/admin/foto-concerti' },
    { id: 'statistiche', testo: 'Statistiche', icona: 'grafico', href: '/admin/statistiche' },
    { id: 'prove', testo: 'Prove', icona: 'calendario', href: '/admin/prove', gruppo: 'Area riservata' },
    { id: 'assenze', testo: 'Assenze', icona: 'presenze', href: '/admin/assenze' },
    { id: 'coristi', testo: 'Coristi', icona: 'persone', href: '/admin/coristi' },
    { id: 'repertorio', testo: 'Repertorio', icona: 'libro', href: '/admin/repertorio' },
    ...(ruoli.length > 0 ? [{ id: 'avvisi', testo: 'Avvisi', icona: 'campanella' as const, href: '/admin/avvisi' }] : []),
  ],
  tesoriere: [
    { id: 'riepilogo', testo: 'Riepilogo e quote', breve: 'Riepilogo', icona: 'euro', href: '/tesoriere', tab: true },
    { id: 'cassa', testo: 'Entrate e uscite', breve: 'Cassa', icona: 'cassa', href: '/tesoriere/cassa', tab: true },
    { id: 'maestri', testo: 'Maestri', icona: 'nota', href: '/tesoriere/maestri', tab: true },
    { id: 'rendiconto', testo: 'Rendiconto', icona: 'documento', href: '/tesoriere/rendiconto', tab: true },
    ...(lettoreTesoriere ? [] : [{ id: 'avvisi', testo: 'Avvisi', icona: 'campanella' as const, href: '/tesoriere/avvisi', tab: true }]),
  ],
  maestro: [
    { id: 'report', testo: 'Presenze', icona: 'presenze', href: '/maestro', tab: true },
    { id: 'repertorio', testo: 'Note sul repertorio', breve: 'Note', icona: 'libro', href: '/maestro/repertorio', tab: true },
    { id: 'avvisi', testo: 'Avvisi', icona: 'campanella', href: '/maestro/avvisi', tab: true },
  ],
} as Record<AreaRiservata, Sezione[]>)[area];
const sezioni = sezioniDi(tipo);
// Nel menu laterale tutte le aree permesse (nella demo del modello e nelle pagine di accesso solo questa)
const gruppi = (aree.some((a) => a.id === tipo) ? aree : [{ id: tipo, testo: nomeArea, href: casa, icona: 'persone' as NomeIcona }])
  .map((a) => ({ ...a, voci: sezioniDi(a.id) }));
const tab = sezioni.filter((s) => s.tab);
// L'invito a installare l'app solo nella prima pagina dell'area
const primaPagina = sezione === sezioni[0]?.id;
const conMenu = conBarra && Boolean(utente);
---
<CaricamentoPagina />

{conMenu ? (
  <>
    <script is:inline>
      // Menu laterale ridotto alle icone, se scelto (prima di disegnarlo, per non vederlo cambiare)
      try { if (localStorage.getItem('hv-laterale') === 'chiuso') document.documentElement.classList.add('laterale-chiuso'); } catch (e) {}
    </script>
    <header class="testata testata-area">
      <div class="w">
        <button class="hamb hamb-area" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu-area"><Icona nome="menu" classe="apri" spessore={2} /><Icona nome="chiudi" classe="chiudi" spessore={2} /></button>
        <span class="marchio-area"><Marchio href={casa} /><span class="etichetta-area">{nomeArea}</span></span>
        <div class="azioni">
          <span class="utente"><span class="av" aria-hidden="true"><Icona nome="persona" classe="" spessore={2} />{utente!.foto && <img src={utente!.foto} alt="" referrerpolicy="no-referrer" onerror="this.remove()" />}</span></span>
        </div>
      </div>
    </header>
    <aside class="laterale" id="menu-area" aria-label="Aree riservate">
      <div class="lat-testa">
        <span class="lat-marchio"><Marchio href={casa} /></span>
        <button class="lat-riduci" type="button" aria-label="Riduci il menu" title="Riduci il menu" aria-expanded="true"><Icona nome="pannello" classe="" /></button>
        <button class="lat-chiudi" type="button" aria-label="Chiudi il menu"><Icona nome="chiudi" classe="" spessore={2} /></button>
      </div>
      <nav class="lat-voci">
        {gruppi.map((g) => (
          <details class="lat-area" open={g.id === tipo}>
            <summary title={g.testo}><Icona nome={g.icona} classe="" /><span class="t">{g.testo}</span><Icona nome="giu" classe="freccina" /></summary>
            <ul>
              {g.voci.map((v) => {
                const on = g.id === tipo && v.id === sezione;
                return <>
                  {v.gruppo && <li class="lat-gruppo" aria-hidden="true"><span class="t">{v.gruppo}</span></li>}
                  <li><a href={v.href} class:list={{ on }} aria-current={on ? 'page' : undefined} title={v.testo}><Icona nome={v.icona} classe="" /><span class="t">{v.testo}</span></a></li>
                </>;
              })}
            </ul>
          </details>
        ))}
      </nav>
      <div class="lat-piede">
        <a class="lat-voce" href={link(veste, '/')} title="Sito pubblico"><Icona nome="globo" classe="" /><span class="t">Sito pubblico</span></a>
        <div class="lat-utente utente">
          <span class="av" aria-hidden="true"><Icona nome="persona" classe="" spessore={2} />{utente!.foto && <img src={utente!.foto} alt="" referrerpolicy="no-referrer" onerror="this.remove()" />}</span>
          <span class="nome t"><b>{utente!.nome}</b><small>{utente!.dettaglio}</small></span>
          <a class="esci-btn" href={esci} aria-label="Esci" title="Esci"><Icona nome="esci" classe="" /></a>
        </div>
      </div>
    </aside>
    <div class="laterale-velo" aria-hidden="true"></div>
  </>
) : (
  <>
    <div class="servizio area-s">
      <div class="w">
        <span class="info">{info}</span>
        <span class="dx">
          <a href={link(veste, '/')}><Icona nome="indietro" />Sito pubblico</a>
          {aree.length > 1 && <MenuRiservato veste={veste} corrente={tipo} permesse={permesse} />}
        </span>
      </div>
    </div>
    <header class="testata">
      <div class="w">
        <span class="marchio-area"><Marchio href={casa} /><span class="etichetta-area">{nomeArea}</span></span>
        <div class="azioni"><a class="btn o piccolo" href={link(veste, '/')}><Icona nome="indietro" />Torna al sito</a></div>
      </div>
    </header>
  </>
)}
{DEMO && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Demo:</b> qui l'area coristi è aperta a tutti. Nel sito vero si entra con l'account Google, solo se l'indirizzo è nell'elenco dei coristi. Nomi e dati sono di esempio.</span></div>
  </div>
)}
{ANTEPRIMA_AREA && tipo === 'coristi' && (
  <div class="avviso-anteprima" role="note">
    <div class="w"><Icona nome="info" classe="" /><span><b>Anteprima:</b> l'area coristi è in preparazione. <b>Calendario</b>, <b>concerti</b>, <b>repertorio</b>, <b>registrazioni</b> e <b>avvisi</b> sono veri; il resto della bacheca è ancora di esempio.</span></div>
  </div>
)}
{conMenu && tab.length > 0 && (
  <nav class="barra-tab" aria-label={`${nomeArea}, sezioni`}>
    {tab.map((s) => <a href={s.href} class:list={{ on: s.id === sezione }} aria-current={s.id === sezione ? 'page' : undefined}><Icona nome={s.icona} classe="" /><span>{s.breve ?? s.testo}</span></a>)}
  </nav>
)}
{conMenu && demo && (
  <div class="sola-lettura no-stampa"><div class="w"><Icona nome="lucchetto" /><span><b>Demo.</b> {tipo === 'tesoriere' ? 'Puoi guardare tutto, ma niente viene salvato. Cifre, note e nomi dei coristi sono nascosti o inventati.' : 'Puoi guardare tutto, ma niente viene salvato. Nomi ed email dei coristi sono inventati, note e foto private nascoste.'}</span></div></div>
)}
{demo && (
  <div class="avviso-demo" role="status" hidden><Icona nome="lucchetto" /><span>Questa è una demo: le modifiche non vengono salvate.</span></div>
  <script is:inline>
    // Modalità demo: i moduli che salvano non partono, compare un avviso (prima degli altri script)
    document.addEventListener('submit', (e) => {
      const f = e.target;
      // Passano solo i moduli che non salvano: le finestre (method="dialog") e i filtri (method="get")
      if (!(f instanceof HTMLFormElement) || ['get', 'dialog'].includes((f.getAttribute('method') || '').toLowerCase())) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      const a = document.querySelector('.avviso-demo');
      if (!a) return;
      a.hidden = false;
      clearTimeout(a._t);
      a._t = setTimeout(() => { a.hidden = true; }, 3500);
    }, true);
  </script>
)}
{conMenu && solaLettura && (
  <div class="sola-lettura no-stampa"><div class="w"><Icona nome="lucchetto" /><span><b>Sola lettura.</b> Puoi consultare quote, cassa, maestri e rendiconto; solo il tesoriere può modificare i dati.</span></div></div>
)}
{conMenu && !DEMO && primaPagina && <InvitoApp area={tipo} />}
{conMenu && !DEMO && !demo && primaPagina && (tipo === 'coristi' || tipo === 'maestro') && <InterruttoreNotifiche area={tipo} />}

<script>
  // Sotto 1000px il menu laterale è un pannello che si apre con l'hamburger (src/motore/menu-mobile.ts;
  // l'area redattori non carica src/motore/interazioni.ts); si chiude anche con la X e toccando fuori.
  // Sul computer il pulsante in alto lo riduce alle sole icone, e il browser ricorda la scelta.
  import { attivaMenu } from '../../motore/menu-mobile';
  const hamb = document.querySelector<HTMLButtonElement>('.hamb-area');
  attivaMenu(hamb);
  const chiudi = () => { if (document.body.classList.contains('menu-aperto')) hamb?.click(); };
  document.querySelector('.laterale-velo')?.addEventListener('click', chiudi);
  document.querySelector('.lat-chiudi')?.addEventListener('click', () => { chiudi(); hamb?.focus(); });
  const riduci = document.querySelector<HTMLButtonElement>('.lat-riduci');
  const segna = () => {
    const chiuso = document.documentElement.classList.contains('laterale-chiuso');
    const nome = chiuso ? 'Allarga il menu' : 'Riduci il menu';
    riduci?.setAttribute('aria-expanded', String(!chiuso));
    riduci?.setAttribute('aria-label', nome);
    riduci?.setAttribute('title', nome);
  };
  segna();
  riduci?.addEventListener('click', () => {
    const chiuso = document.documentElement.classList.toggle('laterale-chiuso');
    try { localStorage.setItem('hv-laterale', chiuso ? 'chiuso' : 'aperto'); } catch {}
    segna();
  });
  // Ridotto alle icone, aprire un'area la riallarga: le sue voci si leggono
  document.querySelectorAll<HTMLElement>('.lat-area summary').forEach((s) => s.addEventListener('click', (e) => {
    if (!document.documentElement.classList.contains('laterale-chiuso') || !matchMedia('(min-width: 1000px)').matches) return;
    e.preventDefault();
    (s.parentElement as HTMLDetailsElement).open = true;
    document.documentElement.classList.remove('laterale-chiuso');
    try { localStorage.setItem('hv-laterale', 'aperto'); } catch {}
    segna();
  }));
</script>

<style>
  .sola-lettura { background: color-mix(in srgb, var(--accento) 16%, var(--bianco)); border-bottom: 1px solid var(--linea); }
  .sola-lettura .w { display: flex; align-items: center; gap: 10px; padding-top: 10px; padding-bottom: 10px; font-size: 14px; line-height: 1.4; }
  .sola-lettura b { color: var(--primario); }
  .sola-lettura :global(svg) { width: 18px; height: 18px; flex-shrink: 0; color: var(--primario); }
  @media print { .sola-lettura { display: none; } }
  .avviso-demo { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 1000; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 32px); padding: 12px 18px; border-radius: var(--raggio); background: var(--primario); color: #fff; font-size: 15px; box-shadow: 0 8px 24px rgb(0 0 0 / .25); }
  .avviso-demo[hidden] { display: none; }
  .avviso-demo :global(svg) { width: 18px; height: 18px; flex-shrink: 0; color: var(--accento); }
</style>
