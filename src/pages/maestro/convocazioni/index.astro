---
// Area del Maestro: convocazioni ai concerti, come nell'Amministrazione (src/area/convocazioni.ts)
import Base from '../../../layouts/Base.astro';
import GestioneConvocazioni from '../../../area/GestioneConvocazioni.astro';
import { dopoIlModulo } from '../../../area/convocazioni';
import { vesteCorrente } from '../../../motore/url';

export const prerender = false;
const veste = vesteCorrente(undefined);
if (Astro.request.method === 'POST') return Astro.redirect(await dopoIlModulo(Astro.request, Astro.locals.corista!.email, '/maestro/convocazioni'));
---

<Base veste={veste} titolo="Convocazioni · Area del Maestro" area={{ maestro: true, sezione: 'convocazioni' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Area del Maestro</span>
        <h1>Convocazioni</h1>
        <p>Per ogni concerto: orario di convocazione, prova generale, programma della giornata, abito e pezzi in programma. I coristi le trovano nella pagina Concerti della loro area.</p>
      </div>
    </div>
  </div>
  <div class="area-main"><div class="w" style="max-width:960px"><GestioneConvocazioni base="/maestro" /></div></div>
</Base>
