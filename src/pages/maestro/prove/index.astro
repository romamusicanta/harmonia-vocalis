---
// Area del Maestro: le prove del calendario "Prove", come nell'Amministrazione; scrive l'account
// di servizio (src/admin/ElencoProve.astro)
import Base from '../../../layouts/Base.astro';
import ElencoProve from '../../../admin/ElencoProve.astro';
import { vesteCorrente } from '../../../motore/url';

export const prerender = false;
const veste = vesteCorrente(undefined);
---

<Base veste={veste} titolo="Prove · Area del Maestro" area={{ maestro: true, sezione: 'prove' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Area del Maestro</span>
        <h1>Prove</h1>
        <p>Le prove del calendario dei coristi: per ognuna puoi indicare i pezzi del repertorio, i passi da preparare, le note e, dopo, il link alla registrazione. La prova del mercoledì si ripete ogni settimana: modificare o cancellare una data cambia solo quella.</p>
      </div>
    </div>
  </div>
  <div class="area-main"><div class="w" style="max-width:960px"><ElencoProve base="/maestro" chi="servizio" /></div></div>
</Base>
