---
// Area del Maestro: nuova prova nel calendario "Prove"
import Base from '../../../layouts/Base.astro';
import ModuloProva from '../../../admin/ModuloProva.astro';
import { vesteCorrente } from '../../../motore/url';

export const prerender = false;
const veste = vesteCorrente(undefined);
const data = Astro.url.searchParams.get('data') ?? undefined;
---

<Base veste={veste} titolo="Nuova prova · Area del Maestro" area={{ maestro: true, sezione: 'prove' }}>
  <div class="area-intesta"><div class="w"><div><span class="eti" style="margin-bottom:12px">Prove</span><h1>Nuova prova</h1></div></div></div>
  <div class="area-main"><div class="w"><ModuloProva data={data} base="/maestro" /></div></div>
</Base>
