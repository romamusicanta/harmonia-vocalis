---
import Base from '../layouts/Base.astro';
import SchedaConcerto from '../components/SchedaConcerto.astro';
import { site } from '../config';
import { archivio } from '../data/concerti';
import { getProssimiConcerti } from '../lib/concerti';

const concerti = await getProssimiConcerti();
const perAnno = Object.entries(Object.groupBy(archivio, (p) => String(p.anno))).sort(([a], [b]) => +b - +a);
const iscrizione = site.link.calendarioId
  ? `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(site.link.calendarioId)}`
  : undefined;
const yt = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---

<Base titolo="Concerti" descrizione="I prossimi concerti del Coro Harmonia Vocalis e l'archivio dei programmi eseguiti.">
  <header class="intestazione-pagina">
    <div class="contenitore">
      <span class="occhiello">Concerti</span>
      <h1>Vieni ad ascoltarci</h1>
      <p class="introduzione">
        Cantiamo a Roma, in provincia e fuori regione, spesso con orchestra, in rassegne promosse da enti pubblici e
        istituzioni culturali.
      </p>
      {iscrizione && (
        <div class="azioni">
          <a class="pulsante pulsante--vuoto" href={iscrizione} rel="noopener">Segui il calendario dei concerti</a>
        </div>
      )}
    </div>
  </header>

  <section class="sezione">
    <div class="contenitore">
      <h2>In programma</h2>
      {concerti.length > 0 ? (
        <div class="elenco">
          {concerti.map((c, i) => <SchedaConcerto concerto={c} inEvidenza={i === 0} />)}
        </div>
      ) : (
        <p class="introduzione">Nessun concerto in calendario al momento: la prossima stagione è in preparazione.</p>
      )}
    </div>
  </section>

  <section class="sezione sezione--alt">
    <div class="contenitore">
      <span class="occhiello">Archivio</span>
      <h2>Le opere che abbiamo cantato</h2>
      <div class="archivio">
        {perAnno.map(([anno, programmi]) => (
          <div class="anno">
            <p class="anno__numero">{anno}</p>
            <ul>
              {programmi!.map((p) => (
                <li class="programma">
                  <p class="programma__autore">{p.autore}</p>
                  <p class="programma__opera">{p.opera}</p>
                  {p.luoghi && <p class="programma__luogo">{p.luoghi}</p>}
                  {(p.video || p.estratti) && (
                    <p class="programma__ascolta">
                      {p.video && <a href={yt(p.video)} rel="noopener">▶ Concerto completo</a>}
                      {p.estratti?.map((e) => <a href={yt(e.video)} rel="noopener">▶ {e.titolo}</a>)}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .elenco { display: grid; gap: 1.25rem; margin-top: 1.5rem; }

  .archivio { margin-top: 2.5rem; display: grid; gap: 0; }
  .anno { display: grid; gap: 0.5rem 2rem; padding-block: 1.75rem; border-top: 1px solid var(--linea); }
  @media (min-width: 48rem) { .anno { grid-template-columns: 7rem 1fr; } }
  .anno__numero { font: 500 2.4rem/1 var(--serif); color: var(--oro); margin: 0; }
  .anno ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .programma p { margin: 0; }
  .programma__autore {
    font: 600 0.72rem/1.4 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--inchiostro-2);
  }
  .programma__opera { font: 500 1.6rem/1.25 var(--serif); }
  .programma__luogo { font-size: 0.92rem; color: var(--inchiostro-2); font-style: italic; }
  .programma__ascolta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin-top: 0.5rem !important; font-size: 0.9rem; }
  .programma__ascolta a { text-decoration: none; }
  .programma__ascolta a:hover { text-decoration: underline; }
</style>
