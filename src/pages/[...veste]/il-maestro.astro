---
// Pagina "Il Maestro": presentazione, biografia, lavori, un video "sul podio".
import Base from '../../layouts/Base.astro';
import Foto from '../../componenti/Foto.astro';
import Video from '../../componenti/Video.astro';
import NotaVideo from '../../componenti/NotaVideo.astro';
import { coro } from '../../motore/coro';
import { link, percorsiVesti, vesteCorrente } from '../../motore/url';
import { testo } from '../../motore/testi';
import { elencoVideo } from '../../motore/video';

export const getStaticPaths = percorsiVesti;
const veste = vesteCorrente(Astro.params.veste);
const l = (p: string) => link(veste, p);

type Lavoro = { anno: string | number; autore?: string; titolo: string; nota?: string; video?: string };
const { dati, Contenuto } = testo<{ titolo?: string; etichetta?: string; attacco?: string; titoloLavori?: string; lavori?: Lavoro[] }>('maestro');
const m = coro.maestro;
const nome = (dati.titolo ?? m.nome).replace(/\.$/, '');
const lavori = dati.lavori ?? [];

// "Livia Serafini" → "L. Serafini"
const parole = m.nome.split(/\s+/);
const nomeBreve = [...parole.slice(0, -1).map((p) => `${p[0]}.`), parole.at(-1)].join(' ');

// Sul podio: il video più recente di un concerto (non quelli di presentazione del coro)
const sulPodio = (await elencoVideo()).find((v) => v.autore !== 'Il coro');
const attacco = m.presentazione.charAt(0).toLowerCase() + m.presentazione.slice(1).replace(/\.$/, '');
---

<Base veste={veste} titolo="Il Maestro" pagina="il-maestro" anteprima={m.foto} descrizione={`Il M° ${m.nome}, ${attacco}.`}>
  {/* Dati: coro.config.ts → maestro; etichetta da coro/testi/maestro.md */}
  <section class="apertura" style="border-bottom:1px solid var(--linea)">
    <div class="w" style="padding-top:0">
      <div class="stagione" style="padding-top:72px">
        <span class="eti">{dati.etichetta ?? 'Il Maestro del coro'}</span>
        <h1 style="font-size:clamp(32px,4.2vw,54px);line-height:1.05;letter-spacing:-0.012em">{nome}<span>.</span></h1>
        <p>{m.presentazione}</p>
      </div>
      <div class="blocco-foto" style="min-height:520px">
        <Foto nome={m.foto} alt={`Il M° ${m.nome}`} caricamento="eager" sizes="(min-width: 980px) 50vw, 100vw" style="object-position:center 20%;mix-blend-mode:normal;opacity:1" />
        {m.anniPodio ? (
          <div class="scheda" style="max-width:300px"><div class="n" style="font-size:44px">{m.anniPodio}<small>anni sul podio</small></div><p style="font-size:16px;font-weight:600">Alla guida del {coro.nome}.</p></div>
        ) : null}
      </div>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="due-col">
        {/* Dati: coro/testi/maestro.md (attacco, corpo, lavori) */}
        <div class="testo-lungo">
          {dati.attacco && <p class="apertura-testo">{dati.attacco}</p>}
          <Contenuto />

          {lavori.length > 0 && (
            <>
              <h3>{dati.titoloLavori ?? 'Arrangiamenti e revisioni'}</h3>
              <div style="border-top:3px solid var(--primario)">
                {lavori.map((lv) => (
                  <div class="riga" style="grid-template-columns:80px minmax(0,1fr)">
                    <span class="quando anno">{lv.anno}</span>
                    <div class="cosa">
                      {lv.autore && <span class="aut">{lv.autore}</span>}
                      <b>{lv.titolo}</b>
                      {(lv.nota || lv.video) && (
                        <span class="tenue" style="font-size:15px">
                          {lv.nota}{lv.nota && lv.video && ' · '}{lv.video && coro.funzioni.ascolta && <a href={l(`/ascolta#${lv.video}`)} style="text-decoration:underline">ascolta</a>}
                        </span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>

        <aside class="appiccicoso">
          {sulPodio && (
            <>
              {/* Dati: canale YouTube (video più recente di un concerto) */}
              <span class="eti" style="margin-bottom:14px">Sul podio</span>
              <Video video={sulPodio} piccolo sottotitolo={[`Dir. ${nomeBreve}`, sulPodio.sottotitolo].filter(Boolean).join(' · ')} />
              <NotaVideo breve />
            </>
          )}
          {coro.funzioni.cantaConNoi && (
            <div class="riquadro" style={sulPodio ? 'margin-top:28px' : undefined}>
              {/* Dati: coro.config.ts → prove.orari */}
              <h3>Studiare con il Maestro</h3>
              <p class="tenue" style="margin-bottom:16px">Il coro cerca nuove voci in tutte le sezioni. Le prove: {coro.prove.orari.charAt(0).toLowerCase()}{coro.prove.orari.slice(1)}.</p>
              <a class="btn" href={l('/canta-con-noi')}>Canta con noi</a>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</Base>
