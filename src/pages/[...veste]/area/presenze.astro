---
// Area coristi: presenze attese alla prossima prova per sezione, assenti segnalati,
// registro delle ultime prove e presenze personali.
import Base from '../../../layouts/Base.astro';
import Icona from '../../../componenti/Icona.astro';
import { AREA_CORISTI, coro, DEMO } from '../../../motore/coro';
import { link, percorsiVesti, vesteCorrente } from '../../../motore/url';
import {
  corista, prossimaProva, assenzeProssima, ritardiProssima, storicoPresenze, sezioni, voci, totaleVoci,
  giorno, percento, iniziali, dataGiorno,
} from '../../../demo/area';

export const getStaticPaths = () => (AREA_CORISTI ? percorsiVesti() : []);
const veste = vesteCorrente(Astro.params.veste);

const p = prossimaProva;
const gp = giorno(p.data);
const attesi = totaleVoci - assenzeProssima.length;
const perSezione = sezioni.map((s) => {
  const assenti = assenzeProssima.filter((a) => a.sezione === s).length;
  return { sezione: s, totale: voci[s], assenti, presenti: voci[s] - assenti };
});
const breveTab = (iso: string) => { const d = giorno(iso); return `${d.giornoSettimana.slice(0, 3)} ${Number(d.giorno)} ${d.meseBreve.toLowerCase()}`; };
const mie = storicoPresenze.filter((r) => r.tu).length;
const conNota = storicoPresenze.filter((r) => r.nota);
const maiuscola = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<Base veste={veste} titolo="Presenze · Area coristi" area={{ sezione: 'presenze' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Presenze</span>
        <h1>Chi c'è {gp.giornoSettimana.toLowerCase()}</h1>
        <p>Per decisione del direttivo le presenze sono visibili a tutti i coristi: così ogni sezione sa su chi può contare. Le assenze si segnalano dalla pagina <a href={link(veste, '/area/prove')} style="text-decoration:underline">Prove</a>.</p>
      </div>
    </div>
  </div>

  <div class="area-main">
    <div class="w">
      <div class="cruscotto">
        <article class="carta c-7 su">
          <div class="ct"><h2>{maiuscola(dataGiorno(p.data))} · {p.inizio} · {p.titolo.split(' · ')[0].toLowerCase()}</h2><span class="tag">Prossima prova</span></div>
          <div class="cc" style="display:flex;gap:28px;flex-wrap:wrap;align-items:end;border-bottom:1px solid var(--linea)">
            <div><b style="font-family:var(--f-titoli);font-weight:var(--peso-titoli);font-size:56px;line-height:.8;letter-spacing:-0.012em;color:var(--primario)">{attesi}</b><span class="tenue" style="font-size:18px;font-weight:600;margin-left:10px">presenti attesi su {totaleVoci}</span></div>
            <div class="legenda"><span><i style="background:var(--primario)"></i>Attesi</span><span><i style="background:var(--rosso)"></i>Assenti</span></div>
          </div>
          <div class="sezioni-presenze">
            {perSezione.map((s) => {
              const tua = s.sezione === corista.sezione;
              return <div class:list={['sp', { tua }]}><span class="nome">{s.sezione}{tua && <span class="tag" style="margin-left:6px;vertical-align:middle">La tua sezione</span>}</span><span class="cifre"><b>{s.presenti}</b> / {s.totale} · {s.assenti === 1 ? '1 assente' : `${s.assenti} assenti`}</span><span class="barra"><i style={`width:${percento(s.presenti, s.totale)};background:var(--primario)`}></i><i style={`width:${percento(s.assenti, s.totale)};background:var(--rosso)`}></i></span></div>;
            })}
          </div>
        </article>

        <article class="carta c-5 su">
          <div class="ct"><h2>Assenti segnalati</h2><span class="tag rosso">{assenzeProssima.length}</span></div>
          <ul class="assenti">
            {assenzeProssima.map((a) => (
              <li><span class="av">{iniziali(a.nome.replace('.', ''))}</span><b>{a.nome}<small>{a.sezione}</small></b>{a.nota ? <span>{a.nota}</span> : <span class="tenue" style="font-style:italic">Nessuna nota</span>}</li>
            ))}
          </ul>
          {ritardiProssima.length > 0 && (
            <div class="cc" style="border-top:1px solid var(--linea);font-size:14px">
              <span class="tenue">Arrivano in ritardo: {ritardiProssima.map((r, i) => <>{i > 0 && ', '}<b style="color:var(--primario)">{r.nome}</b> ({r.sezione}, alle {r.ora})</>)}</span>
            </div>
          )}
        </article>

        <article class="carta c-12">
          <div class="ct"><h2>Ultime prove</h2><span class="tenue" style="font-size:14px">Presenti per sezione</span></div>
          <div class="tabella-wrap">
            <table class="tabella">
              <thead><tr><th>Prova</th>{sezioni.map((s) => <th class="num">{s}</th>)}<th class="num">Tu</th><th class="num">Totale</th></tr></thead>
              <tbody>
                {storicoPresenze.map((r) => {
                  const tot = sezioni.reduce((n, s) => n + (r.presenti[s] ?? 0), 0);
                  return (
                    <tr><td>{breveTab(r.data)}</td>{sezioni.map((s) => <td class="num">{r.presenti[s] ?? 0}/{voci[s]}</td>)}<td class="num">{r.tu ? <Icona nome="spunta" /> : <span class="tenue">assente</span>}</td><td class="num"><span class="cella-barra"><b>{tot}</b><span class="barra"><i style={`width:${percento(tot, totaleVoci)}`}></i></span></span></td></tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="cc tenue" style="border-top:1px solid var(--linea);font-size:14px">
            Tu, {Astro.locals.corista?.nome ?? corista.nome}: presente a {mie} prove su {storicoPresenze.length}.{conNota.map((r) => <> {maiuscola(dataGiorno(r.data))}: {r.nota}.</>)}
          </div>
        </article>
      </div>
    </div>
  </div>
</Base>
