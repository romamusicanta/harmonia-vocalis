---
import PaginaConcerto from '../../../pagine/PaginaConcerto.astro';
import { archivio, prossimiConcerti, slug } from '../../../motore/concerti';
import { percorsiVesti, vesteCorrente } from '../../../motore/url';
import type { Concerto } from '../../../motore/tipi';

// Una pagina per ogni concerto con una data precisa, in programma o passato
export async function getStaticPaths() {
  const concerti = [...(await prossimiConcerti()), ...archivio.filter((c) => !c.dataIncerta)];
  return percorsiVesti().flatMap(({ params }) =>
    concerti.map((concerto) => ({ params: { veste: params.veste, slug: slug(concerto) }, props: { concerto } })),
  );
}

interface Props { concerto: Concerto }
---

<PaginaConcerto concerto={Astro.props.concerto} veste={vesteCorrente(Astro.params.veste)} />
