---
// Area coristi: foto dei concerti (/area/foto, src/area/fotoConcerti.ts). In alto si sceglie un concerto
// già fatto, anche vecchio (?concerto=<id del concerto o data>; di base il più recente che ha foto): dal
// 13/10/2026 la pagina mostra solo le sue foto, per non caricare centinaia di miniature, e le foto caricate
// vanno in quel concerto. Il caricamento: una o più foto; il browser le riduce (lato lungo 2400 px, JPEG)
// e le carica una dopo l'altra (/area/foto/carica). Sotto, le foto del concerto che vedono i coristi (miniature da /area/foto/miniatura, la foto intera da /area/file),
// con "Sul sito" per quelle che i redattori hanno messo nel sito pubblico; chi
// ha caricato una foto la può togliere, finché non è sul sito pubblico (poi solo i redattori).
import Base from '../../layouts/Base.astro';
import Icona from '../../componenti/Icona.astro';
import Errore from '../../area/Errore.astro';
import { vesteCorrente } from '../../motore/url';
import { parti } from '../../motore/concerti';
import { concertiPerFoto, configurato, fotoDeiConcerti, sulSito, type ConcertoConFoto, type ConcertoScelta } from '../../area/fotoConcerti';
import { normalizza } from '../../area/servizio';
import VisoreFoto from '../../area/VisoreFoto.astro';

export const prerender = false;
const veste = vesteCorrente(undefined);
const email = normalizza(Astro.locals.corista!.email);

let errore: unknown;
let concerti: ConcertoScelta[] = [];
let gallerie: ConcertoConFoto[] = [];
if (!configurato()) errore = 'Le foto dei concerti non sono ancora collegate: manca la cartella su Drive (variabile DRIVE_CARTELLA_FOTO_CONCERTI sul server).';
else {
  try {
    [concerti, gallerie] = await Promise.all([concertiPerFoto(), fotoDeiConcerti()]);
  } catch (e) {
    errore = e;
  }
}
const quando = (iso: string) => { const d = parti({ data: iso }); return `${Number(d.giorno)} ${d.mese.toLowerCase()} ${d.anno}`; };
// Le foto di un concerto: quelle legate al suo evento o, per i concerti vecchi, dello stesso giorno
const fotoDi = (c: ConcertoScelta) => gallerie.filter((g) => g.evento?.id === c.id || (!g.evento && g.data === c.data)).flatMap((g) => g.foto);
const richiesto = Astro.url.searchParams.get('concerto');
const scelto = concerti.find((c) => c.id === richiesto || c.data === richiesto)
  ?? concerti.find((c) => gallerie[0] && (gallerie[0].evento?.id === c.id || gallerie[0].data === c.data))
  ?? concerti[0];
const foto = scelto ? fotoDi(scelto) : [];
const caricate = Number(Astro.url.searchParams.get('caricate')) || 0;
---

<Base veste={veste} titolo="Foto · Area coristi" area={{ sezione: 'foto' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Foto dei concerti</span>
        <h1>Foto</h1>
        <p>Carica le tue foto dei concerti: le vedono subito tutti i coristi. I redattori scelgono quali mettere anche nel sito pubblico, nella pagina del concerto, e le più belle nella home.</p>
      </div>
    </div>
  </div>

  <div class="area-main">
    <div class="w">
      {errore && <Errore e={errore} />}

      {scelto && (
        <form method="get" class="scelta-concerto">
          <label>Concerto
            <select name="concerto">
              {concerti.map((c) => { const n = fotoDi(c).length; return <option value={c.id} selected={c === scelto}>{quando(c.data)} · {c.titolo}{n > 0 ? ` · ${n} foto` : ''}</option>; })}
            </select>
          </label>
          <noscript><button class="btn o piccolo" type="submit">Mostra</button></noscript>
        </form>
      )}
      {configurato() && !errore && concerti.length === 0 && <p class="tenue">Nessun concerto già fatto: le foto si caricano dopo il concerto.</p>}

      {scelto && (
        <form class="carta carica-foto" id="carica" data-evento={scelto.id}>
          <div class="ct"><h2>Carica le tue foto di questo concerto</h2></div>
          <div class="cc">
            <label class="scegli-foto">
              <span><Icona nome="fotocamera" />Scegli le foto</span>
              <input type="file" name="foto" accept="image/*" multiple required />
            </label>
            <p class="scelte tenue"></p>
            <div class="avanza" hidden><progress max="100" value="0" aria-label="Caricamento"></progress><small>Tieni aperta questa pagina fino alla fine.</small></div>
            <p class="stato" role="status">{caricate > 0 && `${caricate} ${caricate === 1 ? 'foto caricata' : 'foto caricate'}.`}</p>
            <button class="btn g" type="submit" disabled><Icona nome="spunta" />Carica</button>
          </div>
        </form>
      )}

      {scelto && (
        <div class="carta galleria" id="foto">
          <div class="ct"><h2>{scelto.titolo}</h2><span class="tenue" style="font-size:14px">{quando(scelto.data)} · {foto.length} foto</span></div>
          {foto.length > 0 ? (
            <ul class="foto-griglia" data-gruppo-foto>
              {foto.map((f) => (
                <li>
                  <a href={`/area/file/${f.id}`} target="_blank" rel="noopener" data-visore-foto data-didascalia={scelto.titolo}><img src={`/area/foto/miniatura/${f.id}`} alt={`Foto del concerto ${scelto.titolo}`} loading="lazy" /></a>
                  {f.visibilita === 'home' ? <span class="chi"><span class="tag">In home</span></span> : f.visibilita === 'pubblica' && <span class="chi"><span class="tag grigio">Sul sito</span></span>}
                  {normalizza(f.caricatoDa) === email && !sulSito(f.visibilita) && <button type="button" class="togli-foto" data-id={f.id} title="Togli questa foto" aria-label="Togli questa foto"><Icona nome="chiudi" classe="" /></button>}
                </li>
              ))}
            </ul>
          ) : <p class="tenue" style="padding:14px 18px 18px;margin:0">Ancora nessuna foto di questo concerto: carica la prima!</p>}
        </div>
      )}
    </div>
  </div>
  <VisoreFoto />
</Base>

<style>
  .scelta-concerto { margin-bottom: 16px; }
  .scelta-concerto label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; color: var(--primario); max-width: 640px; }
  .scelta-concerto select { width: 100%; font: inherit; font-weight: 400; padding: 10px 12px; border: 2px solid var(--linea); border-radius: var(--raggio); background: var(--bianco); color: var(--testo); }
  .carica-foto { margin-bottom: 24px; }
  .carica-foto .cc { display: grid; gap: 14px; }
  .carica-foto label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; color: var(--primario); }
  .carica-foto > .cc > label { max-width: 640px; }
  .scegli-foto { cursor: pointer; }
  .scegli-foto span { display: inline-flex; align-items: center; gap: 8px; justify-self: start; padding: 12px 18px; border: 2px dashed var(--linea); border-radius: var(--raggio); background: var(--fondo); }
  .scegli-foto input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .scegli-foto:focus-within span { outline: 3px solid var(--primario); }
  .scelte:empty, .stato:empty { display: none; }
  .scelte, .stato { margin: 0; font-size: 14px; }
  .avanza { display: grid; gap: 4px; }
  .avanza[hidden] { display: none; }
  .avanza progress { width: 100%; height: 10px; }
  .carica-foto button { justify-self: start; }
  .galleria { margin-bottom: 20px; }
  .galleria .ct { flex-wrap: wrap; gap: 4px 16px; }
  .foto-griglia { list-style: none; margin: 0; padding: 14px 18px 18px; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .foto-griglia li { position: relative; display: grid; gap: 4px; min-width: 0; }
  .foto-griglia a { display: block; aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden; background: var(--fondo); }
  .foto-griglia img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-griglia .chi { font-size: 13px; color: var(--tenue); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; min-width: 0; overflow-wrap: anywhere; }
  .togli-foto { position: absolute; top: 6px; right: 6px; width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgb(0 0 0 / .55); color: #fff; display: grid; place-items: center; cursor: pointer; }
  .togli-foto :global(svg) { width: 16px; height: 16px; }
</style>

<script>
  import { carica } from '../../area/caricamento-client';
  import { riduci } from '../../admin/immagini';

  // Il concerto si cambia dal menu: la pagina si ricarica con le sue foto
  document.querySelector<HTMLSelectElement>('.scelta-concerto select')?.addEventListener('change', (e) => (e.target as HTMLSelectElement).form!.submit());

  const f = document.querySelector<HTMLFormElement>('.carica-foto');
  if (f) {
    const input = f.querySelector<HTMLInputElement>('input[type=file]')!;
    const scelte = f.querySelector<HTMLElement>('.scelte')!;
    const stato = f.querySelector<HTMLElement>('.stato')!;
    const avanza = f.querySelector<HTMLElement>('.avanza')!;
    const barra = avanza.querySelector('progress')!;
    const bottone = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    input.addEventListener('change', () => {
      const n = input.files?.length ?? 0;
      scelte.textContent = n ? `${n} ${n === 1 ? 'foto scelta' : 'foto scelte'}` : '';
      bottone.disabled = !n;
    });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const file = [...(input.files ?? [])];
      if (!file.length) return;
      bottone.disabled = true;
      avanza.hidden = false;
      const evento = f.dataset.evento!;
      let fatte = 0;
      const errori: string[] = [];
      for (const [i, originale] of file.entries()) {
        const quale = file.length > 1 ? ` ${i + 1} di ${file.length}` : '';
        stato.textContent = `Preparo la foto${quale}…`;
        try {
          // Ridotta prima di partire: più veloce e leggera da vedere. Se il browser non la sa leggere
          // (alcune foto HEIC), parte così com'è
          const ridotta = await riduci(originale).catch(() => originale);
          stato.textContent = `Carico la foto${quale}…`;
          await carica('/area/foto/carica', ridotta, { evento }, (q) => { barra.value = Math.round(((i + q) / file.length) * 100); });
          fatte++;
        } catch (err) {
          errori.push(`${originale.name}: ${(err as Error).message}`);
        }
      }
      barra.value = 100;
      stato.textContent = `${fatte} ${fatte === 1 ? 'foto caricata' : 'foto caricate'}.${errori.length ? ` Non caricate: ${errori.join(' · ')}` : ''}`;
      if (fatte && !errori.length) location.href = `/area/foto?concerto=${encodeURIComponent(evento)}&caricate=${fatte}#foto`;
      else if (fatte) setTimeout(() => location.reload(), 4000);
      bottone.disabled = false;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.togli-foto').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('Togliere questa foto? Sparisce per tutti.')) return;
    const r = await fetch('/area/foto/togli', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.dataset.id }) });
    const j = await r.json().catch(() => ({ ok: false }));
    if (j.ok) b.closest('li')?.remove();
    else alert(`Non tolta: ${j.errore ?? r.status}`);
  }));
</script>
