---
import Base from '../layouts/Base.astro';
import VideoLite from '../components/VideoLite.astro';
import { site } from '../config';

const oggetto = encodeURIComponent('Vorrei cantare con Harmonia Vocalis');
const corpo = encodeURIComponent(
  'Buongiorno,\n\nvorrei conoscere il coro.\n\nNome:\nVoce (se la conosco):\nEsperienze corali precedenti:\nTelefono:\n',
);
---

<Base titolo="Canta con noi" descrizione="Entra nel Coro Harmonia Vocalis: prove a Roma, grande repertorio sacro e sinfonico con orchestra.">
  <header class="intestazione-pagina">
    <div class="contenitore">
      <span class="occhiello">Canta con noi</span>
      <h1>Cerchiamo nuove voci</h1>
      <p class="introduzione">
        Soprani, contralti, tenori e bassi con esperienza corale e voglia di mettersi in gioco su grandi opere con
        orchestra.
      </p>
    </div>
  </header>

  <section class="sezione">
    <div class="contenitore colonne">
      <div class="testo">
        <h2>Cosa ti aspetta</h2>
        <ul class="punti">
          <li>
            <strong>Grande repertorio.</strong> Messe, Requiem e oratori da Händel a Puccini, spesso con orchestra
            sinfonica e solisti.
          </li>
          <li>
            <strong>Un Maestro esigente.</strong> Il M° {site.maestro} è maestro di coro e insegnante di canto: la
            cura del suono viene prima di tutto.
          </li>
          <li>
            <strong>Concerti veri.</strong> Rassegne a Roma, nel Lazio e fuori regione, promosse da enti pubblici e
            istituzioni culturali.
          </li>
          <li>
            <strong>Un gruppo.</strong> Oltre quaranta coristi che condividono la passione e il sostegno a iniziative
            di solidarietà.
          </li>
        </ul>

        <h2 class="spazio">Prove</h2>
        <p>{site.prove.orari}.<br />{site.prove.luogo}, {site.prove.indirizzo}.</p>
        <p>
          Ai coristi chiediamo impegno e partecipazione costante alle prove. Per entrare si concorda un'audizione con il
          Maestro.
        </p>

        <div class="azioni">
          <a class="pulsante" href={`mailto:${site.email}?subject=${oggetto}&body=${corpo}`}>Scrivici per un'audizione</a>
        </div>
      </div>
      <aside>
        <VideoLite id="IG1OVZOJSh0" titolo="Canta con noi!" sottotitolo="Coro Harmonia Vocalis" />
      </aside>
    </div>
  </section>
</Base>

<style>
  .colonne { display: grid; gap: 3rem; }
  @media (min-width: 60rem) { .colonne { grid-template-columns: 1fr 24rem; gap: 5rem; align-items: start; } }
  .spazio { margin-top: 2.5rem; }
  .punti { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .punti li { padding-left: 1.25rem; border-left: 2px solid var(--oro); }
</style>
