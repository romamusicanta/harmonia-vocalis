---
// Area del tesoriere: pagina di accesso. Stesso accesso con Google dell'area coristi (/area/entra,
// src/area/accesso.ts), poi /tesoriere solo per chi è in uno dei gruppi della tesoreria
// (coro.coristi.tesoreria.gruppi: il tesoriere e gli amministratori). Qui tornano anche gli errori e l'uscita.
import Base from '../../layouts/Base.astro';
import Icona from '../../componenti/Icona.astro';
import AccessoCodice from '../../area/AccessoCodice.astro';
import Foto from '../../componenti/Foto.astro';
import { coro } from '../../motore/coro';
import { vesteCorrente } from '../../motore/url';

export const prerender = false;
const veste = vesteCorrente(undefined);
const p = Astro.url.searchParams;
const errore = p.get('errore');
const uscito = p.has('uscito');
const dopo = p.get('dopo') ?? '/tesoriere';
const entra = `/area/entra?${new URLSearchParams({ dopo: dopo.startsWith('/tesoriere') ? dopo : '/tesoriere' })}`;
---

<Base veste={veste} titolo="Accedi all'area del tesoriere" area={{ conBarra: false, tesoriere: true }}>
  <div class="accesso">
    <div class="lato-foto">
      <Foto nome={coro.foto.accesso} caricamento="eager" sizes="(min-width: 980px) 50vw, 100vw" />
      <div class="sopra"><span class="eti gialla" style="margin-bottom:14px">Area del tesoriere</span><b>Quote,<br />entrate<span>,</span><br />uscite.</b></div>
    </div>
    <div class="lato-modulo">
      <div class="box">
        <span class="eti">Accesso riservato</span>
        <h1>Area del tesoriere</h1>
        <p>Le quote dei coristi e la cassa del coro. Scrivi la tua email per ricevere un <b>codice</b>, oppure entra con il tuo account Google dell'associazione: si apre solo al tesoriere.</p>
        {errore && <p class="messaggio-accesso errore" role="alert">{errore}</p>}
        {uscito && !errore && <p class="messaggio-accesso" role="status">Sei uscito dall'area del tesoriere.</p>}
        <AccessoCodice dopo={dopo.startsWith('/tesoriere') ? dopo : '/tesoriere'} />
        <a class="google" href={entra}><svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg><span>Accedi con Google</span></a>
        <div class="aiuto-accesso">
          <a href={`mailto:${coro.email}?subject=${encodeURIComponent('Accesso area del tesoriere')}`}><Icona nome="domanda" />Non riesci a entrare? Scrivi al direttivo</a>
          <span class="tenue">Se l'area non si apre, forse sei entrato con un altro account Google: rientra scegliendo quello giusto.</span>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .messaggio-accesso { padding: 12px 16px; border-radius: var(--raggio); border: 2px solid var(--linea); font-size: 15px; }
  .messaggio-accesso.errore { border-color: #b3261e; color: #b3261e; }
</style>
