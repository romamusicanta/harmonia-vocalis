---
// Area del tesoriere: i suoi avvisi in bacheca (firma "Il tesoriere"), come nell'area del Maestro.
import Base from '../../layouts/Base.astro';
import GestioneAvvisi from '../../area/GestioneAvvisi.astro';
import { dopoIlModulo } from '../../area/bacheca';
import { vesteCorrente } from '../../motore/url';

export const prerender = false;
const veste = vesteCorrente(undefined);
const email = Astro.locals.corista!.email;
if (Astro.request.method === 'POST') return Astro.redirect(await dopoIlModulo(Astro.request, email, '/tesoriere/avvisi'));
---

<Base veste={veste} titolo="Avvisi · Area del tesoriere" area={{ tesoriere: true, sezione: 'avvisi' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Area del tesoriere</span>
        <h1>Avvisi ai coristi</h1>
        <p>Quello che scrivi qui compare nella bacheca dell'area coristi, firmato «Il tesoriere». Dopo averlo pubblicato puoi mandarlo su WhatsApp o come notifica. Per ricordare le quote solo a chi non le ha pagate c'è il sollecito, in Quote.</p>
      </div>
    </div>
  </div>
  <div class="area-main"><div class="w" style="max-width:860px"><GestioneAvvisi email={email} firma="tesoriere" /></div></div>
</Base>
