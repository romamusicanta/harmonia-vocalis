---
// Area del tesoriere: la pagina Quote non c'è più (dal 5/10/2026 le quote si segnano nella tabella del
// Riepilogo): rimanda lì, nella stagione del mese chiesto. /tesoriere/quote/segna resta: è quello che salva.
import { stagioneCorrente, stagioneDi } from '../../area/tesoreria';

export const prerender = false;
const mese = Astro.url.searchParams.get('mese') ?? '';
const anno = /^\d{4}-\d{2}$/.test(mese) ? stagioneDi(`${mese}-15`) : undefined;
return Astro.redirect(anno && anno !== stagioneCorrente() ? `/tesoriere?stagione=${anno}` : '/tesoriere', 301);
---
