---
// Area del tesoriere: quote dei coristi (/tesoriere/quote?mese=AAAA-MM), come il prospetto "Quote
// coristi" del rendiconto. In alto stagione (anche la prossima, per gli anticipi) e mese (di base
// quello in corso): cifre, sollecito a chi non ha pagato, elenco dei coristi attivi quel mese con i
// tre stati (Pagata, Esonerato, Da pagare), che si salvano subito (/tesoriere/quote/segna), e
// "Importo e data" per una quota diversa dal solito (un anticipo di 5 €, una data di pagamento
// passata). Un mese si può segnare "senza quota" per tutti (come settembre 2025). Sotto, tutta la
// stagione: una riga per corista e una casella per mese; un tocco la fa passare da "da pagare" a
// "pagata" a "esonerato" (per chi paga più mesi insieme). L'esonero chiede il motivo.
import Base from '../../layouts/Base.astro';
import Errore from '../../area/Errore.astro';
import Sollecito from '../../area/Sollecito.astro';
import { vesteCorrente } from '../../motore/url';
import { coristi, oggi, type SchedaCorista } from '../../area/dati';
import {
  arretrati, attiviNelMese, configurata, euro, indice, maiuscola, meseBreve, meseEsteso, mesiSenzaQuota, nomeMese, nomeStagione, questoMese, quotaDi, quotaMensile,
  quote, situazioneMese, stagioneCorrente, stagioneDi, statoDi, tutteLeQuote, type Quota,
} from '../../area/tesoreria';
import '../../area/tesoreria.css';

export const prerender = false;
const veste = vesteCorrente(undefined);

let errore: unknown;
let elenco: SchedaCorista[] = [];
let tutte: Quota[] = [];
// Il mese chiesto, o quello in corso; d'estate (luglio, agosto) giugno, l'ultimo della stagione
const chiesto = Astro.url.searchParams.get('mese') ?? '';
const corrente = configurata() ? stagioneCorrente() : 0;
const annoChiesto = /^\d{4}-\d{2}$/.test(chiesto) ? stagioneDi(`${chiesto}-15`) : corrente;
const anno = annoChiesto >= 2000 && annoChiesto <= corrente + 1 ? annoChiesto : corrente;
const mesi = anno ? tutteLeQuote(anno) : [];
const mese = mesi.includes(chiesto) ? chiesto : mesi.includes(questoMese()) ? questoMese() : mesi.filter((m) => m <= questoMese()).at(-1) ?? mesi[0];

if (!configurata()) errore = 'L’area del tesoriere non è ancora collegata al suo foglio: manca la variabile FOGLIO_TESORERIA_ID sul server.';
else {
  try {
    [elenco, tutte] = await Promise.all([coristi(), quote()]);
  } catch (e) {
    errore = e;
  }
}
const idx = indice(tutte);
const senza = mesiSenzaQuota(tutte);
const notaSenza = tutte.find((q) => q.email === 'tutti' && q.mese === mese)?.nota;
const s = mese && elenco.length ? situazioneMese(mese, elenco, idx, senza) : undefined;
const debitori = s && !s.senzaQuota ? arretrati([mese], elenco, idx) : [];
// Nella griglia: chi è stato nel coro in almeno un mese della stagione
const nellaStagione = elenco.filter((c) => mesi.some((m) => attiviNelMese([c], m).length));
// Le stagioni: quelle con quote nel foglio, quella in corso e la prossima (per gli anticipi)
const stagioni = [...new Set([corrente + 1, corrente, ...tutte.map((q) => stagioneDi(`${q.mese}-15`))])].filter((x) => x <= corrente + 1).sort((a, b) => b - a);
const ETICHETTA = { pagata: 'Pagata', esonerato: 'Esonerato', 'da-pagare': 'Da pagare' } as const;
const SIMBOLO = { pagata: '✓', esonerato: 'E', 'da-pagare': '' } as const;
const dettaglio = (q?: Quota) => [
  q?.stato === 'pagata' && q.importo !== quotaMensile() && euro(q.importo),
  q?.stato === 'pagata' && q.pagataIl && `pagata il ${q.pagataIl.split('-').reverse().join('/')}`,
  q?.nota,
].filter(Boolean).join(' · ');
---

<Base veste={veste} titolo="Quote · Area del tesoriere" area={{ tesoriere: true, sezione: 'quote' }}>
  <div class="area-intesta">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Area del tesoriere · Stagione {anno ? nomeStagione(anno) : ''}</span>
        <h1>Quote</h1>
        <p>{euro(quotaMensile())} al mese, da settembre a giugno. Segna chi ha pagato: si salva subito. Chi è esonerato per un mese non la deve; un mese si può anche segnare senza quota per tutti.</p>
      </div>
    </div>
  </div>

  <div class="area-main">
    <div class="w">
      {errore && <Errore e={errore} />}
      {stagioni.length > 1 && (
        <nav class="scelta-t" aria-label="Stagione" style="margin-bottom:10px">
          {stagioni.map((x) => <a href={x === corrente ? '?' : `?mese=${x}-09`} class:list={{ on: x === anno }}>{nomeStagione(x)}{x > corrente && ' · anticipi'}</a>)}
        </nav>
      )}
      {mesi.length > 0 && (
        <nav class="scelta-t" aria-label="Mese">
          {mesi.map((m) => <a href={`?mese=${m}`} class:list={{ on: m === mese, futuro: m > questoMese() || senza.has(m) }} aria-current={m === mese ? 'page' : undefined}>{nomeMese(m)}{senza.has(m) && ' –'}</a>)}
        </nav>
      )}

      {s && s.senzaQuota && (
        <div class="carta" style="margin-bottom:20px"><div class="cc" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between">
          <span><b>A {meseEsteso(mese)} la quota non si raccoglie.</b>{notaSenza && <span class="tenue"> {notaSenza}</span>}</span>
          <button type="button" class="btn o piccolo mese-senza" data-mese={mese} data-senza="0">Raccogli la quota anche a {nomeMese(mese)}</button>
        </div></div>
      )}

      {s && !s.senzaQuota && (
        <>
          <div class="cifre-t" id="cifre-mese" data-quota={quotaMensile()}>
            <div class="cifra-t forte"><b data-c="raccolto">{euro(s.raccolto)}</b><span>raccolti a {nomeMese(mese)}</span><small>su <span data-c="dovuto">{euro(s.dovuto)}</span></small></div>
            <div class="cifra-t verde"><b data-c="pagate">{s.pagate}</b><span>hanno pagato</span></div>
            <div class="cifra-t"><b data-c="esonerati">{s.esonerati}</b><span>esonerati</span></div>
            <div class:list={['cifra-t', { rosso: s.daPagare }]} data-c-box="da-pagare"><b data-c="da-pagare">{s.daPagare}</b><span>devono ancora pagare</span></div>
          </div>
          <p class="tenue" style="font-size:14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center">{s.attesi.length} coristi nel coro a {meseEsteso(mese)}.
            <button type="button" class="link-freccia mese-senza" data-mese={mese} data-senza="1" style="background:none;border:0;padding:0;font:inherit;cursor:pointer">Nessuna quota a {nomeMese(mese)}?</button></p>

          <Sollecito elenco={debitori} mese={mese} />

          <h2 class="titolo-t">{maiuscola(meseEsteso(mese))}</h2>
          <ul class="carta quote-mese">
            {s.attesi.map((c) => {
              const stato = statoDi(idx, c.email, mese);
              const q = quotaDi(idx, c.email, mese);
              return (
                <li>
                  <span class="chi"><b>{c.nome} {c.cognome}</b><small class="nota-quota">{[c.sezione, dettaglio(q)].filter(Boolean).join(' · ')}</small></span>
                  <span class="azioni-quota">
                    <span class="stati-quota" role="group" aria-label={`Quota di ${c.nome} ${c.cognome}`} data-email={c.email} data-mese={mese} data-nome={`${c.nome} ${c.cognome}`}>
                      {(['pagata', 'esonerato', 'da-pagare'] as const).map((x) => <button type="button" data-stato={x} aria-pressed={stato === x ? 'true' : 'false'}>{ETICHETTA[x]}</button>)}
                    </span>
                    <button type="button" class="btn o piccolo dettagli-quota" title="Importo, data del pagamento e nota" aria-label={`Importo e data della quota di ${c.nome} ${c.cognome}`}
                      data-email={c.email} data-mese={mese} data-nome={`${c.nome} ${c.cognome}`} data-importo={q?.stato === 'pagata' ? String(q.importo) : String(quotaMensile())} data-data={q?.pagataIl ?? oggi()} data-nota={q?.nota ?? ''}>€…</button>
                  </span>
                </li>
              );
            })}
          </ul>
        </>
      )}

      {nellaStagione.length > 0 && (
        <>
          <h2 class="titolo-t">Tutta la stagione {nomeStagione(anno)}</h2>
          <p class="tenue" style="font-size:14px;margin-top:-6px">Un tocco su una casella: da pagare → pagata → esonerato → da pagare. Comodo per chi paga più mesi insieme.</p>
          <div class="carta">
            <div class="tabella-wrap">
              <table class="tabella griglia-quote">
                <thead><tr><th>Corista</th>{mesi.map((m) => <th class:list={{ 'senza-quota': senza.has(m) }}>{meseBreve(m)}</th>)}</tr></thead>
                <tbody>
                  {nellaStagione.map((c) => (
                    <tr>
                      <td>{c.nome} {c.cognome}</td>
                      {mesi.map((m) => {
                        const attivo = attiviNelMese([c], m).length > 0 && !senza.has(m);
                        const stato = statoDi(idx, c.email, m);
                        return (
                          <td>
                            <button type="button" class:list={['cella-quota', { dovuta: m <= questoMese() }]} disabled={!attivo} data-email={c.email} data-mese={m} data-nome={`${c.nome} ${c.cognome}`} data-stato={attivo ? stato : undefined}
                              title={attivo ? `${c.nome} ${c.cognome}, ${meseEsteso(m)}: ${ETICHETTA[stato].toLowerCase()}` : senza.has(m) ? `Nessuna quota a ${meseEsteso(m)}` : `Non era nel coro a ${meseEsteso(m)}`}>{attivo ? SIMBOLO[stato] : '–'}</button>
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
                <tfoot><tr><td>Raccolte</td>{mesi.map((m) => <td style="font-size:12px">{senza.has(m) ? '–' : euro(situazioneMese(m, elenco, idx, senza).raccolto)}</td>)}</tr></tfoot>
              </table>
            </div>
            <div class="legenda-t">
              <span><span class="cella-quota" data-stato="pagata">✓</span>pagata</span>
              <span><span class="cella-quota" data-stato="esonerato">E</span>esonerato</span>
              <span><span class="cella-quota dovuta" data-stato="da-pagare"></span>da pagare</span>
              <span><span class="cella-quota" data-stato="da-pagare"></span>mese non ancora arrivato</span>
              <span><span class="cella-quota" style="border-style:dashed;opacity:.4">–</span>non dovuta (non era nel coro, o mese senza quota)</span>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</Base>

<dialog class="finestra-notifica finestra-dettagli">
  <form method="dialog">
    <h2>Quota di <span class="chi-d"></span></h2>
    <p class="nota mese-d"></p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <label>Importo (€)<input name="importo" inputmode="decimal" pattern="[0-9]+([.,][0-9]{1,2})?" required /></label>
      <label>Pagata il<input name="pagataIl" type="date" required /></label>
    </div>
    <label>Nota <input name="nota" maxlength="300" placeholder="Es. anticipo, pagata con bonifico" /></label>
    <p class="esito" hidden></p>
    <div class="pulsanti">
      <button type="button" class="btn o piccolo chiudi">Annulla</button>
      <button type="submit" class="btn g piccolo">Segna pagata</button>
    </div>
  </form>
</dialog>

<script>
  // Salva lo stato di una quota e aggiorna insieme elenco del mese, griglia e cifre del mese
  const SIMBOLO: Record<string, string> = { pagata: '✓', esonerato: 'E', 'da-pagare': '' };
  const ETICHETTA: Record<string, string> = { pagata: 'pagata', esonerato: 'esonerato', 'da-pagare': 'da pagare' };
  const PROSSIMO: Record<string, string> = { 'da-pagare': 'pagata', pagata: 'esonerato', esonerato: 'da-pagare' };
  const euro = (n: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n).replace(/,00(?=\s?€)/, '');
  const invia = async (corpo: object) => {
    const r = await fetch('/tesoriere/quote/segna', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });
    if (!r.ok) throw new Error((await r.json().catch(() => ({}))).errore ?? `Errore ${r.status}`);
  };

  function mostra(email: string, mese: string, stato: string) {
    document.querySelectorAll<HTMLElement>(`.stati-quota[data-email="${email}"][data-mese="${mese}"] button`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.stato === stato)));
    document.querySelectorAll<HTMLButtonElement>(`.cella-quota[data-email="${email}"][data-mese="${mese}"]`).forEach((c) => {
      c.dataset.stato = stato;
      c.textContent = SIMBOLO[stato];
      c.title = `${c.dataset.nome}: ${ETICHETTA[stato]}`;
    });
    ricalcola();
  }

  // Le cifre in alto, dall'elenco del mese (le quote con importo diverso si vedono giuste ricaricando)
  function ricalcola() {
    const cifre = document.querySelector<HTMLElement>('#cifre-mese');
    if (!cifre) return;
    const quota = Number(cifre.dataset.quota);
    const stati = [...document.querySelectorAll('.stati-quota button[aria-pressed="true"]')].map((b) => (b as HTMLElement).dataset.stato);
    const n = (s: string) => stati.filter((x) => x === s).length;
    const scrivi = (k: string, v: string) => { const el = cifre.querySelector(`[data-c="${k}"]`); if (el) el.textContent = v; };
    scrivi('pagate', String(n('pagata')));
    scrivi('esonerati', String(n('esonerato')));
    scrivi('da-pagare', String(n('da-pagare')));
    scrivi('raccolto', euro(n('pagata') * quota));
    scrivi('dovuto', euro((stati.length - n('esonerato')) * quota));
    cifre.querySelector('[data-c-box="da-pagare"]')?.classList.toggle('rosso', n('da-pagare') > 0);
  }

  async function segna(el: HTMLElement, email: string, mese: string, nome: string, stato: string, prima: string) {
    let nota = '';
    if (stato === 'esonerato') {
      const r = prompt(`Perché ${nome} è esonerato per questo mese? (facoltativo)`, '');
      if (r === null) return;
      nota = r;
    }
    el.classList.add('in-corso');
    mostra(email, mese, stato);
    try {
      await invia({ email, mese, stato, nota });
      if (stato === 'esonerato' && nota) document.querySelectorAll(`.stati-quota[data-email="${email}"][data-mese="${mese}"]`).forEach((g) => { const s = g.closest('li')?.querySelector('.nota-quota'); if (s) s.textContent += ` · ${nota}`; });
    } catch (e) {
      mostra(email, mese, prima);
      alert(`Non salvato: ${(e as Error).message}`);
    } finally {
      el.classList.remove('in-corso');
    }
  }

  document.querySelectorAll<HTMLElement>('.stati-quota').forEach((g) => g.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b || b.getAttribute('aria-pressed') === 'true') return;
    const prima = g.querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.stato ?? 'da-pagare';
    segna(g, g.dataset.email!, g.dataset.mese!, g.dataset.nome!, b.dataset.stato!, prima);
  }));
  document.querySelectorAll<HTMLButtonElement>('button.cella-quota').forEach((c) => c.addEventListener('click', () => {
    const prima = c.dataset.stato ?? 'da-pagare';
    segna(c, c.dataset.email!, c.dataset.mese!, c.dataset.nome!, PROSSIMO[prima], prima);
  }));

  // Importo, data e nota di una quota pagata (anticipo, pagamento di un altro giorno)
  const d = document.querySelector<HTMLDialogElement>('.finestra-dettagli')!;
  const f = d.querySelector('form')!;
  const esito = d.querySelector<HTMLElement>('.esito')!;
  let corrente: HTMLElement | undefined;
  d.querySelector('.chiudi')!.addEventListener('click', () => d.close());
  document.querySelectorAll<HTMLButtonElement>('.dettagli-quota').forEach((b) => b.addEventListener('click', () => {
    corrente = b;
    d.querySelector('.chi-d')!.textContent = b.dataset.nome!;
    d.querySelector('.mese-d')!.textContent = `Mese della quota: ${new Date(`${b.dataset.mese}-15`).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' })}. L'incasso conta nella cassa del giorno del pagamento.`;
    f.importo.value = String(b.dataset.importo).replace('.', ',');
    f.pagataIl.value = b.dataset.data!;
    f.nota.value = b.dataset.nota ?? '';
    esito.hidden = true;
    d.showModal();
  }));
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!corrente) return;
    try {
      await invia({ email: corrente.dataset.email, mese: corrente.dataset.mese, stato: 'pagata', importo: f.importo.value, pagataIl: f.pagataIl.value, nota: f.nota.value });
      location.reload();
    } catch (err) {
      esito.className = 'esito errore';
      esito.textContent = `Non salvato: ${(err as Error).message}`;
      esito.hidden = false;
    }
  });

  // Un mese senza quota per tutti, o di nuovo con la quota
  document.querySelectorAll<HTMLButtonElement>('.mese-senza').forEach((b) => b.addEventListener('click', async () => {
    const senza = b.dataset.senza === '1';
    let nota = '';
    if (senza) {
      const r = prompt('In questo mese la quota non si raccoglie per nessuno. Perché? (facoltativo, es. «coperto dalla quota di giugno»)', '');
      if (r === null) return;
      nota = r;
    }
    try {
      await invia({ azione: 'senza-quota', mese: b.dataset.mese, senza, nota });
      location.reload();
    } catch (e) {
      alert(`Non salvato: ${(e as Error).message}`);
    }
  }));
</script>
