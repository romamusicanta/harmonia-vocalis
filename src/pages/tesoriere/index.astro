---
// Area del tesoriere (/tesoriere): il riepilogo della stagione (dal 1 settembre al 31 agosto;
// ?stagione=2025 per le passate, la stagione dopo per gli anticipi). Una sola tabella, come il
// prospetto "Quote coristi" del rendiconto, da cui si segnano anche i pagamenti (dal 5/10/2026, al
// posto della pagina Quote, che rimanda qui): una riga per corista (in ordine alfabetico) e una
// casella per mese. Un tocco su una casella: da pagare → pagata → esonerato →
// da pagare; pressione lunga o doppio clic: importo, data del pagamento e nota (anticipi, pagamenti
// di altri giorni). Un tocco sul nome del mese: le sue cifre, il sollecito per quel mese e "Nessuna
// quota" (come settembre 2025) e la quota base del mese (giugno e settembre cambiano ogni anno).
// La quota base di ogni mese sta sotto il suo nome, non sulle caselle. Riporto (dal 5/10/2026): la
// colonna prima di settembre con i debiti della stagione prima di ogni corista, calcolati e
// correggibili nel campo (salvato all'uscita; vuoto = quello calcolato), e la casellina «versato».
// In alto tre cifre (quote raccolte, chi deve pagare, saldo di cassa)
// e il sollecito per tutte le quote dovute fino a oggi. Si salva tutto subito con /tesoriere/quote/segna.
import Base from '../../layouts/Base.astro';
import Errore from '../../area/Errore.astro';
import Icona from '../../componenti/Icona.astro';
import Sollecito from '../../area/Sollecito.astro';
import { vesteCorrente } from '../../motore/url';
import { coro } from '../../motore/coro';
import { coristi, oggi, type SchedaCorista } from '../../area/dati';
import {
  arretrati, attiviNelMese, cassa, configurata, euro, indice, quotaBase, riporti, riportoDi, meseBreve, meseEsteso, mesiDelleQuote, mesiDovuti, mesiSenzaQuota, movimenti, nomeStagione, questoMese,
  quotaDi, quotaMensile, quote, situazioneMese, stagioneCorrente, stagioneDi, statoDi, tutteLeQuote, type Cassa, type Quota,
} from '../../area/tesoreria';
import '../../area/tesoreria.css';

export const prerender = false;
const veste = vesteCorrente(undefined);

const corrente = configurata() ? stagioneCorrente() : 0;
const chiesta = Number(Astro.url.searchParams.get('stagione'));
const anno = chiesta >= 2000 && chiesta <= corrente + 1 ? chiesta : corrente;
const passata = anno < corrente;

let errore: unknown;
let elenco: SchedaCorista[] = [];
let tutte: Quota[] = [];
let conti: Cassa | undefined;
let stagioni: number[] = [];
if (!configurata()) errore = 'L’area del tesoriere non è ancora collegata al suo foglio: manca la variabile FOGLIO_TESORERIA_ID sul server.';
else {
  try {
    const [c, q, m] = await Promise.all([coristi(), quote(), movimenti()]);
    elenco = c; tutte = q;
    conti = cassa(anno, q, m);
    stagioni = [...new Set([corrente + 1, corrente, ...q.map((x) => stagioneDi(`${x.mese}-15`)), ...m.map((x) => stagioneDi(x.data))])].filter((x) => x <= corrente + 1).sort((a, b) => b - a);
  } catch (e) {
    errore = e;
  }
}
const idx = indice(tutte);
const rip = riporti(tutte, elenco);
const senza = mesiSenzaQuota(tutte);
const mesi = anno ? tutteLeQuote(anno) : [];
// Le quote "dovute": fino al mese in corso (tutte, per una stagione passata)
const dovuti = passata ? mesiDelleQuote(anno, tutte) : anno > corrente ? [] : mesiDovuti(anno, tutte);
const debitori = anno > corrente ? [] : arretrati(dovuti, elenco, idx, rip, anno);
const situazioni = mesi.map((m) => situazioneMese(m, elenco, idx, senza));
const nellaStagione = elenco.filter((c) => mesi.some((m) => attiviNelMese([c], m).length));
// I riporti della stagione (dalla seconda stagione del foglio): la colonna Riporto c'è solo se ci sono
const riportiQui = nellaStagione.map((c) => riportoDi(rip, c.email, anno)).filter((r) => r !== undefined);
const conRiporto = riportiQui.length > 0;
const riportiVersati = riportiQui.reduce((t, r) => t + r.pagato, 0);
const raccolte = situazioni.filter((s) => dovuti.includes(s.mese)).reduce((t, s) => t + s.raccolto, 0) + (anno > corrente ? 0 : riportiVersati);
const attese = situazioni.filter((s) => dovuti.includes(s.mese)).reduce((t, s) => t + s.dovuto, 0) + (anno > corrente ? 0 : riportiQui.reduce((t, r) => t + r.importo, 0));
const cifra = (n: number) => euro(n).replace(/\s*€/, '');
// Nella stagione in corso i mesi prima di quello corrente (e il riporto) si possono richiudere: la
// pagina si apre con loro chiusi, sul mese corrente
const passati = anno === corrente ? mesi.filter((m) => m < questoMese()) : [];
const richiudibili = passati.length > 0;
const etichettaPassati = [...(conRiporto ? ['riporto'] : []), ...(passati.length ? [passati.length > 1 ? `${meseBreve(passati[0])}–${meseBreve(passati.at(-1)!)}` : meseBreve(passati[0])] : [])].join(', ');
// Intestazione della stampa della tabella, come nei prospetti del rendiconto
const intestazione = { associazione: coro.associazione ?? coro.nome, cf: coro.coristi?.tesoreria?.codiceFiscale };
const oggiStampa = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' }).format(new Date());
const ETICHETTA = { pagata: 'pagata', esonerato: 'esonerato', 'da-pagare': 'da pagare' } as const;
const SIMBOLO = { pagata: '✓', esonerato: 'E', 'da-pagare': '' } as const;
---

<Base veste={veste} titolo="Riepilogo · Area del tesoriere" area={{ tesoriere: true, sezione: 'riepilogo' }}>
  <div class="area-intesta no-stampa">
    <div class="w">
      <div>
        <span class="eti" style="margin-bottom:12px">Area del tesoriere · Stagione {anno ? nomeStagione(anno) : ''}</span>
        <h1>Riepilogo</h1>
        <p>{euro(quotaMensile())} al mese, da ottobre a giugno; a settembre di solito metà quota (la quota base di ogni mese è sotto il suo nome). I debiti della stagione prima sono nella colonna Riporto. Segna le quote nella tabella: un tocco su una casella per «pagata», pressione lunga per importo e data.</p>
      </div>
    </div>
  </div>

  <div class="area-main">
    <div class="w">
      {errore && <Errore e={errore} />}
      {stagioni.length > 1 && (
        <nav class="scelta-t no-stampa" aria-label="Stagione">
          {stagioni.map((s) => <a href={s === corrente ? '/tesoriere' : `/tesoriere?stagione=${s}`} class:list={{ on: s === anno }}>{nomeStagione(s)}{s > corrente && ' · anticipi'}</a>)}
        </nav>
      )}

      {conti && (
        <>
          <div class="cifre-t no-stampa">
            <div class="cifra-t forte"><b>{euro(raccolte)}</b><span>quote raccolte {passata ? 'nella stagione' : 'fino a oggi'}</span><small>su {euro(attese)} dovute</small></div>
            <div class:list={['cifra-t', { rosso: debitori.length }]}><b>{debitori.length}</b><span>{debitori.length === 1 ? 'corista deve' : 'coristi devono'} ancora pagare</span><small>{euro(debitori.reduce((t, a) => t + a.importo, 0))} in tutto</small></div>
            <a class="cifra-t" href={passata ? `/tesoriere/cassa?stagione=${anno}` : '/tesoriere/cassa'}><b>{euro(conti.saldoFinale)}</b><span>{passata ? 'saldo di fine stagione' : 'saldo di cassa'}</span><small>Entrate e uscite →</small></a>
          </div>
          {!passata && anno <= corrente && debitori.length > 0 && <p class="no-stampa" style="margin:12px 0 0"><button type="button" class="btn g apri-sollecito"><Icona nome="campanella" />Sollecita chi non ha pagato</button></p>}
        </>
      )}

      {nellaStagione.length > 0 && (
        <>
        <div class="testa-tabella no-stampa"><button type="button" class="btn o piccolo" onclick="print()"><Icona nome="documento" />Stampa la tabella</button></div>
        <div class="solo-stampa intesta-stampa"><span><b>{intestazione.associazione}</b>{intestazione.cf && ` · C.F. ${intestazione.cf}`}</span><h2>Quote dei coristi · Stagione {nomeStagione(anno)}</h2><small>Situazione al {oggiStampa}</small></div>
        <div class="carta tabella-stampa">
          <div class="tabella-wrap">
            <table class:list={['tabella griglia-quote', { compatta: richiudibili }]}>
              <thead>
                <tr>
                  <th>
                    <span class="testa-corista">Corista
                      {richiudibili && <button type="button" class="mostra-passati" aria-expanded="false" data-etichetta={etichettaPassati} title="Mostra o nascondi i mesi già passati"><span class="freccia">‹</span> <span class="testo-passati">{etichettaPassati}</span></button>}
                    </span>
                  </th>
                  {conRiporto && <th class:list={['testa-riporto', { passato: richiudibili }]} title="I debiti della stagione prima: calcolati, correggibili a mano; la casellina segna se sono stati versati">Riporto</th>}
                  {mesi.map((m) => (
                    <th class:list={{ passato: passati.includes(m) }}><button type="button" class:list={['testa-mese', { 'senza-quota': senza.has(m), ora: m === questoMese() }]} data-mese={m} data-senza={senza.has(m) ? '1' : ''} data-base={senza.has(m) ? '0' : String(quotaBase(idx, m))} data-nota={tutte.find((q) => q.email === 'tutti' && q.mese === m && q.stato === 'nessuna')?.nota ?? ''} title={`${meseEsteso(m)}: cifre, quota base e sollecito`}>{meseBreve(m)}<small>{senza.has(m) ? '0 €' : `${cifra(quotaBase(idx, m))} €`}</small></button></th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {nellaStagione.map((c) => (
                  <tr>
                    <td title={c.sezione}>{c.nome} {c.cognome}</td>
                    {conRiporto && (() => {
                      const r = riportoDi(rip, c.email, anno);
                      if (!r) return <td class:list={['cella-riporto', { passato: richiudibili }]}><span class="tenue">–</span></td>;
                      const origine = [r.mesi.length && `quote di ${r.mesi.map(meseEsteso).join(', ')}`, r.precedente && `riporto non versato ${euro(r.precedente)}`].filter(Boolean).join('; ');
                      return (
                        <td class:list={['cella-riporto', { passato: richiudibili }]}>
                          <span class:list={['riporto', { versato: r.versato, debito: !r.versato && r.importo > 0 }]}>
                            <input class:list={['cifra-riporto', { mano: r.scritto !== undefined }]} inputmode="decimal" value={cifra(r.importo)} disabled={r.versato}
                              data-email={c.email} data-anno={String(anno)} data-valore={cifra(r.importo)} aria-label={`Riporto di ${c.nome} ${c.cognome}`}
                              title={`${r.scritto !== undefined ? `Scritto a mano. Il calcolo ora dà ${euro(r.calcolato)}` : `Calcolato: ${euro(r.calcolato)}`}${origine ? ` (${origine})` : ''}${r.versato ? '. Versato: togli la spunta per cambiarlo' : ''}`} />
                            {r.scritto !== undefined && !r.versato && <button type="button" class="torna-calcolo" data-email={c.email} data-anno={String(anno)} title={`Cifra scritta a mano: il calcolo ora dà ${euro(r.calcolato)}. Tocca per tornare al calcolo`} aria-label={`Riporta al calcolo (${euro(r.calcolato)})`}>↺</button>}
                            <input type="checkbox" class="versato-riporto" checked={r.versato} disabled={!r.importo && !r.versato} data-email={c.email} data-anno={String(anno)}
                              aria-label={`Riporto di ${c.nome} ${c.cognome} versato`} title={r.versato ? `Versato${r.versatoIl ? ` il ${r.versatoIl.split('-').reverse().join('/')}` : ''}` : 'Segna versato (oggi)'} />
                          </span>
                        </td>
                      );
                    })()}
                    {mesi.map((m) => {
                      const attivo = attiviNelMese([c], m).length > 0 && !senza.has(m);
                      const stato = statoDi(idx, c.email, m);
                      const q = quotaDi(idx, c.email, m);
                      const diversa = q?.stato === 'pagata' && q.importo !== quotaBase(idx, m);
                      const dettaglio = [diversa && euro(q.importo), q?.pagataIl && `il ${q.pagataIl.split('-').reverse().join('/')}`, q?.nota].filter(Boolean).join(' · ');
                      return (
                        <td class:list={{ passato: passati.includes(m) }}>
                          <button type="button" class:list={['cella-quota', { dovuta: dovuti.includes(m), diversa }]} disabled={!attivo}
                            data-email={c.email} data-mese={m} data-nome={`${c.nome} ${c.cognome}`} data-stato={attivo ? stato : undefined}
                            data-importo={q?.stato === 'pagata' ? String(q.importo) : String(quotaBase(idx, m))} data-data={q?.pagataIl ?? oggi()} data-nota={q?.nota ?? ''}
                            title={attivo ? `${c.nome} ${c.cognome}, ${meseEsteso(m)}: ${ETICHETTA[stato]}${dettaglio ? ` (${dettaglio})` : ''}` : senza.has(m) ? `Nessuna quota a ${meseEsteso(m)}` : `Non era nel coro a ${meseEsteso(m)}`}>{attivo ? SIMBOLO[stato] : '–'}</button>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
              <tfoot><tr><td>Raccolte</td>{conRiporto && <td class:list={['tot-riporto', { passato: richiudibili }]}>{cifra(riportiVersati)}</td>}{situazioni.map((s) => <td class:list={['tot-mese', { passato: passati.includes(s.mese) }]} data-mese={s.mese}>{s.senzaQuota ? '–' : euro(s.raccolto).replace(/\s*€/, '')}</td>)}</tr></tfoot>
            </table>
          </div>
          <div class="legenda-t">
            {conRiporto && <b class="gruppo-legenda">Mesi</b>}
            <span><span class="cella-quota" data-stato="pagata">✓</span>pagata</span>
            <span><span class="cella-quota" data-stato="esonerato">E</span>esonerato</span>
            <span><span class="cella-quota dovuta" data-stato="da-pagare"></span>da pagare</span>
            <span><span class="cella-quota" data-stato="da-pagare"></span>mese non ancora arrivato</span>
            <span><span class="cella-quota" style="border-style:dashed;opacity:.4">–</span>non dovuta</span>
            <span><span class="cella-quota diversa" data-stato="pagata">✓</span>importo diverso</span>
          </div>
          {conRiporto && (
            <div class="legenda-t" aria-hidden="true">
              <b class="gruppo-legenda">Riporto</b>
              <span><span class="riporto debito mini"><span class="cifra-mini">20</span><span class="spunta-mini"></span></span>da versare</span>
              <span><span class="riporto versato mini"><span class="cifra-mini fissa">20</span><span class="spunta-mini on">✓</span></span>versato</span>
              <span><span class="riporto mini"><span class="cifra-mini">0</span><span class="spunta-mini off"></span></span>nessun debito</span>
              <span><span class="riporto debito mini"><span class="cifra-mini mano">25</span><span class="spunta-mini"></span><span class="torna-mini">↺</span></span>cifra scritta a mano (↺ torna al calcolo)</span>
            </div>
          )}
        </div>
        </>
      )}
      <p class="tenue no-stampa" style="font-size:14px;margin-top:10px">Un tocco su una casella: da pagare → pagata → esonerato → da pagare. Pressione lunga (o doppio clic): importo, data del pagamento e nota. Riporto: i debiti della stagione prima, calcolati (quote non pagate più il riporto non versato); si correggono nel campo (vuoto = quello calcolato) e la casellina li segna versati (per cambiare un riporto versato, prima si toglie la spunta). Un tocco sul mese: le sue cifre, la quota base (zero = il mese non ha quota) e il sollecito per quel mese.{richiudibili && ' I mesi già passati e il riporto si mostrano con la freccia accanto a «Corista».'} Il rendiconto completo è in <a href={`/tesoriere/rendiconto${passata ? `?stagione=${anno}` : ''}`}>Rendiconto</a>.</p>
    </div>
  </div>

  <Sollecito />

  <dialog class="finestra-notifica finestra-mese">
    <form method="dialog">
      <h2 class="titolo-m"></h2>
      <div class="cifre-mese"></div>
      <p class="nota nota-m"></p>
      <div class="base-m">
        <label>Quota base del mese (€)<input name="base" inputmode="decimal" pattern="[0-9]+([.,][0-9]{1,2})?" /></label>
        <button type="button" class="btn o piccolo salva-base">Salva la quota base</button>
      </div>
      <p class="nota spiega-base"></p>
      <div class="pulsanti" style="justify-content:flex-start">
        <button type="button" class="btn g piccolo apri-sollecito">Sollecita per questo mese</button>
        <button type="button" class="btn o piccolo chiudi" style="margin-left:auto">Chiudi</button>
      </div>
    </form>
  </dialog>

  <dialog class="finestra-notifica finestra-dettagli">
    <form method="dialog">
      <h2>Quota di <span class="chi-d"></span></h2>
      <p class="nota mese-d"></p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <label>Importo (€)<input name="importo" inputmode="decimal" pattern="[0-9]+([.,][0-9]{1,2})?" required /></label>
        <label>Pagata il<input name="pagataIl" type="date" required /></label>
      </div>
      <label>Nota <input name="nota" maxlength="300" placeholder="Es. anticipo, pagata con bonifico" /></label>
      <p class="esito" hidden></p>
      <div class="pulsanti">
        <button type="button" class="btn o piccolo chiudi">Annulla</button>
        <button type="submit" class="btn g piccolo">Segna pagata</button>
      </div>
    </form>
  </dialog>

</Base>

<style>
  a.cifra-t { text-decoration: none; color: inherit; }
  a.cifra-t:hover { border-color: var(--primario); }
  .testa-mese { font: inherit; font-weight: 700; font-size: 13px; color: var(--primario); background: none; border: 0; padding: 6px 4px; border-radius: 6px; cursor: pointer; text-transform: lowercase; }
  .testa-mese:hover { background: var(--fondo); }
  .testa-mese.ora { box-shadow: inset 0 -3px 0 var(--accento); }
  .testa-mese.senza-quota { color: var(--tenue); text-decoration: line-through; }
  .testa-mese small { display: block; font-size: 11px; font-weight: 600; color: var(--tenue); white-space: nowrap; }
  .riporto { display: inline-flex; align-items: center; gap: 4px; padding: 2px 4px; border-radius: 8px; border: 2px solid var(--linea); }
  .riporto.debito { border-color: var(--accento); background: color-mix(in srgb, var(--accento) 18%, var(--bianco)); }
  .riporto.versato { border-color: #2e7d4f; }
  .cifra-riporto { width: 48px; padding: 4px; font: inherit; font-size: 13px; text-align: right; border: 1px solid var(--linea); border-radius: 6px; background: var(--bianco); }
  .cifra-riporto.mano { font-weight: 700; color: var(--primario); }
  .cifra-riporto:disabled { color: var(--testo); background: transparent; border-color: transparent; }
  .versato-riporto { width: 20px; height: 20px; accent-color: #2e7d4f; margin: 0; }
  /* La legenda del riporto riproduce in piccolo le caselle vere */
  .legenda-t + .legenda-t { border-top: 0; padding-top: 0; }
  .gruppo-legenda { color: var(--testo); font-weight: 700; min-width: 64px; }
  .riporto.mini { padding: 1px 3px; gap: 3px; border-radius: 6px; }
  .cifra-mini { min-width: 26px; padding: 1px 3px; font-size: 11px; text-align: right; border: 1px solid var(--linea); border-radius: 4px; background: var(--bianco); color: var(--testo); }
  .cifra-mini.fissa { border-color: transparent; background: transparent; }
  .cifra-mini.mano { font-weight: 700; color: var(--primario); }
  .spunta-mini { width: 13px; height: 13px; border: 1px solid #767676; border-radius: 3px; background: var(--bianco); display: grid; place-items: center; font-size: 9px; color: #fff; }
  .spunta-mini.on { background: #2e7d4f; border-color: #2e7d4f; }
  .spunta-mini.off { opacity: .4; }
  .griglia-quote .cella-riporto, .griglia-quote .tot-riporto, .testa-riporto { border-right: 2px solid var(--linea); }
  .base-m { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; }
  .base-m label { flex: 1 1 160px; }
  .spiega-base:empty { display: none; }
  .compatta .passato { display: none; }
  .testa-corista { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mostra-passati { font: inherit; font-size: 12px; font-weight: 600; color: var(--primario); background: var(--fondo); border: 1px solid var(--linea); border-radius: 999px; padding: 3px 9px; cursor: pointer; white-space: nowrap; text-transform: none; letter-spacing: 0; }
  .mostra-passati:hover { border-color: var(--primario); }
  .mostra-passati[aria-expanded='true'] .freccia { display: inline-block; transform: scaleX(-1); }
  .torna-calcolo { font: inherit; font-size: 15px; line-height: 1; color: var(--primario); background: none; border: 0; padding: 2px; cursor: pointer; }
  .torna-mini { font-size: 11px; color: var(--primario); }
  .cella-quota.diversa { box-shadow: inset 0 0 0 2px var(--accento); }
  .griglia-quote tfoot td { font-size: 12px; text-align: center; }
  .cifre-mese { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .cifre-mese:empty { display: none; }
  .cifre-mese :global(div) { border: 1px solid var(--linea); border-radius: var(--raggio); padding: 10px 12px; display: grid; }
  .cifre-mese :global(b) { font-size: 22px; color: var(--primario); }
  .cifre-mese :global(span) { font-size: 13px; color: var(--tenue); }
  .testa-tabella { display: flex; justify-content: flex-end; margin-top: 24px; }
  .testa-tabella + .solo-stampa + .carta { margin-top: 12px; }
  .solo-stampa { display: none; }
  /* Stampa: solo la tabella delle quote (con tutti i mesi, anche quelli chiusi) e la sua legenda, su un
     solo foglio A4 verticale, con l'intestazione dell'associazione: righe basse, caselle piccole */
  @page { size: A4 portrait; margin: 10mm; }
  @media print {
    :global(.salta), :global(.servizio), :global(.testata), :global(.barra-area), :global(.barra-tab), :global(.piede-sito), :global(.invito-app), .no-stampa, .mostra-passati, .torna-calcolo { display: none !important; }
    :global(body) { background: #fff; }
    .area-main { padding: 0; }
    .area-main :global(.w) { padding: 0; max-width: none; }
    .solo-stampa { display: block; }
    .intesta-stampa { margin-bottom: 6px; font-size: 10px; }
    .intesta-stampa h2 { margin: 2px 0; font-size: 14px; }
    .intesta-stampa small { color: var(--tenue); }
    .compatta .passato { display: table-cell; }
    .tabella-stampa { border: 0; box-shadow: none; margin: 0; }
    .tabella-wrap { overflow: visible; }
    .griglia-quote { font-size: 10px; width: 100%; border-collapse: collapse; }
    .griglia-quote :global(:is(th, td)) { padding: 0 2px; height: auto; line-height: 1.15; letter-spacing: 0; }
    .griglia-quote :global(th) { font-size: 9px; }
    .griglia-quote :global(:is(th, td):first-child) { position: static; white-space: nowrap; font-size: 10px; padding-left: 0; min-width: 0; max-width: none; }
    .griglia-quote :global(tfoot td) { font-size: 9px; }
    .griglia-quote tr { break-inside: avoid; }
    .griglia-quote :global(.cella-quota) { width: 15px; height: 15px; min-width: 0; min-height: 0; padding: 0; font-size: 9px; line-height: 1; border-width: 1px; border-radius: 3px; vertical-align: middle; }
    .griglia-quote :global(.cella-quota), .riporto, .legenda-t :global(.cella-quota) { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .testa-mese { padding: 0 1px; font-size: 9px; }
    .testa-mese small { font-size: 7px; }
    .riporto { border-width: 1px; padding: 0 1px; gap: 2px; border-radius: 3px; }
    .cifra-riporto { width: 28px; height: 13px; padding: 0 1px; border: 0; background: transparent; font-size: 9px; }
    .versato-riporto { width: 9px; height: 9px; }
    .legenda-t { font-size: 8px; gap: 4px 10px; padding: 4px 0 0; margin: 0; }
    .legenda-t :global(.cella-quota) { width: 11px; height: 11px; font-size: 7px; }
  }
</style>

<script>
  const SIMBOLO: Record<string, string> = { pagata: '✓', esonerato: 'E', 'da-pagare': '' };
  const ETICHETTA: Record<string, string> = { pagata: 'pagata', esonerato: 'esonerato', 'da-pagare': 'da pagare' };
  const PROSSIMO: Record<string, string> = { 'da-pagare': 'pagata', pagata: 'esonerato', esonerato: 'da-pagare' };
  const euro = (n: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', useGrouping: 'always' }).format(n).replace(/,00(?=\s?€)/, '');
  const meseLungo = (m: string) => new Date(`${m}-15`).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
  const numero = (v: string) => Number(v.replace(/\./g, '').replace(',', '.'));
  const base = (mese: string) => Number(document.querySelector<HTMLElement>(`.testa-mese[data-mese="${mese}"]`)?.dataset.base ?? 0);
  const celle = (mese: string) => [...document.querySelectorAll<HTMLButtonElement>(`button.cella-quota[data-mese="${mese}"]`)];
  const invia = async (corpo: object) => {
    const r = await fetch('/tesoriere/quote/segna', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });
    if (!r.ok) throw new Error((await r.json().catch(() => ({}))).errore ?? `Errore ${r.status}`);
  };

  // Il totale del mese in fondo alla colonna, dalle caselle (le quote degli ex coristi si vedono ricaricando)
  function totale(mese: string) {
    const td = document.querySelector<HTMLElement>(`.tot-mese[data-mese="${mese}"]`);
    if (!td || td.textContent === '–') return;
    const t = celle(mese).filter((c) => c.dataset.stato === 'pagata').reduce((s, c) => s + Number(c.dataset.importo), 0);
    td.textContent = euro(t).replace(/\s*€/, '');
  }

  function mostra(c: HTMLButtonElement, stato: string) {
    c.dataset.stato = stato;
    c.textContent = SIMBOLO[stato];
    c.title = `${c.dataset.nome}, ${meseLungo(c.dataset.mese!)}: ${ETICHETTA[stato]}`;
    if (stato !== 'pagata') { c.dataset.importo = String(base(c.dataset.mese!)); c.classList.remove('diversa'); }
    totale(c.dataset.mese!);
  }

  // Un tocco: da pagare → pagata → esonerato → da pagare
  async function avanza(c: HTMLButtonElement) {
    const prima = c.dataset.stato ?? 'da-pagare';
    const stato = PROSSIMO[prima];
    const nota = '';
    c.classList.add('in-corso');
    mostra(c, stato);
    try {
      await invia({ email: c.dataset.email, mese: c.dataset.mese, stato, nota });
      c.dataset.nota = nota;
    } catch (e) {
      mostra(c, prima);
      alert(`Non salvato: ${(e as Error).message}`);
    } finally {
      c.classList.remove('in-corso');
    }
  }

  // Pressione lunga, doppio clic o tasto destro: importo, data e nota
  const det = document.querySelector<HTMLDialogElement>('.finestra-dettagli')!;
  const fd = det.querySelector('form')!;
  let inDettaglio: HTMLButtonElement | undefined;
  function dettagli(c: HTMLButtonElement) {
    inDettaglio = c;
    det.querySelector('.chi-d')!.textContent = c.dataset.nome!;
    det.querySelector('.mese-d')!.textContent = `Quota di ${meseLungo(c.dataset.mese!)}. L'incasso conta nella cassa del giorno del pagamento.`;
    fd.importo.value = String(c.dataset.importo).replace('.', ',');
    fd.pagataIl.value = c.dataset.data!;
    fd.nota.value = c.dataset.nota ?? '';
    det.querySelector<HTMLElement>('.esito')!.hidden = true;
    det.showModal();
  }
  det.querySelector('.chiudi')!.addEventListener('click', () => det.close());
  fd.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!inDettaglio) return;
    try {
      await invia({ email: inDettaglio.dataset.email, mese: inDettaglio.dataset.mese, stato: 'pagata', importo: fd.importo.value, pagataIl: fd.pagataIl.value, nota: fd.nota.value });
      location.reload();
    } catch (err) {
      const es = det.querySelector<HTMLElement>('.esito')!;
      es.className = 'esito errore'; es.textContent = `Non salvato: ${(err as Error).message}`; es.hidden = false;
    }
  });

  // Riporto: la cifra si salva all'uscita dal campo (vuoto = quella calcolata), la casellina lo segna versato
  document.querySelectorAll<HTMLInputElement>('.cifra-riporto').forEach((i) => {
    i.addEventListener('keydown', (e) => { if (e.key === 'Enter') i.blur(); });
    i.addEventListener('change', async () => {
      if (i.value.trim() && !/^\d+([.,]\d{1,2})?$/.test(i.value.trim())) { alert('Scrivi una cifra in euro, per esempio 20 o 12,50.'); i.value = i.dataset.valore!; return; }
      i.classList.add('in-corso');
      try {
        await invia({ azione: 'riporto', email: i.dataset.email, anno: i.dataset.anno, cifra: i.value.trim() });
        location.reload();
      } catch (e) {
        i.value = i.dataset.valore!;
        alert(`Non salvato: ${(e as Error).message}`);
      } finally {
        i.classList.remove('in-corso');
      }
    });
  });
  document.querySelectorAll<HTMLInputElement>('.versato-riporto').forEach((v) => v.addEventListener('change', async () => {
    v.disabled = true;
    try {
      await invia({ azione: 'riporto', email: v.dataset.email, anno: v.dataset.anno, versato: v.checked });
      location.reload();
    } catch (e) {
      v.checked = !v.checked; v.disabled = false;
      alert(`Non salvato: ${(e as Error).message}`);
    }
  }));

  document.querySelectorAll<HTMLButtonElement>('button.cella-quota').forEach((c) => {
    let timer: ReturnType<typeof setTimeout> | undefined;
    let lunga = false;
    let clicTimer: ReturnType<typeof setTimeout> | undefined;
    c.addEventListener('pointerdown', () => { lunga = false; timer = setTimeout(() => { lunga = true; dettagli(c); }, 550); });
    ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => c.addEventListener(ev, () => clearTimeout(timer)));
    c.addEventListener('contextmenu', (e) => { e.preventDefault(); if (!lunga) { lunga = true; dettagli(c); } });
    // Il clic aspetta un attimo: se arriva il secondo è un doppio clic (dettagli), non due avanzamenti
    c.addEventListener('click', () => {
      if (lunga) { lunga = false; return; }
      if (clicTimer) { clearTimeout(clicTimer); clicTimer = undefined; dettagli(c); return; }
      clicTimer = setTimeout(() => { clicTimer = undefined; avanza(c); }, 260);
    });
  });

  // Un tocco sul mese: cifre, sollecito, "Nessuna quota"
  const fm = document.querySelector<HTMLDialogElement>('.finestra-mese')!;
  fm.querySelector('.chiudi')!.addEventListener('click', () => fm.close());
  let meseAperto: HTMLButtonElement | undefined;
  document.querySelectorAll<HTMLButtonElement>('.testa-mese').forEach((t) => t.addEventListener('click', () => {
    meseAperto = t;
    const m = t.dataset.mese!;
    const cc = celle(m).filter((c) => !c.disabled);
    const n = (s: string) => cc.filter((c) => c.dataset.stato === s).length;
    const senza = t.dataset.senza === '1';
    fm.querySelector('.titolo-m')!.textContent = meseLungo(m).replace(/^./, (x) => x.toUpperCase());
    fm.querySelector('.cifre-mese')!.innerHTML = senza ? '' : [
      [euro(cc.filter((c) => c.dataset.stato === 'pagata').reduce((s, c) => s + Number(c.dataset.importo), 0)), 'raccolti'],
      [String(n('pagata')), 'hanno pagato'], [String(n('esonerato')), 'esonerati'], [String(n('da-pagare')), 'da pagare'],
    ].map(([v, e]) => `<div><b>${v}</b><span>${e}</span></div>`).join('');
    fm.querySelector('.nota-m')!.textContent = senza ? `A ${meseLungo(m)} la quota non si raccoglie.${t.dataset.nota ? ` ${t.dataset.nota}` : ''}` : `${cc.length} coristi nel coro.`;
    const sol = fm.querySelector<HTMLButtonElement>('.apri-sollecito')!;
    sol.dataset.mese = m;
    sol.hidden = senza || !n('da-pagare');
    fm.querySelector<HTMLInputElement>('input[name="base"]')!.value = String(t.dataset.base ?? '').replace('.', ',');
    fm.querySelector('.spiega-base')!.textContent = m.endsWith('-09') ? 'Settembre ha poche prove e si assimila a giugno: se giugno ne ha avute poche la quota base è zero, se è stato un mese intero metà quota. I debiti della stagione prima sono nella colonna Riporto.'
      : m.endsWith('-06') ? 'Se giugno ha poche prove, si paga solo giugno e la quota base di settembre è zero.' : 'Zero = in questo mese la quota non si raccoglie.';
    fm.showModal();
  }));
  fm.querySelector('.salva-base')!.addEventListener('click', async () => {
    if (!meseAperto) return;
    const campo = fm.querySelector<HTMLInputElement>('input[name="base"]')!;
    if (!campo.value.trim() || !campo.reportValidity()) return;
    try {
      await invia({ azione: 'quota-base', mese: meseAperto.dataset.mese, importo: String(numero(campo.value)) });
      location.reload();
    } catch (e) {
      alert(`Non salvato: ${(e as Error).message}`);
    }
  });

  // I mesi già passati (e il riporto): chiusi all'apertura, si mostrano con la freccia
  const passati = document.querySelector<HTMLButtonElement>('.mostra-passati');
  passati?.addEventListener('click', () => {
    const aperti = !document.querySelector('.griglia-quote')!.classList.toggle('compatta');
    passati.setAttribute('aria-expanded', String(aperti));
    passati.querySelector('.testo-passati')!.textContent = aperti ? 'nascondi' : passati.dataset.etichetta!;
  });

  // Riporto scritto a mano: ↺ lo riporta al calcolo
  document.querySelectorAll<HTMLButtonElement>('.torna-calcolo').forEach((b) => b.addEventListener('click', async () => {
    b.disabled = true;
    try {
      await invia({ azione: 'riporto', email: b.dataset.email, anno: b.dataset.anno, cifra: '' });
      location.reload();
    } catch (e) {
      b.disabled = false;
      alert(`Non salvato: ${(e as Error).message}`);
    }
  }));
</script>
