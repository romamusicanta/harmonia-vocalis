---
// Pubblicazione e controlli: quando è stata costruita la versione online, il pulsante "Pubblica
// ora" e, per ogni evento del calendario "Concerti", i problemi che la build troverebbe adesso.
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import { comeIcal, configurazioneMancante, eventiConcerti, type EventoApi } from '../../admin/operazioni';
import { daEvento, slug } from '../../motore/calendario';
import { esisteImmagine } from '../../motore/coro';
import type { Concerto } from '../../motore/tipi';

export const prerender = false;

const sessione = Astro.locals.sessione!;
const p = Astro.url.searchParams;
const build = new Date(__ORA_BUILD__);
const quando = (d: Date) => new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', dateStyle: 'full', timeStyle: 'short' }).format(d);
const mancanti = configurazioneMancante();
const immagini = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/avif']);
const estensione: Record<string, string> = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/avif': 'avif' };

interface Riga { e: EventoApi; c: Concerto; avvisi: string[]; daPubblicare: boolean; futuro: boolean }
let righe: Riga[] = [];
let erroreCalendario: string | undefined;
try {
  const oggi = new Date().toISOString().slice(0, 10);
  righe = (await eventiConcerti(sessione)).map((e) => {
    const avvisi: string[] = [];
    const c = daEvento(comeIcal(e), (m) => avvisi.push(m));
    for (const a of e.attachments ?? []) {
      if (!immagini.has(a.mimeType)) avvisi.push(`allegato "${a.title}" non usato: il sito prende solo immagini JPEG, PNG, WebP o AVIF`);
    }
    // Un allegato che la versione online non ha ancora: serve "Pubblica ora"
    const nuoviAllegati = (e.attachments ?? []).some((a) => immagini.has(a.mimeType) && a.fileId && !esisteImmagine(`drive/${a.fileId}.${estensione[a.mimeType]}`));
    // Gli allegati non scaricati li segnala già il controllo qui sopra
    const filtrati = avvisi.filter((m) => !(nuoviAllegati && /non scaricato da Drive/.test(m)));
    return { e, c, avvisi: filtrati, daPubblicare: new Date(e.updated) > build || nuoviAllegati, futuro: c.data.slice(0, 10) >= oggi };
  });
} catch (err) {
  erroreCalendario = (err as Error).message;
}
const futuri = righe.filter((r) => r.futuro);
const passati = righe.filter((r) => !r.futuro).reverse();
const daPubblicare = righe.filter((r) => r.daPubblicare).length;
const conAvvisi = righe.filter((r) => r.avvisi.length).length;
const dataBreve = (c: Concerto) => new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(`${c.data.slice(0, 10)}T12:00:00`));
---

<LayoutAdmin titolo="Pubblicazione" sezione="pubblicazione">
  <h1>Ciao {sessione.nome}</h1>
  <p class="tenue">Il sito si ricostruisce da solo ogni notte con i dati del calendario "Concerti", di Drive e di YouTube. Per non aspettare, usa "Pubblica ora".</p>

  {mancanti.length > 0 && <p class="messaggio errore">Configurazione incompleta sul server: manca {mancanti.join(', ')}.</p>}
  {p.get('pubblicato') && <p class="messaggio ok">Pubblicazione avviata: tra due o tre minuti il sito è aggiornato. Ricarica questa pagina: quando cambia l'ora della versione online, è fatto.</p>}
  {p.get('completata') && <p class="messaggio ok">Pubblicazione completata: il sito è aggiornato.</p>}
  {p.get('errore') && <p class="messaggio errore">{p.get('errore')}</p>}

  <div class="scheda-admin" style="display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between;margin-top:24px">
    <div>
      <span class="eti">Versione online</span>
      <p style="font-size:19px;font-weight:600;color:var(--primario)">Costruita {quando(build)}</p>
      {daPubblicare > 0
        ? <p style="margin-top:6px"><b>{daPubblicare === 1 ? '1 concerto è cambiato' : `${daPubblicare} concerti sono cambiati`}</b> dopo questa versione: non sono ancora sul sito.</p>
        : !erroreCalendario && <p class="tenue" style="margin-top:6px">Il calendario non è cambiato da allora.</p>}
    </div>
    <div id="pubblicazione" data-build={__ORA_BUILD__}>
      <form id="pubblica" method="post" action="/admin/pubblica"><button class="btn g" type="submit">Pubblica ora</button></form>
      <div class="in-corso" hidden>
        <span class="rotella" aria-hidden="true"></span>
        <div><b>Pubblicazione in corso…</b><span class="tenue" data-durata>di solito due o tre minuti</span></div>
      </div>
    </div>
  </div>
  <p id="esito-pubblicazione" role="status" aria-live="polite" hidden></p>

  <div class="scheda-admin" style="display:flex;flex-wrap:wrap;gap:12px 32px;align-items:center;justify-content:space-between;margin-top:16px">
    <div>
      <span class="eti">Coristi</span>
      <p style="margin-top:4px">Assenze a prove e concerti: segna chi ha avvisato a voce o chi non è venuto.</p>
    </div>
    <a class="btn g" href="/admin/assenze">Assenze dei coristi</a>
  </div>

  <style>
    .in-home { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--primario); cursor: pointer; }
    .in-home input { width: 18px; height: 18px; accent-color: var(--primario); }
    #pubblicazione .in-corso { display: flex; align-items: center; gap: 14px; color: var(--primario); }
    #pubblicazione .in-corso[hidden] { display: none; }
    #pubblicazione .in-corso div { display: grid; gap: 2px; }
    #pubblicazione .in-corso span.tenue { font-size: 14px; }
    .rotella { width: 30px; height: 30px; flex: none; border-radius: 50%; border: 4px solid color-mix(in srgb, var(--primario) 15%, transparent); border-top-color: var(--accento); animation: gira 0.9s linear infinite; }
    @keyframes gira { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .rotella { animation-duration: 3s; } }
  </style>

  <script>
    // Dopo "Pubblica ora" la pagina chiede ogni 5 secondi quando è stata costruita la versione che
    // risponde (/admin/stato): quando cambia, la nuova è online e la pagina si ricarica con i dati
    // aggiornati. L'avvio resta nel browser, così ricaricando o tornando qui la rotella continua.
    const CHIAVE = 'hv-pubblicazione';
    const OGNI = 5000, LENTA = 10 * 60_000, MASSIMO = 20 * 60_000;
    const box = document.getElementById('pubblicazione')!;
    const modulo = document.getElementById('pubblica') as HTMLFormElement;
    const inCorso = box.querySelector<HTMLElement>('.in-corso')!;
    const durata = box.querySelector<HTMLElement>('[data-durata]')!;
    const esito = document.getElementById('esito-pubblicazione')!;
    const buildAttuale = box.dataset.build!;

    const leggi = (): { avviata: number; build: string } | undefined => {
      try { return JSON.parse(localStorage.getItem(CHIAVE) ?? 'null') ?? undefined; } catch { return undefined; }
    };
    const scrivi = (v?: { avviata: number; build: string }) => {
      try { v ? localStorage.setItem(CHIAVE, JSON.stringify(v)) : localStorage.removeItem(CHIAVE); } catch {}
    };
    function messaggio(testo: string, classe: string) {
      esito.hidden = false;
      esito.className = `messaggio ${classe}`;
      esito.textContent = testo;
    }
    const mmss = (ms: number) => `${Math.floor(ms / 60_000)}:${String(Math.floor(ms / 1000) % 60).padStart(2, '0')}`;

    function attendi(avvio: { avviata: number; build: string }) {
      modulo.hidden = true;
      inCorso.hidden = false;
      esito.hidden = true;
      const orologio = setInterval(() => {
        const passato = Date.now() - avvio.avviata;
        durata.textContent = `${mmss(passato)} · di solito due o tre minuti`;
        if (passato > LENTA) messaggio('La pubblicazione sta impiegando più del solito. Se non finisce, la ricostruzione potrebbe essere fallita: riprova tra qualche minuto, o avvisa Mario.', 'errore');
      }, 1000);
      const controlla = async () => {
        if (Date.now() - avvio.avviata > MASSIMO) {
          clearInterval(orologio);
          scrivi();
          inCorso.hidden = true;
          modulo.hidden = false;
          messaggio('La pubblicazione non si è conclusa entro 20 minuti: probabilmente è fallita. Riprova, e se succede ancora avvisa Mario.', 'errore');
          return;
        }
        try {
          const r = await fetch('/admin/stato', { cache: 'no-store' });
          if (r.redirected && r.url.includes('/admin/accedi')) {
            messaggio('La sessione è scaduta: ricarica la pagina per rientrare (la pubblicazione intanto continua).', 'errore');
            return;
          }
          const { build } = await r.json();
          if (build !== avvio.build) {
            scrivi();
            location.replace('/admin?completata=1');
            return;
          }
        } catch {
          // Durante il passaggio alla nuova versione una richiesta può fallire: si riprova
        }
        setTimeout(controlla, OGNI);
      };
      setTimeout(controlla, OGNI);
    }

    modulo.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const pulsante = modulo.querySelector('button')!;
      pulsante.disabled = true;
      try {
        const r = await fetch('/admin/pubblica', { method: 'POST', headers: { Accept: 'application/json' } });
        const j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
        if (!j.ok) throw new Error(j.errore);
        const avvio = { avviata: Date.now(), build: buildAttuale };
        scrivi(avvio);
        attendi(avvio);
      } catch (e) {
        messaggio(`Pubblicazione non avviata: ${(e as Error).message}`, 'errore');
      } finally {
        pulsante.disabled = false;
      }
    });

    // Casella "In home": si salva subito nell'evento del calendario
    for (const casella of document.querySelectorAll<HTMLInputElement>('.in-home input')) {
      casella.addEventListener('change', async () => {
        casella.disabled = true;
        const dati = new FormData();
        dati.set('evento', casella.dataset.evento!);
        dati.set('home', casella.checked ? '1' : '0');
        try {
          const r = await fetch('/admin/concerti/home', { method: 'POST', body: dati });
          const j = await r.json().catch(() => ({ ok: false, errore: `risposta inattesa dal server (${r.status})` }));
          if (!j.ok) throw new Error(j.errore);
          const scheda = casella.closest('.scheda-admin')!;
          if (!scheda.querySelector('.tag')) casella.closest('label')!.insertAdjacentHTML('beforebegin', '<span class="tag">Da pubblicare</span>');
        } catch (e) {
          casella.checked = !casella.checked;
          messaggio(`Non salvato: ${(e as Error).message}`, 'errore');
        } finally {
          casella.disabled = false;
        }
      });
    }

    // Il messaggio "completata" si vede una volta: ricaricando non torna
    if (location.search.includes('completata')) history.replaceState(null, '', '/admin');

    // Una pubblicazione avviata prima di ricaricare: se la versione è ancora quella, si continua ad aspettare
    const avvio = leggi();
    if (avvio && avvio.build === buildAttuale && Date.now() - avvio.avviata < MASSIMO) attendi(avvio);
    else if (avvio) scrivi();
  </script>

  <h2>Controllo dei concerti</h2>
  {erroreCalendario
    ? <p class="messaggio errore">Non riesco a leggere il calendario: {erroreCalendario}</p>
    : <p class="tenue">{righe.length === 1 ? '1 evento' : `${righe.length} eventi`} nel calendario "Concerti". {conAvvisi ? `${conAvvisi} con qualcosa da sistemare: apri l'evento nel calendario, correggi e poi pubblica.` : 'Nessun problema trovato.'}</p>}

  {[{ titolo: 'In programma', elenco: futuri }, { titolo: 'Passati', elenco: passati }].map(({ titolo, elenco }) => elenco.length > 0 && (
    <>
      <h2 style="font-size:20px">{titolo}</h2>
      <div style="display:grid;gap:10px">
        {elenco.map(({ e, c, avvisi, daPubblicare, futuro }) => (
          <div class="scheda-admin" style={`padding:16px 18px;${avvisi.length ? 'border-left:4px solid #b3261e' : ''}`}>
            <div style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:baseline;justify-content:space-between">
              <div><b style="color:var(--primario)">{dataBreve(c)}</b> · {[c.autore, c.titolo].filter(Boolean).join(', ')}{c.luogo && <span class="tenue"> · {c.luogo}</span>}</div>
              <div style="display:flex;gap:14px;font-size:14px;flex-wrap:wrap">
                {daPubblicare && <span class="tag">Da pubblicare</span>}
                <label class="in-home" title="Mostra il concerto tra le schede della home page"><input type="checkbox" data-evento={e.id} checked={c.home ?? futuro} /> In home</label>
                <a href={`/admin/concerti/modifica?id=${encodeURIComponent(e.id)}`} style="text-decoration:underline;font-weight:700">Modifica</a>
                <a href={e.htmlLink} target="_blank" rel="noopener" style="text-decoration:underline">Apri nel calendario</a>
                {!daPubblicare && <a href={`/concerti/${slug(c)}`} target="_blank" rel="noopener" style="text-decoration:underline">Pagina sul sito</a>}
              </div>
            </div>
            {avvisi.length > 0 && <ul style="margin:10px 0 0 18px;color:#b3261e;font-size:15px">{avvisi.map((a) => <li>{a}</li>)}</ul>}
            {!(e.attachments ?? []).some((a) => /locandina/i.test(a.title)) && !c.locandina && <p class="tenue" style="font-size:14px;margin-top:6px">Senza locandina: il sito ne genera una con i dati dell'evento.</p>}
          </div>
        ))}
      </div>
    </>
  ))}
</LayoutAdmin>
