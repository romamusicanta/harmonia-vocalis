---
// Pubblicazione: quando è stata costruita la versione online, il pulsante "Pubblica ora" e un
// riepilogo dei concerti da pubblicare o da sistemare (l'elenco è nella pagina Concerti).
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import Errore from '../../area/Errore.astro';
import { configurazioneMancante } from '../../admin/operazioni';
import { controllaConcerti, type Riga } from '../../admin/controllo';

export const prerender = false;

const sessione = Astro.locals.sessione!;
const p = Astro.url.searchParams;
const build = new Date(__ORA_BUILD__);
const quando = (d: Date) => new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', dateStyle: 'full', timeStyle: 'short' }).format(d);
const mancanti = configurazioneMancante();
let righe: Riga[] = [];
let erroreCalendario: unknown;
try {
  righe = await controllaConcerti(sessione);
} catch (err) {
  erroreCalendario = err;
}
const daPubblicare = righe.filter((r) => r.daPubblicare).length;
const conAvvisi = righe.filter((r) => r.avvisi.length).length;
---

<LayoutAdmin titolo="Pubblicazione" sezione="pubblicazione">
  <h1>Ciao {sessione.nome}</h1>
  <p class="tenue">Il sito si ricostruisce da solo ogni notte con i dati del calendario "Concerti", di Drive e di YouTube. Per non aspettare, usa "Pubblica ora".</p>

  {mancanti.length > 0 && <p class="messaggio errore">Configurazione incompleta sul server: manca {mancanti.join(', ')}.</p>}
  {p.get('pubblicato') && <p class="messaggio ok">Pubblicazione avviata: tra due o tre minuti il sito è aggiornato.</p>}
  {p.get('errore') && <p class="messaggio errore">{p.get('errore')}</p>}

  <div class="scheda-admin" style="display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between;margin-top:24px">
    <div>
      <span class="eti">Versione online</span>
      <p style="font-size:19px;font-weight:600;color:var(--primario)">Costruita {quando(build)}</p>
      {daPubblicare > 0
        ? <p style="margin-top:6px"><b>{daPubblicare === 1 ? '1 concerto è cambiato' : `${daPubblicare} concerti sono cambiati`}</b> dopo questa versione: non sono ancora sul sito.</p>
        : !erroreCalendario && <p class="tenue" style="margin-top:6px">Il calendario non è cambiato da allora.</p>}
    </div>
    <div id="pubblicazione" data-build={__ORA_BUILD__}>
      <form id="pubblica" method="post" action="/admin/pubblica"><button class="btn g" type="submit">Pubblica ora</button></form>
    </div>
  </div>

  {erroreCalendario ? <Errore e={erroreCalendario} /> : (
    <div class="scheda-admin" style="display:flex;flex-wrap:wrap;gap:12px 32px;align-items:center;justify-content:space-between;margin-top:16px">
      <p>{righe.length === 1 ? '1 concerto' : `${righe.length} concerti`} nel calendario. {conAvvisi ? <b style="color:#b3261e">{conAvvisi === 1 ? '1 ha qualcosa da sistemare.' : `${conAvvisi} hanno qualcosa da sistemare.`}</b> : 'Nessun problema trovato.'}</p>
      <a class="btn o" href="/admin/concerti">Vai ai concerti</a>
    </div>
  )}



</LayoutAdmin>
