---
// Amministrazione: il repertorio dell'area coristi (src/area/repertorio.ts)
import LayoutAdmin from '../../../admin/LayoutAdmin.astro';
import GestioneRepertorio from '../../../area/GestioneRepertorio.astro';
import { dopoIlModulo } from '../../../area/repertorio';

export const prerender = false;
if (Astro.request.method === 'POST') return Astro.redirect(await dopoIlModulo(Astro.request, Astro.locals.sessione!.email, '/admin/repertorio'));
---

<LayoutAdmin titolo="Repertorio" sezione="repertorio">
  <h1>Repertorio</h1>
  <p class="tenue" style="max-width:64ch">Quello che i coristi trovano nella pagina Repertorio della loro area. Ogni <b>pezzo</b> ha spartito, parti (movimenti o estratti, caricati su Drive nella cartella Spartiti), tracce di studio per sezione, anche per ogni parte, esecuzione di riferimento e note del Maestro. Le <b>raccolte</b> sono cartelle di pezzi, come i canti natalizi o i brani per i bis: un pezzo può stare in più raccolte. Il Maestro dalla sua area scrive solo le note sull'esecuzione.</p>
  <GestioneRepertorio base="/admin" />
</LayoutAdmin>
