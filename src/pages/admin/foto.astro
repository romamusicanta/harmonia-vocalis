---
// Foto del sito: le foto generali (cartella Sito/Foto del Drive condiviso) con quella pubblicata
// adesso accanto, quella già su Drive ma non ancora pubblicata e il caricamento di una nuova, con
// l'anteprima del file scelto. L'invio va a /admin/foto/carica. Sotto (dal 13/10/2026), il carosello
// della pagina «Il Maestro» (src/admin/fotoMaestro.ts): caricamento, scelta e ordine delle foto.
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import '../../admin/ordine.css';
import Errore from '../../area/Errore.astro';
import { fotoSitoSuDrive } from '../../admin/operazioni';
import { fotoDelMaestro, type FotoMaestro } from '../../admin/fotoMaestro';
import { coro, immagine, LIMITE_CAROSELLO } from '../../motore/coro';

export const prerender = false;

// Su Drive e modificate dopo la build: sul sito non ci sono ancora
let suDrive: Awaited<ReturnType<typeof fotoSitoSuDrive>> = {};
try {
  suDrive = await fotoSitoSuDrive(Astro.locals.sessione!);
} catch {}
const build = new Date(__ORA_BUILD__);
const nuova = (nome: string) => {
  const f = suDrive[nome];
  return f && new Date(f.modificata) > build ? `/admin/drive/immagine?${new URLSearchParams({ id: f.id, v: f.modificata })}` : undefined;
};

let fotoMaestro: FotoMaestro[] = [];
let erroreMaestro: unknown;
try {
  fotoMaestro = await fotoDelMaestro();
} catch (e) {
  erroreMaestro = e;
}
const nelCarosello = fotoMaestro.filter((f) => f.carosello);
const fuori = fotoMaestro.filter((f) => !f.carosello);
const quando = (iso: string) => new Date(iso).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' });

const posti = [
  { nome: 'apertura', titolo: 'Apertura', dove: 'Home, in alto: la prima cosa che si vede; anche anteprima dei link condivisi.', consiglio: 'Il coro in concerto, orizzontale, almeno 2000 px.', attuale: coro.foto.apertura },
  { nome: 'coro', titolo: 'Il coro', dove: 'Pagina "Il coro" (a tutta larghezza) e sezione "Il coro" della home.', consiglio: 'Il coro intero, orizzontale, almeno 2400 px.', attuale: coro.foto.coro },
  { nome: 'prove', titolo: 'Prove', dove: 'Pagina "Canta con noi".', consiglio: 'Una prova del coro.', attuale: coro.foto.prove ?? coro.foto.coro },
  { nome: 'maestro', titolo: 'Il Maestro', dove: 'Home e anteprima della pagina "Il Maestro"; nella pagina, solo se il carosello qui sotto è vuoto.', consiglio: `Ritratto del M° ${coro.maestro.nome}, quadrato o verticale, almeno 1200 px.`, attuale: coro.maestro.foto },
  { nome: 'accesso', titolo: 'Accesso coristi', dove: "Pagina di accesso dell'area coristi (se manca, si usa l'apertura).", consiglio: 'Facoltativa.', attuale: coro.foto.accesso },
];
---

<LayoutAdmin titolo="Foto del sito" sezione="foto">
  <h1>Foto del sito</h1>
  <p class="tenue" style="max-width:64ch">Accanto a ogni posto c'è la foto pubblicata adesso. Caricandone una nuova, sostituisce quella su Drive (cartella Sito/Foto); sul sito compare con la prossima pubblicazione (fino ad allora si vede qui accanto, "da pubblicare"). Prima di caricare: chi l'ha scattata e il consenso delle persone riconoscibili.</p>
  <p id="esito" role="status"></p>

  <div style="display:grid;gap:16px;margin-top:20px">
    {posti.map((p) => (
      <form class="scheda-admin modulo-foto" data-nome={p.nome} style="display:flex;flex-wrap:wrap;gap:20px;align-items:center">
        <div class="anteprime">
          <figure><img src={immagine(p.attuale).src} alt="" loading="lazy" /><figcaption>Sul sito</figcaption></figure>
          {nuova(p.nome) && <figure class="nuova"><img src={nuova(p.nome)} alt="" loading="lazy" /><figcaption>Su Drive, da pubblicare</figcaption></figure>}
          <figure class="da-salvare" hidden><img alt="" /><figcaption>Scelta, non ancora caricata</figcaption></figure>
        </div>
        <div style="display:grid;gap:8px;flex:1 1 280px">
          <b style="color:var(--primario);font-size:19px">{p.titolo}</b>
          <span class="tenue" style="font-size:15px">{p.dove} {p.consiglio}</span>
          <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" required />
            <button class="btn g" type="submit">Sostituisci</button>
          </div>
        </div>
      </form>
    ))}
  </div>

  <section class="scheda-admin maestro-carosello" id="maestro">
    <h2>Il Maestro: carosello della sua pagina <small class="tenue">· {nelCarosello.length} {nelCarosello.length === 1 ? 'foto' : 'foto'}</small></h2>
    <p class="tenue" style="max-width:64ch;font-size:15px">Le foto del carosello scorrono, in quest'ordine, nella foto grande in cima alla pagina «Il Maestro» (al massimo {LIMITE_CAROSELLO}): riordinale trascinandole o con le frecce. Una foto caricata entra nel carosello in fondo; «Fuori dal carosello» la tiene da parte su Drive (cartella Sito/Foto/Maestro), «Togli» la mette nel cestino. Senza foto nel carosello resta la foto «Il Maestro» qui sopra. Tutto vale dopo la prossima <a href="/admin">pubblicazione</a>. Prima di caricare: chi l'ha scattata e il consenso.</p>
    {erroreMaestro ? <Errore e={erroreMaestro} /> : <>
      <form class="carica-maestro">
        <label class="btn o piccolo scegli">Carica foto <input type="file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
        <span class="stato-maestro tenue" role="status"></span>
      </form>
      {nelCarosello.length > 0 && (
        <ol class="ordine-carosello" data-limite={LIMITE_CAROSELLO}>
          {nelCarosello.map((f, i) => (
            <li draggable="true" data-id={f.id} class:list={{ fuori: i >= LIMITE_CAROSELLO }}>
              <span class="posto">{i + 1}</span>
              <img src={`/admin/foto-maestro/miniatura/${f.id}`} alt="" loading="lazy" draggable="false" />
              <small>Caricata il {quando(f.caricata)}<span class="non-scorre"> · non in carosello</span></small>
              <span class="frecce">
                <button type="button" class="su" aria-label="Sposta prima">↑</button>
                <button type="button" class="giu" aria-label="Sposta dopo">↓</button>
              </span>
              <span class="azioni-ordine">
                <button type="button" class="togli-carosello esci" data-id={f.id}>Fuori dal carosello</button>
                <button type="button" class="togli-carosello cestina" data-id={f.id}>Togli</button>
              </span>
            </li>
          ))}
        </ol>
      )}
      <p class="esito-ordine tenue" role="status"></p>
      {fuori.length > 0 && <>
        <h3 class="fuori-titolo">Fuori dal carosello</h3>
        <ul class="ordine-carosello da-parte">
          {fuori.map((f) => (
            <li data-id={f.id}>
              <img src={`/admin/foto-maestro/miniatura/${f.id}`} alt="" loading="lazy" />
              <small>Caricata il {quando(f.caricata)}</small>
              <span class="azioni-ordine">
                <button type="button" class="btn o piccolo entra" data-id={f.id}>Nel carosello</button>
                <button type="button" class="togli-carosello cestina" data-id={f.id}>Togli</button>
              </span>
            </li>
          ))}
        </ul>
      </>}
    </>}
  </section>

  <style>
    .maestro-carosello { margin-top: 28px; }
    .maestro-carosello h2 { font-size: 19px; margin: 0 0 8px; }
    .maestro-carosello h2 small { font-size: 14px; font-weight: 400; }
    .carica-maestro { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 12px 0 4px; }
    .carica-maestro .scegli { cursor: pointer; }
    .fuori-titolo { font-size: 16px; margin: 20px 0 0; }
    .da-parte li { cursor: default; }
    .anteprime { display: flex; flex-wrap: wrap; gap: 12px; }
    .anteprime figure { margin: 0; width: 180px; }
    .anteprime img { display: block; width: 100%; height: 130px; object-fit: cover; border-radius: var(--raggio); background: var(--primario); }
    .anteprime figcaption { font-size: 13px; margin-top: 4px; color: var(--tenue); }
    .anteprime .nuova figcaption, .anteprime .da-salvare figcaption { font-weight: 700; color: var(--primario); }
    .anteprime .da-salvare img { outline: 3px solid var(--accento); outline-offset: -3px; }
  </style>

  <script>
    import { riduci } from '../../admin/immagini';
    import { attivaOrdine, inviaJson } from '../../admin/ordine-client';

    const esito = document.getElementById('esito')!;
    const mostra = (html: string, classe: string) => { esito.className = `messaggio ${classe}`; esito.innerHTML = html; esito.scrollIntoView({ block: 'nearest' }); };

    // Carosello del Maestro: caricamento (una foto alla volta, ridotta prima), ordine, dentro/fuori, cestino
    const caricaMaestro = document.querySelector<HTMLFormElement>('.carica-maestro');
    if (caricaMaestro) {
      const input = caricaMaestro.querySelector<HTMLInputElement>('input[type=file]')!;
      const stato = caricaMaestro.querySelector<HTMLElement>('.stato-maestro')!;
      input.addEventListener('change', async () => {
        const file = [...(input.files ?? [])];
        if (!file.length) return;
        let fatte = 0;
        const errori: string[] = [];
        for (const [i, f] of file.entries()) {
          stato.textContent = `Carico la foto ${i + 1} di ${file.length}…`;
          try {
            const dati = new FormData();
            dati.set('foto', await riduci(f));
            const r = await fetch('/admin/foto-maestro/carica', { method: 'POST', body: dati });
            const j = await r.json().catch(() => ({ ok: false, errore: `Risposta inattesa dal server (${r.status})` }));
            if (!j.ok) throw new Error(j.errore);
            fatte++;
          } catch (e) {
            errori.push(`${f.name}: ${(e as Error).message}`);
          }
        }
        stato.textContent = `${fatte} ${fatte === 1 ? 'foto caricata' : 'foto caricate'}.${errori.length ? ` Non caricate: ${errori.join(' · ')}` : ''}`;
        if (fatte) setTimeout(() => { location.hash = 'maestro'; location.reload(); }, errori.length ? 4000 : 600);
      });
      const lista = document.querySelector<HTMLOListElement>('.maestro-carosello ol.ordine-carosello');
      const esito = document.querySelector<HTMLElement>('.maestro-carosello .esito-ordine')!;
      if (lista) attivaOrdine(lista, esito, (ids) => inviaJson('/admin/foto-maestro/stato', { ids }), Number(lista.dataset.limite));
      document.querySelector('.maestro-carosello')!.addEventListener('click', async (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>('.esci, .entra, .cestina');
        if (!b) return;
        const corpo = b.classList.contains('cestina') ? { id: b.dataset.id, togli: true } : { id: b.dataset.id, carosello: b.classList.contains('entra') };
        if (b.classList.contains('cestina') && !confirm('Togliere questa foto? Va nel cestino del Drive condiviso (si recupera per 30 giorni).')) return;
        b.disabled = true;
        try {
          await inviaJson('/admin/foto-maestro/stato', corpo);
          location.hash = 'maestro';
          location.reload();
        } catch (err) {
          b.disabled = false;
          alert(`Non salvato: ${(err as Error).message}`);
        }
      });
    }

    for (const modulo of document.querySelectorAll<HTMLFormElement>('.modulo-foto')) {
      // Anteprima del file appena scelto, prima ancora di caricarlo
      const input = modulo.elements.namedItem('foto') as HTMLInputElement;
      const scelta = modulo.querySelector<HTMLElement>('.da-salvare')!;
      const didascalia = scelta.querySelector('figcaption')!;
      input.addEventListener('change', () => {
        const file = input.files?.[0];
        const img = scelta.querySelector('img')!;
        if (img.src) URL.revokeObjectURL(img.src);
        scelta.hidden = !file;
        if (file) { img.src = URL.createObjectURL(file); didascalia.textContent = 'Scelta, non ancora caricata'; }
      });

      modulo.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const file = (modulo.elements.namedItem('foto') as HTMLInputElement).files?.[0];
        if (!file) return;
        const pulsante = modulo.querySelector('button')!;
        pulsante.disabled = true;
        mostra('Carico la foto…', '');
        try {
          const dati = new FormData();
          dati.set('nome', modulo.dataset.nome!);
          dati.set('foto', await riduci(file));
          const r = await fetch('/admin/foto/carica', { method: 'POST', body: dati });
          const j = await r.json().catch(() => ({ ok: false, errore: `Risposta inattesa dal server (${r.status})` }));
          if (!j.ok) throw new Error(j.errore);
          // La foto scelta resta come anteprima: ora è quella su Drive, da pubblicare
          modulo.querySelector('.nuova')?.remove();
          didascalia.textContent = 'Su Drive, da pubblicare';
          modulo.reset();
          mostra(`Foto "${modulo.dataset.nome}" sostituita su Drive. Per vederla sul sito: <a href="/admin">Pubblicazione</a> → "Pubblica ora".`, 'ok');
        } catch (e) {
          mostra(`Non caricata: ${(e as Error).message}`, 'errore');
        } finally {
          pulsante.disabled = false;
        }
      });
    }
  </script>
</LayoutAdmin>
