---
// Accesso all'area Amministrazione. Dal 7/10/2026, in quest'ordine:
// 1. chi ha già la sessione delle aree (per esempio entrato con il codice via email) ed è redattore
//    entra subito, senza Google (sessioneDalleAree);
// 2. si chiede a Google in silenzio, con l'account della sessione scaduta, di quella delle aree o
//    dell'ultimo accesso (accountRicordato): chi ha l'account collegato nel browser rientra senza
//    vedere niente; se non riesce, il ritorno torna qui con ?scegli=1. Mai dopo "Esci";
// 3. la pagina con il codice via email (src/area/AccessoCodice.astro) e «Accedi con Google»
//    (?google=1: si va da Google e si torna su /admin/callback).
// Un valore casuale (state) in un cookie protegge il ritorno da Google da richieste estranee.
import { randomBytes } from 'node:crypto';
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import AccessoCodice from '../../area/AccessoCodice.astro';
import { configurato, sessioneDalleAree, urlAccesso } from '../../admin/google';
import { cifra, leggiSessione, salvaSessione } from '../../admin/sessione';
import { accountRicordato, coristaValido, leggiCorista, rientroSilenzioso } from '../../area/accesso';
import { codiceConfigurato } from '../../area/codice';
import { coro } from '../../motore/coro';

export const prerender = false;

const p = Astro.url.searchParams;
const richiesta = p.get('dopo') ?? '/admin';
const dopo = richiesta.startsWith('/admin') && !richiesta.startsWith('/admin/accedi') ? richiesta : '/admin';
const errore = p.get('errore');
const sicuro = Astro.url.protocol === 'https:';

if (!errore && !p.has('google')) {
  const delleAree = leggiCorista(Astro.cookies);
  const corista = delleAree && (await coristaValido(delleAree));
  const sessione = corista ? await sessioneDalleAree(corista) : undefined;
  if (sessione) {
    salvaSessione(Astro.cookies, sessione, sicuro);
    return Astro.redirect(dopo);
  }
}

const daGoogle = (silenzioso?: string) => {
  const stato = randomBytes(16).toString('hex');
  Astro.cookies.set('hv-stato', cifra({ stato, silenzioso: Boolean(silenzioso), dopo }), { httpOnly: true, secure: sicuro, sameSite: 'lax', path: '/admin', maxAge: 600 });
  return Astro.redirect(urlAccesso(`${Astro.url.origin}/admin/callback`, stato, silenzioso));
};
if (configurato() && !errore) {
  if (p.has('google')) return daGoogle();
  const delDominio = (e?: string) => (e?.toLowerCase().endsWith(`@${coro.amministrazione!.dominio}`) ? e : undefined);
  const silenzioso = !p.has('scegli') && rientroSilenzioso(Astro.cookies, Astro.request)
    ? delDominio(leggiSessione(Astro.cookies)?.email) ?? delDominio(leggiCorista(Astro.cookies)?.email) ?? delDominio(accountRicordato(Astro.cookies))
    : undefined;
  if (silenzioso) return daGoogle(silenzioso);
  // Senza il codice via email resta solo Google
  if (!codiceConfigurato()) return daGoogle();
}
const google = `/admin/accedi?${new URLSearchParams({ google: '1', dopo })}`;
---

<LayoutAdmin titolo="Accesso">
  <div class="accesso-admin">
    <h1>Area Amministrazione</h1>
    <p class="tenue">Per i redattori del sito. Scrivi la tua email per ricevere un codice, oppure entra con il tuo account Google dell'associazione.</p>
    {errore && <p class="messaggio errore">{errore}</p>}
    <AccessoCodice dopo={dopo} />
    {configurato() ? (
      <a class="btn o google-admin" href={google}>Accedi con Google</a>
    ) : (
      !codiceConfigurato() && <p class="messaggio errore">L'accesso non è ancora configurato: mancano le credenziali sul server.</p>
    )}
  </div>
</LayoutAdmin>

<style>
  .accesso-admin { max-width: 420px; display: grid; gap: 16px; }
  .google-admin { width: 100%; min-height: 48px; justify-content: center; }
</style>
