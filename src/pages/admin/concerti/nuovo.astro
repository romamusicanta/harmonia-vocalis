---
// Nuovo concerto: il modulo (src/admin/ModuloConcerto.astro) scrive l'evento nel calendario
// "Concerti" secondo la convenzione, crea la cartella del concerto su Drive e ci carica locandina e
// foto principale, allegandole all'evento.
import LayoutAdmin from '../../../admin/LayoutAdmin.astro';
import ModuloConcerto from '../../../admin/ModuloConcerto.astro';

export const prerender = false;
---

<LayoutAdmin titolo="Nuovo concerto" sezione="concerto">
  <h1>Nuovo concerto</h1>
  <p class="tenue" style="max-width:62ch">Crea l'evento nel calendario "Concerti" e la cartella del concerto su Drive, con locandina e foto principale già allegate. Dopo, si modifica da <a href="/admin" style="text-decoration:underline">Pubblicazione e controlli</a> → "Modifica".</p>
  <ModuloConcerto />
</LayoutAdmin>
