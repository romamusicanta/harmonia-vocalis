---
// Nuovo concerto: un modulo che scrive l'evento nel calendario "Concerti" secondo la convenzione
// (src/motore/concerti.ts), crea la cartella del concerto su Drive e ci carica locandina e copertina,
// allegandole all'evento. Il browser riduce le immagini prima dell'invio (limite di 4,5 MB per
// richiesta delle funzioni Vercel). L'invio va a /admin/concerti/crea.
import LayoutAdmin from '../../../admin/LayoutAdmin.astro';
import { coro } from '../../../motore/coro';

export const prerender = false;

const ruoli = ['Soprano', 'Mezzosoprano', 'Contralto', 'Tenore', 'Baritono', 'Basso', 'Solisti', 'Orchestra', 'Canta insieme a noi', 'Direttore', 'Maestro del coro', 'Pianoforte', 'Organo', 'Percussioni', 'Voce recitante'];
---

<LayoutAdmin titolo="Nuovo concerto" sezione="concerto">
  <h1>Nuovo concerto</h1>
  <p class="tenue" style="max-width:62ch">Crea l'evento nel calendario "Concerti" e la cartella del concerto su Drive, con locandina e copertina già allegate. Dopo, per correggere qualcosa, si modifica l'evento direttamente nel calendario.</p>

  <form class="modulo" id="nuovo-concerto" style="max-width:820px;margin-top:28px" novalidate>
    <h2>Quando e dove</h2>
    <div class="riga-campi">
      <div class="campo"><label for="data">Data</label><input id="data" name="data" type="date" required /></div>
      <div class="campo"><label for="ora">Ora</label><input id="ora" name="ora" type="time" /><span class="aiuto">Vuota se l'orario non è ancora deciso: il sito scrive "Orario da definire".</span></div>
    </div>
    <div class="riga-campi">
      <div class="campo"><label for="citta">Città</label><input id="citta" name="citta" required placeholder="Rignano Flaminio (RM)" /></div>
      <div class="campo"><label for="sala">Sala o chiesa</label><input id="sala" name="sala" placeholder="Chiesa di S. Giuseppe" /></div>
    </div>
    <div class="campo"><label for="indirizzo">Indirizzo</label><input id="indirizzo" name="indirizzo" placeholder="Via Carlo Alberto dalla Chiesa 1" /><span class="aiuto">Facoltativo: serve per il pulsante "Apri la mappa".</span></div>
    <div class="campo"><label for="rassegna">Rassegna o evento</label><input id="rassegna" name="rassegna" placeholder="Autunno Musicale 2026" /><span class="aiuto">Facoltativo: è il titolo dell'evento nel calendario; senza, si usa l'opera.</span></div>

    <h2>Programma</h2>
    <div id="opere" style="display:grid;gap:14px">
      <div class="riga-campi opera">
        <div class="campo"><label>Autore</label><input name="autore" placeholder="W. A. Mozart" /></div>
        <div class="campo"><label>Opera</label><input name="opera" required placeholder="Requiem in re minore K 626" /></div>
      </div>
    </div>
    <p><button class="btn o" type="button" data-aggiungi="opere">+ Un'altra opera</button></p>
    <div class="campo"><label for="organico">Organico</label><input id="organico" name="organico" placeholder="per soli, coro e orchestra" /><span class="aiuto">Dell'ultima opera dell'elenco. Facoltativo.</span></div>
    <div class="campo"><label for="brani">Brani</label><input id="brani" name="brani" placeholder="Introitus, Kyrie, Dies irae…" /><span class="aiuto">Dell'ultima opera, separati da virgole. Facoltativo.</span></div>

    <h2>Dettagli</h2>
    <div class="riga-campi">
      <div class="campo"><label for="organizza">Organizza</label><input id="organizza" name="organizza" placeholder="Comune di Rignano Flaminio" /></div>
      <div class="campo"><label for="ingresso">Ingresso</label><input id="ingresso" name="ingresso" placeholder="libero" /></div>
    </div>
    <div class="campo"><label for="evidenza">In evidenza</label><input id="evidenza" name="evidenza" placeholder="Per gli 800 anni dalla morte di San Francesco d'Assisi" /><span class="aiuto">Una frase che compare in risalto. Facoltativa.</span></div>

    <h2>Interpreti</h2>
    <p class="tenue" style="font-size:15px">Il M° {coro.maestro.nome} e il coro compaiono da soli. Aggiungi "Direttore" solo se dirige qualcun altro. Nome vuoto = "da annunciare".</p>
    <datalist id="ruoli">{ruoli.map((r) => <option value={r} />)}</datalist>
    <div id="interpreti" style="display:grid;gap:14px">
      <div class="riga-campi interprete">
        <div class="campo"><label>Ruolo</label><input name="ruolo" list="ruoli" placeholder="Soprano" /></div>
        <div class="campo"><label>Nome</label><input name="nome" placeholder="Maria Rossi" /></div>
      </div>
    </div>
    <p><button class="btn o" type="button" data-aggiungi="interpreti">+ Un altro interprete</button></p>

    <h2>Immagini</h2>
    <div class="riga-campi">
      <div class="campo"><label for="locandina">Locandina</label><input id="locandina" name="locandina" type="file" accept="image/jpeg,image/png,image/webp" /><span class="aiuto">La locandina ufficiale (JPEG o PNG; un PDF va prima salvato come immagine).</span></div>
      <div class="campo"><label for="copertina">Foto di copertina</label><input id="copertina" name="copertina" type="file" accept="image/jpeg,image/png,image/webp" /><span class="aiuto">Una foto del coro in questo concerto, se c'è. Solo con il consenso delle persone riconoscibili.</span></div>
    </div>

    <div class="bottoni" style="margin-top:12px"><button class="btn g" type="submit">Crea il concerto</button></div>
    <p id="esito" role="status"></p>
  </form>

  <script>
    import { riduci } from '../../../admin/immagini';

    const modulo = document.getElementById('nuovo-concerto') as HTMLFormElement;
    const esito = document.getElementById('esito')!;

    // Righe ripetibili: si copia la prima, svuotata
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-aggiungi]')) {
      b.addEventListener('click', () => {
        const contenitore = document.getElementById(b.dataset.aggiungi!)!;
        const copia = contenitore.firstElementChild!.cloneNode(true) as HTMLElement;
        copia.querySelectorAll('input').forEach((i) => { i.value = ''; i.required = false; });
        contenitore.append(copia);
        copia.querySelector('input')!.focus();
      });
    }

    function mostra(html: string, classe: string) {
      esito.className = `messaggio ${classe}`;
      esito.innerHTML = html;
    }

    modulo.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!modulo.reportValidity()) return;
      const pulsante = modulo.querySelector<HTMLButtonElement>('button[type=submit]')!;
      pulsante.disabled = true;
      mostra('Preparo le immagini e creo il concerto…', '');
      try {
        const dati = new FormData(modulo);
        for (const campo of ['locandina', 'copertina']) {
          const f = dati.get(campo);
          if (f instanceof File && f.size) dati.set(campo, await riduci(f));
          else dati.delete(campo);
        }
        const r = await fetch('/admin/concerti/crea', { method: 'POST', body: dati });
        const j = await r.json().catch(() => ({ ok: false, errore: `Risposta inattesa dal server (${r.status})` }));
        if (!j.ok) throw new Error(j.errore);
        modulo.reset();
        mostra(`Concerto creato. <a href="${j.evento}" target="_blank" rel="noopener">Apri l'evento nel calendario</a> · <a href="${j.cartella}" target="_blank" rel="noopener">Apri la cartella su Drive</a>. Per vederlo sul sito: <a href="/admin">Pubblicazione</a> → "Pubblica ora".`, 'ok');
      } catch (e) {
        mostra(`Non creato: ${(e as Error).message}`, 'errore');
      } finally {
        pulsante.disabled = false;
      }
    });
  </script>
</LayoutAdmin>
