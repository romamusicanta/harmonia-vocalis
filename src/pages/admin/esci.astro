---
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import { chiudiSessione } from '../../admin/sessione';
import { chiudiCorista, segnaUscita } from '../../area/accesso';

export const prerender = false;
// Si esce anche dalle altre aree (un solo accesso, una sola uscita) e non si rientra in silenzio
// finché non si accede di nuovo (dal 7/10/2026)
chiudiSessione(Astro.cookies);
chiudiCorista(Astro.cookies);
segnaUscita(Astro.cookies, Astro.url.protocol === 'https:');
---

<LayoutAdmin titolo="Uscita">
  <h1>Sei uscito</h1>
  <p class="bottoni"><a class="btn g" href="/admin">Rientra</a><a class="btn o" href="/">Vai al sito</a></p>
</LayoutAdmin>
