---
// Ritorno da Google: si controlla lo state, si scambia il codice e si verifica che chi entra
// faccia parte del gruppo dei redattori. Con lo stesso accesso si apre anche la sessione delle altre aree
// a cui ha diritto (apriSessioneAree): un solo passaggio da Google. Se la richiesta era silenziosa
// (accedi.astro) e qualcosa non va, si riprova subito facendo scegliere l'account.
import { completaAccesso } from '../../admin/google';
import { decifra, leggiSessione, salvaSessione } from '../../admin/sessione';
import { apriSessioneAree, ricordaAccount } from '../../area/accesso';

export const prerender = false;

const p = Astro.url.searchParams;
const atteso = decifra<{ stato: string; dopo: string; silenzioso?: boolean }>(Astro.cookies.get('hv-stato')?.value);
Astro.cookies.delete('hv-stato', { path: '/admin' });
const errore = (m: string) => Astro.redirect(`/admin/accedi?${new URLSearchParams(atteso?.silenzioso ? { scegli: '1', dopo: atteso.dopo } : { errore: m, dopo: atteso?.dopo ?? '/admin' })}`);

if (p.get('error')) return errore('Accesso annullato su Google.');
if (!atteso || atteso.stato !== p.get('state') || !p.get('code')) return errore('Accesso scaduto o non valido: riprova.');
let esito;
try {
  esito = await completaAccesso(p.get('code')!, `${Astro.url.origin}/admin/callback`);
} catch (e) {
  return errore(`Accesso non riuscito: ${(e as Error).message}`);
}
// Il Maestro (solo nel gruppo della direzione) non entra nell'Amministrazione: va nella sua area
const sicuro = Astro.url.protocol === 'https:';
if (esito.altrove) {
  if (esito.persona) {
    await apriSessioneAree(Astro.cookies, esito.persona, sicuro);
    ricordaAccount(Astro.cookies, esito.persona.email, sicuro);
  }
  return Astro.redirect(esito.altrove);
}
if (!esito.sessione) return errore(esito.errore ?? 'Accesso non riuscito.');
// Google dà il token per rinnovare l'accesso solo la prima volta: rientrando si tiene quello di prima
const prima = leggiSessione(Astro.cookies);
const rinnovo = esito.sessione.rinnovo ?? (prima?.email === esito.sessione.email ? prima.rinnovo : undefined);
salvaSessione(Astro.cookies, { ...esito.sessione, rinnovo }, sicuro);
ricordaAccount(Astro.cookies, esito.sessione.email, sicuro);
await apriSessioneAree(Astro.cookies, esito.sessione, sicuro);
return Astro.redirect(atteso.dopo);
---
