---
// Amministrazione → Foto dei concerti (src/area/fotoConcerti.ts): tutte le foto caricate dai coristi,
// per concerto, il più recente prima. Per ognuna i redattori scelgono dove si vede, e ogni livello
// comprende quello prima: Coristi (com'è appena caricata), Sito (anche nella pagina del concerto),
// Home (anche tra le foto più belle della home); oppure Nascosta, o la tolgono (cestino del Drive
// condiviso). Si salva subito (/admin/foto-concerti/stato); Sito e Home valgono dopo la pubblicazione.
import LayoutAdmin from '../../admin/LayoutAdmin.astro';
import Errore from '../../area/Errore.astro';
import FotoAdmin from '../../admin/FotoAdmin.astro';
import { parti } from '../../motore/concerti';
import { configurato, fotoDeiConcerti, sulSito, type ConcertoConFoto } from '../../area/fotoConcerti';

export const prerender = false;
let errore: unknown;
let gallerie: ConcertoConFoto[] = [];
if (!configurato()) errore = 'Manca la cartella «Foto dei concerti» su Drive (variabile DRIVE_CARTELLA_FOTO_CONCERTI sul server).';
else {
  try {
    gallerie = await fotoDeiConcerti(true);
  } catch (e) {
    errore = e;
  }
}
const quando = (iso: string) => { const d = parti({ data: iso }); return `${Number(d.giorno)} ${d.mese.toLowerCase()} ${d.anno}`; };
const inHome = gallerie.reduce((t, g) => t + g.foto.filter((f) => f.visibilita === 'home').length, 0);
---

<LayoutAdmin titolo="Foto dei concerti" sezione="foto-concerti">
  <h1>Foto dei concerti</h1>
  <p class="tenue" style="max-width:64ch">Le foto caricate dai coristi dalla loro area. Per ognuna scegli dove si vede; ogni livello comprende quello prima:</p>
  <ul class="legenda-foto tenue">
    <li><b>Coristi</b>: solo nell'area coristi (com'è appena caricata).</li>
    <li><b>Sito</b>: anche i visitatori, nella pagina del concerto.</li>
    <li><b>Home</b>: anche nella home, tra le foto più belle dei nostri concerti (si vedono le 9 dei concerti più recenti).</li>
    <li><b>Nascosta</b>: la vedono solo i redattori.</li>
  </ul>
  <p class="tenue" style="max-width:64ch">Sito e Home valgono dopo la prossima <a href="/admin">pubblicazione</a>. Le foto di un concerto si caricano e si gestiscono anche dalla sua Modifica (Concerti → Modifica, in fondo).{inHome > 0 && <> Ora in home: <b>{inHome}</b> {inHome === 1 ? 'foto' : 'foto'}{inHome > 9 && ' (si vedono le 9 dei concerti più recenti)'}.</>}</p>
  {errore && <Errore e={errore} />}
  {!errore && gallerie.length === 0 && <p class="tenue">Ancora nessuna foto.</p>}

  {gallerie.map((g) => (
    <section class="scheda-admin galleria-admin">
      <h2>{g.titolo} <small class="tenue">· {quando(g.data)} · {g.foto.length} foto, {g.foto.filter((f) => sulSito(f.visibilita)).length} sul sito, {g.foto.filter((f) => f.visibilita === 'home').length} in home</small></h2>
      <FotoAdmin foto={g.foto} />
    </section>
  ))}
</LayoutAdmin>

<style>
  .galleria-admin { margin: 24px 0; }
  .galleria-admin h2 { font-size: 19px; margin: 0 0 12px; }
  .galleria-admin h2 small { font-size: 14px; font-weight: 400; }
  .legenda-foto { margin: 0 0 12px; padding-left: 20px; font-size: 14px; display: grid; gap: 2px; }
</style>
