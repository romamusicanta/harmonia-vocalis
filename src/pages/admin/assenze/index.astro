---
// Assenze: i redattori scelgono una prova o un concerto (ultimi due mesi e prossimo mese) e
// correggono chi c'era, partendo da quanto dichiarato dai coristi. Un tocco su un nome lo segna
// assente o presente (/admin/assenze/cambia). Stessi dati dell'area coristi (src/area/dati.ts).
// In testa i report: chi è atteso al prossimo appuntamento, per sezione e con gli assenti, e
// i presenti per sezione alle ultime prove della stagione. Dopo ogni tocco salvato i report si
// rileggono dalla pagina stessa e si sostituiscono, senza ricaricarla (dal 7/10/2026).
import LayoutAdmin from '../../../admin/LayoutAdmin.astro';
import Icona from '../../../componenti/Icona.astro';
import { assenze, configurati, coristi, eventi, inizioStagione, nomeEvento, oggi, piuGiorni, riepilogo, sezioniDi, type Evento, type Riepilogo } from '../../../area/dati';
import { parti } from '../../../motore/concerti';
import Errore from '../../../area/Errore.astro';

export const prerender = false;

let errore: unknown;
let elenco: Evento[] = [];
let r: Riepilogo | undefined;
let prossimo: Riepilogo | undefined;
let storico: Riepilogo[] = [];
if (!configurati()) errore = 'Mancano le variabili FOGLIO_CORISTI_ID e CALENDARIO_PROVE_ID sul server.';
else {
  try {
    const [tutti, tutte, ev, futuri, passati] = await Promise.all([
      coristi(), assenze(), eventi(piuGiorni(oggi(), -62), piuGiorni(oggi(), 31)),
      eventi(oggi(), piuGiorni(oggi(), 60)), eventi(inizioStagione(oggi()), piuGiorni(oggi(), -1)),
    ]);
    elenco = ev;
    const p = futuri.find((x) => x.inizioMs > Date.now() - 3 * 3600 * 1000);
    if (p) prossimo = riepilogo(p, tutti, tutte);
    storico = passati.filter((x) => x.tipo === 'prova').slice(-8).reverse().map((x) => riepilogo(x, tutti, tutte));
    const scelto = Astro.url.searchParams.get('evento');
    // Senza scelta: la prima prova o concerto in programma (anche in corso da meno di tre ore, come
    // nel report in testa), altrimenti l'ultimo passato
    const e = elenco.find((x) => x.id === scelto) ?? elenco.find((x) => x.inizioMs > Date.now() - 3 * 3600 * 1000) ?? elenco.at(-1);
    if (e) r = riepilogo(e, tutti, tutte);
  } catch (e) {
    errore = e;
  }
}
const etichetta = (e: Evento) => { const d = parti({ data: e.data }); return `${d.giornoSettimana.slice(0, 3)} ${Number(d.giorno)} ${d.meseBreve.toLowerCase()}${e.inizio ? ` ${e.inizio}` : ''} · ${e.tipo === 'concerto' ? 'Concerto: ' : ''}${nomeEvento(e)}`; };
const assenti = new Map(r?.assenti.map((c) => [c.email, c]) ?? []);
const percento = (parte: number, totale: number) => `${totale ? Math.round((parte / totale) * 1000) / 10 : 0}%`;
const quando = (data: string) => { const d = parti({ data }); return `${d.giornoSettimana} ${Number(d.giorno)} ${d.mese.toLowerCase()}`; };
const breve = (data: string) => { const d = parti({ data }); return `${d.giornoSettimana.slice(0, 3)} ${Number(d.giorno)} ${d.meseBreve.toLowerCase()}`; };
const sezioniStorico = [...new Set(storico.flatMap((x) => x.perSezione.map((s) => s.sezione)))];
---

<LayoutAdmin titolo="Assenze dei coristi" sezione="assenze">
  <h1>Assenze dei coristi</h1>
  {errore && <Errore e={errore} />}

  {(prossimo || storico.length > 0) && (
    <div class="cruscotto" style="margin:28px 0 8px">
      {prossimo && (
        <article class="carta c-7 su">
          <div class="ct"><h2>{quando(prossimo.evento.data)}{prossimo.evento.inizio && ` · ${prossimo.evento.inizio}`} · {nomeEvento(prossimo.evento)}</h2><span class="tag">{prossimo.evento.tipo === 'concerto' ? 'Prossimo concerto' : 'Prossima prova'}</span>{elenco.some((e) => e.id === prossimo!.evento.id) && <a class="link-freccia" href={`?evento=${encodeURIComponent(prossimo.evento.id)}#correggi`}>Segna gli assenti <Icona nome="freccia" /></a>}</div>
          <div class="cc" style="display:flex;gap:28px;flex-wrap:wrap;align-items:end;border-bottom:1px solid var(--linea)">
            <div><b style="font-family:var(--f-titoli);font-weight:var(--peso-titoli);font-size:56px;line-height:.8;letter-spacing:-0.012em;color:var(--primario)">{prossimo.attesi.length - prossimo.assenti.length}</b><span class="tenue" style="font-size:18px;font-weight:600;margin-left:10px">attesi su {prossimo.attesi.length}</span></div>
            <div class="legenda"><span><i style="background:var(--primario)"></i>Attesi</span><span><i style="background:var(--rosso)"></i>Assenti</span></div>
          </div>
          <div class="sezioni-presenze">
            {prossimo.perSezione.map((s) => <div class="sp"><span class="nome">{s.sezione}</span><span class="cifre"><b>{s.presenti}</b> / {s.totale} · {s.assenti === 1 ? '1 assente' : `${s.assenti} assenti`}</span><span class="barra"><i style={`width:${percento(s.presenti, s.totale)};background:var(--primario)`}></i><i style={`width:${percento(s.assenti, s.totale)};background:var(--rosso)`}></i></span></div>)}
          </div>
        </article>
      )}

      {prossimo && (
        <article class="carta c-5 su">
          <div class="ct"><h2>Assenti segnalati</h2><span class="tag rosso">{prossimo.assenti.length}</span></div>
          {prossimo.assenti.length ? (
            <ul class="assenti">
              {prossimo.assenti.map((c) => <li><span class="av">{c.nome.charAt(0)}{c.cognome.charAt(0)}</span><b>{c.nome} {c.cognome}<small>{c.sezione}{c.daRedattore && ' · segnata dai redattori'}</small></b>{c.nota ? <span>{c.nota}</span> : <span class="tenue" style="font-style:italic">Nessuna nota</span>}</li>)}
            </ul>
          ) : <div class="cc tenue">Nessuna assenza segnalata.</div>}
        </article>
      )}

      {storico.length > 0 && (
        <article class="carta c-12">
          <div class="ct"><h2>Ultime prove</h2><span class="tenue" style="font-size:14px">Presenti per sezione</span></div>
          <div class="tabella-wrap">
            <table class="tabella">
              <thead><tr><th>Prova</th>{sezioniStorico.map((s) => <th class="num">{s}</th>)}<th class="num">Totale</th></tr></thead>
              <tbody>
                {storico.map((x) => {
                  const tot = x.attesi.length - x.assenti.length;
                  return (
                    <tr><td>{elenco.some((e) => e.id === x.evento.id) ? <a href={`?evento=${encodeURIComponent(x.evento.id)}#correggi`} style="text-decoration:underline">{breve(x.evento.data)}</a> : breve(x.evento.data)}</td>{sezioniStorico.map((s) => { const y = x.perSezione.find((p) => p.sezione === s); return <td class="num">{y ? `${y.presenti}/${y.totale}` : '—'}</td>; })}<td class="num"><span class="cella-barra"><b>{tot}</b><span class="barra"><i style={`width:${percento(tot, x.attesi.length)}`}></i></span></span></td></tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </article>
      )}
    </div>
  )}

  <h2 id="correggi">Segna le assenze</h2>
  <p class="tenue" style="max-width:64ch">Qui i redattori segnano le assenze degli altri: chi ha avvisato a voce o per messaggio, chi non è venuto senza avvisare. Scegli la prova o il concerto e tocca il nome. Chi non ha un'assenza è contato presente. I coristi segnalano le loro dall'area coristi fino all'inizio della prova; qui si correggono, anche dopo. Un tocco su un nome lo segna assente o presente e si salva subito nel foglio "Coristi e assenze" del Drive.</p>
  {elenco.length > 0 && (
    <form method="get" style="margin:20px 0;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
      <label for="evento" style="font-weight:700;color:var(--primario);width:100%">Prova o concerto</label>
      <select id="evento" name="evento" style="padding:10px 12px;border:2px solid var(--linea);border-radius:var(--raggio);background:var(--bianco);font:inherit;max-width:100%">
        {elenco.map((e) => <option value={e.id} selected={e.id === r?.evento.id}>{etichetta(e)}</option>)}
      </select>
      <button class="btn g piccolo">Mostra</button>
    </form>
  )}

  {r && (
    <>
      <p id="conteggio" style="font-size:18px"><b>{r.attesi.length - r.assenti.length}</b> presenti su {r.attesi.length} · <b>{r.assenti.length}</b> assenti</p>
      <div class="sezioni-assenze" data-evento={r.evento.id}>
        {sezioniDi(r.attesi).filter((s) => r!.attesi.some((c) => c.sezione === s)).map((s) => (
          <section class="scheda-admin">
            <h3 style="margin:0 0 10px;font-size:20px">{s}</h3>
            <ul>
              {r!.attesi.filter((c) => c.sezione === s).map((c) => {
                const a = assenti.get(c.email);
                return (
                  <li>
                    <button type="button" class:list={['corista', { assente: a }]} data-email={c.email} aria-pressed={a ? 'true' : 'false'}>
                      <span class="nome">{c.nome} {c.cognome}</span>
                      <span class="stato">{a ? (a.daRedattore ? 'Assente · redattori' : 'Assente · dichiarata') : 'Presente'}</span>
                    </button>
                    {a?.nota && <small class="tenue">{a.nota}</small>}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </>
  )}

  <style>
    .sezioni-assenze { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
    .sezioni-assenze ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .corista { width: 100%; display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 10px 12px; border: 1px solid var(--linea); border-radius: var(--raggio); background: var(--bianco); font: inherit; text-align: left; cursor: pointer; min-height: 44px; }
    .corista .stato { font-size: 13px; color: var(--tenue); white-space: nowrap; }
    .corista.assente { border-color: #b3261e; background: color-mix(in srgb, #b3261e 8%, var(--bianco)); }
    .corista.assente .stato { color: #b3261e; font-weight: 700; }
    .corista[aria-busy] { opacity: .5; }
    .sezioni-assenze small { display: block; padding: 2px 12px 4px; font-size: 13px; }
  </style>

  <script>
    const box = document.querySelector<HTMLElement>('.sezioni-assenze');
    const conteggio = () => {
      const tutti = document.querySelectorAll('.corista').length;
      const assenti = document.querySelectorAll('.corista.assente').length;
      document.querySelector('#conteggio')!.innerHTML = `<b>${tutti - assenti}</b> presenti su ${tutti} · <b>${assenti}</b> assenti`;
    };
    // I report in testa (prossimo appuntamento, ultime prove) rifatti dal server, un secondo e mezzo
    // dopo l'ultimo tocco: toccando più nomi di seguito si rilegge la pagina una volta sola (ogni
    // lettura costa letture del foglio, e Google ne accetta 60 al minuto); vale l'ultima richiesta
    let ultima = 0;
    let attesa: ReturnType<typeof setTimeout> | undefined;
    const aggiornaReport = () => { clearTimeout(attesa); attesa = setTimeout(rileggiReport, 1500); };
    const rileggiReport = async () => {
      const mia = ++ultima;
      try {
        const html = await (await fetch(location.href, { cache: 'no-store' })).text();
        if (mia !== ultima) return;
        const nuovo = new DOMParser().parseFromString(html, 'text/html').querySelector('.cruscotto');
        const vecchio = document.querySelector('.cruscotto');
        if (nuovo && vecchio) vecchio.replaceWith(document.importNode(nuovo, true));
      } catch { /* restano quelli di prima: si aggiornano al prossimo tocco o ricaricando */ }
    };
    box?.querySelectorAll<HTMLButtonElement>('.corista').forEach((b) => b.addEventListener('click', async () => {
      const assente = !b.classList.contains('assente');
      // L'assenza dichiarata dal corista (con la sua nota) non si toglie con un tocco involontario
      if (!assente && /dichiarata/.test(b.querySelector('.stato')!.textContent ?? '') && !confirm(`${b.querySelector('.nome')!.textContent} aveva segnalato l'assenza${b.parentElement?.querySelector('small') ? ', con una nota' : ''}. Segnarlo presente cancella la sua dichiarazione. Procedere?`)) return;
      const f = new FormData();
      f.set('evento', box.dataset.evento!);
      f.set('email', b.dataset.email!);
      f.set('assente', assente ? '1' : '0');
      b.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch('/admin/assenze/cambia', { method: 'POST', body: f });
        const esito = await r.json().catch(() => ({ ok: false, errore: `errore ${r.status}` }));
        if (!esito.ok) throw new Error(esito.errore);
        b.classList.toggle('assente', assente);
        b.setAttribute('aria-pressed', String(assente));
        b.querySelector('.stato')!.textContent = assente ? 'Assente · redattori' : 'Presente';
        if (!assente) b.parentElement?.querySelector('small')?.remove();
        conteggio();
        aggiornaReport();
      } catch (e) {
        alert((e as Error).message);
      } finally {
        b.removeAttribute('aria-busy');
      }
    }));
  </script>
</LayoutAdmin>
